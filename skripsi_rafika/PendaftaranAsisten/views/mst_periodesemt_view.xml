<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_mst_periodesemt" model="ir.sequence">
            <field name="name">Periode Semester Sequence</field>
            <field name="code">mst.periodesemt.sequence</field>
            <field name="prefix">PRD/%(year)s/</field>
            <field name="padding">2</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>

    <record id="view_mst_periodesemt_tree" model="ir.ui.view">
        <field name="name">mst.periodesemt.tree</field>
        <field name="model">mst_periodesemt</field>
        <field name="arch" type="xml">
            <tree string="Master Periode Semester">
                <field name="name"/>
                <field name="id_periode_semester"/>
                <field name="tahun_semester"/>
                <field name="deadline_date"/>
            </tree>
        </field>
    </record>

    <record id="view_mst_periodesemt_form" model="ir.ui.view">
        <field name="name">mst.periodesemt.form</field>
        <field name="model">mst_periodesemt</field>
        <field name="arch" type="xml">
            <form string="Master Periode Semester">
                <header>
                    <button name="%(action_wizard_publikasi_hasil)d" string="Publikasi Hasil" type="action" class="oe_highlight"/>
                </header>
                <sheet>
                    <field name="poster_img" widget="image" class="oe_avatar"/>
                    <group string="Informasi Periode">
                        <field name="name" placeholder="Misal: Genap 2026"/>
                        <field name="id_periode_semester"/>
                        <field name="tahun_semester"/>
                        <field name="deadline_date"/>
                        <field name="active"/>
                        <field name="deadline_alokasi" widget="datetime"/>
                    </group>
                    <group string="Rekrutmen">
                        <field name="link_pendaftaran" widget="url"/>
                    </group>
                    <group string="Dokumen Keputusan (SKEP)">
                        <field name="skep_filename" invisible="1"/>
                        <field name="skep_file" filename="skep_filename" widget="binary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_op_facility_form_assistant_inherit" model="ir.ui.view">
        <field name="name">op.facility.form.inherit.assistant</field>
        <field name="model">op.facility</field>
        <field name="inherit_id" ref="openeducat_facility.view_op_facility_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="inside">
                <group string="Assistant Registration">
                    <field name="assistant_id"/>
                    <field name="registration_status"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
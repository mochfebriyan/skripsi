<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lab_master_ruangan_form" model="ir.ui.view">
        <field name="name">lab.master.ruangan.form</field>
        <field name="model">lab.master.ruangan</field>
        <field name="arch" type="xml">
            <form string="Master Ruangan">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Nama Ruangan..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="kode_ruangan"/>
                            <field name="kapasitas"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_lab_master_ruangan_tree" model="ir.ui.view">
        <field name="name">lab.master.ruangan.tree</field>
        <field name="model">lab.master.ruangan</field>
        <field name="arch" type="xml">
            <tree string="Master Ruangan">
                <field name="kode_ruangan"/>
                <field name="name"/>
                <field name="kapasitas"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="action_lab_master_ruangan" model="ir.actions.act_window">
        <field name="name">Master Ruangan</field>
        <field name="res_model">lab.master.ruangan</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        
        <!-- ================================================================================================ -->
        <!-- VIEWS untuk OpAssistantDocument -->
        <!-- ================================================================================================ -->
        
        <!-- TREE VIEW -->
        <record id="view_op_assistant_document_tree" model="ir.ui.view">
            <field name="name">op.assistant.document.tree</field>
            <field name="model">op.assistant.document</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <tree string="Assistant Documents">
                    <field name="name"/>
                    <field name="assistant_id"/>
                    <field name="document_type"/>
                    <field name="document_date"/>
                    <field name="expiry_date"/>
                </tree>
            </field>
        </record>

        <!-- FORM VIEW -->
        <record id="view_op_assistant_document_form" model="ir.ui.view">
            <field name="name">op.assistant.document.form</field>
            <field name="model">op.assistant.document</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="Assistant Document">
                    <sheet>
                        <group>
                            <group>
                                <field name="assistant_id" required="1"/>
                                <field name="document_type" required="1"/>
                            </group>
                            <group>
                                <field name="document_date"/>
                                <field name="expiry_date"/>
                            </group>
                        </group>
                        <separator string="File"/>
                        <group>
                            <field name="raw" widget="binary" help="Upload file dokumen"/>
                            <field name="mimetype" invisible="1"/>
                        </group>
                        <separator string="Catatan"/>
                        <field name="notes" nolabel="1" placeholder="Catatan tentang dokumen ini"/>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- SEARCH VIEW -->
        <record id="view_op_assistant_document_search" model="ir.ui.view">
            <field name="name">op.assistant.document.search</field>
            <field name="model">op.assistant.document</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="Assistant Document">
                    <field name="name"/>
                    <field name="assistant_id"/>
                    <field name="document_type"/>
                    <newline/>
                    <group expand="0" string="Group By...">
                        <filter name="group_by_type" string="Type" domain="[]"
                                context="{'group_by': 'document_type'}"/>
                        <filter name="group_by_assistant" string="Assistant" domain="[]"
                                context="{'group_by': 'assistant_id'}"/>
                    </group>
                </search>
            </field>
        </record>

    </data>
</odoo>

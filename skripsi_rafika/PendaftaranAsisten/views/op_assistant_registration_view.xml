<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        
        <!-- ================================================================================================ -->
        <!-- VIEWS untuk OpAssistantRegistration -->
        <!-- ================================================================================================ -->
        
        <!-- TREE VIEW -->
        <record id="view_op_assistant_registration_tree" model="ir.ui.view">
            <field name="name">op.assistant.registration.tree</field>
            <field name="model">op.assistant.registration</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <tree string="Assistant Registrations">
                    <field name="registration_number"/>
                    <field name="registration_date"/>
                    <field name="student_id"/>
                    <field name="preferred_assistants"/>
                    <field name="preferred_department_id"/>
                    <field name="state"/>
                    <field name="gpa" optional="hide"/>
                </tree>
            </field>
        </record>

        <!-- FORM VIEW -->
        <record id="view_op_assistant_registration_form" model="ir.ui.view">
            <field name="name">op.assistant.registration.form</field>
            <field name="model">op.assistant.registration</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="Assistant Registration">
                    <header>
                        <button name="action_submit" type="object" string="Submit Application"
                                class="oe_highlight"
                                invisible="state != 'draft'"
                                groups="openeducat_core.group_op_faculty,base.group_portal"/>
                        <button name="action_under_review" type="object" string="Under Review"
                                invisible="state != 'submitted'"
                                groups="openeducat_core.group_op_back_office_admin"/>
                        <button name="action_approve" type="object" string="Approve" 
                                class="oe_highlight"
                                invisible="state != 'under_review'"
                                groups="openeducat_core.group_op_back_office_admin"/>
                        <button name="action_reject" type="object" string="Reject"
                                invisible="state not in ['under_review', 'submitted']"
                                groups="openeducat_core.group_op_back_office_admin"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box">
                        </div>
                        <field name="active" invisible="1"/>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                                invisible="active == True"/>
                        <h2>
                            <field name="registration_number"/>
                        </h2>
                        <group>
                            <group>
                                <field name="registration_date" readonly="1"/>
                                <field name="student_id" required="1" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="submitted_by" readonly="1"/>
                                <field name="review_date" readonly="1"/>
                                <field name="reviewed_by" readonly="1"/>
                            </group>
                        </group>

                        <notebook colspan="4">
                            <!-- TAB: IDENTITAS & RIWAYAT AKADEMIK -->
                            <page name="identitas" string="Identity &amp; Academic">
                                <group>
                                    <group>
                                        <field name="email" readonly="1"/>
                                        <field name="phone" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="course_id" readonly="1"/>
                                        <field name="batch_id" readonly="1"/>
                                        <field name="gpa"/>
                                    </group>
                                </group>
                            </page>

                            <!-- TAB: PREFERENSI POSISI -->
                            <page name="preferensi" string="Position Preference">
                                <group>
                                    <group>
                                        <field name="preferred_assistants" required="1"/>
                                        <field name="preferred_department_id" required="1"/>
                                    </group>
                                    <group>
                                        <field name="preferred_faculty_id"/>
                                        <field name="availability_hours"/>
                                    </group>
                                </group>
                            </page>

                            <!-- TAB: MOTIVASI & PENGALAMAN -->
                            <page name="motivation" string="Motivation &amp; Experience">
                                <field name="motivation_letter" nolabel="1" placeholder="Surat Motivasi"/>
                                <separator string="Pengalaman Kerja"/>
                                <field name="work_experience" nolabel="1" placeholder="Pengalaman kerja sebelumnya"/>
                                <separator string="Keahlian &amp; Kompetensi"/>
                                <field name="skills" nolabel="1" placeholder="Keahlian dan kompetensi yang dimiliki"/>
                            </page>

                            <!-- TAB: REVIEW & NOTES -->
                            <page name="review" string="Review">
                                <group>
                                    <label for="rejection_reason" string="Rejection Reason" 
                                           invisible="state != 'rejected'"/>
                                    <field name="rejection_reason" nolabel="1" 
                                           invisible="state != 'rejected'"/>
                                </group>
                                <separator string="Catatan"/>
                                <field name="notes" nolabel="1" placeholder="Catatan dari reviewer"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                        <field name="message_ids" widget="mail_thread"/>
                        <field name="activity_ids" widget="mail_activity"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- SEARCH VIEW -->
        <record id="view_op_assistant_registration_search" model="ir.ui.view">
            <field name="name">op.assistant.registration.search</field>
            <field name="model">op.assistant.registration</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="Assistant Registration">
                    <field name="registration_number"/>
                    <field name="student_id"/>
                    <field name="preferred_assistants"/>
                    <field name="preferred_department_id"/>
                    <newline/>
                    <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                    <filter name="submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                    <filter name="under_review" string="Under Review" domain="[('state', '=', 'under_review')]"/>
                    <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                    <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                    <separator/>
                    <group expand="0" string="Group By...">
                        <filter name="group_by_status" string="Status" domain="[]"
                                context="{'group_by': 'state'}"/>
                        <filter name="group_by_position" string="Position" domain="[]"
                                context="{'group_by': 'preferred_assistants'}"/>
                        <filter name="group_by_department" string="Department" domain="[]"
                                context="{'group_by': 'preferred_department_id'}"/>
                        <filter name="group_by_date" string="Date" domain="[]"
                                context="{'group_by': 'registration_date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ACTION WINDOW -->
        <record model="ir.actions.act_window" id="act_open_op_assistant_registration_view">
            <field name="name">Assistant Registrations</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">op.assistant.registration</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_op_assistant_registration_search"/>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>

    </data>
</odoo>

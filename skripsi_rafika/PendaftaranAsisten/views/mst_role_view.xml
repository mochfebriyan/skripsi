<odoo>
    <record id="view_mst_role_tree" model="ir.ui.view">
        <field name="name">mst.role.tree</field>
        <field name="model">mst_role</field>
        <field name="arch" type="xml">
            <tree string="Master Role">
                <field name="id_master_role"/>
                <field name="nama_role"/>
            </tree>
        </field>
    </record>

    <record id="view_mst_role_form" model="ir.ui.view">
        <field name="name">mst.role.form</field>
        <field name="model">mst_role</field>
        <field name="arch" type="xml">
            <form string="Master Role">
                <sheet>
                    <group>
                        <field name="id_master_role"/>
                        <field name="nama_role"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mst_role" model="ir.actions.act_window">
        <field name="name">Master Role</field>
        <field name="res_model">mst_role</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_mst_role_tree"/>
    </record>
</odoo>

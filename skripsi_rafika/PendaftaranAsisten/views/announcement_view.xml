<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lab_recruitment_announcement_form" model="ir.ui.view">
        <field name="name">lab.recruitment.announcement.form</field>
        <field name="model">lab.recruitment.announcement</field>
        <field name="arch" type="xml">
            <form string="Pengumuman Rekrutmen">
                <header>
                    <button name="action_publish" type="object" string="Publish" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_unpublish" type="object" string="Unpublish/Close" invisible="state != 'published'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Judul Pengumuman..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="periode_id"/>
                            <field name="date_deadline"/>
                        </group>
                        <group>
                            <field name="poster" widget="image" class="oe_avatar" options="{'size': [256, 256]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Isi Pengumuman">
                            <field name="content"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_lab_recruitment_announcement_tree" model="ir.ui.view">
        <field name="name">lab.recruitment.announcement.tree</field>
        <field name="model">lab.recruitment.announcement</field>
        <field name="arch" type="xml">
            <tree string="Pengumuman Rekrutmen">
                <field name="name"/>
                <field name="periode_id"/>
                <field name="date_deadline"/>
                <field name="state" widget="badge" decoration-success="state == 'published'" decoration-info="state == 'draft'" decoration-danger="state == 'closed'"/>
            </tree>
        </field>
    </record>

    <record id="action_lab_recruitment_announcement" model="ir.actions.act_window">
        <field name="name">Pengumuman Rekrutmen</field>
        <field name="res_model">lab.recruitment.announcement</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>

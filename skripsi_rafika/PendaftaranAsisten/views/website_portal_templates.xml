<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Modifikasi tautan logout di portal untuk memunculkan konfirmasi -->
        <template id="portal_user_dropdown_custom_logout" inherit_id="portal.user_dropdown">
            <xpath expr="//a[@id='o_logout']" position="attributes">
                <attribute name="data-confirm">Apakah Anda yakin ingin logout?</attribute>
            </xpath>
        </template>
    </data>
</odoo>

<odoo>
    <record id="view_mst_kodekelas_tree" model="ir.ui.view">
        <field name="name">mst.kodekelas.tree</field>
        <field name="model">mst_kodekelas</field>
        <field name="arch" type="xml">
            <tree string="Master Kode Kelas">
                <field name="id_kode_kelas"/>
                <field name="kode_kelas"/>
                <field name="nama_kelas"/>
            </tree>
        </field>
    </record>

    <record id="view_mst_kodekelas_form" model="ir.ui.view">
        <field name="name">mst.kodekelas.form</field>
        <field name="model">mst_kodekelas</field>
        <field name="arch" type="xml">
            <form string="Master Kode Kelas">
                <sheet>
                    <group>
                        <field name="id_kode_kelas" readonly="1" force_save="1"/>
                        <field name="kode_kelas"/>
                        <field name="nama_kelas"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mst_kodekelas" model="ir.actions.act_window">
        <field name="name">Master Kode Kelas</field>
        <field name="res_model">mst_kodekelas</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_mst_kodekelas_tree"/>
    </record>
</odoo>

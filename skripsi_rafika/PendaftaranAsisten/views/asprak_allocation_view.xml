<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asprak_allocation_search" model="ir.ui.view">
        <field name="name">asprak.allocation.search</field>
        <field name="model">asprak.allocation</field>
        <field name="arch" type="xml">
            <search string="Cari Alokasi Jadwal">
                <field name="id_alokasi"/>
                <field name="periode_semester_id"/>
                <field name="penanggung_jawab_lab_id"/>
                
                <filter string="Status Draft" name="filter_draft" domain="[('status_alokasi', '=', 'draft')]"/>
                <filter string="Sudah Disahkan" name="filter_done" domain="[('status_alokasi', '=', 'done')]"/>
                
                <group expand="1" string="Kelompokkan Berdasarkan">
                    <filter string="Periode Semester" name="group_periode" context="{'group_by':'periode_semester_id'}"/>
                    <filter string="Status Alokasi" name="group_status" context="{'group_by':'status_alokasi'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_asprak_allocation_tree" model="ir.ui.view">
        <field name="name">asprak.allocation.tree</field>
        <field name="model">asprak.allocation</field>
        <field name="arch" type="xml">
            <tree string="Asprak Allocation" 
                  decoration-info="status_alokasi == 'draft'" 
                  decoration-success="status_alokasi == 'done'">
                <field name="id_alokasi"/>
                <field name="tanggal_penetapan"/>
                <field name="periode_semester_id"/>
                <field name="penanggung_jawab_lab_id"/>
                <field name="status_alokasi" widget="badge" 
                       decoration-info="status_alokasi == 'draft'" 
                       decoration-success="status_alokasi == 'done'"/>
            </tree>
        </field>
    </record>

    <record id="view_asprak_allocation_form" model="ir.ui.view">
        <field name="name">asprak.allocation.form</field>
        <field name="model">asprak.allocation</field>
        <field name="arch" type="xml">
            <form string="Asprak Allocation">
                <header>
                    <button name="action_konfirmasi_plotting" string="Konfirmasi Plotting" type="object" class="btn-primary" invisible="status_alokasi != 'draft'"/>
                    <button name="action_sahkan_jadwal" string="Sahkan Jadwal" type="object" class="btn-success" invisible="status_alokasi != 'allocated'"/>
                    <field name="status_alokasi" widget="statusbar" statusbar_visible="draft,allocated,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="id_alokasi" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="periode_semester_id" readonly="1"/>
                            <field name="tanggal_penetapan" readonly="1"/>
                        </group>
                        <group>
                            <field name="penanggung_jawab_lab_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Detail Alokasi Asisten">
                            <field name="line_ids" readonly="1">
                                <tree editable="bottom">
                                    <field name="asisten_terpilih_id"/>
                                    <field name="mata_kuliah_id"/>
                                    <field name="kelas_id"/>
                                    <field name="ruang_lab_id"/>
                                    <field name="jadwal_waktu_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_asprak_allocation" model="ir.actions.act_window">
        <field name="name">Dokumen Alokasi Jadwal</field>
        <field name="res_model">asprak.allocation</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_asprak_allocation_search"/>
        <field name="context">{'search_default_group_periode': 1}</field>
    </record>
</odoo>
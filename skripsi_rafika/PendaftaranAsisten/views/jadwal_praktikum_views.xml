<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_jadwal_praktikum_form" model="ir.ui.view">
        <field name="name">jadwal.praktikum.form</field>
        <field name="model">jadwal.praktikum</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="mata_kuliah_id"/>
                            <field name="dosen_id"/>
                            <field name="kode_kelas_id"/>
                        </group>
                        <group>
                            <field name="hari"/>
                            <field name="jam_mulai" />
                            <field name="jam_selesai" />
                            <field name="kuota_asisten" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Asisten Terdaftar">
                            <field name="asisten_ids" widget="many2many_tags" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_jadwal_praktikum_tree" model="ir.ui.view">
        <field name="name">jadwal.praktikum.tree</field>
        <field name="model">jadwal.praktikum</field>
        <field name="arch" type="xml">
            <tree>
                <field name="mata_kuliah_id"/>
                <field name="hari"/>
                <field name="jam_mulai" />
                <field name="jam_selesai" />
                <field name="pertemuan_ke" string="Pertemuan Ke-"/>
                <field name="kuota_asisten"/>
            </tree>
        </field>
    </record>

    <record id="view_jadwal_praktikum_search" model="ir.ui.view">
        <field name="name">jadwal.praktikum.search</field>
        <field name="model">jadwal.praktikum</field>
        <field name="arch" type="xml">
            <search string="Cari Jadwal">
                <field name="hari"/>
                <field name="mata_kuliah_id"/>
                <group expand="1" string="Group By">
                    <filter string="Hari" name="group_hari" context="{'group_by':'hari'}"/>
                    <filter string="Jam Mulai" name="group_jam_mulai" context="{'group_by':'jam_mulai'}"/>
                    <filter string="Pertemuan" name="group_pertemuan" context="{'group_by':'pertemuan_ke'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_jadwal_praktikum" model="ir.actions.act_window">
        <field name="name">Master Jadwal Praktikum</field>
        <field name="res_model">jadwal.praktikum</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_jadwal_praktikum"
              name="Master Jadwal Praktikum"
              parent="menu_configuration_root"
              action="action_jadwal_praktikum"
              sequence="10"/>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="website_selection_result" name="Hasil Seleksi Asisten">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="container mt-5 mb-5 text-center">
                    
                    <t t-if="not pendaftaran">
                        <div class="alert alert-info d-inline-block p-4 shadow-sm" role="alert">
                            <h4 class="alert-heading mb-3">Informasi</h4>
                            <p>Data pendaftaran atau hasil seleksi untuk Anda belum tersedia.</p>
                            <a href="/my/home" class="btn btn-primary mt-3">Kembali ke Portal</a>
                        </div>
                    </t>

                    <t t-if="pendaftaran">
                        <div class="card shadow-sm mx-auto" style="max-width: 600px;">
                            <div class="card-header bg-primary text-white">
                                <h4 class="mb-0">Pengumuman Seleksi Asisten Praktikum</h4>
                            </div>
                            <div class="card-body p-4">
                                
                                <t t-if="status_admin == 'tidak_lolos' or status_final == 'failed'">
                                    <div class="alert alert-danger mb-4" role="alert">
                                        <h4 class="alert-heading">TIDAK LOLOS</h4>
                                        <p>Mohon Maaf. Anda belum lolos seleksi asisten praktikum pada periode ini. Tetap semangat dan coba lagi di kesempatan berikutnya!</p>
                                    </div>
                                </t>

                                <t t-elif="status_final == 'passed'">
                                    <div class="alert alert-success mb-4" role="alert">
                                        <h4 class="alert-heading">SELAMAT! ANDA RESMI DITERIMA</h4>
                                        <p>Anda telah lulus seluruh tahapan seleksi Asisten Praktikum. Silakan unduh SKEP Rektor dan pilih jadwal mengajar Anda.</p>
                                    </div>
                                    
                                    <div class="mb-4">
                                        <t t-if="skep_file">
                                            <a t-attf-href="/download/skep-rektor/{{ pendaftaran.id }}" class="btn btn-success btn-lg mb-2">
                                                <i class="fa fa-download mr-2"></i> Unduh SKEP Rektor
                                            </a>
                                        </t>
                                        <t t-else="">
                                            <button class="btn btn-secondary btn-lg mb-2" disabled="disabled">
                                                <i class="fa fa-clock-o mr-2"></i> SKEP dalam proses pengesahan
                                            </button>
                                        </t>
                                        <br/>
                                        <a href="/my/alokasi-jadwal" class="btn btn-primary btn-lg mt-2 shadow-sm">
                                            <i class="fa fa-calendar-check-o mr-2"></i> Pilih Jadwal Mengajar
                                        </a>
                                    </div>
                                </t>

                                <t t-elif="status_admin == 'lolos'">
                                    <div class="alert alert-info mb-4" role="alert">
                                        <h4 class="alert-heading">Lolos Seleksi Administrasi</h4>
                                        <p>Selamat! Berkas Anda telah disetujui. Silakan persiapkan diri Anda untuk tahapan Tes Tulis / Wawancara selanjutnya sesuai jadwal yang ditentukan oleh Laboran.</p>
                                    </div>
                                </t>

                                <t t-else="">
                                    <div class="alert alert-warning mb-4" role="alert">
                                        <h4 class="alert-heading">Sedang Diproses</h4>
                                        <p>Status pendaftaran Anda saat ini masih dalam tahap verifikasi berkas atau penilaian tim seleksi. Mohon pantau halaman ini secara berkala.</p>
                                    </div>
                                </t>
                                
                                <hr class="mt-4"/>
                                <a href="/my/home" class="btn btn-outline-primary mt-2">Kembali ke Portal</a>
                            </div>
                        </div>
                    </t>

                </div>
            </div>
        </t>
    </template>
</odoo>
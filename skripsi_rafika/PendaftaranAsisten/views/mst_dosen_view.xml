<odoo>
    <record id="view_mst_dosen_tree" model="ir.ui.view">
        <field name="name">mst.dosen.tree</field>
        <field name="model">mst_dosen</field>
        <field name="arch" type="xml">
            <tree string="Master Dosen">
                <field name="id_dosen"/>
                <field name="kode_dosen"/>
                <field name="nama_dosen"/>
            </tree>
        </field>
    </record>

    <record id="view_mst_dosen_form" model="ir.ui.view">
        <field name="name">mst.dosen.form</field>
        <field name="model">mst_dosen</field>
        <field name="arch" type="xml">
            <form string="Master Dosen">
                <sheet>
                    <group>
                        <field name="id_dosen" readonly="1" force_save="1"/>
                        <field name="kode_dosen"/>
                        <field name="nama_dosen"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mst_dosen" model="ir.actions.act_window">
        <field name="name">Master Dosen</field>
        <field name="res_model">mst_dosen</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_mst_dosen_tree"/>
    </record>
</odoo>

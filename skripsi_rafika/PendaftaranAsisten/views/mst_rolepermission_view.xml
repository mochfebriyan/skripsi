<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mst_rolepermission_tree" model="ir.ui.view">
        <field name="name">mst.rolepermission.tree</field>
        <field name="model">mst_rolepermission</field>
        <field name="arch" type="xml">
            <tree string="Master Role Permission">
                <field name="id_master_role_permission"/>
                <field name="role_id"/>
                <field name="create_perm"/>
                <field name="read_perm"/>
                <field name="update_perm"/>
                <field name="delete_perm"/>
                <field name="view_perm"/>
            </tree>
        </field>
    </record>

    <record id="view_mst_rolepermission_form" model="ir.ui.view">
        <field name="name">mst.rolepermission.form</field>
        <field name="model">mst_rolepermission</field>
        <field name="arch" type="xml">
            <form string="Master Role Permission">
                <sheet>
                    <group>
                        <field name="id_master_role_permission"/>
                        <field name="role_id"/>
                    </group>
                    <group>
                        <field name="create_perm"/>
                        <field name="read_perm"/>
                        <field name="update_perm"/>
                        <field name="delete_perm"/>
                        <field name="view_perm"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_mst_rolepermission" model="ir.actions.act_window">
        <field name="name">Master Role Permission</field>
        <field name="res_model">mst_rolepermission</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_mst_rolepermission_tree"/>
    </record>
</odoo>
<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_timetable_keseluruhan_calendar" model="ir.ui.view">
            <field name="name">timetable.keseluruhan.calendar</field>
            <field name="model">timetable.keseluruhan</field>
            <field name="arch" type="xml">
                <calendar
                    string="All Schedule"
                    date_start="waktu_mulai"
                    date_stop="waktu_selesai"
                    color="kelas_id"
                    quick_create="false"
                    mode="week"
                >
                    <field name="name"/>
                    <field name="dosen_id"/>
                    <field name="kelas_id"/>
                    <field name="course_id"/>
                </calendar>
            </field>
        </record>

        <record id="view_timetable_keseluruhan_tree" model="ir.ui.view">
            <field name="name">timetable.keseluruhan.tree</field>
            <field name="model">timetable.keseluruhan</field>
            <field name="arch" type="xml">
                <tree string="All Schedule" decoration-info="keterangan != False">
                    <field name="name" string="Activity"/>
                    <field name="jadwal_praktikum_id"/>
                    <field name="waktu_mulai" string="Start Time" widget="datetime"/>
                    <field name="waktu_selesai" string="End Time" widget="datetime"/>
                    <field name="course_id" string="Course"/>
                    <field name="kelas_id" string="Class"/>
                    <field name="dosen_id" string="Lecturer"/>
                    <field name="keterangan" string="Information" optional="show"/>
                </tree>
            </field>
        </record>

        <record id="view_timetable_keseluruhan_form" model="ir.ui.view">
            <field name="name">timetable.keseluruhan.form</field>
            <field name="model">timetable.keseluruhan</field>
            <field name="arch" type="xml">
                <form string="All Schedule">
                    <header/>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Activity"/>
                            <h1>
                                <field name="name"
                                       placeholder="Example: Practicum Algorithm Class A"
                                       required="1"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Schedule Information">
                                <field name="course_id" options="{'no_create': True}"/>
                                <field name="kelas_id" options="{'no_create': True}"/>
                                <field name="dosen_id" options="{'no_create': True}"/>
                            </group>
                            <group string="Schedule Time">
                                <field name="jadwal_praktikum_id"/>
                                <field name="waktu_mulai" widget="datetime"/>
                                <field name="waktu_selesai" widget="datetime"/>
                            </group>
                        </group>
                        <group string="Additional Information">
                            <field name="keterangan" nolabel="1" placeholder="Add additional information if needed..."/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_timetable_keseluruhan_search" model="ir.ui.view">
            <field name="name">timetable.keseluruhan.search</field>
            <field name="model">timetable.keseluruhan</field>
            <field name="arch" type="xml">
                <search string="Search Timetable">
                    <field name="name" string="Activity"/>
                    <field name="dosen_id" string="Lecturer"/>
                    <field name="kelas_id" string="Class"/>
                    <field name="course_id" string="Course"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_kelas" string="Class" context="{'group_by': 'kelas_id'}"/>
                        <filter name="group_by_dosen" string="Lecturer" context="{'group_by': 'dosen_id'}"/>
                        <filter name="group_by_course" string="Course" context="{'group_by': 'course_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_timetable_keseluruhan" model="ir.actions.act_window">
            <field name="name">All Schedule</field>
            <field name="res_model">timetable.keseluruhan</field>
            <field name="view_mode">calendar,tree,form</field>
            <field name="groups_id" eval="[
                (4, ref('group_timetable_laboran')),
                (4, ref('group_timetable_kepala_lab')),
                (4, ref('group_pimpinan'))
            ]"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No schedule registered yet.
                </p>
                <p>
                    Create a new entry to start compiling the All Schedule.
                </p>
            </field>
        </record>

        <menuitem id="menu_timetable_keseluruhan"
                  name="All Schedule"
                  parent="menu_assistant_root"
                  action="action_timetable_keseluruhan"
                  sequence="30"
                  groups="group_timetable_laboran,group_timetable_kepala_lab,group_pimpinan"/>

    </data>
</odoo>
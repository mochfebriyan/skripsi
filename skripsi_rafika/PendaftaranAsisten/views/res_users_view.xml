<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View inherit untuk memastikan grup muncul dengan rapi 
         Catatan: Odoo secara otomatis me-render grup di tab Access Rights berdasarkan module_category.
         Inherit view ini ditambahkan untuk mengakomodasi kebutuhan kustomisasi form jika diperlukan. -->
    <record id="view_users_form_inherit_lab_groups" model="ir.ui.view">
        <field name="name">res.users.form.inherit.lab.groups</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="attributes">
                <attribute name="string">Access Rights</attribute>
            </xpath>
        </field>
    </record>
</odoo>

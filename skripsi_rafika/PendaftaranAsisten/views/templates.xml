<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="website_pendaftaran_form" name="Form Pendaftaran Asisten">
            <t t-call="website.layout">
                <div id="wrap" class="o_portal_wrap">
                    <div class="container mt-4 mb-5">

                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="/my/home">Home</a></li>
                                <li class="breadcrumb-item active">Pendaftaran Asisten</li>
                            </ol>
                        </nav>

                        <div class="row justify-content-center">
                            <div class="col-lg-8">

                                <t t-if="not pendaftaran">
                                    <h2 class="mb-1">Pendaftaran Asisten Praktikum</h2>
                                    <p class="text-muted mb-4">
                                        Periode: <strong t-esc="periode.name if periode else 'Tidak ada periode aktif'"/>
                                    </p>

                                    <t t-if="is_closed">
                                        <div class="alert alert-danger text-center p-4">
                                            <h4>Pendaftaran Ditolak</h4>
                                            <p class="mb-0">Mohon maaf, periode rekrutmen sudah kedaluwarsa atau ditutup otomatis oleh sistem.</p>
                                        </div>
                                    </t>
                                    
                                    <t t-else="">
                                        <t t-if="error_msg">
                                            <div class="alert alert-danger">
                                                <t t-esc="error_msg"/>
                                            </div>
                                        </t>

                                        <t t-if="success">
                                            <div class="alert alert-success">
                                                <t t-esc="success"/>
                                            </div>
                                        </t>

                                        <t t-if="error">
                                            <div class="alert alert-danger">
                                                <ul class="mb-0">
                                                    <li t-foreach="error.items()" t-as="err">
                                                        <t t-esc="err[1]"/>
                                                    </li>
                                                </ul>
                                            </div>
                                        </t>

                                        <div class="card">
                                            <div class="card-body">
                                                <form action="/pendaftaran-asisten/submit" method="post" enctype="multipart/form-data">
                                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                                    <div class="mb-3">
                                                        <label class="col-form-label fw-bold" for="student_name">Nama Lengkap</label>
                                                        <input type="text" class="form-control" id="student_name" name="student_name" required="1" t-att-value="data.get('student_name', '')"/>
                                                    </div>

                                                    <div class="mb-3">
                                                        <label class="col-form-label fw-bold" for="npm">NPM / NIM</label>
                                                        <input type="text" class="form-control" id="npm" name="npm" required="1" t-att-value="data.get('npm', '')"/>
                                                    </div>

                                                    <div class="mb-3">
                                                        <label class="col-form-label fw-bold" for="phone_number">Nomor HP / WhatsApp</label>
                                                        <input type="tel" class="form-control" id="phone_number" name="phone_number" required="1" placeholder="Contoh: 0812XXXXXXXX" t-att-value="data.get('phone_number', '')"/>
                                                    </div>

                                                    <div class="mb-3">
                                                        <label class="col-form-label fw-bold" for="course_ids">Mata Kuliah Pilihan</label>
                                                        <select name="course_ids" multiple="multiple" class="form-control" required="required" style="height: 120px;">
                                                            <option value="">-- Pilih Mata Kuliah Target --</option>
                                                            <t t-foreach="master_courses" t-as="course">
                                                                <option t-att-value="course.id">
                                                                    [<t t-esc="course.kode_matkul"/>] <t t-esc="course.nama_matkul"/>
                                                                </option>
                                                            </t>
                                                        </select>
                                                    </div>

                                                    <div class="mb-3">
                                                        <label class="col-form-label fw-bold" for="berkas_khs">Upload KHS (maks. 2MB)</label>
                                                        <input type="file" class="form-control" id="berkas_khs" name="berkas_khs" accept=".pdf,.jpg,.png"/>
                                                        <t t-if="error and error.get('berkas_khs')">
                                                            <div class="text-danger small mt-1">
                                                                <t t-esc="error['berkas_khs']"/>
                                                            </div>
                                                        </t>
                                                    </div>

                                                    <hr/>

                                                    <div class="d-flex gap-2 justify-content-end">
                                                        <!-- Menambahkan class fw-bold agar tulisan Submit Form menjadi tebal -->
                                                        <button type="submit" name="action" value="submit" class="btn btn-primary fw-bold">
                                                            Submit Form
                                                        </button>
                                                    </div>

                                                </form>
                                            </div>
                                        </div>
                                    </t>
                                </t>

                                <t t-if="pendaftaran">
                                    <div class="card shadow-sm border-0 mt-3">
                                        <div class="card-header bg-primary text-white text-center py-3">
                                            <h3 class="mb-0">Pengumuman Hasil Seleksi</h3>
                                        </div>
                                        <div class="card-body p-5 text-center">
                                            <h5 class="mb-4">Nomor Registrasi: <strong class="text-primary"><t t-esc="pendaftaran.id_registrasi"/></strong></h5>
                                            
                                            <t t-if="pendaftaran.state == 'lolos'">
                                                <div class="alert alert-success text-center">
                                                    <h5>🎉 Selamat! Anda Dinyatakan Lolos Seleksi</h5>
                                                    <p>Silakan pilih jadwal praktikum Anda dan unduh dokumen SKEP Rektor untuk langkah selanjutnya.</p>
                                                    
                                                    <div class="d-flex justify-content-center mt-3" style="gap: 15px;">
                                                        
                                                        <a href="/my/alokasi-jadwal" class="btn btn-warning mt-2">
                                                            <i class="fa fa-calendar-plus-o"></i> Pilih Jadwal Praktikum
                                                        </a>

                                                        <t t-if="skep_file">
                                                            <a href="/my/hasil-seleksi/download" class="btn btn-success mt-2">
                                                                <i class="fa fa-download"></i> Unduh SKEP Rektor
                                                            </a>
                                                        </t>
                                                        <t t-else="">
                                                            <button class="btn btn-secondary mt-2" disabled="disabled">
                                                                <i class="fa fa-clock-o"></i> Dokumen SKEP sedang dalam proses pengesahan
                                                            </button>
                                                        </t>

                                                    </div>
                                                </div>
                                            </t>

                                            <t t-elif="pendaftaran.state == 'tidak_lolos'">
                                                <div class="alert alert-danger text-center">
                                                    <h5>Mohon Maaf, Anda Belum Lolos</h5>
                                                    <p>Tetap semangat dan jangan berkecil hati. Cobalah lagi di periode berikutnya!</p>
                                                </div>
                                            </t>

                                            <t t-else="">
                                                <div class="alert alert-info py-4 text-center" role="alert">
                                                    <h4 class="alert-heading">Sedang Dalam Proses Seleksi</h4>
                                                    <p class="mb-0">Berkas Anda sedang ditinjau oleh Laboran. Silakan cek halaman ini secara berkala untuk mengetahui hasil akhirnya.</p>
                                                </div>
                                            </t>

                                        </div>
                                    </div>
                                </t>

                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>
    </data>
</odoo>
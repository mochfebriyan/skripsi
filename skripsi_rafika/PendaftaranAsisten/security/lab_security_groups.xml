<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Module Category -->
        <record id="module_category_lab_management" model="ir.module.category">
            <field name="name">Laboratorium</field>
            <field name="description">Kategori akses untuk modul laboratorium dan pendaftaran asisten.</field>
            <field name="sequence">10</field>
        </record>

        <!-- Groups -->
        <record id="group_lab_mahasiswa" model="res.groups">
            <field name="name">Mahasiswa / Calon Asisten</field>
            <field name="category_id" ref="module_category_lab_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_teaching_assistant" model="res.groups">
            <field name="name">Teaching Assistant</field>
            <field name="category_id" ref="module_category_lab_management"/>
            <field name="implied_ids" eval="[(4, ref('group_lab_mahasiswa'))]"/>
        </record>

        <record id="group_lab_admin" model="res.groups">
            <field name="name">Laboran (Admin)</field>
            <field name="category_id" ref="module_category_lab_management"/>
            <field name="implied_ids" eval="[(4, ref('group_teaching_assistant'))]"/>
        </record>

        <record id="group_lab_pimpinan" model="res.groups">
            <field name="name">Kepala Lab / Pimpinan</field>
            <field name="category_id" ref="module_category_lab_management"/>
            <field name="implied_ids" eval="[(4, ref('group_lab_admin'))]"/>
        </record>
    </data>
</odoo>

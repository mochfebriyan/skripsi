<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Security Groups untuk Assistant Management -->
        
        <record id="group_op_assistant_manager" model="res.groups">
            <field name="name">Assistant Manager</field>
            <field name="category_id" ref="openeducat_core.module_category_openeducat"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
            <field name="implied_ids" eval="[(4, ref('openeducat_core.group_op_back_office'))]"/>
        </record>

        <record id="group_op_assistant_user" model="res.groups">
            <field name="name">Assistant User</field>
            <field name="category_id" ref="openeducat_core.module_category_openeducat"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Record Rules untuk Student Assistant -->
        
        <record model="ir.rule" id="assistant_student_rule">
            <field name="name">Student Access Own Assistant Records</field>
            <field name="model_id" ref="model_op_student_assistant"/>
            <field name="groups" eval="[(4, ref('openeducat_core.group_op_back_office_admin'))]"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record model="ir.rule" id="registration_student_rule">
            <field name="name">Student Access Registration Records</field>
            <field name="model_id" ref="model_op_assistant_registration"/>
            <field name="groups" eval="[(4, ref('openeducat_core.group_op_back_office_admin'))]"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Menu Rule untuk Faculty -->
        
        <record model="ir.rule" id="assistant_faculty_rule">
            <field name="name">Faculty View Students Assistants</field>
            <field name="model_id" ref="model_op_student_assistant"/>
            <field name="groups" eval="[(4, ref('openeducat_core.group_op_faculty'))]"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>

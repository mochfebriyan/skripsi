<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_category_pendaftaran_asprak" model="ir.module.category">
            <field name="name">Pendaftaran Asisten Laboratorium</field>
            <field name="description">Kategori akses untuk modul pendaftaran asisten laboratorium.</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_asprak_mahasiswa" model="res.groups">
            <field name="name">Mahasiswa / Calon Asprak</field>
            <field name="category_id" ref="module_category_pendaftaran_asprak"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_asprak_laboran" model="res.groups">
            <field name="name">Laboran (Admin Lab)</field>
            <field name="category_id" ref="module_category_pendaftaran_asprak"/>
            <field name="implied_ids" eval="[(4, ref('group_asprak_mahasiswa'))]"/>
        </record>

        <record id="group_asprak_kepala_lab" model="res.groups">
            <field name="name">Kepala Laboratorium</field>
            <field name="category_id" ref="module_category_pendaftaran_asprak"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_asisten_praktikum" model="res.groups">
            <field name="name">Teaching Assistant</field>
            <field name="category_id" ref="module_category_pendaftaran_asprak"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="module_category_manajemen_asisten_lab" model="ir.module.category">
            <field name="name">Manajemen Asisten Laboratorium</field>
            <field name="description">Kategori akses untuk fitur Timetable Keseluruhan dan manajemen jadwal laboratorium.</field>
            <field name="sequence">11</field>
        </record>

        <record id="group_timetable_laboran" model="res.groups">
            <field name="name">Laboran</field>
            <field name="category_id" ref="module_category_manajemen_asisten_lab"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_timetable_kepala_lab" model="res.groups">
            <field name="name">Kepala Laboratorium</field>
            <field name="category_id" ref="module_category_manajemen_asisten_lab"/>
            <field name="implied_ids" eval="[(4, ref('group_timetable_laboran'))]"/>
        </record>

        <record id="group_pimpinan" model="res.groups">
            <field name="name">Pimpinan / Jurusan</field>
            <field name="category_id" ref="module_category_manajemen_asisten_lab"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

    </data>
</odoo>
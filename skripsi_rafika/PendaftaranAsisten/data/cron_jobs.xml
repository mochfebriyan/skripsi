<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_update_status_asisten" model="ir.cron">
            <field name="name">Update Status Asisten Aktif (Harian)</field>
            <field name="model_id" ref="model_mst_periodesemt"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_status_asisten()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).replace(hour=0, minute=0, second=0, microsecond=0)"/>
        </record>

    </data>
</odoo>

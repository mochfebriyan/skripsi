<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- V3 Form Rencana -->
    <record id="plan_view_form" model="ir.ui.view">
        <field name="name">labfik.plan.form</field>
        <field name="model">labfik.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_ajukan" string="Ajukan" type="object" class="btn-primary" invisible="state != 'draf'"/>
                    <button name="action_terbitkan" string="Terbitkan" type="object" invisible="state not in ('draf', 'diajukan')"/>
                    <button name="action_unggah_ttd" string="Unggah TTD" type="object" invisible="state != 'diajukan'"/>
                    <button name="action_sahkan" string="Sahkan" type="object" class="btn-primary" invisible="state != 'diajukan'"/>
                    <button name="action_kembalikan" string="Kembalikan" type="object" invisible="state != 'diajukan'"/>
                    <button name="action_buat_revisi" string="Buat Revisi" type="object" invisible="state != 'disahkan'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draf,diajukan,disahkan"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_tinjauan" type="object" class="oe_stat_button" icon="fa-check-square-o">
                            <field name="jml_tinjauan" widget="statinfo" string="Tinjauan"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="judul" placeholder="Judul rencana"/></h1></div>
                    <group>
                        <group><field name="jenis"/><field name="periode_id"/></group>
                        <group><field name="penyusun_id"/><field name="kriteria_tertinggi" string="Kriteria terpenuhi (K)"/></group>
                    </group>
                    <notebook>
                        <page string="Item Rencana">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="kegiatan"/>
                                    <field name="kpi_id"/>
                                    <field name="target"/>
                                    <field name="satuan"/>
                                    <field name="pic_id" widget="many2one_avatar_employee"/>
                                    <field name="jadwal_mulai"/>
                                    <field name="jadwal_selesai"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="anggaran" sum="Total"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Temuan Gap" invisible="jenis != 'pengembangan'">
                            <field name="gap_ids">
                                <tree editable="bottom">
                                    <field name="aspek"/><field name="kondisi_saat_ini"/><field name="kebutuhan"/><field name="uraian_gap"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Narasi"><field name="narasi"/></page>
                        <page string="Riwayat Pengesahan">
                            <field name="log_ids">
                                <tree><field name="waktu"/><field name="kejadian"/><field name="pelaku_id"/><field name="alasan"/></tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter"><field name="message_ids"/></div>
            </form>
        </field>
    </record>
    <record id="plan_view_tree" model="ir.ui.view">
        <field name="name">labfik.plan.tree</field>
        <field name="model">labfik.plan</field>
        <field name="arch" type="xml">
            <tree>
                <field name="judul"/><field name="jenis"/><field name="periode_id"/><field name="penyusun_id"/>
                <field name="state" widget="badge" decoration-info="state == 'diajukan'" decoration-success="state == 'disahkan'"/>
            </tree>
        </field>
    </record>
    <record id="plan_view_kanban" model="ir.ui.view">
        <field name="name">labfik.plan.kanban</field>
        <field name="model">labfik.plan</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" records_draggable="0" quick_create="0" group_create="0">
                <field name="judul"/><field name="jenis"/><field name="periode_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <strong><field name="judul"/></strong>
                            <div class="text-muted"><field name="jenis"/> · <field name="periode_id"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="action_plan" model="ir.actions.act_window">
        <field name="name">Rencana</field>
        <field name="res_model">labfik.plan</field>
        <field name="view_mode">tree,kanban,form</field>
    </record>

    <!-- V4 Kalender Item Rencana -->
    <record id="plan_line_view_calendar" model="ir.ui.view">
        <field name="name">labfik.plan.line.calendar</field>
        <field name="model">labfik.plan.line</field>
        <field name="arch" type="xml">
            <calendar date_start="jadwal_mulai" date_stop="jadwal_selesai" color="pic_id" mode="month"
                      quick_create="0" event_open_popup="1">
                <field name="plan_id"/>
                <field name="target"/>
                <field name="satuan"/>
                <field name="pic_id" filters="1"/>
            </calendar>
        </field>
    </record>
    <record id="plan_line_view_pivot" model="ir.ui.view">
        <field name="name">labfik.plan.line.pivot</field>
        <field name="model">labfik.plan.line</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="pic_id" type="row"/>
                <field name="plan_id" type="col"/>
                <field name="anggaran" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="plan_line_view_tree" model="ir.ui.view">
        <field name="name">labfik.plan.line.tree</field>
        <field name="model">labfik.plan.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="kegiatan"/><field name="plan_id"/><field name="pic_id"/>
                <field name="jadwal_mulai"/><field name="jadwal_selesai"/><field name="target"/><field name="satuan"/>
            </tree>
        </field>
    </record>
    <record id="plan_line_view_form" model="ir.ui.view">
        <field name="name">labfik.plan.line.form</field>
        <field name="model">labfik.plan.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="kegiatan"/></h1></div>
                    <group>
                        <group><field name="plan_id"/><field name="kpi_id"/><field name="target"/><field name="satuan"/></group>
                        <group><field name="pic_id"/><field name="jadwal_mulai"/><field name="jadwal_selesai"/>
                            <field name="currency_id" invisible="1"/><field name="anggaran"/></group>
                    </group>
                    <notebook>
                        <page string="Realisasi">
                            <field name="realisasi_ids">
                                <tree editable="bottom"><field name="periode_lapor"/><field name="capaian"/><field name="status_capaian"/></tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="plan_line_view_search" model="ir.ui.view">
        <field name="name">labfik.plan.line.search</field>
        <field name="model">labfik.plan.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="kegiatan"/><field name="pic_id"/>
                <filter name="item_saya" string="Item saya" domain="[('pic_id.user_id', '=', uid)]"/>
                <filter name="disahkan" string="Rencana disahkan" domain="[('plan_state', '=', 'disahkan')]"/>
                <group expand="0" string="Kelompokkan">
                    <filter name="g_plan" string="Rencana" context="{'group_by': 'plan_id'}"/>
                    <filter name="g_pic" string="PIC" context="{'group_by': 'pic_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_plan_line" model="ir.actions.act_window">
        <field name="name">Jadwal Kegiatan</field>
        <field name="res_model">labfik.plan.line</field>
        <field name="view_mode">calendar,tree,pivot,form</field>
        <field name="context">{'initial_date': '2027-02-01 00:00:00'}</field>
    </record>

    <!-- V5 Pivot Realisasi -->
    <record id="realisasi_view_pivot" model="ir.ui.view">
        <field name="name">labfik.realisasi.pivot</field>
        <field name="model">labfik.realisasi</field>
        <field name="arch" type="xml">
            <pivot display_quantity="0">
                <field name="line_id" type="row"/>
                <field name="periode_lapor" type="col"/>
                <field name="target" type="measure"/>
                <field name="capaian" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="realisasi_view_graph" model="ir.ui.view">
        <field name="name">labfik.realisasi.graph</field>
        <field name="model">labfik.realisasi</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="line_id"/>
                <field name="capaian" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="realisasi_view_tree" model="ir.ui.view">
        <field name="name">labfik.realisasi.tree</field>
        <field name="model">labfik.realisasi</field>
        <field name="arch" type="xml">
            <tree>
                <field name="line_id"/><field name="periode_lapor"/><field name="target"/><field name="capaian"/>
                <field name="status_capaian" widget="badge" decoration-success="status_capaian == 'tercapai'" decoration-warning="status_capaian == 'sebagian'"/>
                <field name="pelapor_id"/>
            </tree>
        </field>
    </record>
    <record id="realisasi_view_form" model="ir.ui.view">
        <field name="name">labfik.realisasi.form</field>
        <field name="model">labfik.realisasi</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group><field name="line_id"/><field name="periode_lapor"/><field name="tanggal"/><field name="pelapor_id"/></group>
                        <group><field name="target"/><field name="capaian"/><field name="currency_id" invisible="1"/>
                            <field name="biaya_terpakai"/><field name="status_capaian"/></group>
                    </group>
                    <group><field name="tindak_lanjut"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_realisasi" model="ir.actions.act_window">
        <field name="name">Realisasi</field>
        <field name="res_model">labfik.realisasi</field>
        <field name="view_mode">pivot,graph,tree,form</field>
    </record>
</odoo>

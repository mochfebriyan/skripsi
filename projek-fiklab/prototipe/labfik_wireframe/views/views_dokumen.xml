<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Contoh list: Dokumen Induk -->
    <record id="document_view_tree" model="ir.ui.view">
        <field name="name">labfik.document.tree</field>
        <field name="model">labfik.document</field>
        <field name="arch" type="xml">
            <tree decoration-warning="perlu_ditinjau">
                <field name="kode"/>
                <field name="judul"/>
                <field name="jenis"/>
                <field name="kategori"/>
                <field name="asal"/>
                <field name="is_wajib" widget="boolean_toggle" readonly="1"/>
                <field name="versi_berlaku_id"/>
                <field name="perlu_ditinjau"/>
            </tree>
        </field>
    </record>
    <record id="document_view_form" model="ir.ui.view">
        <field name="name">labfik.document.form</field>
        <field name="model">labfik.document</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="judul" placeholder="Judul dokumen"/></h1></div>
                    <group>
                        <group><field name="kode"/><field name="jenis"/><field name="kategori"/><field name="asal"/></group>
                        <group><field name="is_wajib"/><field name="siklus_tinjau_bulan"/><field name="versi_berlaku_id"/></group>
                    </group>
                    <notebook>
                        <page string="Versi">
                            <field name="versi_ids">
                                <tree><field name="revisi"/><field name="tanggal_efektif"/><field name="state" widget="badge"/></tree>
                            </field>
                        </page>
                        <page string="Dasar Kebutuhan"><field name="dasar_kebutuhan"/></page>
                    </notebook>
                </sheet>
                <div class="oe_chatter"><field name="message_ids"/></div>
            </form>
        </field>
    </record>
    <record id="document_view_search" model="ir.ui.view">
        <field name="name">labfik.document.search</field>
        <field name="model">labfik.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="judul"/><field name="kode"/>
                <filter name="wajib" string="Wajib" domain="[('is_wajib', '=', True)]"/>
                <separator/>
                <filter name="arsip" string="Diarsipkan" domain="[('active', '=', False)]"/>
                <group expand="0" string="Kelompokkan">
                    <filter name="g_jenis" string="Jenis" context="{'group_by': 'jenis'}"/>
                    <filter name="g_kategori" string="Kategori" context="{'group_by': 'kategori'}"/>
                    <filter name="g_asal" string="Asal" context="{'group_by': 'asal'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_document" model="ir.actions.act_window">
        <field name="name">Dokumen Induk</field>
        <field name="res_model">labfik.document</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- V1 Kanban Versi SOP/IK -->
    <record id="document_version_view_kanban" model="ir.ui.view">
        <field name="name">labfik.document.version.kanban</field>
        <field name="model">labfik.document.version</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" records_draggable="0" quick_create="0" group_create="0">
                <field name="state"/>
                <field name="document_id"/>
                <field name="revisi"/>
                <field name="penyusun_id"/>
                <field name="tanggal_ajukan"/>
                <field name="tanggal_sah"/>
                <field name="perlu_ditinjau"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="document_id"/></strong>
                                <div class="text-muted">Revisi <field name="revisi"/></div>
                                <div><i class="fa fa-user me-1" title="Penyusun"/><field name="penyusun_id"/></div>
                                <div t-if="record.tanggal_ajukan.raw_value" class="small">Diajukan: <field name="tanggal_ajukan" widget="date"/></div>
                                <div t-if="record.tanggal_sah.raw_value" class="small">Disahkan: <field name="tanggal_sah"/></div>
                                <span t-if="record.perlu_ditinjau.raw_value" class="badge text-bg-warning mt-1">Perlu ditinjau</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- V2 Form Versi SOP/IK -->
    <record id="document_version_view_form" model="ir.ui.view">
        <field name="name">labfik.document.version.form</field>
        <field name="model">labfik.document.version</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_ajukan" string="Ajukan" type="object" class="btn-primary" invisible="state != 'draf'"/>
                    <button name="action_terbitkan" string="Terbitkan" type="object" invisible="state not in ('draf', 'diajukan')"/>
                    <button name="action_unggah_ttd" string="Unggah TTD" type="object" invisible="state != 'diajukan'"/>
                    <button name="action_sahkan" string="Sahkan" type="object" class="btn-primary" invisible="state != 'diajukan'"/>
                    <button name="action_kembalikan" string="Kembalikan" type="object" invisible="state != 'diajukan'"/>
                    <button name="action_cabut" string="Cabut" type="object" invisible="state != 'disahkan'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draf,diajukan,disahkan"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_rekaman" type="object" class="oe_stat_button" icon="fa-share-square-o">
                            <field name="jml_distribusi" widget="statinfo" string="Distribusi"/>
                        </button>
                        <button name="action_rekaman" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="jml_sosialisasi" widget="statinfo" string="Sosialisasi"/>
                        </button>
                        <button name="action_rekaman" type="object" class="oe_stat_button" icon="fa-refresh">
                            <field name="jml_tinjau" widget="statinfo" string="Tinjau Ulang"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="document_id"/>
                        <h1><field name="document_id" readonly="state != 'draf'" options="{'no_open': True}"/></h1>
                    </div>
                    <group>
                        <group string="Isi">
                            <field name="revisi"/>
                            <field name="tanggal_efektif"/>
                            <field name="berkas_nama" invisible="1"/>
                            <field name="berkas" filename="berkas_nama"/>
                        </group>
                        <group string="Pengesahan">
                            <field name="penyusun_id"/>
                            <field name="tanggal_ajukan"/>
                            <field name="berkas_ttd_nama" invisible="1"/>
                            <field name="berkas_ttd" filename="berkas_ttd_nama"/>
                            <field name="pengesah_id"/>
                            <field name="tanggal_sah"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Perubahan">
                            <group>
                                <field name="bagian_diubah"/>
                                <field name="ringkasan_perubahan"/>
                                <field name="alasan_revisi"/>
                            </group>
                        </page>
                        <page string="Tinjau Ulang">
                            <group><field name="tanggal_tinjau_berikutnya"/><field name="perlu_ditinjau"/></group>
                        </page>
                        <page string="Riwayat Pengesahan">
                            <field name="log_ids">
                                <tree><field name="waktu"/><field name="kejadian"/><field name="pelaku_id"/><field name="alasan"/></tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter"><field name="message_ids"/></div>
            </form>
        </field>
    </record>
    <record id="document_version_view_tree" model="ir.ui.view">
        <field name="name">labfik.document.version.tree</field>
        <field name="model">labfik.document.version</field>
        <field name="arch" type="xml">
            <tree>
                <field name="document_id"/><field name="revisi"/><field name="penyusun_id"/>
                <field name="tanggal_efektif"/><field name="tanggal_tinjau_berikutnya"/>
                <field name="state" widget="badge" decoration-info="state == 'diajukan'" decoration-success="state == 'disahkan'"/>
            </tree>
        </field>
    </record>
    <record id="document_version_view_calendar" model="ir.ui.view">
        <field name="name">labfik.document.version.calendar</field>
        <field name="model">labfik.document.version</field>
        <field name="arch" type="xml">
            <calendar date_start="tanggal_tinjau_berikutnya" mode="month" quick_create="0" color="document_id">
                <field name="document_id"/><field name="revisi"/>
            </calendar>
        </field>
    </record>
    <record id="document_version_view_search" model="ir.ui.view">
        <field name="name">labfik.document.version.search</field>
        <field name="model">labfik.document.version</field>
        <field name="arch" type="xml">
            <search>
                <field name="document_id"/>
                <filter name="menunggu" string="Menunggu pengesahan" domain="[('state', '=', 'diajukan')]"/>
                <filter name="berlaku" string="Berlaku" domain="[('state', '=', 'disahkan')]"/>
                <filter name="tinjau" string="Perlu ditinjau" domain="[('perlu_ditinjau', '=', True)]"/>
                <group expand="0" string="Kelompokkan">
                    <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="g_doc" string="Dokumen Induk" context="{'group_by': 'document_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_version" model="ir.actions.act_window">
        <field name="name">Versi SOP/IK</field>
        <field name="res_model">labfik.document.version</field>
        <field name="view_mode">kanban,tree,form,calendar</field>
    </record>
</odoo>

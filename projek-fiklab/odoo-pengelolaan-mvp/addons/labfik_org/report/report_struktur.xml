<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_bagan_node">
        <li style="margin: 4px 0;">
            <b t-out="j.name"/>:
            <t t-set="nama" t-value="data['pemangku'].get(j.id, [])"/>
            <span t-if="nama" t-out="', '.join(nama)"/>
            <i t-else="" style="color: #b54708;">belum ada pemangku</i>
            <span t-if="j.pengganti_id" style="color: #666;"> · pengganti: <t t-out="j.pengganti_id.name"/></span>
            <ul t-if="j.bawahan_ids">
                <t t-foreach="j.bawahan_ids" t-as="anak">
                    <t t-call="labfik_org.report_bagan_node">
                        <t t-set="j" t-value="anak"/>
                    </t>
                </t>
            </ul>
        </li>
    </template>

    <template id="report_bagan_organisasi">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="o">
                <div class="page" style="font-size: 13px; page-break-after: always;">
                    <t t-call="labfik_org.report_kop"/>
                    <h3 style="text-align: center; margin: 0;">BAGAN ORGANISASI LABORATORIUM</h3>
                    <p style="text-align: center;">Berdasarkan SK <span t-out="o.name"/> tanggal <span t-out="o.tgl_id(o.tanggal)"/>
                        · status: <span t-field="o.state"/></p>
                    <t t-set="data" t-value="o.get_data_struktur()"/>
                    <ul>
                        <t t-foreach="data['akar']" t-as="akar">
                            <t t-call="labfik_org.report_bagan_node">
                                <t t-set="j" t-value="akar"/>
                            </t>
                        </t>
                    </ul>
                    <p style="color: #666;">Garis menurun menunjukkan alur pelaporan (bawahan melapor ke atasan).</p>
                </div>
            </t>
        </t>
    </template>

    <template id="report_matriks_kewenangan">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="o">
                <div class="page" style="font-size: 11px; page-break-after: always;">
                    <t t-call="labfik_org.report_kop"/>
                    <h3 style="text-align: center; margin: 0;">MATRIKS KEWENANGAN</h3>
                    <p style="text-align: center;">Berdasarkan SK <span t-out="o.name"/> · status: <span t-field="o.state"/></p>
                    <t t-set="data" t-value="o.get_data_struktur()"/>
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Jabatan</th><th>Pemangku</th><th>Atasan</th><th>Pengganti</th>
                                <th t-foreach="data['kewenangan']" t-as="k" style="text-align: center;" t-out="k.name"/>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="data['jabatan']" t-as="j">
                                <td><b t-out="j.name"/></td>
                                <td t-out="', '.join(data['pemangku'].get(j.id, [])) or '-'"/>
                                <td t-out="j.atasan_id.name or '-'"/>
                                <td t-out="j.pengganti_id.name or '-'"/>
                                <td t-foreach="data['kewenangan']" t-as="k" style="text-align: center;">
                                    <t t-if="k in j.kewenangan_ids">✓</t>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <h5>Uraian tugas</h5>
                    <div t-foreach="data['jabatan']" t-as="j" style="margin-bottom: 6px;">
                        <b t-out="j.name"/>
                        <div t-if="j.uraian_tugas" t-out="j.uraian_tugas"/>
                        <i t-else="" style="color: #b54708;">belum diisi</i>
                        <div t-if="j.kewenangan_uraian" t-out="j.kewenangan_uraian"/>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_kop">
        <div style="border-bottom: 2px solid #222; margin-bottom: 14px; padding-bottom: 6px;">
            <div style="font-size: 16px; font-weight: bold;" t-out="o.get_nama_lab()"/>
            <div style="font-size: 12px; color: #555;">Dokumen dihasilkan dari LabFIK Organization Management</div>
        </div>
    </template>

    <template id="report_rencana_kerja">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="o">
                <div class="page" style="font-size: 12px; page-break-after: always;">
                    <t t-call="labfik_org.report_kop"/>
                    <div t-if="o.state in ('draf', 'diajukan')"
                         style="border: 1px dashed #b54708; color: #b54708; padding: 4px 8px; margin-bottom: 10px;">
                        BELUM DISAHKAN · status: <span t-field="o.state"/>
                    </div>
                    <h3 style="text-align: center; margin: 0;">
                        <t t-if="o.jenis == 'tahunan'">RENCANA KERJA TAHUNAN</t>
                        <t t-else="">ROADMAP / RENCANA STRATEGIS</t>
                    </h3>
                    <h4 style="text-align: center; margin-top: 4px;" t-out="o.name"/>
                    <table class="table table-sm table-borderless" style="width: auto; margin-bottom: 8px;">
                        <tr><td>Periode</td><td>: <span t-out="o.periode_id.name"/>
                            (<span t-out="o.tgl_id(o.periode_id.tanggal_mulai)"/> – <span t-out="o.tgl_id(o.periode_id.tanggal_selesai)"/>)</td></tr>
                        <tr><td>Pemilik rencana</td><td>: <span t-out="o.pemilik_id.name or '-'"/></td></tr>
                        <tr><td>Total anggaran</td><td>: Rp <span t-out="'{:,.0f}'.format(o.total_anggaran).replace(',', '.')"/></td></tr>
                    </table>

                    <t t-if="o.narasi">
                        <h5>A. Latar belakang dan arah</h5>
                        <div t-out="o.narasi"/>
                    </t>

                    <h5>B. Sasaran, KPI, target, penanggung jawab, jadwal, dan anggaran</h5>
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>No</th><th>Sasaran / kegiatan</th><th>KPI</th><th>Target</th>
                                <th>PIC</th><th>Jadwal</th><th style="text-align: right;">Anggaran (Rp)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="o.item_ids" t-as="item">
                                <td t-out="item_index + 1"/>
                                <td t-out="item.sasaran"/>
                                <td><span t-out="item.kpi_id.display_name"/>
                                    <div t-if="item.kpi_id.definisi" style="color: #666;" t-out="item.kpi_id.definisi"/></td>
                                <td t-out="item.target"/>
                                <td t-out="item.pic_id.name"/>
                                <td><span t-out="o.tgl_id(item.tanggal_mulai)"/> – <span t-out="o.tgl_id(item.tanggal_selesai)"/></td>
                                <td style="text-align: right;">
                                    <t t-if="item.tanpa_anggaran">tanpa biaya</t>
                                    <t t-else="" t-out="'{:,.0f}'.format(item.anggaran).replace(',', '.')"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <h5>C. Matriks keterkaitan Renstra</h5>
                    <table class="table table-sm table-bordered">
                        <thead><tr><th>Sasaran Renstra</th><th>Item rencana terkait</th></tr></thead>
                        <tbody>
                            <tr t-foreach="o.get_renstra_matriks()" t-as="baris">
                                <td>
                                    <span t-out="baris['sasaran']"/>
                                    <span t-if="baris['tingkat']" style="color: #666;"> (<t t-out="baris['tingkat']"/>)</span>
                                </td>
                                <td t-out="baris['item']"/>
                            </tr>
                        </tbody>
                    </table>

                    <table style="width: 100%; margin-top: 30px;">
                        <tr>
                            <td style="width: 50%; text-align: center;">
                                Disusun oleh,<br/>Pemilik rencana<br/><br/><br/><br/>
                                <b t-out="o.pemilik_id.name or '................................'"/>
                            </td>
                            <td style="width: 50%; text-align: center;">
                                <t t-if="o.tanggal_sah">Disahkan <span t-out="o.tgl_id(o.tanggal_sah)"/>,</t>
                                <t t-else="">Disahkan oleh,</t><br/>Pejabat berwenang<br/><br/><br/><br/>
                                <b t-out="o.pengesah_id.name or '................................'"/>
                            </td>
                        </tr>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <template id="report_laporan_pelaksanaan">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="o">
                <div class="page" style="font-size: 12px; page-break-after: always;">
                    <t t-call="labfik_org.report_kop"/>
                    <h3 style="text-align: center; margin: 0;">LAPORAN PELAKSANAAN RENCANA KERJA</h3>
                    <h4 style="text-align: center; margin-top: 4px;" t-out="o.name"/>
                    <p>Periode <span t-out="o.periode_id.name"/> · status rencana: <span t-field="o.state"/></p>
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>No</th><th>Sasaran</th><th>KPI</th><th>Target</th><th>Realisasi per semester</th>
                                <th style="text-align: right;">Anggaran (Rp)</th><th style="text-align: right;">Terpakai (Rp)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="o.item_ids" t-as="item">
                                <td t-out="item_index + 1"/>
                                <td t-out="item.sasaran"/>
                                <td t-out="item.kpi_id.display_name"/>
                                <td t-out="item.target"/>
                                <td>
                                    <t t-if="not item.realisasi_ids"><i>belum ada realisasi</i></t>
                                    <div t-foreach="item.realisasi_ids.sorted('tanggal')" t-as="r">
                                        <b t-out="r.semester_id.display_name"/>: <span t-out="r.capaian"/>
                                        <t t-if="not r.berbukti"> <i>(tanpa bukti)</i></t>
                                    </div>
                                </td>
                                <td style="text-align: right;"
                                    t-out="'{:,.0f}'.format(item.anggaran).replace(',', '.')"/>
                                <td style="text-align: right;"
                                    t-out="'{:,.0f}'.format(sum(item.realisasi_ids.mapped('anggaran_terpakai'))).replace(',', '.')"/>
                            </tr>
                        </tbody>
                    </table>
                    <p style="color: #666;">Dicetak <span t-out="o.get_tgl_cetak()"/>.</p>
                </div>
            </t>
        </t>
    </template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Versi dokumen: pengguna lab hanya melihat versi yang berlaku -->
    <record id="rule_versi_pengguna_berlaku" model="ir.rule">
        <field name="name">Versi dokumen: pengguna hanya SOP/IK/formulir yang berlaku</field>
        <field name="model_id" ref="model_labfik_dokumen_versi"/>
        <field name="groups" eval="[(4, ref('group_labfik_pengguna'))]"/>
        <field name="domain_force">[('state', '=', 'berlaku'), ('jenis', 'in', ('sop', 'ik', 'formulir'))]</field>
    </record>
    <record id="rule_versi_laboran_semua" model="ir.rule">
        <field name="name">Versi dokumen: laboran semua versi</field>
        <field name="model_id" ref="model_labfik_dokumen_versi"/>
        <field name="groups" eval="[(4, ref('group_labfik_laboran'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_versi_penilai_semua" model="ir.rule">
        <field name="name">Versi dokumen: penilai membaca semua versi</field>
        <field name="model_id" ref="model_labfik_dokumen_versi"/>
        <field name="groups" eval="[(4, ref('group_labfik_penilai'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Rapat: pengguna lab hanya melihat rapat yang ia ikuti -->
    <record id="rule_rapat_pengguna_peserta" model="ir.rule">
        <field name="name">Rapat: pengguna hanya rapat yang diikuti</field>
        <field name="model_id" ref="model_labfik_rapat"/>
        <field name="groups" eval="[(4, ref('group_labfik_pengguna'))]"/>
        <field name="domain_force">[('peserta_ids.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_rapat_laboran_semua" model="ir.rule">
        <field name="name">Rapat: laboran semua rapat</field>
        <field name="model_id" ref="model_labfik_rapat"/>
        <field name="groups" eval="[(4, ref('group_labfik_laboran'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_rapat_penilai_semua" model="ir.rule">
        <field name="name">Rapat: penilai membaca semua rapat</field>
        <field name="model_id" ref="model_labfik_rapat"/>
        <field name="groups" eval="[(4, ref('group_labfik_penilai'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Realisasi: laboran membaca semua, tetapi hanya mengubah item yang ia PIC-i -->
    <record id="rule_realisasi_laboran_baca" model="ir.rule">
        <field name="name">Realisasi: laboran membaca semua</field>
        <field name="model_id" ref="model_labfik_rencana_realisasi"/>
        <field name="groups" eval="[(4, ref('group_labfik_laboran'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_realisasi_laboran_milik_sendiri" model="ir.rule">
        <field name="name">Realisasi: laboran mengubah item yang ia PIC-i</field>
        <field name="model_id" ref="model_labfik_rencana_realisasi"/>
        <field name="groups" eval="[(4, ref('group_labfik_laboran'))]"/>
        <field name="domain_force">[('item_id.pic_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="rule_realisasi_kalab_semua" model="ir.rule">
        <field name="name">Realisasi: kepala lab semua</field>
        <field name="model_id" ref="model_labfik_rencana_realisasi"/>
        <field name="groups" eval="[(4, ref('group_labfik_kalab'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_realisasi_penilai_baca" model="ir.rule">
        <field name="name">Realisasi: penilai membaca semua</field>
        <field name="model_id" ref="model_labfik_rencana_realisasi"/>
        <field name="groups" eval="[(4, ref('group_labfik_penilai'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rapat_tree" model="ir.ui.view">
        <field name="name">labfik.rapat.tree</field>
        <field name="model">labfik.rapat</field>
        <field name="arch" type="xml">
            <tree>
                <field name="tanggal"/>
                <field name="name"/>
                <field name="periode_id"/>
                <field name="semester_id"/>
                <field name="peserta_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <record id="view_rapat_form" model="ir.ui.view">
        <field name="name">labfik.rapat.form</field>
        <field name="model">labfik.rapat</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="periode_id"/>
                            <field name="tanggal"/>
                            <field name="semester_id"/>
                        </group>
                        <group>
                            <field name="notulen" filename="notulen_name"/>
                            <field name="notulen_name" invisible="1"/>
                        </group>
                    </group>
                    <group string="Peserta">
                        <field name="peserta_ids" widget="many2many_tags" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Keputusan">
                        <field name="keputusan" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_rapat" model="ir.actions.act_window">
        <field name="name">Rapat koordinasi</field>
        <field name="res_model">labfik.rapat</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Catat rapat koordinasi</p>
            <p>Rapat koordinasi adalah bukti struktur dijalankan (Pengelolaan 3 K3).</p>
        </field>
    </record>

    <record id="view_evaluasi_tree" model="ir.ui.view">
        <field name="name">labfik.evaluasi.struktur.tree</field>
        <field name="model">labfik.evaluasi.struktur</field>
        <field name="arch" type="xml">
            <tree>
                <field name="tanggal"/>
                <field name="name"/>
                <field name="periode_id"/>
                <field name="sk_revisi_id"/>
            </tree>
        </field>
    </record>

    <record id="view_evaluasi_form" model="ir.ui.view">
        <field name="name">labfik.evaluasi.struktur.form</field>
        <field name="model">labfik.evaluasi.struktur</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="periode_id"/>
                            <field name="tanggal"/>
                        </group>
                        <group>
                            <field name="sk_revisi_id"/>
                            <field name="jabatan_revisi_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group string="Peserta">
                        <field name="peserta_ids" widget="many2many_tags" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Temuan beban kerja dan koordinasi">
                        <field name="temuan" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Keputusan perbaikan">
                        <field name="keputusan" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_evaluasi" model="ir.actions.act_window">
        <field name="name">Evaluasi struktur</field>
        <field name="res_model">labfik.evaluasi.struktur</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Catat evaluasi struktur dan beban kerja</p>
            <p>Bukti Pengelolaan 3 K4: beban kerja dan efektivitas koordinasi dievaluasi, lalu struktur diperbaiki bila perlu.</p>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_labfik_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.labfik</field>
        <field name="model">res.config.settings</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Pengaturan LabFIK">
                <header>
                    <button string="Simpan" type="object" name="execute" class="oe_highlight"/>
                    <button string="Batal" special="cancel"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1>Pengaturan LabFIK</h1></div>
                    <p class="text-muted">Nilai awal adalah usulan penulis (PRD §8.3) dan dapat disesuaikan dengan ketetapan KaLab.</p>
                    <group>
                        <group string="Umum">
                            <field name="labfik_nama_lab"/>
                        </group>
                        <group string="SOP (Pengelolaan 2)">
                            <field name="labfik_siklus_tinjau_bulan"/>
                            <field name="labfik_pengingat_hari"/>
                        </group>
                        <group string="Ambang kriteria (Pengelolaan 1 dan 3)">
                            <field name="labfik_p1_k3_min_realisasi"/>
                            <field name="labfik_p3_k3_min_rapat"/>
                            <field name="labfik_k4_min_per_tahun"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_labfik_settings" model="ir.actions.act_window">
        <field name="name">Pengaturan LabFIK</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_labfik_settings_form"/>
        <field name="target">inline</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_checklist_form" model="ir.ui.view">
        <field name="name">labfik.checklist.mulai.form</field>
        <field name="model">labfik.checklist.mulai</field>
        <field name="arch" type="xml">
            <form string="Mulai di sini" create="0" edit="0">
                <sheet>
                    <div class="oe_title">
                        <h1>Mulai di sini</h1>
                        <p class="text-muted">Ikuti urutan ini untuk menyiapkan bukti Pengelolaan 1, 2, dan 3 dari nol.
                            Progres: <field name="progres" class="oe_inline"/>%</p>
                    </div>
                    <field name="periode_id" invisible="1"/>
                    <group>
                        <group string="Struktur (Pengelolaan 3)">
                            <field name="langkah_periode" widget="boolean" readonly="1"/>
                            <div colspan="2" class="text-muted"><field name="ket_periode" class="oe_inline"/>
                                · <button name="action_periode" type="object" string="Buka periode" class="btn-link p-0"/></div>
                            <field name="langkah_jabatan" widget="boolean" readonly="1"/>
                            <div colspan="2" class="text-muted"><field name="ket_jabatan" class="oe_inline"/>
                                · <button name="action_jabatan" type="object" string="Buka jabatan" class="btn-link p-0"/></div>
                            <field name="langkah_personel" widget="boolean" readonly="1"/>
                            <div colspan="2" class="text-muted"><field name="ket_personel" class="oe_inline"/>
                                · <button name="action_personel" type="object" string="Buka personel" class="btn-link p-0"/></div>
                            <field name="langkah_sk" widget="boolean" readonly="1"/>
                            <div colspan="2" class="text-muted"><field name="ket_sk" class="oe_inline"/>
                                · <button name="action_sk" type="object" string="Buka SK" class="btn-link p-0"/></div>
                        </group>
                        <group string="SOP dan rencana (Pengelolaan 2, 1)">
                            <field name="langkah_wajib" widget="boolean" readonly="1"/>
                            <div colspan="2" class="text-muted"><field name="ket_wajib" class="oe_inline"/>
                                · <button name="action_wajib" type="object" string="Atur di periode" class="btn-link p-0"/></div>
                            <field name="langkah_rencana" widget="boolean" readonly="1"/>
                            <div colspan="2" class="text-muted"><field name="ket_rencana" class="oe_inline"/>
                                · <button name="action_rencana" type="object" string="Buka rencana kerja" class="btn-link p-0"/></div>
                            <div colspan="2" class="mt-3">
                                Kerangka SOP baku:
                                <a href="/labfik_org/static/src/kerangka_sop.docx" target="_blank">unduh kerangka_sop.docx</a>
                            </div>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_server_checklist" model="ir.actions.server">
        <field name="name">Mulai di sini</field>
        <field name="model_id" ref="model_labfik_checklist_mulai"/>
        <field name="state">code</field>
        <field name="code">action = model.action_buka()</field>
        <field name="groups_id" eval="[(4, ref('labfik_org.group_labfik_kalab'))]"/>
    </record>
</odoo>

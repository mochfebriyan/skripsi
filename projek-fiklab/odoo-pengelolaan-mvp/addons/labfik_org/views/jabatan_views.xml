<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_jabatan_tree" model="ir.ui.view">
        <field name="name">labfik.jabatan.tree</field>
        <field name="model">labfik.jabatan</field>
        <field name="arch" type="xml">
            <tree decoration-warning="kekurangan">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="atasan_id"/>
                <field name="pengganti_id"/>
                <field name="pemangku_ids" widget="many2many_tags"/>
                <field name="kekurangan" string="Belum lengkap"/>
            </tree>
        </field>
    </record>

    <record id="view_jabatan_form" model="ir.ui.view">
        <field name="name">labfik.jabatan.form</field>
        <field name="model">labfik.jabatan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not kekurangan">
                        Belum lengkap untuk Pengelolaan 3 K2: <field name="kekurangan" class="oe_inline"/>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="atasan_id" invisible="is_puncak"/>
                            <field name="is_puncak"/>
                            <field name="pengganti_id"/>
                        </group>
                        <group>
                            <field name="group_ids" widget="many2many_tags" groups="labfik_org.group_labfik_admin"
                                   options="{'no_create': True}"/>
                            <field name="pemangku_ids" widget="many2many_tags"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Uraian tugas" name="tugas">
                            <field name="uraian_tugas" placeholder="Tugas dan tanggung jawab jabatan ini..."/>
                        </page>
                        <page string="Kewenangan" name="kewenangan">
                            <field name="kewenangan_ids" widget="many2many_checkboxes"/>
                            <separator string="Uraian kewenangan tambahan"/>
                            <field name="kewenangan_uraian"/>
                        </page>
                        <page string="Bawahan" name="bawahan">
                            <field name="bawahan_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="pemangku_ids" widget="many2many_tags"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_jabatan" model="ir.actions.act_window">
        <field name="name">Jabatan</field>
        <field name="res_model">labfik.jabatan</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Lengkapi jabatan di struktur lab</p>
            <p>Jabatan adalah kursinya. Isi uraian tugas, kewenangan, atasan, dan pengganti.</p>
        </field>
    </record>

    <record id="view_kewenangan_tree" model="ir.ui.view">
        <field name="name">labfik.kewenangan.tree</field>
        <field name="model">labfik.kewenangan</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="deskripsi"/>
                <field name="jabatan_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <record id="action_kewenangan" model="ir.actions.act_window">
        <field name="name">Kewenangan</field>
        <field name="res_model">labfik.kewenangan</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>

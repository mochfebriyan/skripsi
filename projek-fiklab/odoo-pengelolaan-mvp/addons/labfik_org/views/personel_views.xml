<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_personel_tree" model="ir.ui.view">
        <field name="name">labfik.personel.tree</field>
        <field name="model">labfik.personel</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="jenis"/>
                <field name="nomor_induk" groups="labfik_org.group_labfik_kalab"/>
                <field name="jabatan_aktif_ids" widget="many2many_tags"/>
                <field name="user_id"/>
            </tree>
        </field>
    </record>

    <record id="view_personel_form" model="ir.ui.view">
        <field name="name">labfik.personel.form</field>
        <field name="model">labfik.personel</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_buat_akun" type="object" string="Buat akun login"
                            invisible="user_id" groups="labfik_org.group_labfik_admin"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Nonaktif" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="jenis"/>
                            <field name="nomor_induk" groups="labfik_org.group_labfik_kalab"/>
                            <field name="email" widget="email"/>
                        </group>
                        <group>
                            <field name="user_id" options="{'no_create': True}"/>
                            <field name="jabatan_aktif_ids" widget="many2many_tags"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Riwayat jabatan" name="riwayat">
                            <field name="sk_line_ids" readonly="1">
                                <tree>
                                    <field name="sk_id"/>
                                    <field name="jabatan_id"/>
                                    <field name="tanggal_mulai"/>
                                    <field name="tanggal_selesai_efektif"/>
                                    <field name="sk_state"/>
                                    <field name="is_aktif"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_personel_search" model="ir.ui.view">
        <field name="name">labfik.personel.search</field>
        <field name="model">labfik.personel</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="nomor_induk" groups="labfik_org.group_labfik_kalab"/>
                <filter name="punya_akun" string="Punya akun login" domain="[('user_id', '!=', False)]"/>
                <filter name="nonaktif" string="Nonaktif" domain="[('active', '=', False)]"/>
                <group expand="0" string="Kelompokkan">
                    <filter name="group_jenis" string="Jenis" context="{'group_by': 'jenis'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_personel" model="ir.actions.act_window">
        <field name="name">Personel</field>
        <field name="res_model">labfik.personel</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Daftarkan personel laboratorium</p>
            <p>Personel adalah orangnya: KaLab, laboran, dosen, asisten, petugas K3, dan pejabat penandatangan.
               Impor sekaligus lewat menu ⚙ › Impor rekaman dengan kolom: name, jenis, nomor_induk, email.</p>
        </field>
    </record>
</odoo>

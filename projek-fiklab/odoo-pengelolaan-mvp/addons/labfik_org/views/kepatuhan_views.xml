<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kepatuhan_tree" model="ir.ui.view">
        <field name="name">labfik.kepatuhan.tree</field>
        <field name="model">labfik.kepatuhan</field>
        <field name="arch" type="xml">
            <tree create="0">
                <field name="periode_id"/>
                <field name="indikator"/>
                <field name="tanggal_penilaian"/>
                <field name="jenis_skor"/>
                <field name="ringkasan"/>
                <field name="skor_sistem" string="Skor sistem (P2)"/>
                <field name="kriteria_tertinggi"/>
                <field name="skor_penilai"/>
            </tree>
        </field>
    </record>

    <record id="view_kepatuhan_form" model="ir.ui.view">
        <field name="name">labfik.kepatuhan.form</field>
        <field name="model">labfik.kepatuhan</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_snapshot" type="object" string="Bekukan (snapshot)"
                            groups="labfik_org.group_labfik_kalab,labfik_org.group_labfik_penilai"
                            confirm="Snapshot menyimpan status dan daftar bukti pada tanggal penilaian ini secara permanen. Lanjutkan?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="indikator" readonly="1"/></h1>
                        <field name="periode_id" readonly="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="tanggal_penilaian"/>
                            <field name="jenis_skor"/>
                        </group>
                        <group>
                            <field name="persen" invisible="jenis_skor != 'persentase'"/>
                            <field name="skor_sistem" invisible="jenis_skor != 'persentase'"/>
                            <field name="kriteria_tertinggi" invisible="jenis_skor != 'kriteria'"/>
                        </group>
                    </group>
                    <field name="detail_html" readonly="1" nolabel="1"/>
                    <group string="Penilaian (diisi penilai)" name="penilai" groups="labfik_org.group_labfik_penilai">
                        <field name="skor_penilai"/>
                        <field name="catatan_penilai"/>
                    </group>
                    <separator string="Snapshot"/>
                    <field name="snapshot_ids" readonly="1">
                        <tree>
                            <field name="create_date" string="Dibuat"/>
                            <field name="tanggal_penilaian"/>
                            <field name="ringkasan"/>
                            <field name="create_uid" string="Oleh"/>
                        </tree>
                    </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_kepatuhan" model="ir.actions.act_window">
        <field name="name">Status monev tata kelola</field>
        <field name="res_model">labfik.kepatuhan</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Belum ada status monev</p>
            <p>Buka menu Konfigurasi › Periode, pilih periode, lalu tekan "Lihat status monev".</p>
        </field>
    </record>

    <record id="view_snapshot_form" model="ir.ui.view">
        <field name="name">labfik.kepatuhan.snapshot.form</field>
        <field name="model">labfik.kepatuhan.snapshot</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="kepatuhan_id"/>
                            <field name="tanggal_penilaian"/>
                            <field name="create_date" string="Dibuat"/>
                        </group>
                        <group>
                            <field name="persen"/>
                            <field name="skor_sistem"/>
                            <field name="kriteria_tertinggi"/>
                        </group>
                    </group>
                    <field name="ringkasan"/>
                    <field name="detail_html" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>

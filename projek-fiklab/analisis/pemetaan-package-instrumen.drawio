        <mxCell id="lg_note" value="Arah panah: package pemakai → package penyedia entitas [T]/[R].&lt;br&gt;Semua package meng-&lt;i&gt;import&lt;/i&gt; &lt;b&gt;PKG-00 Core&lt;/b&gt;; panah ke Core tidak digambar.&lt;br&gt;PKG-03 dan PKG-07 adalah hulu lewat master Core yang mereka kelola." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="legend">
          <mxGeometry x="16" y="374" width="388" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
        <mxCell id="lg_note" parent="legend" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" value="Arah panah: package pemakai → package penyedia entitas [T]/[R].&lt;br&gt;Semua package meng-&lt;i&gt;import&lt;/i&gt; &lt;b&gt;PKG-00 Core&lt;/b&gt;; panah ke Core tidak digambar.&lt;br&gt;PKG-03 dan PKG-07 adalah hulu lewat master Core yang mereka kelola." vertex="1">
          <mxGeometry height="90" width="388" x="16" y="374" as="geometry" />

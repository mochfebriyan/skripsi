;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd3-ui" target="prk-ssd3-ct"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd3-m14" value="dto_status_sesi (terlaksana, waktu_kirim)" style="html=1;endArrow=open;endSize=9;dashed=1;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.4570;exitDx=0;exitDy=0;entryX=0.5;entryY=0.4570;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd3-ui" target="prk-ssd3-a0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd3-t15" value="use case berhasil setelah simpan_jurnal(); dilanjutkan kemudian dari langkah 5 dengan rincian_jurnal(sesi)" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="90" y="780" width="760" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd3-fr0" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=54;height=22;fontSize=11;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="742" width="1035" height="80" as="geometry"/></mxCell><mxCell id="prk-ssd3-gd0" value="«variant» V1 [simpan sebagai draf] · setelah langkah 6" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="82" y="742" width="945" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd3-m16" value="dto_status_sesi, MSG" style="html=1;endArrow=open;endSize=9;dashed=1;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.6223;exitDx=0;exitDy=0;entryX=0.5;entryY=0.6223;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd3-ui" target="prk-ssd3-a0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd3-t17" value="use case gagal" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="90" y="910" width="760" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd3-fr1" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=54;height=22;fontSize=11;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="838" width="1035" height="114" as="geometry"/></mxCell><mxCell id="prk-ssd3-gd1" value="«exception» E1 [Sesi belum terpublikasi, belum berlangsung, atau sudah berjurnal, AB-PRK-17] · langkah 4" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="82" y="838" width="945" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd3-m18" value="MSG jam tidak valid" style="html=1;endArrow=open;endSize=9;dashed=1;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.7319;exitDx=0;exitDy=0;entryX=0.5;entryY=0.7319;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd3-ui" target="prk-ssd3-a0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd3-t19" value="kembali ke langkah 5" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="90" y="1040" width="760" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd3-fr2" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=54;height=22;fontSize=11;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="968" width="1035" height="114" as="geometry"/></mxCell><mxCell id="prk-ssd3-gd2" value="«exception» E2 [jam selesai ≤ jam mulai, AB-PRK-18] · langkah 5" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="82" y="968" width="945" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd3-m20" value="dto_kelengkapan* = cek_kelengkapan_jurnal(sesi)" style="html=1;endArrow=block;endFill=1;endSize=9;strokeColor=#6C4A87;fontColor=#6C4A87;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.8415;exitDx=0;exitDy=0;entryX=0.5;entryY=0.8415;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd3-ui" target="prk-ssd3-ct"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd3-m21" value="dto_kelengkapan*, MSG" style="html=1;endArrow=open;endSize=9;dashed=1;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.8702;exitDx=0;exitDy=0;entryX=0.5;entryY=0.8702;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd3-ui" target="prk-ssd3-a0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd3-t22" value="kembali ke langkah 5" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="90" y="1204" width="760" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd3-fr3" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=54;height=22;fontSize=11;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="1098" width="1035" height="148" as="geometry"/></mxCell><mxCell id="prk-ssd3-gd3" value="«exception» E3 [isian wajib belum lengkap, AB-PRK-19] · langkah 7" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="82" y="1098" width="945" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd3-legend" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, Bab 7)&lt;br&gt;• Panah hitam penuh: &lt;i&gt;system event&lt;/i&gt; (aktor → antarmuka)&lt;br&gt;• Panah hitam putus-putus: &lt;i&gt;system return&lt;/i&gt; (antarmuka → aktor)&lt;br&gt;• Panah ungu, kepala segitiga: operasi sistem ke kontroler. &lt;b&gt;Command&lt;/b&gt; &lt;code&gt;op(args)&lt;/code&gt; mengubah data tanpa nilai balik; &lt;b&gt;query&lt;/b&gt; &lt;code&gt;dto = op(args)&lt;/code&gt; hanya membaca (CQS, §7.1)&lt;br&gt;• &lt;code&gt;dto_x&lt;/code&gt; = data majemuk (lihat kamus DTO), &lt;code&gt;*&lt;/code&gt; = koleksi, &lt;i&gt;terpilih&lt;/i&gt; = pilihan dari daftar (§7.3)&lt;br&gt;• Stateless: &lt;code&gt;user_id&lt;/code&gt; dikirim ke setiap operasi yang membutuhkannya (§7.5)&lt;br&gt;• &lt;code&gt;opt «exception»&lt;/code&gt; / &lt;code&gt;opt «variant»&lt;/code&gt;: alur alternatif; &lt;code&gt;ref&lt;/code&gt;: use case lain (§7.6)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1085" y="150" width="330" height="230" as="geometry"/></mxCell><mxCell id="prk-ssd3-src" value="&lt;b&gt;Catatan&lt;/b&gt;: presensi petugas merujuk &lt;code&gt;hr.employee&lt;/code&gt;; ketidaksesuaian dengan penugasan SDM hanya ditandai (AB-PRK-20, O).&lt;br&gt;&lt;br&gt;Sumber: expanded-use-case-praktikum.md (alur lengkap, AB-PRK-01–34). Katalog operasi dan kamus DTO: ssd-praktikum.md. Draf 16 Nov 2026 · Herrens" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1085" y="400" width="330" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="prk-ssd4" name="SSD TO-BE (4-5) - UC-PRK-15 Putuskan Perubahan Sesi"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1594" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="prk-ssd4-title" value="SSD-4 · UC-PRK-15 Putuskan Perubahan Sesi" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1100" height="32" as="geometry"/></mxCell><mxCell id="prk-ssd4-pre" value="&lt;b&gt;Prakondisi&lt;/b&gt;: pengguna sudah login dan &lt;code&gt;user_id&lt;/code&gt; diketahui antarmuka. KaLab memegang wewenang &lt;i&gt;mengesahkan&lt;/i&gt; untuk jenis &lt;i&gt;perubahan_sesi&lt;/i&gt;; ada Perubahan Sesi berstatus Diajukan." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1380" height="52" as="geometry"/></mxCell><mxCell id="prk-ssd4-a0" value=":KaLab" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=12;fontStyle=1;size=60;participant=umlActor;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="60" height="1404" as="geometry"/></mxCell><mxCell id="prk-ssd4-ui" value=":Antarmuka" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=12;fontStyle=1;size=60;participant=umlBoundary;" vertex="1" parent="1"><mxGeometry x="400" y="150" width="130" height="1404" as="geometry"/></mxCell><mxCell id="prk-ssd4-ct" value=":Kontroler" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=12;fontStyle=1;size=60;participant=umlControl;" vertex="1" parent="1"><mxGeometry x="900" y="150" width="130" height="1404" as="geometry"/></mxCell><mxCell id="prk-ssd4-a1" value=":Pengaju" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=12;fontStyle=1;size=60;participant=umlActor;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="1300" y="150" width="60" height="1404" as="geometry"/></mxCell><mxCell id="prk-ssd4-m1" value="(minta perubahan diajukan)" style="html=1;endArrow=open;endSize=9;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.0712;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0712;entryDx=0;entryDy=0;" edge=
" as="geometry"/></mxCell><mxCell id="prk-ssd4-gd0" value="«variant» V1 / V2 [jenis = daring / batal] · langkah 5" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="82" y="742" width="1310" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd4-m16" value="keputusan = ditolak, alasan" style="html=1;endArrow=open;endSize=9;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.5256;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5256;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd4-a0" target="prk-ssd4-ui"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd4-m17" value="putuskan_pengajuan(perubahan, ditolak, alasan, karena_bentrok, —, user_id)" style="html=1;endArrow=block;endFill=1;endSize=9;strokeColor=#6C4A87;fontColor=#6C4A87;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.5499;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5499;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd4-ui" target="prk-ssd4-ct"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd4-m18" value="dto_rincian_pengajuan = rincian_pengajuan(perubahan)" style="html=1;endArrow=block;endFill=1;endSize=9;strokeColor=#6C4A87;fontColor=#6C4A87;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.5741;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5741;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd4-ui" target="prk-ssd4-ct"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd4-m19" value="dto_rincian_pengajuan (Ditolak)" style="html=1;endArrow=open;endSize=9;dashed=1;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.5983;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5983;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd4-ui" target="prk-ssd4-a0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd4-m20" value="pemberitahuan ‹perubahan, alasan› (O)" style="html=1;endArrow=open;endSize=9;dashed=1;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.6225;exitDx=0;exitDy=0;entryX=0.5;entryY=0.6225;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd4-ui" target="prk-ssd4-a1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd4-fr1" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=54;height=22;fontSize=11;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="838" width="1400" height="226" as="geometry"/></mxCell><mxCell id="prk-ssd4-gd1" value="«variant» V3 [ditolak] · langkah 5" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="82" y="838" width="1310" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd4-m21" value="dto_konflik*, MSG bentrok" style="html=1;endArrow=open;endSize=9;dashed=1;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.6980;exitDx=0;exitDy=0;entryX=0.5;entryY=0.6980;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd4-ui" target="prk-ssd4-a0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd4-t22" value="kembali ke pengiriman dto_pengganti" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="90" y="1152" width="760" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd4-fr2" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=54;height=22;fontSize=11;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="1080" width="1400" height="114" as="geometry"/></mxCell><mxCell id="prk-ssd4-gd2" value="«exception» E1 [waktu pengganti bentrok, AB-PRK-01] · langkah 4" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="82" y="1080" width="1310" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd4-m23" value="dto_status_sesi, MSG" style="html=1;endArrow=open;endSize=9;dashed=1;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.7906;exitDx=0;exitDy=0;entryX=0.5;entryY=0.7906;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd4-ui" target="prk-ssd4-a0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd4-t24" value="use case gagal" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="90" y="1282" width="760" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd4-fr3" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=54;height=22;fontSize=11;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="1210" width="1400" height="114" as="geometry"/></mxCell><mxCell id="prk-ssd4-gd3" value="«exception» E2 [Sesi asal tidak lagi terjadwal, AB-PRK-12] · langkah 4" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="82" y="1210" width="1310" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd4-m25" value="MSG alasan wajib" style="html=1;endArrow=open;endSize=9;dashed=1;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.8832;exitDx=0;exitDy=0;entryX=0.5;entryY=0.8832;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd4-ui" target="prk-ssd4-a0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd4-t26" value="kembali ke V3.1" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="90" y="1412" width="760" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd4-fr4" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=54;height=22;fontSize=11;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="1340" width="1400" height="114" as="geometry"/></mxCell><mxCell id="prk-ssd4-gd4" value="«exception» E3 [alasan penolakan kosong, AB-PRK-10] · V3" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="82" y="1340" width="1310" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd4-legend" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, Bab 7)&lt;br&gt;• Panah hitam penuh: &lt;i&gt;system event&lt;/i&gt; (aktor → antarmuka)&lt;br&gt;• Panah hitam putus-putus: &lt;i&gt;system return&lt;/i&gt; (antarmuka → aktor)&lt;br&gt;• Panah ungu, kepala segitiga: operasi sistem ke kontroler. &lt;b&gt;Command&lt;/b&gt; &lt;code&gt;op(args)&lt;/code&gt; mengubah data tanpa nilai balik; &lt;b&gt;query&lt;/b&gt; &lt;code&gt;dto = op(args)&lt;/code&gt; hanya membaca (CQS, §7.1)&lt;br&gt;• &lt;code&gt;dto_x&lt;/code&gt; = data majemuk (lihat kamus DTO), &lt;code&gt;*&lt;/code&gt; = koleksi, &lt;i&gt;terpilih&lt;/i&gt; = pilihan dari daftar (§7.3)&lt;br&gt;• Stateless: &lt;code&gt;user_id&lt;/code&gt; dikirim ke setiap operasi yang membutuhkannya (§7.5)&lt;br&gt;• &lt;code&gt;opt «exception»&lt;/code&gt; / &lt;code&gt;opt «variant»&lt;/code&gt;: alur alternatif; &lt;code&gt;ref&lt;/code&gt;: use case lain (§7.6)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1450" y="150" width="330" height="230" as="geometry"/></mxCell><mxCell id="prk-ssd4-src" value="&lt;b&gt;Dipakai ulang&lt;/b&gt;: &lt;code&gt;daftar_pengajuan()&lt;/code&gt;, &lt;code&gt;rincian_pengajuan()&lt;/code&gt;, dan &lt;code&gt;putuskan_pengajuan()&lt;/code&gt; juga melayani UC-PRK-08 Putuskan Pemakaian Lab (pola S2 sama, tanpa dto_pengganti).&lt;br&gt;&lt;br&gt;Sumber: expanded-use-case-praktikum.md (alur lengkap, AB-PRK-01–34). Katalog operasi dan kamus DTO: ssd-praktikum.md. Draf 16 Nov 2026 · Herrens" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1450" y="400" width="330" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="prk-ssd5" name="SSD TO-BE (5-5) - UC-PRK-23 Catat Evaluasi Survei"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1435" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="prk-ssd5-title" value="SSD-5 · UC-PRK-23 Catat Evaluasi Survei" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1100" height="32" as="geometry"/></mxCell><mxCell id="prk-ssd5-pre" value="&lt;b&gt;Prakondisi&lt;/b&gt;: pengguna sudah login dan &lt;code&gt;user_id&lt;/code&gt; diketahui antarmuka. Survei kepuasan periode sudah Ditetapkan dan tanggal tutupnya terlewati." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1015" height="52" as="geometry"/></mxCell><mxCell id="prk-ssd5-a0" value=":KaLab" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=12;fontStyle=1;size=60;participant=umlActor;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="60" height="770" as="geometry"/></mxCell><mxCell id="prk-ssd5-ui" value=":Antarmuka" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=12;fontStyle=1;size=60;participant=umlBoundary;" vertex="1" parent="1"><mxGeometry x="400" y="150" width="130" height="770" as="geometry"/></mxCell><mxCell id="prk-ssd5-ct" value=":Kontroler" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=12;fontStyle=1;size=60;participant=umlControl;" vertex="1" parent="1"><mxGeometry x="900" y="150" width="130" height="770" as="geometry"/></mxCell><mxCell id="prk-ssd5-m1" value="(minta survei siap dievaluasi)" style="html=1;endArrow=open;endSize=9;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.1299;exitDx=0;exitDy=0;entryX=0.5;entryY=0.1299;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd5-a0" target="prk-ssd5-ui"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd5-m2" value="dto_survei_ringkas* = daftar_survei(filter = siap_dievaluasi, user_id)" style="html=1;endArrow=block;endFill=1;endSize=9;strokeColor=#6C4A87;fontColor=#6C4A87;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.1740;exitDx=0;exitDy=0;entryX=0.5;entryY=0.1740;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd5-ui" target="prk-ssd5-ct"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd5-m3" value="dto_survei_ringkas*" style="html=1;endArrow=open;endSize=9;dashed=1;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.2182;exitDx=0;exitDy=0;entryX=0.5;entryY=0.2182;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd5-ui" target="prk-ssd5-a0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd5-m4" value="survei terpilih" style="html=1;endArrow=open;endSize=9;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.2623;exitDx=0;exitDy=0;entryX=0.5;entryY=0.2623;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd5-a0" target="prk-ssd5-ui"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd5-m5" value="dto_rekap_survei =
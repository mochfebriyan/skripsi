><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd2-m18" value="dto_koreksi" style="html=1;endArrow=open;endSize=9;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.5968;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5968;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd2-a0" target="prk-ssd2-ui"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd2-m19" value="koreksi_rekaman(pemeriksaan, dto_koreksi, user_id)" style="html=1;endArrow=block;endFill=1;endSize=9;strokeColor=#6C4A87;fontColor=#6C4A87;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.6215;exitDx=0;exitDy=0;entryX=0.5;entryY=0.6215;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd2-ui" target="prk-ssd2-ct"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd2-t20" value="koreksi terlacak (AB-PRK-31); kembali ke langkah 8" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="90" y="1026" width="760" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd2-fr1" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=54;height=22;fontSize=11;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="886" width="1400" height="182" as="geometry"/></mxCell><mxCell id="prk-ssd2-gd1" value="«exception» E1 [Sesi sudah punya pemeriksaan, AB-PRK-13] · langkah 4" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="82" y="886" width="1310" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd2-m21" value="butir_bermasalah*, MSG" style="html=1;endArrow=open;endSize=9;dashed=1;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.7162;exitDx=0;exitDy=0;entryX=0.5;entryY=0.7162;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd2-ui" target="prk-ssd2-a0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd2-t22" value="kembali ke langkah 7" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="90" y="1156" width="760" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd2-fr2" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=54;height=22;fontSize=11;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="1084" width="1400" height="114" as="geometry"/></mxCell><mxCell id="prk-ssd2-gd2" value="«exception» E2 [ada butir bermasalah ∧ keputusan = siap, AB-PRK-15] · langkah 7" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="82" y="1084" width="1310" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd2-m23" value="butir_menunggu*, MSG" style="html=1;endArrow=open;endSize=9;dashed=1;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.8108;exitDx=0;exitDy=0;entryX=0.5;entryY=0.8108;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd2-ui" target="prk-ssd2-a0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd2-t24" value="kembali ke langkah 7" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="90" y="1286" width="760" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd2-fr3" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=54;height=22;fontSize=11;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="1214" width="1400" height="114" as="geometry"/></mxCell><mxCell id="prk-ssd2-gd3" value="«exception» E3 [substitusi belum disetujui ∧ keputusan = siap, AB-PRK-16] · langkah 7" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="82" y="1214" width="1310" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd2-t25" value="dto_pemeriksaan.tepat_waktu = salah; use case berhasil, tetapi Sesi tidak memenuhi PKG-16 S1" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="90" y="1382" width="760" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd2-fr4" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=54;height=22;fontSize=11;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="1344" width="1400" height="80" as="geometry"/></mxCell><mxCell id="prk-ssd2-gd4" value="«exception» E4 [waktu periksa ≥ jam mulai Sesi, AB-PRK-13] · langkah 8" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="82" y="1344" width="1310" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd2-legend" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, Bab 7)&lt;br&gt;• Panah hitam penuh: &lt;i&gt;system event&lt;/i&gt; (aktor → antarmuka)&lt;br&gt;• Panah hitam putus-putus: &lt;i&gt;system return&lt;/i&gt; (antarmuka → aktor)&lt;br&gt;• Panah ungu, kepala segitiga: operasi sistem ke kontroler. &lt;b&gt;Command&lt;/b&gt; &lt;code&gt;op(args)&lt;/code&gt; mengubah data tanpa nilai balik; &lt;b&gt;query&lt;/b&gt; &lt;code&gt;dto = op(args)&lt;/code&gt; hanya membaca (CQS, §7.1)&lt;br&gt;• &lt;code&gt;dto_x&lt;/code&gt; = data majemuk (lihat kamus DTO), &lt;code&gt;*&lt;/code&gt; = koleksi, &lt;i&gt;terpilih&lt;/i&gt; = pilihan dari daftar (§7.3)&lt;br&gt;• Stateless: &lt;code&gt;user_id&lt;/code&gt; dikirim ke setiap operasi yang membutuhkannya (§7.5)&lt;br&gt;• &lt;code&gt;opt «exception»&lt;/code&gt; / &lt;code&gt;opt «variant»&lt;/code&gt;: alur alternatif; &lt;code&gt;ref&lt;/code&gt;: use case lain (§7.6)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1450" y="150" width="330" height="230" as="geometry"/></mxCell><mxCell id="prk-ssd2-src" value="&lt;b&gt;Catatan&lt;/b&gt;: butir dihitung oleh query &lt;code&gt;form_kesiapan()&lt;/code&gt; dan baru disimpan oleh &lt;code&gt;catat_pemeriksaan()&lt;/code&gt; (CQS). Bila keputusan &lt;i&gt;tunda&lt;/i&gt;, laboran melanjutkan UC-PRK-14 sebagai use case terpisah.&lt;br&gt;&lt;br&gt;Sumber: expanded-use-case-praktikum.md (alur lengkap, AB-PRK-01–34). Katalog operasi dan kamus DTO: ssd-praktikum.md. Draf 16 Nov 2026 · Herrens" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1450" y="400" width="330" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="prk-ssd3" name="SSD TO-BE (3-5) - UC-PRK-13 Kirim Jurnal Sesi"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1435" pageHeight="1376" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="prk-ssd3-title" value="SSD-3 · UC-PRK-13 Kirim Jurnal Sesi" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1100" height="32" as="geometry"/></mxCell><mxCell id="prk-ssd3-pre" value="&lt;b&gt;Prakondisi&lt;/b&gt;: pengguna sudah login dan &lt;code&gt;user_id&lt;/code&gt; diketahui antarmuka. Ada Sesi terpublikasi yang sudah berlangsung. Petugas Praktikum = asisten, dosen, atau laboran." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1015" height="52" as="geometry"/></mxCell><mxCell id="prk-ssd3-a0" value=":Petugas Praktikum" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=12;fontStyle=1;size=60;participant=umlActor;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="60" height="1186" as="geometry"/></mxCell><mxCell id="prk-ssd3-ui" value=":Antarmuka" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=12;fontStyle=1;size=60;participant=umlBoundary;" vertex="1" parent="1"><mxGeometry x="400" y="150" width="130" height="1186" as="geometry"/></mxCell><mxCell id="prk-ssd3-ct" value=":Kontroler" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=12;fontStyle=1;size=60;participant=umlControl;" vertex="1" parent="1"><mxGeometry x="900" y="150" width="130" height="1186" as="geometry"/></mxCell><mxCell id="prk-ssd3-m1" value="(minta Sesi belum berjurnal)" style="html=1;endArrow=open;endSize=9;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.0843;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0843;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd3-a0" target="prk-ssd3-ui"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd3-m2" value="dto_sesi_ringkas* = daftar_sesi(filter = belum_berjurnal, user_id)" style="html=1;endArrow=block;endFill=1;endSize=9;strokeColor=#6C4A87;fontColor=#6C4A87;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.1130;exitDx=0;exitDy=0;entryX=0.5;entryY=0.1130;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd3-ui" target="prk-ssd3-ct"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd3-m3" value="dto_sesi_ringkas* (penanda terlewat)" style="html=1;endArrow=open;endSize=9;dashed=1;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.
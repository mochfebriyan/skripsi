geometry"/></mxCell><mxCell id="prk-ssd5-m10" value="dto_status_survei (Dievaluasi, kriteria_tertinggi K1–K3)" style="html=1;endArrow=open;endSize=9;dashed=1;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.5273;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5273;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd5-ui" target="prk-ssd5-a0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd5-m11" value="dto_status_survei, MSG" style="html=1;endArrow=open;endSize=9;dashed=1;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.6571;exitDx=0;exitDy=0;entryX=0.5;entryY=0.6571;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd5-ui" target="prk-ssd5-a0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd5-t12" value="use case gagal" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="90" y="678" width="760" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd5-fr0" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=54;height=22;fontSize=11;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="606" width="1035" height="114" as="geometry"/></mxCell><mxCell id="prk-ssd5-gd0" value="«exception» E1 [survei belum ditutup atau sudah dievaluasi, AB-PRK-29] · langkah 4" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="82" y="606" width="945" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd5-m13" value="baris_rtl_kurang*, MSG" style="html=1;endArrow=open;endSize=9;dashed=1;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.8260;exitDx=0;exitDy=0;entryX=0.5;entryY=0.8260;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd5-ui" target="prk-ssd5-a0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd5-t14" value="kembali ke langkah 5" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="90" y="808" width="760" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd5-fr1" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=54;height=22;fontSize=11;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="736" width="1035" height="114" as="geometry"/></mxCell><mxCell id="prk-ssd5-gd1" value="«exception» E2 [baris RTL tidak lengkap: aspek, tindakan, PIC, tenggat, AB-PRK-29] · langkah 5" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="82" y="736" width="945" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd5-legend" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, Bab 7)&lt;br&gt;• Panah hitam penuh: &lt;i&gt;system event&lt;/i&gt; (aktor → antarmuka)&lt;br&gt;• Panah hitam putus-putus: &lt;i&gt;system return&lt;/i&gt; (antarmuka → aktor)&lt;br&gt;• Panah ungu, kepala segitiga: operasi sistem ke kontroler. &lt;b&gt;Command&lt;/b&gt; &lt;code&gt;op(args)&lt;/code&gt; mengubah data tanpa nilai balik; &lt;b&gt;query&lt;/b&gt; &lt;code&gt;dto = op(args)&lt;/code&gt; hanya membaca (CQS, §7.1)&lt;br&gt;• &lt;code&gt;dto_x&lt;/code&gt; = data majemuk (lihat kamus DTO), &lt;code&gt;*&lt;/code&gt; = koleksi, &lt;i&gt;terpilih&lt;/i&gt; = pilihan dari daftar (§7.3)&lt;br&gt;• Stateless: &lt;code&gt;user_id&lt;/code&gt; dikirim ke setiap operasi yang membutuhkannya (§7.5)&lt;br&gt;• &lt;code&gt;opt «exception»&lt;/code&gt; / &lt;code&gt;opt «variant»&lt;/code&gt;: alur alternatif; &lt;code&gt;ref&lt;/code&gt;: use case lain (§7.6)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1085" y="150" width="330" height="230" as="geometry"/></mxCell><mxCell id="prk-ssd5-src" value="&lt;b&gt;Catatan&lt;/b&gt;: kriteria tertinggi dihitung &lt;code&gt;labfik.criteria.mixin&lt;/code&gt; (AB-PRK-34); skor akhir ditetapkan penilai. K4 baru lengkap setelah UC-PRK-24 pada periode berikutnya.&lt;br&gt;&lt;br&gt;Sumber: expanded-use-case-praktikum.md (alur lengkap, AB-PRK-01–34). Katalog operasi dan kamus DTO: ssd-praktikum.md. Draf 16 Nov 2026 · Herrens" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1085" y="400" width="330" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
tSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.2707;exitDx=0;exitDy=0;entryX=0.5;entryY=0.2707;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd2-ui" target="prk-ssd2-a0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd2-m10" value="keputusan" style="html=1;endArrow=open;endSize=9;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.2955;exitDx=0;exitDy=0;entryX=0.5;entryY=0.2955;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd2-a0" target="prk-ssd2-ui"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd2-m11" value="catat_pemeriksaan(sesi, dto_hasil_butir*, keputusan, user_id)" style="html=1;endArrow=block;endFill=1;endSize=9;strokeColor=#6C4A87;fontColor=#6C4A87;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.3202;exitDx=0;exitDy=0;entryX=0.5;entryY=0.3202;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd2-ui" target="prk-ssd2-ct"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd2-m12" value="dto_pemeriksaan = rincian_pemeriksaan(sesi)" style="html=1;endArrow=block;endFill=1;endSize=9;strokeColor=#6C4A87;fontColor=#6C4A87;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.3450;exitDx=0;exitDy=0;entryX=0.5;entryY=0.3450;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd2-ui" target="prk-ssd2-ct"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd2-m13" value="dto_pemeriksaan (waktu_periksa, keputusan, tepat_waktu)" style="html=1;endArrow=open;endSize=9;dashed=1;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.3697;exitDx=0;exitDy=0;entryX=0.5;entryY=0.3697;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd2-ui" target="prk-ssd2-a0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd2-t14" value="dto_hasil_butir bahan memuat bahan_pengganti dan alasan_substitusi; butir
entryX=0.5;entryY=0.2325;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd1-a0" target="prk-ssd1-ui"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd1-m6" value="impor_jadwal(periode, dto_baris_jadwal*, tanggal_pertemuan_pertama, user_id)" style="html=1;endArrow=block;endFill=1;endSize=9;strokeColor=#6C4A87;fontColor=#6C4A87;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.2675;exitDx=0;exitDy=0;entryX=0.5;entryY=0.2675;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd1-ui" target="prk-ssd1-ct"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd1-m7" value="dto_ringkasan_jadwal = ringkasan_jadwal(periode)" style="html=1;endArrow=block;endFill=1;endSize=9;strokeColor=#6C4A87;fontColor=#6C4A87;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.3025;exitDx=0;exitDy=0;entryX=0.5;entryY=0.3025;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd1-ui" target="prk-ssd1-ct"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd1-m8" value="dto_ringkasan_jadwal (Sesi terjadwal, kelas lewat kapasitas)" style="html=1;endArrow=open;endSize=9;dashed=1;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.3374;exitDx=0;exitDy=0;entryX=0.5;entryY=0.3374;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd1-ui" target="prk-ssd1-a0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd1-m9" value="dto_baris_jadwal (satu kelas: pola mingguan), tanggal_pertemuan_pertama" style="html=1;endArrow=open;endSize=9;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.4403;exitDx=0;exitDy=0;entryX=0.5;entryY=0.4403;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd1-a0" target="prk-ssd1-ui"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd1-t10" value="operasi sama: pratinjau_impor() lalu impor_jadwal() dengan satu baris" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="90" y="600" width="760" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd1-fr0" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=54;height=22;fontSize=11;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="528" width="1035" height="114" as="geometry"/></mxCell><mxCell id="prk-ssd1-gd0" value="«variant» V1 [tanpa berkas: satu kelas diisi manual] · langkah 1" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="82" y="528" width="945" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd1-m11" value="dto_konflik*, MSG bentrok" style="html=1;endArrow=open;endSize=9;dashed=1;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.5741;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5741;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd1-ui" target="prk-ssd1-a0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd1-t12" value="kelas yang bentrok tidak dibangkitkan; laboran menyampaikan bentrok ke fakultas (di luar sistem)" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="90" y="730" width="760" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd1-fr1" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=54;height=22;fontSize=11;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="658" width="1035" height="114" as="geometry"/></mxCell><mxCell id="prk-ssd1-gd1" value="«exception» E1 [ruang bentrok, AB-PRK-01] · langkah 2" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="82" y="658" width="945" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd1-m13" value="kelas_terkunci*, MSG" style="html=1;endArrow=open;endSize=9;dashed=1;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.7078;exitDx=0;exitDy=0;entryX=0.5;entryY=0.7078;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd1-ui" target="prk-ssd1-a0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd1-t14" value="kelas itu dilewati; perubahannya lewat UC-PRK-14 Ajukan Perubahan Sesi" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="90" y="860" width="760" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd1-fr2" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=54;height=22;fontSize=11;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="788" width="1035" height="114" as="geometry"/></mxCell><mxCell id="prk-ssd1-gd2" value="«exception» E2 [kelas terkunci: jadwal periode sudah disahkan atau Sesi sudah berjurnal, AB-PRK-04] · langkah 2" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="82" y="788" width="945" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd1-m15" value="dto_baris_salah*, MSG" style="html=1;endArrow=open;endSize=9;dashed=1;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.8416;exitDx=0;exitDy=0;entryX=0.5;entryY=0.8416;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-ssd1-ui" target="prk-ssd1-a0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-ssd1-t16" value="kembali ke langkah 1" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="90" y="990" width="760" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd1-fr3" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=54;height=22;fontSize=11;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="918" width="1035" height="114" as="geometry"/></mxCell><mxCell id="prk-ssd1-gd3" value="«exception» E3 [baris tidak valid: ruang/dosen tidak dikenal, jam selesai ≤ jam mulai] · langkah 2" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="82" y="918" width="945" height="22" as="geometry"/></mxCell><mxCell id="prk-ssd1-legend" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, Bab 7)&lt;br&gt;• Panah hitam penuh: &lt;i&gt;system event&lt;/i&gt; (aktor → antarmuka)&lt;br&gt;• Panah hitam putus-putus: &lt;i&gt;system return&lt;/i&gt; (antarmuka → aktor)&lt;br&gt;• Panah ungu, kepala segitiga: operasi sistem ke kontroler. &lt;b&gt;Command&lt;/b&gt; &lt;code&gt;op(args)&lt;/code&gt; mengubah data tanpa nilai balik; &lt;b&gt;query&lt;/b&gt; &lt;code&gt;dto = op(args)&lt;/code&gt; hanya membaca (CQS, §7.1)&lt;br&gt;• &lt;code&gt;dto_x&lt;/code&gt; = data majemuk (lihat kamus DTO), &lt;code&gt;*&lt;/code&gt; = koleksi, &lt;i&gt;terpilih&lt;/i&gt; = pilihan dari daftar (§7.3)&lt;br&gt;• Stateless: &lt;code&gt;user_id&lt;/code&gt; dikirim ke setiap operasi yang membutuhkannya (§7.5)&lt;br&gt;• &lt;code&gt;opt «exception»&lt;/code&gt; / &lt;code&gt;opt «variant»&lt;/code&gt;: alur alternatif; &lt;code&gt;ref&lt;/code&gt;: use case lain (§7.6)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1085" y="150" width="330" height="230" as="geometry"/></mxCell><mxCell id="prk-ssd1-src" value="&lt;b&gt;Catatan&lt;/b&gt;: peringatan kapasitas (AB-PRK-03) tidak menggagalkan impor. Pertemuan 8 = UTS, 16 = UAS (AB-PRK-02).&lt;br&gt;&lt;br&gt;Sumber: expanded-use-case-praktikum.md (alur lengkap, AB-PRK-01–34). Katalog operasi dan kamus DTO: ssd-praktikum.md. Draf 16 Nov 2026 · Herrens" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1085" y="400" width="330" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="prk-ssd2" name="SSD TO-BE (2-5) - UC-PRK-11 Periksa Kesiapan Sesi"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1564" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="prk-ssd2-title" value="SSD-2 · UC-PRK-11 Periksa Kesiapan Sesi" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1100" height="32" as="geometry"/></mxCell><mxCell id="prk-ssd2-pre" value="&lt;b&gt;Prakondisi&lt;/b&gt;: pengguna sudah login dan &lt;code&gt;user_id&lt;/code&gt; diketahui antarmuka. Ada Sesi terpublikasi hari itu (Penetapan Jadwal periode sudah disahkan)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1380" height="52" as="geometry"/></mxCell><mxCell id="prk-ssd2-a0" value=":Laboran" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=12;fontStyle=1;size=60;participant=umlActor;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="60" height="1374" as="geometry"/></mxCell><mxCell id="prk-ssd2-ui" value=":Antarmuka" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=12;fontStyle=1;size=60;participant=umlBoundary;" vertex="1" parent="1"><mxGeometry x="400" y="150" width="130" height="1374" as="geometry"/></mxCell><mxCell id="prk-ssd2-ct" value=":
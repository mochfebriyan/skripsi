tion=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150" y="110" width="30" height="60" as="geometry"/></mxCell><mxCell id="prk-uc3-lab" value="Laboran" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150" y="230" width="30" height="60" as="geometry"/></mxCell><mxCell id="prk-uc3-kal" value="KaLab" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150" y="420" width="30" height="60" as="geometry"/></mxCell><mxCell id="prk-uc3-ka2" value="KaLab" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1330" y="220" width="30" height="60" as="geometry"/></mxCell><mxCell id="prk-uc3-res" value="Responden&lt;br&gt;(praktikan, dosen, asisten)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1330" y="555" width="30" height="60" as="geometry"/></mxCell><mxCell id="prk-uc3-a-dos-17" value="" style="endArrow=none;html=1;strokeColor=#555555;entryX=0;entryY=0.5;" edge="1" parent="1" source="prk-uc3-dos" target="prk-uc3-uc17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc3-a-dos-18" value="" style="endArrow=none;html=1;strokeColor=#555555;entryX=0;entryY=0.5;" edge="1" parent="1" source="prk-uc3-dos" target="prk-uc3-uc18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc3-a-lab-17" value="" style="endArrow=none;html=1;strokeColor=#555555;entryX=0;entryY=0.5;" edge="1" parent="1" source="prk-uc3-lab" target="prk-uc3-uc17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc3-a-lab-18" value="" style="endArrow=none;html=1;strokeColor=#555555;entryX=0;entryY=0.5;" edge="1" parent="1" source="prk-uc3-lab" target="prk-uc3-uc18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc3-a-kal-26" value="" style="endArrow=none;html=1;strokeColor=#555555;entryX=0;entryY=0.5;" edge="1" parent="1" source="prk-uc3-kal" target="prk-uc3-uc26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc3-a-kal-27" value="" style="endArrow=none;html=1;strokeColor=#555555;entryX=0;entryY=0.5;" edge="1" parent="1" source="prk-uc3-kal" target="prk-uc3-uc27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc3-a-kal-28" value="" style="endArrow=none;html=1;strokeColor=#555555;entryX=0;entryY=0.5;" edge="1" parent="1" source="prk-uc3-kal" target="prk-uc3-uc28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc3-a-ka2-19" value="" style="endArrow=none;html=1;strokeColor=#555555;entryX=1;entryY=0.5;" edge="1" parent="1" source="prk-uc3-ka2" target="prk-uc3-uc19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc3-a-ka2-20" value="" style="endArrow=none;html=1;strokeColor=#555555;entryX=1;entryY=0.5;" edge="1" parent="1" source="prk-uc3-ka2" target="prk-uc3-uc20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc3-a-ka2-21" value="" style="endArrow=none;html=1;strokeColor=#555555;entryX=1;entryY=0.5;" edge="1" parent="1" source="prk-uc3-ka2" target="prk-uc3-uc21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc3-a-ka2-23" value="" style="endArrow=none;html=1;strokeColor=#555555;entryX=1;entryY=0.5;" edge="1" parent="1" source="prk-uc3-ka2" target="prk-uc3-uc23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc3-a-ka2-24" value="" style="endArrow=none;html=1;strokeColor=#555555;entryX=1;entryY=0.5;" edge="1" parent="1" source="prk-uc3-ka2" target="prk-uc3-uc24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc3-a-ka2-25" value="" style="endArrow=none;html=1;strokeColor=#555555;entryX=1;entryY=0.5;" edge="1" parent="1" source="prk-uc3-ka2" target="prk-uc3-uc25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc3-a-res-22" value="" style="endArrow=none;html=1;strokeColor=#555555;entryX=1;entryY=0.5;" edge="1" parent="1" source="prk-uc3-res" target="prk-uc3-uc22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc3-n0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §4.2–4.3)&lt;br&gt;• Aktor miring biru = &lt;b&gt;aktor abstrak&lt;/b&gt;; panah segitiga kosong = generalisasi (turunan mewarisi use case induk)&lt;br&gt;• «CRUDL» = kelola data (buat, lihat, ubah, hapus, daftar) dengan satu pola; «report» = hanya membaca&lt;br&gt;• Tanpa «include»/«extend»: setiap use case satu sesi dan berdiri sendiri (§4.3.1, §4.5)&lt;br&gt;• Tidak ada aktor «system» Penjadwal: status yang bergantung waktu dihitung, tidak dijadwalkan&lt;br&gt;• KaLab digambar dua kali hanya agar garis tidak menyilang" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="600" height="135" as="geometry"/></mxCell><mxCell id="prk-uc3-n1" value="&lt;b&gt;Cara baca&lt;/b&gt;&lt;br&gt;• UC-PRK-17: tautan penilaian LeADS per kelas (Inti); UC-PRK-18: impor ekspor Excel LeADS bila tersedia (Pelengkap).&lt;br&gt;• UC-PRK-22: lewat tautan addon &lt;code&gt;survey&lt;/code&gt;, tanpa nama, tanpa login.&lt;br&gt;• UC-PRK-26: persentase PKG-15–19 dan kriteria tertinggi K1–K4 PKG-20; skor kriteria berurutan ditetapkan penilai.&lt;br&gt;• UC-PRK-27: laporan bukti per indikator per periode, diserahkan ke penilai." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="660" y="710" width="600" height="135" as="geometry"/></mxCell><mxCell id="prk-uc3-n2" value="Diturunkan dari activity A1–A5 dan state machine S1–S3 (proses-bisnis-praktikum.md), kebutuhan KF-PRK-01–51. Rincian: use-case-praktikum.md · Draf 16 Nov 2026 · Herrens" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="1220" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
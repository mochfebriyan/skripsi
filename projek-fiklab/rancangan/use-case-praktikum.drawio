<mxfile host="app.diagrams.net"><diagram id="prk-uc1" name="UC TO-BE (1-3) - Jadwal, Modul, dan Pemakaian Lab"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1110" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="prk-uc1-title" value="Use case TO-BE 1/3 · Jadwal, Modul, dan Pemakaian Lab (PKG-15)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1100" height="36" as="geometry"/></mxCell><mxCell id="prk-uc1-sys" value="Sistem LabFIK Compliance · Modul Pelaksanaan Praktikum" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=8;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="380" y="60" width="880" height="740" as="geometry"/></mxCell><mxCell id="prk-uc1-p1" value="Jadwal (PKG-15)" style="shape=folder;tabWidth=270;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#EEF6FF;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="410" y="100" width="380" height="390" as="geometry"/></mxCell><mxCell id="prk-uc1-uc01" value="&lt;font style='font-size:9px' color='#3B5F8F'&gt;«CRUDL»&lt;/font&gt;&lt;br&gt;&lt;b&gt;UC-PRK-01&lt;/b&gt;&lt;br&gt;Kelola Mata Kuliah" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="134" width="250" height="58" as="geometry"/></mxCell><mxCell id="prk-uc1-uc02" value="&lt;font style='font-size:9px' color='#3B5F8F'&gt;«CRUDL»&lt;/font&gt;&lt;br&gt;&lt;b&gt;UC-PRK-02&lt;/b&gt;&lt;br&gt;Kelola Kelas" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="204" width="250" height="58" as="geometry"/></mxCell><mxCell id="prk-uc1-uc03" value="&lt;b&gt;UC-PRK-03&lt;/b&gt;&lt;br&gt;Impor Jadwal Kelas" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="274" width="250" height="58" as="geometry"/></mxCell><mxCell id="prk-uc1-uc04" value="&lt;b&gt;UC-PRK-04&lt;/b&gt;&lt;br&gt;Susun Penetapan Jadwal" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="344" width="250" height="58" as="geometry"/></mxCell><mxCell id="prk-uc1-uc10" value="&lt;font style='font-size:9px' color='#3B5F8F'&gt;«report»&lt;/font&gt;&lt;br&gt;&lt;b&gt;UC-PRK-10&lt;/b&gt;&lt;br&gt;Lihat Laporan Jadwal" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="414" width="250" height="58" as="geometry"/></mxCell><mxCell id="prk-uc1-p2" value="Pemakaian Lab (PKG-15)" style="shape=folder;tabWidth=270;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#EEF6FF;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="410" y="520" width="380" height="250" as="geometry"/></mxCell><mxCell id="prk-uc1-uc07" value="&lt;b&gt;UC-PRK-07&lt;/b&gt;&lt;br&gt;Ajukan Pemakaian Lab" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="554" width="250" height="58" as="geometry"/></mxCell><mxCell id="prk-uc1-uc08" value="&lt;b&gt;UC-PRK-08&lt;/b&gt;&lt;br&gt;Putuskan Pemakaian Lab" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="624" width="250" height="58" as="geometry"/></mxCell><mxCell id="prk-uc1-uc09" value="&lt;b&gt;UC-PRK-09&lt;/b&gt;&lt;br&gt;Tarik Pengajuan" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="694" width="250" height="58" as="geometry"/></mxCell><mxCell id="prk-uc1-p3" value="Modul (PKG-15, dipakai 16, 17, 19)" style="shape=folder;tabWidth=270;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#EEF6FF;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="850" y="100" width="380" height="180" as="geometry"/></mxCell><mxCell id="prk-uc1-uc05" value="&lt;b&gt;UC-PRK-05&lt;/b&gt;&lt;br&gt;Terbitkan Versi Modul" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="910" y="134" width="250" height="58" as="geometry"/></mxCell><mxCell id="prk-uc1-uc06" value="&lt;b&gt;UC-PRK-06&lt;/b&gt;&lt;br&gt;Baca Modul Berlaku" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="910" y="204" width="250" height="58" as="geometry"/></mxCell><mxCell id="prk-uc1-n3" value="&lt;b&gt;Pengesahan jadwal&lt;/b&gt; memakai use case milik &lt;b&gt;Tata Kelola&lt;/b&gt;, tidak dibuat ulang: &lt;i&gt;Ajukan Dokumen&lt;/i&gt; (UC-01), &lt;i&gt;Terbitkan Dokumen Resmi&lt;/i&gt; (UC-02), &lt;i&gt;Unggah Dokumen Bertanda Tangan&lt;/i&gt; (UC-03), &lt;i&gt;Sahkan Dokumen&lt;/i&gt; (UC-05) oleh KaLab, lewat &lt;code&gt;labfik.approval.mixin&lt;/code&gt;. UC-PRK-04 menyiapkan dokumennya." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="660" y="990" width="600" height="90" as="geometry"/></mxCell><mxCell id="prk-uc1-lab" value="Laboran" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150" y="180" width="30" height="60" as="geometry"/></mxCell><mxCell id="prk-uc1-kal" value="KaLab" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150" y="420" width="30" height="60" as="geometry"/></mxCell><mxCell id="prk-uc1-dos" value="Dosen" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1330" y="130" width="30" height="60" as="geometry"/></mxCell><mxCell id="prk-uc1-ptg" value="Petugas Praktikum" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=3;fillColor=#EEF6FF;" vertex="1" parent="1"><mxGeometry x="1330" y="520" width="30" height="60" as="geometry"/></mxCell><mxCell id="prk-uc1-a-lab-01" value="" style="endArrow=none;html=1;strokeColor=#555555;entryX=0;entryY=0.5;" edge="1" parent="1" source="prk-uc1-lab" target="prk-uc1-uc01"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc1-a-lab-02" value="" style="endArrow=none;html=1;strokeColor=#555555;entryX=0;entryY=0.5;" edge="1" parent="1" source="prk-uc1-lab" target="prk-uc1-uc02"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc1-a-lab-03" value="" style="endArrow=none;html=1;strokeColor=#555555;entryX=0;entryY=0.5;" edge="1" parent="1" source="prk-uc1-lab" target="prk-uc1-uc03"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc1-a-lab-04" value="" style="endArrow=none;html=1;strokeColor=#555555;entryX=0;entryY=0.5;" edge="1" parent="1" source="prk-uc1-lab" target="prk-uc1-uc04"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc1-a-lab-07" value="" style="endArrow=none;html=1;strokeColor=#555555;entryX=0;entryY=0.5;" edge="1" parent="1" source="prk-uc1-lab" target="prk-uc1-uc07"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc1-a-lab-10" value="" style="endArrow=none;html=1;strokeColor=#555555;entryX=0;entryY=0.5;" edge="1" parent="1" source="prk-uc1-lab" target="prk-uc1-uc10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc1-a-kal-08" value="" style="endArrow=none;html=1;strokeColor=#555555;entryX=0;entryY=0.5;" edge="1" parent="1" source="prk-uc1-kal" target="prk-uc1-uc08"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc1-a-kal-10" value="" style="endArrow=none;html=1;strokeColor=#555555;entryX=0;entryY=0.5;" edge="1" parent="1" source="prk-uc1-kal" target="prk-uc1-uc10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc1-a-dos-05" value="" style="endArrow=none;html=1;strokeColor=#555555;entryX=1;entryY=0.5;" edge="1" parent="1" source="prk-uc1-dos" target="prk-uc1-uc05"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc1-a-ptg-06" value="" style="endArrow=none;html=1;strokeColor=#555555;entryX=1;entryY=0.5;" edge="1" parent="1" source="prk-uc1-ptg" target="prk-uc1-uc06"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc1-a-ptg-09" value="" style="endArrow=none;html=1;strokeColor=#555555;entryX=1;entryY=0.5;" edge="1" parent="1" source="prk-uc1-ptg" target="prk-uc1-uc09"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc1-a-ptg-10" value="" style="endArrow=none;html=1;strokeColor=#555555;entryX=1;entryY=0.5;" edge="1" parent="1" source="prk-uc1-ptg" target="prk-uc1-uc10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc1-n0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §4.2–4.3)&lt;br&gt;• Aktor miring biru = &lt;b&gt;aktor abstrak&lt;/b&gt;; panah segitiga kosong = generalisasi (turunan mewarisi use case induk)&lt;br&gt;• «CRUDL» = kelola data (buat, lihat, ubah, hapus, daftar) dengan satu pola; «report» = hanya membaca&lt;br&gt;• Tanpa «include»/«extend»: setiap use case satu sesi dan berdiri sendiri (§4.3.1, §4.5)&lt;br&gt;• Tidak ada aktor «system» Penjadwal: status yang bergantung waktu dihitung, tidak dijadwalkan" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="600" height="120" as="geometry"/></mxCell><mxCell id="prk-uc1-n1" value="&lt;b&gt;Cara baca&lt;/b&gt;&lt;br&gt;• &lt;i&gt;Petugas Praktikum&lt;/i&gt; = asisten, dosen, atau laboran yang bertugas di sesi (hierarki di halaman 2/3).&lt;br&gt;• UC-PRK-03: berkas jadwal dari tim jadwal fakultas (pola mingguan per kelas); sistem membangkitkan 16 sesi per kelas, memeriksa bentrok dan kapasitas &lt;b&gt;[ASUMSI: impor berkas, tanpa API]&lt;/b&gt;.&lt;br&gt;• UC-PRK-10: jadwal terpadu (sesi + pemakaian disetujui) dan rekaman konflik.&lt;br&gt;• UC-PRK-07: pengguna lab tidak punya akun; laboran mencatat permintaannya. UC-PRK-09: menarik pengajuan sebelum diputuskan (laboran turunan Petugas Praktikum)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="660" y="830" width="600" height="140" as="geometry"/></mxCell><mxCell id="prk-uc1-n2" value="&lt;b&gt;Bukan aktor&lt;/b&gt;: pengguna lab di luar praktikum (tanpa akun; dicatat laboran), tim jadwal fakultas (berkasnya diimpor laboran), Dekan, penilai monev (menerima PDF), pihak eksternal. Diturunkan dari activity A1–A5 dan state machine S1–S3 (proses-bisnis-praktikum.md), kebutuhan KF-PRK-01–51. Rincian: use-case-praktikum.md · Draf 16 Nov 2026 · Herrens" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="600" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="prk-uc2" name="UC TO-BE (2-3) - Pelaksanaan Sesi"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="prk-uc2-title" value="Use case TO-BE 2/3 · Kesiapan (PKG-16, 17) dan Pelaksanaan Sesi (PKG-18), dengan hierarki aktor" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1200" height="36" as="geometry"/></mxCell><mxCell id="prk-uc2-sys" value="Sistem LabFIK Compliance · Modul Pelaksanaan Praktikum" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=8;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="380" y="60" width="880" height="560" as="geometry"/></mxCell><mxCell id="prk-uc2-p1" value="Pelaksanaan Sesi (PKG-18)" style="shape=folder;tabWidth=270;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#EEF6FF;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="410" y="100" width="380" height="320" as="geometry"/></mxCell><mxCell id="prk-uc2-uc13" value="&lt;b&gt;UC-PRK-13&lt;/b&gt;&lt;br&gt;Kirim Jurnal Sesi" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="134" width="250" height="58" as="geometry"/></mxCell><mxCell id="prk-uc2-uc14" value="&lt;b&gt;UC-PRK-14&lt;/b&gt;&lt;br&gt;Ajukan Perubahan Sesi" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="204" width="250" height="58" as="geometry"/></mxCell><mxCell id="prk-uc2-uc15" value="&lt;b&gt;UC-PRK-15&lt;/b&gt;&lt;br&gt;Putuskan Perubahan Sesi" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="274" width="250" height="58" as="geom
ect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1330" y="310" width="30" height="60" as="geometry"/></mxCell><mxCell id="prk-uc2-dos" value="Dosen" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1330" y="420" width="30" height="60" as="geometry"/></mxCell><mxCell id="prk-uc2-a-kal-15" value="" style="endArrow=none;html=1;strokeColor=#555555;entryX=0;entryY=0.5;" edge="1" parent="1" source="prk-uc2-kal" target="prk-uc2-uc15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc2-a-kal-16" value="" style="endArrow=none;html=1;strokeColor=#555555;entryX=0;entryY=0.5;" edge="1" parent="1" source="prk-uc2-kal" target="prk-uc2-uc16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc2-a-ptg-13" value="" style="endArrow=none;html=1;strokeColor=#555555;entryX=1;entryY=0.5;" edge="1" parent="1" source="prk-uc2-ptg" target="prk-uc2-uc13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc2-a-ptg-14" value="" style="endArrow=none;html=1;strokeColor=#555555;entryX=1;entryY=0.5;" edge="1" parent="1" source="prk-uc2-ptg" target="prk-uc2-uc14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc2-a-lab-11" value="" style="endArrow=none;html=1;strokeColor=#555555;entryX=1;entryY=0.5;" edge="1" parent="1" source="prk-uc2-lab" target="prk-uc2-uc11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc2-a-dos-12" value="" style="endArrow=none;html=1;strokeColor=#555555;entryX=1;entryY=0.5;" edge="1" parent="1" source="prk-uc2-dos" target="prk-uc2-uc12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc2-hbox" value="&lt;b&gt;Hierarki aktor&lt;/b&gt; (§4.2): turunan mewarisi use case &lt;i&gt;Petugas Praktikum&lt;/i&gt;" style="rounded=1;arcSize=4;dashed=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=none;strokeColor=#6C8EBF;wadah=1;" vertex="1" parent="1"><mxGeometry x="1290" y="520" width="330" height="300" as="geometry"/></mxCell><mxCell id="prk-uc2-ptg2" value="Petugas Praktikum" style="shape=umlActor;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;html=1;outlineConnect=0;fontSize=12;fontStyle=3;fillColor=#EEF6FF;" vertex="1" parent="1"><mxGeometry x="1440" y="580" width="30" height="60" as="geometry"/></mxCell><mxCell id="prk-uc2-asi2" value="Asisten" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1320" y="720" width="30" height="60" as="geometry"/></mxCell><mxCell id="prk-uc2-dos2" value="Dosen" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1440" y="720" width="30" height="60" as="geometry"/></mxCell><mxCell id="prk-uc2-lab2" value="Laboran" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1560" y="720" width="30" height="60" as="geometry"/></mxCell><mxCell id="prk-uc2-g-asi2-ptg2" value="" style="endArrow=block;endFill=0;endSize=14;html=1;strokeColor=#333333;exitX=0.5;exitY=0;entryX=0.1;entryY=1;" edge="1" parent="1" source="prk-uc2-asi2" target="prk-uc2-ptg2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc2-g-dos2-ptg2" value="" style="endArrow=block;endFill=0;endSize=14;html=1;strokeColor=#333333;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="prk-uc2-dos2" target="prk-uc2-ptg2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc2-g-lab2-ptg2" value="" style="endArrow=block;endFill=0;endSize=14;html=1;strokeColor=#333333;exitX=0.5;exitY=0;entryX=0.9;entryY=1;" edge="1" parent="1" source="prk-uc2-lab2" target="prk-uc2-ptg2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prk-uc2-n0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §4.2–4.3)&lt;br&gt;• Aktor miring biru = &lt;b&gt;aktor abstrak&lt;/b&gt;; panah segitiga kosong = generalisasi (turunan mewarisi use case induk)&lt;br&gt;• «CRUDL» = kelola data (buat, lihat, ubah, hapus, daftar) dengan satu pola; «report» = hanya membaca&lt;br&gt;• Tanpa «include»/«extend»: setiap use case satu sesi dan berdiri sendiri (§4.3.1, §4.5)&lt;br&gt;• Tidak ada aktor «system» Penjadwal: status yang bergantung waktu dihitung, tidak dijadwalkan" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="600" height="120" as="geometry"/></mxCell><mxCell id="prk-uc2-n1" value="&lt;b&gt;Cara baca&lt;/b&gt;&lt;br&gt;• UC-PRK-13 dalam satu sesi kerja: isi jurnal, presensi petugas (merujuk &lt;code&gt;hr.employee&lt;/code&gt;), &lt;i&gt;log book&lt;/i&gt;, lalu kirim; sistem memvalidasi, mengubah Sesi menjadi &lt;i&gt;terlaksana&lt;/i&gt;, dan menandai petugas yang tidak sesuai penugasan SDM.&lt;br&gt;• Pengisi jurnal kelas tanpa asisten = dosen yang mengajar &lt;b&gt;[ASUMSI]&lt;/b&gt;.&lt;br&gt;• UC-PRK-11 dilakukan sebelum jam mulai; keputusan &lt;i&gt;tunda&lt;/i&gt; dilanjutkan dengan UC-PRK-14 (sesi lain, tidak di-«include»).&lt;br&gt;• UC-PRK-15 membangkitkan sesi pengganti bila disetujui dengan pengganti." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="660" y="650" width="600" height="160" as="geometry"/></mxCell><mxCell id="prk-uc2-n2" value="Diturunkan dari activity A1–A5 dan state machine S1–S3 (proses-bisnis-praktikum.md), kebutuhan KF-PRK-01–51. Rincian: use-case-praktikum.md · Draf 16 Nov 2026 · Herrens" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="1220" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="prk-uc3" name="UC TO-BE (3-3) - Penilaian, Kepuasan, dan Status Monev"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="940" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="prk-uc3-title" value="Use case TO-BE 3/3 · Penilaian (PKG-19), Kepuasan Pengguna (PKG-20), dan Status Monev" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1200" height="36" as="geometry"/></mxCell><mxCell id="prk-uc3-sys" value="Sistem LabFIK Compliance · Modul Pelaksanaan Praktikum" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=8;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="380" y="60" width="880" height="620" as="geometry"/></mxCell><mxCell id="prk-uc3-p1" value="Penilaian Individual (PKG-19)" style="shape=folder;tabWidth=270;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#EEF6FF;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="410" y="100" width="380" height="180" as="geometry"/></mxCell><mxCell id="prk-uc3-uc17" value="&lt;b&gt;UC-PRK-17&lt;/b&gt;&lt;br&gt;Catat Penilaian Kelas" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="134" width="250" height="58" as="geometry"/></mxCell><mxCell id="prk-uc3-uc18" value="&lt;b&gt;UC-PRK-18&lt;/b&gt;&lt;br&gt;Impor Nilai Kelas" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;str
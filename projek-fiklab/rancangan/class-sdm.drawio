.5;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sdm-dcd4-eve" target="sdm-dcd4-bk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-dcd4-mon" value="«AbstractModel»&lt;br&gt;&lt;b&gt;&lt;i&gt;labfik.sdm.monev&lt;/i&gt;&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;swimlaneFillColor=#FFFFFF;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="1000" y="40" width="360" height="169" as="geometry"/></mxCell><mxCell id="sdm-dcd4-mon-a" value="&lt;i&gt;(layanan tanpa tabel; Status Monev SDM [R])&lt;/i&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Times New Roman;" vertex="1" parent="sdm-dcd4-mon"><mxGeometry x="0" y="40" width="360" height="23" as="geometry"/></mxCell><mxCell id="sdm-dcd4-mon-s" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;html=1;" vertex="1" parent="sdm-dcd4-mon"><mxGeometry x="0" y="63" width="360" height="8" as="geometry"/></mxCell><mxCell id="sdm-dcd4-mon-m" value="+ get_status(periode, tanggal_acuan): dict&lt;br&gt;@model + status_sesi(periode): list (AB-SDM-26)&lt;br&gt;@model + status_pasangan(tanggal): list (AB-SDM-27)&lt;br&gt;@model # hitung_skor(persentase): int&lt;br&gt;+ get_unit(unit, tanggal_acuan): dict&lt;br&gt;+ action_laporan_bukti(): report" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Times New Roman;" vertex="1" parent="sdm-dcd4-mon"><mxGeometry x="0" y="71" width="360" height="98" as="geometry"/></mxCell><mxCell id="sdm-dcd4-d-mon-rp" value="get_kriteria() (AB-SDM-28)" style="endArrow=open;endFill=0;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;dashed=1;fontSize=10;fontFamily=Times New Roman;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=1;entryY=0.15;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sdm-dcd4-mon" target="sdm-dcd4-rp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="960" y="160"/><mxPoint x="960" y="20"/><mxPoint x="470" y="20"/><mxPoint x="470" y="62"/></Array></mxGeometry></mxCell><mxCell id="sdm-dcd4-ses" value="«Core»&lt;br&gt;&lt;b&gt;labfik.sesi&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Sesi [T]&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=55;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;swimlaneFillColor=#FFFFFF;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="1000" y="330" width="220" height="93" as="geometry"/></mxCell><mxCell id="sdm-dcd4-ses-a" value="&lt;i&gt;(rincian: kontrak Core)&lt;/i&gt;&lt;br&gt;+ state = terlaksana" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Times New Roman;" vertex="1" parent="sdm-dcd4-ses"><mxGeometry x="0" y="55" width="220" height="38" as="geometry"/></mxCell><mxCell id="sdm-dcd4-d-mon-ses" value="membaca sesi terlaksana" style="endArrow=open;endFill=0;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;dashed=1;fontSize=10;fontFamily=Times New Roman;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sdm-dcd4-mon" target="sdm-dcd4-ses"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="sdm-dcd-notes" name="Catatan DCD TO-BE (bahan kerja)"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1380" pageHeight="972" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sdm-dcd-notes-title" value="Catatan design class diagram modul SDM (bahan kerja, tidak disisipkan ke naskah)" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1300" height="34" as="geometry"/></mxCell><mxCell id="sdm-dcd-notes-legend" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §13.6; UML)&lt;br&gt;• «AbstractModel» (nama miring) = &lt;i&gt;mixin&lt;/i&gt; tanpa tabel; segitiga kosong = &lt;code&gt;_inherit = [mixin, …]&lt;/code&gt;.&lt;br&gt;• «Odoo» = model bawaan; &lt;code&gt;{_inherit: …} di labfik_sdm&lt;/code&gt; = diperluas modul ini tanpa &lt;code&gt;_name&lt;/code&gt; baru. «Core» = master bersama labfik_core. Model tanpa stereotype = model baru modul SDM.&lt;br&gt;• Panah terbuka = Many2one/Many2many berarah, label = nama field. Belah ketupat hitam = One2many + Many2one (anak ikut terhapus). Putus-putus = asosiasi turunan {compute}.&lt;br&gt;• Field warisan mixin tidak ditulis ulang. &lt;code&gt;+&lt;/code&gt; publik, &lt;code&gt;#&lt;/code&gt; internal, @model, «override», {hook}." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1300" height="110" as="geometry"/></mxCell><mxCell id="sdm-dcd-notes-h0" value="&lt;b&gt;DCD 1/4 · Mixin Core yang dipakai, perluasan model Odoo, dan pewarisan model SDM&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="186" width="1300" height="24" as="geometry"/></mxCell><mxCell id="sdm-dcd-notes-n0-0" value="&lt;b&gt;Pewarisan&lt;/b&gt;&lt;br&gt;• Tiga dokumen SDM mewarisi &lt;code&gt;approval.mixin&lt;/code&gt;; Rencana Pelatihan juga &lt;code&gt;period.mixin&lt;/code&gt; (satu rencana per tahun) dan &lt;code&gt;criteria.mixin&lt;/code&gt; (K1–K4 PKG-14). Otorisasi &lt;b&gt;tidak&lt;/b&gt; memakai period.mixin (K-3).&lt;br&gt;• Delapan rekaman bukti mewarisi &lt;code&gt;evidence.mixin&lt;/code&gt;: tidak dihapus, hanya dikoreksi (AB-SDM-24).&lt;br&gt;• &lt;code&gt;hr.employee&lt;/code&gt; dan &lt;code&gt;hr.job&lt;/code&gt; diperluas dari labfik_sdm tanpa &lt;code&gt;_name&lt;/code&gt; baru; jenis dokumen wewenang ditambah lewat &lt;code&gt;selection_add&lt;/code&gt;. Core tidak diubah.&lt;br&gt;• Template Method &lt;code&gt;action_ajukan()&lt;/code&gt; / &lt;code&gt;action_sahkan()&lt;/code&gt; milik Core tidak di-&lt;i&gt;override&lt;/i&gt;; model SDM hanya mengisi &lt;i&gt;hook&lt;/i&gt; (DCD 2–4)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="216" width="1300" height="130" as="geometry"/></mxCell><mxCell id="sdm-dcd-notes-n0-1" value="Design class diagram (masuk proposal Bab II 2.3). Diturunkan dari conceptual model CM-1–4, katalog operasi SSD, dan AB-SDM-01–28. Rincian: design-class-sdm.md · Draf 19 Nov 2026 · Zahir" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="356" width="1300" height="46" as="geometry"/></mxCell><mxCell id="sdm-dcd-notes-h1" value="&lt;b&gt;DCD 2/4 · Kompetensi, seleksi, dan penugasan petugas (PKG-04)&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="422" width="1300" height="24" as="geometry"/></mxCell><mxCell id="sdm-dcd-notes-n1-0" value="&lt;b&gt;Kunci&lt;/b&gt;&lt;br&gt;• Specification class: &lt;code&gt;kompetensi&lt;/code&gt; = spesifikasi, &lt;code&gt;bukti.kompetensi&lt;/code&gt; = exemplar milik Personel; syarat jabatan merujuk spesifikasi (&lt;code&gt;hr.job.syarat_kompetensi_ids&lt;/code&gt;).&lt;br&gt;• Pengecualian seleksi (CM) dilebur menjadi field &lt;code&gt;alasan_pengecualian&lt;/code&gt; dan &lt;code&gt;penyetuju_id&lt;/code&gt; karena multiplisitasnya 0..1 (§13.6).&lt;br&gt;• Surat Tugas bergaris (K-6): disahkan sekali; baris sah bila suratnya disahkan dan tanggal di rentangnya.&lt;br&gt;• Orientasi tidak bertaut ke model lain di modul ini; dibaca laporan bukti (KU-3)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="1300" height="120" as="geometry"/></mxCell><mxCell id="sdm-dcd-notes-h2" value="&lt;b&gt;DCD 3/4 · Tugas/alat berkewenangan khusus, asesmen, otorisasi, dan evaluasi ulang (PKG-10)&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="592" width="1300" height="24" as="geometry"/></mxCell><mxCell id="sdm-dcd-notes-n2-0" value="&lt;b&gt;Kunci&lt;/b&gt;&lt;br&gt;• &lt;code&gt;tugas.khusus.pelaksana_ids&lt;/code&gt; = penyebut PKG-10 (KB-1). Otorisasi berlaku dihitung dari interval sendiri (&lt;code&gt;is_berlaku&lt;/code&gt;), bukan period.mixin (K-3).&lt;br&gt;• &lt;code&gt;_dokumen_diganti()&lt;/code&gt; mengembalikan otorisasi Disahkan lain untuk pasangan (employee, tugas_khusus) yang sama, sehingga Template Method Core mengubahnya menjadi Diganti (AB-SDM-10).&lt;br&gt;• Keputusan evaluasi (konsep kejadian 0..1 di CM) dilebur menjadi field; &lt;code&gt;status&lt;/code&gt; dihitung dari ada-tidaknya keputusan." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="622" width="1300" height="120" as="geometry"/></mxCell><mxCell id="sdm-dcd-notes-h3" value="&lt;b&gt;DCD 4/4 · Rencana, realisasi, evaluasi pelatihan (PKG-14) dan layanan status monev&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="762" width="1300" height="24" as="geometry"/></mxCell><mxCell id="sdm-dcd-notes-n3-0" value="&lt;b&gt;Kunci&lt;/b&gt;&lt;br&gt;• Template Method Core: &lt;code&gt;_sebelum_ajukan()&lt;/code&gt; membekukan kebutuhan (AB-SDM-04); &lt;code&gt;_sebelum_disahkan()&lt;/code&gt; menolak rencana kedua untuk periode yang sama (AB-SDM-12).&lt;br&gt;• &lt;code&gt;criteria.mixin.get_kriteria()&lt;/code&gt; memanggil &lt;code&gt;_cek_k1()–_cek_k4()&lt;/code&gt; berurutan; berhenti di kriteria pertama yang gagal.&lt;br&gt;• &lt;code&gt;labfik.sdm.monev&lt;/code&gt; mendelegasikan perhitungan: PKG-04 ke &lt;code&gt;penugasan.berlaku_pada()&lt;/code&gt; dan &lt;code&gt;hr.employee.memenuhi_syarat_jabatan()&lt;/code&gt;, PKG-10 ke &lt;code&gt;otorisasi.berlaku_pada()&lt;/code&gt;, PKG-14 ke &lt;code&gt;get_kriteria()&lt;/code&gt;. Tidak menyimpan data.&lt;br&gt;• PembatalanItem (CM) dilebur menjadi &lt;code&gt;alasan_batal&lt;/code&gt; + status &lt;i&gt;batal&lt;/i&gt;." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="792" width="1300" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
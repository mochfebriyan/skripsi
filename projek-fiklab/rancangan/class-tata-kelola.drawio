      <mxCell id="tk-dcd4-v-pln" value="«form»&lt;br&gt;&lt;b&gt;plan_view_form&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;Form Rencana → labfik.plan&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=55;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;swimlaneFillColor=#FFFFFF;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="320" height="244" as="geometry"/></mxCell><mxCell id="tk-dcd4-v-pln-a" value="header: state (statusbar), kriteria_tertinggi&lt;br&gt;isi: jenis, judul, periode_id, penyusun_id&lt;br&gt;tab Temuan Gap: gap_ids (bila jenis = pengembangan)&lt;br&gt;tab Item Rencana: line_ids&lt;br&gt;tab Narasi: narasi (O) · tab Riwayat: log_ids" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Times New Roman;" vertex="1" parent="tk-dcd4-v-pln"><mxGeometry y="55" width="320" height="83" as="geometry"/></mxCell><mxCell id="tk-dcd4-v-pln-s" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;html=1;" vertex="1" parent="tk-dcd4-v-pln"><mxGeometry y="138" width="320" height="8" as="geometry"/></mxCell><mxCell id="tk-dcd4-v-pln-m" value="+ [Ajukan] → action_ajukan()&lt;br&gt;+ [Terbitkan] → action_terbitkan()&lt;br&gt;+ [Unggah TTD] → action_unggah_ttd(berkas)&lt;br&gt;+ [Kembalikan | Sahkan] → action_*() {groups: labfik_kalab}&lt;br&gt;+ [Buat Revisi] → action_buat_revisi() (O)&lt;br&gt;+ [Tinjauan] → daftar tinjauan rencana ini (UC-26)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Times New Roman;" vertex="1" parent="tk-dcd4-v-pln"><mxGeometry y="146" width="320" height="98" as="geometry"/></mxCell><mxCell id="tk-dcd4-v-cal" value="«calendar»&lt;br&gt;&lt;b&gt;plan_line_view_calendar&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;Kalender Item Rencana → labfik.plan.line&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=55;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;swimlaneFillColor=#FFFFFF;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="400" y="680" width="340" height="169" as="geometry"/></mxCell><mxCell id="tk-dcd4-v-cal-a" value="date_start: jadwal_mulai · date_stop: jadwal_selesai&lt;br&gt;color: pic_id · mode: month · quick_create: False&lt;br&gt;tampil: kegiatan, plan_id, target, satuan&lt;br&gt;filter: Item saya (pic_id.user_id = uid),&lt;br&gt;      rencana disahkan" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Times New Roman;" vertex="1" parent="tk-dcd4-v-cal"><mxGeometry y="55" width="340" height="83" as="geometry"/></mxCell><mxCell id="tk-dcd4-v-cal-s" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;html=1;" vertex="1" parent="tk-dcd4-v-cal"><mxGeometry y="138" width="340" height="8" as="geometry"/></mxCell><mxCell id="tk-dcd4-v-cal-m" value="+ klik kegiatan → form Item, [Isi Realisasi] (UC-25)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Times New Roman;" vertex="1" parent="tk-dcd4-v-cal"><mxGeometry y="146" width="340" height="23" as="geometry"/></mxCell><mxCell id="tk-dcd4-v-piv" value="«pivot»&lt;br&gt;&lt;b&gt;realisasi_view_pivot&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;Pivot Realisasi → labfik.realisasi (UC-27)&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=55;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;swimlaneFillColor=#FFFFFF;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="800" y="680" width="320" height="154" as="geometry"/></mxCell><mxCell id="tk-dcd4-v-piv-a" value="row: line_id · col: periode_lapor&lt;br&gt;measure: target (max), capaian (sum),&lt;br&gt;      biaya_terpakai (sum)&lt;br&gt;pasangan «graph»: batang target vs capaian" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Times New Roman;" vertex="1" parent="tk-dcd4-v-piv"><mxGeometry y="55" width="320" height="68" as="geometry"/></mxCell><mxCell id="tk-dcd4-v-piv-s" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;html=1;" vertex="1" parent="tk-dcd4-v-piv"><mxGeometry y="123" width="320" height="8" as="geometry"/></mxCell><mxCell id="tk-dcd4-v-piv-m" value="+ klik sel → daftar realisasi (drill-down)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Times New Roman;" vertex="1" parent="tk-dcd4-v-piv"><mxGeometry y="131" width="320" height="23" as="geometry"/></mxCell><mxCell id="tk-dcd4-v-pln-e" value="«view»" style="endArrow=open;endFill=0;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;dashed=1;fontSize=10;fontFamily=Times New Roman;exitX=1;exitY=0.12;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tk-dcd4-v-pln" target="tk-dcd4-pln"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="370" y="709"/><mxPoint x="370" y="242"/></Array></mxGeometry></mxCell><mxCell id="tk-dcd4-v-cal-e" value="«view»" style="endArrow=open;endFill=0;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;dashed=1;fontSize=10;fontFamily=Times New Roman;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tk-dcd4-v-cal" target="tk-dcd4-lin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-dcd4-v-piv-e" value="«view»" style="endArrow=open;endFill=0;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;dashed=1;fontSize=10;fontFamily=Times New Roman;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tk-dcd4-v-piv" target="tk-dcd4-rea"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root>
    </mxGraphModel>
  </diagram>
  <diagram id="tk-dcd-notes" name="Catatan DCD TO-BE (bahan kerja)">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1380" pageHeight="1546" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="tk-dcd-notes-title" value="Catatan design class diagram (bahan kerja, tidak disisipkan ke naskah)" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1300" height="34" as="geometry" />
        </mxCell>
        <mxCell id="tk-dcd-notes-legend" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §13.6; UML)&lt;br&gt;• «AbstractModel» (nama miring) = &lt;i&gt;mixin&lt;/i&gt; tanpa tabel; segitiga kosong = &lt;code&gt;_inherit = [mixin, …]&lt;/code&gt;.&lt;br&gt;• «Odoo» = model bawaan; bila diberi &lt;code&gt;{_inherit: …}&lt;/code&gt;, model itu diperluas tanpa &lt;code&gt;_name&lt;/code&gt; baru. «Core» = master bersama di labfik_core. Model tanpa stereotype = model baru modul ini. Semua kotak polos hitam-putih.&lt;br&gt;• Panah terbuka = Many2one/Many2many berarah, label = nama field. Belah ketupat hitam = One2many + Many2one (anak ikut terhapus). Belah ketupat putih = agregasi: Many2many, atau Many2one tanpa &lt;code&gt;cascade&lt;/code&gt; (bagian tetap ada bila keseluruhan dihapus). Putus-putus = field &lt;code&gt;compute&lt;/code&gt;.&lt;br&gt;• Atribut bertipe hanya untuk model bawaan Odoo (hr.employee, res.users, res.currency, ir.attachment). Field warisan mixin tidak ditulis ulang.&lt;br&gt;• &lt;code&gt;+&lt;/code&gt; publik (&lt;code&gt;action_*&lt;/code&gt;, &lt;code&gt;get_*&lt;/code&gt;), &lt;code&gt;#&lt;/code&gt; internal (&lt;code&gt;_…&lt;/code&gt;), @model, «override», {abstract}, {hook}." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1300" height="146" as="geometry" />
        </mxCell>
        <mxCell id="tk-dcd-notes-h0" value="&lt;b&gt;DCD 1/4 · Mixin bersama (labfik_core) dan mekanisme pengesahan&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="206" width="1300" height="24" as="geometry" />
        </mxCell>
        <mxCell id="tk-dcd-notes-n0-0" value="&lt;b&gt;Template Method&lt;/b&gt; &lt;code&gt;action_sahkan(pengesah, tanggal_sah)&lt;/code&gt; — urutan tetap di mixin, tidak di-&lt;i&gt;override&lt;/i&gt;:&lt;br&gt;1. state harus &lt;i&gt;diajukan&lt;/i&gt; · 2. berkas_ttd ada (AB-04) · 3. &lt;code&gt;_cek_wewenang(pengesah)&lt;/code&gt; (AB-05) · 4. &lt;code&gt;_sebelum_disahkan()&lt;/code&gt; {hook} · 5. tulis pengesah, pencatat = pengguna, tanggal_sah, state = disahkan · 6. &lt;code&gt;_dokumen_diganti()&lt;/code&gt; {hook} → state = diganti + log (AB-08) · 7. log &lt;i&gt;disahkan&lt;/i&gt; (AB-09) · 8. &lt;code&gt;_setelah_disahkan()&lt;/code&gt; {hook}.&lt;br&gt;Model turunan hanya mengisi &lt;i&gt;hook&lt;/i&gt;. Hanya grup KaLab yang boleh memanggilnya (AB-06). &lt;code&gt;action_ajukan()&lt;/code&gt; berpola sama: cek draf → &lt;code&gt;_cek_kelengkapan()&lt;/code&gt; → &lt;code&gt;_sebelum_ajukan()&lt;/code&gt; → ubah status." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="40" y="236" width="1300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="tk-dcd-notes-n0-1" value="&lt;b&gt;Dari CM ke desain&lt;/b&gt; (§13.6)&lt;br&gt;• DokumenDisahkan → &lt;code&gt;approval.mixin&lt;/code&gt;; Pengesahan (0..1) → field readonly di mixin; KejadianPengesahan → &lt;code&gt;approval.log&lt;/code&gt; generik (res_model, res_id) untuk semua dokumen.&lt;br&gt;• RekamanBukti → &lt;code&gt;evidence.mixin&lt;/code&gt;. Periode → &lt;code&gt;period.mixin&lt;/code&gt;. /kriteria_tertinggi → &lt;code&gt;criteria.mixin&lt;/code&gt;.&lt;br&gt;• &lt;code&gt;revisi_dari_id&lt;/code&gt; ditulis di tiap model (Many2one ke model itu sendiri) karena mixin tidak bisa merujuk dirinya.&lt;br&gt;• &lt;code&gt;labfik.controlled.mixin&lt;/code&gt; tidak dipakai (lihat dokumen)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="40" y="396" width="1300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="tk-dcd-notes-n0-2" value="Design class diagram (masuk proposal Bab II 2.3). Diturunkan dari conceptual model CM-1–4, katalog operasi SSD, dan AB-01–25. Rincian: design-class-tata-kelola.md · Draf 14 Nov 2026 · Febriyan" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="40" y="556" width="1300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tk-dcd-notes-h1" value="&lt;b&gt;DCD 2/4 · Struktur organisasi (PKG-03)&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="626" width="1300" height="24" as="geometry" />
        </mxCell>
        <mxCell id="tk-dcd-notes-n1-0" value="&lt;b&gt;Kunci&lt;/b&gt;&lt;br&gt;• Personel dan Jabatan &lt;b&gt;memperluas&lt;/b&gt; model bawaan &lt;code&gt;hr&lt;/code&gt; (is-a), sedangkan Tugas dan Wewenang adalah &lt;b&gt;model anak baru&lt;/b&gt; (has-a) (keputusan 14 Nov 2026).&lt;br&gt;• AB-05: &lt;code&gt;approval.mixin._cek_wewenang(pengesah)&lt;/code&gt; memanggil &lt;code&gt;pengesah.job_id.punya_wewenang(&#39;mengesahkan&#39;, self._jenis_dokumen())&lt;/code&gt; (delegasi, §13.5). Matriks kewenangan (UC-13) dibaca dari &lt;code&gt;wewenang_ids&lt;/code&gt;.&lt;br&gt;• Pejabat fakultas = hr.employee tanpa &lt;code&gt;user_id&lt;/code&gt;; jabatannya &lt;code&gt;is_eksternal&lt;/code&gt;." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="40" y="656" width="1300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="tk-dcd-notes-n1-1" value="Design class diagram (masuk proposal Bab II 2.3). Diturunkan dari conceptual model CM-1–4, katalog operasi SSD, dan AB-01–25. Rincian: design-class-tata-kelola.md · Draf 14 Nov 2026 · Febriyan" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="40" y="816" width="1300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tk-dcd-notes-h2" value="&lt;b&gt;DCD 3/4 · Pengendalian dokumen SOP/IK (PKG-02)&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="886" width="1300" height="24" as="geometry" />
        </mxCell>
        <mxCell id="tk-dcd-notes-n2-0" value="&lt;b&gt;Kunci&lt;/b&gt;&lt;br&gt;• AB-13 &lt;code&gt;_sql_constraints&lt;/code&gt;; AB-12 (O) di hook &lt;code&gt;_sebelum_ajukan()&lt;/code&gt;; AB-14 &lt;code&gt;_compute_tanggal_tinjau()&lt;/code&gt; dari tanggal_sah / tinjau ulang terakhir + siklus.&lt;br&gt;• AB-15, AB-16 &lt;code&gt;@api.constrains&lt;/code&gt; di Distribusi, Sosialisasi, Tinjau Ulang. AB-17 (O) &lt;i&gt;record rule&lt;/i&gt; grup Pengguna Lab: &lt;code&gt;state = &#39;disahkan&#39;&lt;/code&gt;.&lt;br&gt;• AB-24 &lt;code&gt;cek_monev()&lt;/code&gt; per dokumen + &lt;code&gt;hitung_persentase()&lt;/code&gt;." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="40" y="916" width="1300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="tk-dcd-notes-n2-1" value="Design class diagram (masuk proposal Bab II 2.3). Diturunkan dari conceptual model CM-1–4, katalog operasi SSD, dan AB-01–25. Rincian: design-class-tata-kelola.md · Draf 14 Nov 2026 · Febriyan" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="40" y="1076" width="1300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tk-dcd-notes-h3" value="&lt;b&gt;DCD 4/4 · Renstra, rencana (PKG-01, PKG-13), dan status monev&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="1146" width="1300" height="24" as="geometry" />
        </mxCell>
        <mxCell id="tk-dcd-notes-n3-0" value="&lt;b&gt;Kunci&lt;/b&gt;&lt;br&gt;• Satu model &lt;code&gt;labfik.plan&lt;/code&gt; untuk rencana tahunan dan pengembangan: &lt;code&gt;_jenis_dokumen()&lt;/code&gt;, &lt;code&gt;_cek_kelengkapan()&lt;/code&gt; (AB-02), dan &lt;code&gt;_cek_k1()–_cek_k4()&lt;/code&gt; (AB-25) bercabang menurut &lt;code&gt;jenis&lt;/code&gt;.&lt;br&gt;• &lt;code&gt;labfik.org.monev.get_status()&lt;/code&gt; mendelegasikan perhitungan ke &lt;code&gt;labfik.document.hitung_persentase()&lt;/code&gt; (AB-24) dan ke &lt;code&gt;get_kriteria()&lt;/code&gt; di Rencana dan SK (AB-25). Tidak menyimpan data.&lt;br&gt;• Biaya rencana pengembangan = &lt;code&gt;anggaran&lt;/code&gt;." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="40" y="1176" width="1300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="tk-dcd-notes-n3-1" value="Design class diagram (masuk proposal Bab II 2.3). Diturunkan dari conceptual model CM-1–4, katalog operasi SSD, dan AB-01–25. Rincian: design-class-tata-kelola.md · Draf 14 Nov 2026 · Febriyan" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="40" y="1336" width="1300" height="50" as="geometry" />
        </mxCell>
      <mxCell id="tk-dcd-notes-view" value="&lt;b&gt;Kelas view (lapisan antarmuka, Wazlawick §16.3; arahan Pak Widi 19 Nov 2026)&lt;/b&gt;&lt;br&gt;• Stereotype = jenis view Odoo: «form», «kanban», «calendar», «pivot», «hierarchy». Nama = XML ID view (ir.ui.view); baris kedua = model utama.&lt;br&gt;• Atribut = field yang tampil, dikelompokkan per bagian layar, plus atribut arsitektur view (default_group_by, date_start, row/col/measure). Operasi = tombol, masing-masing memanggil method action_* model (UC → tombol → method → AB).&lt;br&gt;• Garis putus-putus «view» = dependensi view ke model utamanya. Model lain ikut tampil lewat field relasi (mis. line_ids), tanpa garis tambahan.&lt;br&gt;• Hanya view inti yang digambar. Semua model ber-menu juga punya list + form standar; matriks lengkap di design-class-tata-kelola.md bagian 11. Gantt tidak dipakai (hanya Odoo Enterprise); jadwal kegiatan memakai «calendar». Diverifikasi di image odoo:17 (20 Nov 2026)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="1396" width="1300" height="110" as="geometry"/></mxCell></root>
    </mxGraphModel>
  </diagram>
</mxfile>

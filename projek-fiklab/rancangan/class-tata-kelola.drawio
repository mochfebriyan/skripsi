360" height="23" as="geometry"/></mxCell><mxCell id="tk-dcd3-v-frm" value="«form»&lt;br&gt;&lt;b&gt;document_version_view_form&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;Form Versi SOP/IK → labfik.document.version&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=55;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;swimlaneFillColor=#FFFFFF;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="480" y="430" width="400" height="289" as="geometry"/></mxCell><mxCell id="tk-dcd3-v-frm-a" value="header: state (statusbar)&lt;br&gt;isi: document_id, revisi, berkas, tanggal_efektif,&lt;br&gt;      bagian_diubah, ringkasan_perubahan, alasan_revisi&lt;br&gt;pengesahan: penyusun_id, tanggal_ajukan, berkas_ttd,&lt;br&gt;      pengesah_id, tanggal_sah (readonly)&lt;br&gt;tinjau: tanggal_tinjau_berikutnya, perlu_ditinjau&lt;br&gt;tab Riwayat: log_ids · chatter: message_ids" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Times New Roman;" vertex="1" parent="tk-dcd3-v-frm"><mxGeometry y="55" width="400" height="113" as="geometry"/></mxCell><mxCell id="tk-dcd3-v-frm-s" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;html=1;" vertex="1" parent="tk-dcd3-v-frm"><mxGeometry y="168" width="400" height="8" as="geometry"/></mxCell><mxCell id="tk-dcd3-v-frm-m" value="+ [Ajukan] → action_ajukan() (UC-01)&lt;br&gt;+ [Terbitkan] → action_terbitkan() (UC-02)&lt;br&gt;+ [Unggah TTD] → action_unggah_ttd(berkas) (UC-03)&lt;br&gt;+ [Kembalikan] → action_kembalikan(alasan) {groups: labfik_kalab}&lt;br&gt;+ [Sahkan] → action_sahkan(pengesah, tanggal_sah) {groups: labfik_kalab}&lt;br&gt;+ [Cabut] → action_cabut(alasan) {groups: labfik_kalab}&lt;br&gt;+ [Distribusi | Sosialisasi | Tinjau Ulang] → daftar rekaman versi ini (UC-16–18)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Times New Roman;" vertex="1" parent="tk-dcd3-v-frm"><mxGeometry y="176" width="400" height="113" as="geometry"/></mxCell><mxCell id="tk-dcd3-v-kan-e" value="«view»" style="endArrow=open;endFill=0;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;dashed=1;fontSize=10;fontFamily=Times New Roman;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tk-dcd3-v-kan" target="tk-dcd3-ver"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="621"/><mxPoint x="440" y="331"/></Array></mxGeometry></mxCell><mxCell id="tk-dcd3-v-frm-e" value="«view»" style="endArrow=open;endFill=0;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;dashed=1;fontSize=10;fontFamily=Times New Roman;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tk-dcd3-v-frm" target="tk-dcd3-ver"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root>

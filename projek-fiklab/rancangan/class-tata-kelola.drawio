try></mxCell><mxCell id="tk-dcd2-n-asl-rng-l1" value="ruang_ids *" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="tk-dcd2-n-asl-rng"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-dcd2-n-asg-self" value="" style="endArrow=open;endFill=0;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#555555;fontSize=10;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=1;entryY=0.1;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tk-dcd2-asg" target="tk-dcd2-asg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-dcd2-n-asg-self-l0" value="pengganti 0..1" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="tk-dcd2-n-asg-self"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-dcd2-n-asg-self-l1" value="revisi_dari_id 0..1" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="tk-dcd2-n-asg-self"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-dcd2-n-oev-asg" value="" style="endArrow=open;endFill=0;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#555555;fontSize=10;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tk-dcd2-oev" target="tk-dcd2-asg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-dcd2-n-oev-asg-l0" value="*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="tk-dcd2-n-oev-asg"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-dcd2-n-oev-asg-l1" value="sk_id 1" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="tk-dcd2-n-oev-asg"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-dcd2-n-oev-asg2" value="" style="endArrow=open;endFill=0;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#555555;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.85;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tk-dcd2-oev" target="tk-dcd2-asg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-dcd2-n-oev-asg2-l0" value="0..1" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="tk-dcd2-n-oev-asg2"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-dcd2-n-oev-asg2-l1" value="sk_revisi_id 0..1" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="tk-dcd2-n-oev-asg2"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-dcd2-n-oev-job" value="" style="endArrow=open;endFill=0;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#555555;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tk-dcd2-oev" target="tk-dcd2-job"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-dcd2-n-oev-job-l0" value="*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="tk-dcd2-n-oev-job"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-dcd2-n-oev-job-l1" value="jabatan_direvisi_ids *" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="tk-dcd2-n-oev-job"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-dcd2-n0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §13.6; UML)&lt;br&gt;• Ungu «AbstractModel» (nama miring) = &lt;i&gt;mixin&lt;/i&gt; tanpa tabel; segitiga kosong ungu = &lt;code&gt;_inherit = [mixin, …]&lt;/code&gt;.&lt;br&gt;• «Odoo» abu-abu = model bawaan; bila diberi &lt;code&gt;{_inherit: …}&lt;/code&gt;, model itu diperluas tanpa &lt;code&gt;_name&lt;/code&gt; baru. «Core» abu-abu putus-putus = master bersama di labfik_core. Tepi merah = model hasil desain yang tidak ada padanannya 1:1 di CM.&lt;br&gt;• Panah terbuka = Many2one/Many2many berarah, label = nama field. Belah ketupat hitam = One2many + Many2one (anak ikut terhapus). Putus-putus = field &lt;code&gt;compute&lt;/code&gt;.&lt;br&gt;• Atribut bertipe hanya untuk model bawaan Odoo (hr.employee, res.users, res.currency, ir.attachment). Field warisan mixin tidak ditulis ulang.&lt;br&gt;• &lt;code&gt;+&lt;/code&gt; publik (&lt;code&gt;action_*&lt;/code&gt;, &lt;code&gt;get_*&lt;/code&gt;), &lt;code&gt;#&lt;/code&gt; internal (&lt;code&gt;_…&lt;/code&gt;), @model, «override», {abstract}, {hook}." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="694" width="760" height="150" as="geometry"/></mxCell><mxCell id="tk-dcd2-n1" value="&lt;b&gt;Kunci&lt;/b&gt;&lt;br&gt;• Personel dan Jabatan &lt;b&gt;memperluas&lt;/b&gt; model bawaan &lt;code&gt;hr&lt;/code&gt; (is-a), sedangkan Tugas dan Wewenang adalah &lt;b&gt;model anak baru&lt;/b&gt; (has-a) (keputusan 14 Nov 2026).&lt;br&gt;• AB-05: &lt;code&gt;approval.mixin._cek_wewenang(pengesah)&lt;/code&gt; memanggil &lt;code&gt;pengesah.job_id.punya_wewenang('mengesahkan', self._jenis_dokumen())&lt;/code&gt; (delegasi, §13.5). Matriks kewenangan (UC-13) dibaca dari &lt;code&gt;wewenang_ids&lt;/code&gt;.&lt;br&gt;• Pejabat fakultas = hr.employee tanpa &lt;code&gt;user_id&lt;/code&gt;; jabatannya &lt;code&gt;is_eksternal&lt;/code&gt;." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="820" y="694" width="640" height="150" as="geometry"/></mxCell><mxCell id="tk-dcd2-n2" value="Design class diagram (masuk proposal Bab II 2.3). Diturunkan dari conceptual model CM-1–4, katalog operasi SSD, dan AB-01–25. Rincian: design-class-tata-kelola.md · Draf 14 Nov 2026 · Febriyan" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="864" width="1420" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="tk-dcd3" name="DCD TO-BE (3-4) - Pengendalian Dokumen"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="845" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tk-dcd3-title" value="DCD 3/4 · Pengendalian dokumen SOP/IK (PKG-02)" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1700" height="34" as="geometry"/></mxCell><mxCell id="tk-dcd3-doc" value="&lt;b&gt;labfik.document&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Dokumen Induk [M]&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#6C4A87'&gt;{inherit: mail.thread}&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=55;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="360" height="319" as="geometry"/></mxCell><mxCell id="tk-dcd3-doc-a" value="+ kode: Char «unique»&lt;br&gt;+ judul: Char&lt;br&gt;+ jenis: Selection {sop, ik, formulir, eksternal}&lt;br&gt;+ kategori: Selection&lt;br&gt;+ asal: Selection {lab, fakultas, universitas}&lt;br&gt;+ is_wajib: Boolean&lt;br&gt;+ dasar_kebutuhan: Text&lt;br&gt;+ tanggal_ditetapkan_wajib: Date&lt;br&gt;+ siklus_tinjau_bulan: Integer&lt;br&gt;+ active: Boolean = True&lt;br&gt;+ memenuhi: Boolean {compute}" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="tk-dcd3-doc"><mxGeometry x="0" y="55" width="360" height="173" as="geometry"/></mxCell><mxCell id="tk-dcd3-doc-s" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;html=1;" vertex="1" parent="tk-dcd3-doc"><mxGeometry x="0" y="228" width="360" height="8" as="geometry"/></mxCell><mxCell id="tk-dcd3-doc-m" value="+ get_info_versi(): dict&lt;br&gt;+ cek_monev(tanggal_tutup): dict (S1–S5)&lt;br&gt;@model + hitung_persentase(tanggal_tutup): dict&lt;br&gt;# _compute_versi_berlaku()&lt;br&gt;+ unlink() «override» (AB-23)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="tk-dcd3-doc"><mxGeometry x="0" y="236" width="360" height="83" as="geometry"/></mxCell><mxCell id="tk-dcd3-rng" value="«Core»&lt;br&gt;&lt;b&gt;labfik.ruang&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Ruang Lab [M]&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=55;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="425" width="220" height="108" as="geometry"/></mxCell><mxCell id="tk-dcd3-rng-a" value="+ kode: Char&lt;br&gt;+ name: Char&lt;br&gt;+ kapasitas: Integer" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="tk-dcd3-rng"><mxGeometry x="0" y="55" width="220" height="53" as="geometry"/></mxCell><mxCell id="tk-dcd3-ver" value="&lt;b&gt;labfik.document.version&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Versi Dokumen SOP/IK [T]&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#6C4A87'&gt;{inherit: approval, mail.thread}&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=55;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="480" y="60" width="380" height="319" as="geometry"/></mxCell><mxCell id="tk-dcd3-ver-a" value="+ revisi: Char&lt;br&gt;+ berkas: Binary&lt;br&gt;+ tanggal_efektif: Date&lt;br&gt;+ bagian_diubah: Text [0..1]&lt;br&gt;+ ringkasan_perubahan: Text [0..1]&lt;br&gt;+ alasan_revisi: Text [0..1]&lt;br&gt;+ tanggal_tinjau_berikutnya: Date {compute, store}&lt;br&gt;+ pe
labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="tk-dcd2-c-vs"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-dcd2-c-vr" value="" style="endArrow=none;startArrow=diamondThin;startFill=1;startSize=16;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tk-dcd2-ver" target="tk-dcd2-rev"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-dcd2-c-vr-l0" value="1" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="tk-dcd2-c-vr"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-dcd2-c-vr-l1" value="review_ids *" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="tk-dcd2-c-vr"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-dcd2-n-dsr" value="" style="endArrow=open;endFill=0;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tk-dcd2-dis" target="tk-dcd2-rng"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-dcd2-n-dsr-l0" value="*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="tk-dcd2-n-dsr"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-dcd2-n-dsr-l1" value="lokasi_id 0..1" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="tk-dcd2-n-dsr"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-dcd2-n-sp" value="" style="endArrow=open;endFill=0;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tk-dcd2-soc" target="tk-dcd2-per"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-dcd2-n-sp-l0" value="*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="tk-dcd2-n-sp"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-dcd2-n-sp-l1" value="peserta_ids 1..*" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="tk-dcd2-n-sp"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-dcd2-n1" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §13.6; UML)&lt;br&gt;• Segitiga kosong ungu = generalisasi; di Odoo &lt;code&gt;_inherit = [mixin, …]&lt;/code&gt;. Kelas ungu «AbstractModel» tidak punya tabel sendiri.&lt;br&gt;• Panah terbuka = asosiasi &lt;b&gt;berarah&lt;/b&gt; (dapat dinavigasi dari pemilik field): Many2one atau Many2many. Label = nama field.&lt;br&gt;• Belah ketupat hitam = komposisi: One2many di induk + Many2one di anak (dua arah, anak ikut terhapus).&lt;br&gt;• Garis putus-putus = asosiasi turunan (field &lt;code&gt;compute&lt;/code&gt;). Garis polos tanpa panah = dua arah (One2many + Many2one).&lt;br&gt;• &lt;code&gt;+&lt;/code&gt; publik, &lt;code&gt;#&lt;/code&gt; internal (diawali garis bawah di Odoo). «override» = method warisan yang diisi ulang. {abstract} = wajib diisi turunan. @model = method kelas (&lt;code&gt;@api.model&lt;/code&gt;).&lt;br&gt;• Referensi ke model bawaan Odoo (res.users, ir.attachment, res.currency) ditulis sebagai atribut bertipe." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="806" width="760" height="140" as="geometry"/></mxCell><mxCell id="tk-dcd2-n2" value="&lt;b&gt;Field warisan tidak ditulis ulang&lt;/b&gt;: lihat DCD 1/3 (mis. &lt;code&gt;state&lt;/code&gt;, &lt;code&gt;pengesah_id&lt;/code&gt;, &lt;code&gt;tanggal&lt;/code&gt;, &lt;code&gt;pelapor_id&lt;/code&gt;, &lt;code&gt;bukti_ids&lt;/code&gt;).&lt;br&gt;&lt;b&gt;Aturan bisnis sebagai constraint&lt;/b&gt;: AB-04 satu versi berlaku (&lt;code&gt;_setelah_disahkan&lt;/code&gt;), AB-13 satu versi diproses (&lt;code&gt;@api.constrains&lt;/code&gt;), «unique» = &lt;code&gt;_sql_constraints&lt;/code&gt;.&lt;br&gt;&lt;b&gt;[KONFIRMASI]&lt;/b&gt; &lt;code&gt;labfik.personel&lt;/code&gt; vs &lt;code&gt;hr.employee&lt;/code&gt; vs model Rafika (kontrak kelompok)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="820" y="806" width="560" height="140" as="geometry"/></mxCell><mxCell id="tk-dcd2-n3" value="Design class diagram (masuk proposal). Diturunkan dari conceptual model (CM-1–3) + katalog operasi SSD. Rincian: rancangan/design-class-tata-kelola.md · Draf 13 Nov 2026 · Febriyan" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="966" width="1300" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="tk-dcd3" name="DCD (3-3) Perencanaan"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1018" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tk-dcd3-title" value="DCD 3/3 · Design class diagram: perencanaan (PKG-01, PKG-13)" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1700" height="34" as="geometry"/></mxCell><mxCell id="tk-dcd3-sas" value="&lt;b&gt;labfik.plan.sasaran&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Sasaran Strategis&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="240" height="93" as="geometry"/></mxCell><mxCell id="tk-dcd3-sas-a" value="+ kode: Char&lt;br&gt;+ sasaran: Text&lt;br&gt;+ target_akhir: Char" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="tk-dcd3-sas"><mxGeometry x="0" y="40" width="240" height="53" as="geometry"/></mxCell><mxCell id="tk-dcd3-prg" value="&lt;b&gt;labfik.plan.program&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Program Strategis&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="253" width="240" height="123" as="geometry"/></mxCell><mxCell id="tk-dcd3-prg-a" value="+ kode: Char&lt;br&gt;+ name: Char&lt;br&gt;+ kegiatan_utama: Text&lt;br&gt;+ luaran: Text&lt;br&gt;+ tahapan: Text" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatabl
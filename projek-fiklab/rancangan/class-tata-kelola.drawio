n-soc-ver" value="" style="endArrow=open;endFill=0;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#555555;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.45;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tk-dcd3-soc" target="tk-dcd3-ver"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-dcd3-n-soc-ver-l0" value="*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="tk-dcd3-n-soc-ver"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-dcd3-n-soc-ver-l1" value="version_id 1" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="tk-dcd3-n-soc-ver"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-dcd3-n-rev-ver" value="" style="endArrow=open;endFill=0;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#555555;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tk-dcd3-rev" target="tk-dcd3-ver"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-dcd3-n-rev-ver-l0" value="*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="tk-dcd3-n-rev-ver"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-dcd3-n-rev-ver-l1" value="version_id 1" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="tk-dcd3-n-rev-ver"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-dcd3-n0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §13.6; UML)&lt;br&gt;• Ungu «AbstractModel» (nama miring) = &lt;i&gt;mixin&lt;/i&gt; tanpa tabel; segitiga kosong ungu = &lt;code&gt;_inherit = [mixin, …]&lt;/code&gt;.&lt;br&gt;• «Odoo» abu-abu = model bawaan; bila diberi &lt;code&gt;{_inherit: …}&lt;/code&gt;, model itu diperluas tanpa &lt;code&gt;_name&lt;/code&gt; baru. «Core» abu-abu putus-putus = master bersama di labfik_core. Tepi merah = model hasil desain yang tidak ada padanannya 1:1 di CM.&lt;br&gt;• Panah terbuka = Many2one/Many2many berarah, label = nama field. Belah ketupat hitam = One2many + Many2one (anak ikut terhapus). Putus-putus = field &lt;code&gt;compute&lt;/code&gt;.&lt;br&gt;• Atribut bertipe hanya untuk model bawaan Odoo (hr.employee, res.users, res.currency, ir.attachment). Field warisan mixin tidak ditulis ulang.&lt;br&gt;• &lt;code&gt;+&lt;/code&gt; publik (&lt;code&gt;action_*&lt;/code&gt;, &lt;code&gt;get_*&lt;/code&gt;), &lt;code&gt;#&lt;/code&gt; internal (&lt;code&gt;_…&lt;/code&gt;), @model, «override», {abstract}, {hook}." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="605" width="760" height="150" as="geometry"/></mxCell><mxCell id="tk-dcd3-n1" value="&lt;b&gt;Kunci&lt;/b&gt;&lt;br&gt;• AB-13 &lt;code&gt;_sql_constraints&lt;/code&gt;; AB-12 (O) di hook &lt;code&gt;_sebelum_ajukan()&lt;/code&gt;; AB-14 &lt;code&gt;_compute_tanggal_tinjau()&lt;/code&gt; dari tanggal_sah / tinjau ulang terakhir + siklus.&lt;br&gt;• AB-15, AB-16 &lt;code&gt;@api.constrains&lt;/code&gt; di Distribusi, Sosialisasi, Tinjau Ulang. AB-17 (O) &lt;i&gt;record rule&lt;/i&gt; grup Pengguna Lab: &lt;code&gt;state = 'disahkan'&lt;/code&gt;.&lt;br&gt;• AB-24 &lt;code&gt;cek_monev()&lt;/code&gt; per dokumen + &lt;code&gt;hitung_persentase()&lt;/code&gt;." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="820" y="605" width="600" height="150" as="geometry"/></mxCell><mxCell id="tk-dcd3-n2" value="Design class diagram (masuk proposal Bab II 2.3). Diturunkan dari conceptual model CM-1–4, katalog operasi SSD, dan AB-01–25. Rincian: design-class-tata-kelola.md · Draf 14 Nov 2026 · Febriyan" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="775" width="1380" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="tk-dcd4" name="DCD TO-BE (4-4) - Rencana dan Status Monev"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tk-dcd4-title" value="DCD 4/4 · Renstra, rencana (PKG-01, PKG-13), dan status monev" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1700" height="34" as="geometry"/></mxCell><mxCell id="tk-dcd4-ren" value="&lt;b&gt;labfik.renstra&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Renstra [T]&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#6C4A87'&gt;{inherit: approval, period}&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=55;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="300" height="154" as="geometry"/></mxCell><mxCell id="tk-dcd4-ren-a" value="+ judul: Char&lt;br&gt;+ berkas: Binary" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="tk-dcd4-ren"><mxGeometry x="0" y="55" width="300" height="38" as="geometry"/></mxCell><mxCell id="tk-dcd4-ren-s" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;html=1;" vertex="1" parent="tk-dcd4-ren"><mxGeometry x="0" y="93" width="300" height="8" as="geometry"/></mxCell><mxCell id="tk-dcd4-ren-m" value="# _jenis_dokumen() «override»&lt;br&gt;# _cek_kelengkapan() «override»&lt;br&gt;# _dokumen_diganti() «override»" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="tk-dcd4-ren"><mxGeometry x="0" y="101" width="300" height="53" as="geometry"/></mxCell><mxCell id="tk-dcd4-kpi" value="&lt;b&gt;labfik.kpi&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;KPI [M]&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="300" height="214" as="geometry"/></mxCell><mxCell id="tk-dcd4-kpi-a" value="+ kode: Char «unique»&lt;br&gt;+ nama: Char&lt;br&gt;+ definisi: Text&lt;br&gt;+ rumus_pembilang: Text&lt;br&gt;+ rumus_penyebut: Text&lt;br&gt;+ satuan: Char&lt;br&gt;+ frekuensi: Selection&lt;br&gt;+ sumber_data: Text&lt;br&gt;+ active: Boolean = True" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="tk-dcd4-kpi"><mxGeometry x="0" y="40" width="300" height="143" as="geometry"/></mxCell><mxCell id="tk-dcd4-kpi-s" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;html=1;" vertex="1" parent="tk-dcd4-kpi"><mxGeometry x="0" y="183" width="300" height="8" as="geometry"/></mxCell><mxCell id="tk-dcd4-kpi-m" value="+ unlink() «override» (AB-23)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="tk-dcd4-kpi"><mxGeometry x="0" y="191" width="300" height="23" as="geometry"/></mxCell><mxCell id="tk-dcd4-pln" value="&lt;b&gt;labfik.plan&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Rencana [T]&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#6C4A87'&gt;{inherit: approval, period, criteria}&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=55;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="400" y="60" width="340" height="214" as="geometry"/></mxCell><mxCell id="tk-dcd4-pln-a" value="+ jenis: Selection {tahunan, pengembangan}&lt;br&gt;+ judul: Char&lt;br&gt;+ narasi: Html [0..1] (O)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="tk-dcd4-pln"><mxGeometry x="0" y="55" width="340" height="53" as="geometry"/></mxCell><mxCell id="tk-dcd4-pln-s" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;html=1;" vertex="1" parent="tk-dcd4-pln"><mxGeometry x="0" y="108" width="340" height="8" as="geometry"/></mxCell><mxCell id="tk-dcd4-pln-m" value="+ action_buat_revisi() (O)&lt;br&gt;# _jenis_dokumen() «override»&lt;br&gt;# _cek_kelengkapan() «override»&lt;br&gt;# _sebelum_disahkan() «override» (AB-11, O)&lt;br&gt;# _dokumen_diganti() «override»&lt;br&gt;# _cek_k1() … _cek_k4() «override»" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="tk-dcd4-pln"><mxGeometry x="0" y="116" width="340" height="98" as="geometry"/></mxCell><mxCell id="tk-dcd4-lin" value="&lt;b&gt;labfik.plan.line&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Item Rencana [T]&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="400" y="320" width="340" height="274" as="geometry"/></mxCell><mxCell id="tk-dcd4-lin-a" value="+ kegiatan: Text&lt;br&gt;+ target: Float&lt;br&gt;+ satuan: Char&lt;br&gt;+ pic_id: hr.employee&lt;br&gt;+ jadwal_mulai: Date&lt;br&gt;+ jadwal_selesai: Date&lt;br&gt;+ anggaran: Monetary&lt;br&gt;+ currency_id: res.currency&lt;br&gt;+ rujukan_renstra: Text&lt;br&gt;+ nilai_risiko: Selection {1, 2, 3}&lt;br&gt;+ nilai_manfaat: Selection {1, 2, 3}&lt;br&gt;+ prioritas: Selection {compute} (O)" style="text;st
3-n-tp-l1" value="peserta_ids 1..*" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="tk-dcd3-n-tp"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-dcd3-c-tm" value="" style="endArrow=none;startArrow=diamondThin;startFill=1;startSize=16;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tk-dcd3-tin" target="tk-dcd3-man"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-dcd3-c-tm-l0" value="1" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="tk-dcd3-c-tm"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-dcd3-c-tm-l1" value="manfaat_ids *" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="tk-dcd3-c-tm"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-dcd3-n-ml" value="" style="endArrow=open;endFill=0;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tk-dcd3-man" target="tk-dcd3-lin"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-dcd3-n-ml-l0" value="*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="tk-dcd3-n-ml"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-dcd3-n-ml-l1" value="line_id 1" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="tk-dcd3-n-ml"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-dcd3-n-kj" value="" style="endArrow=open;endFill=0;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tk-dcd3-kpi" target="tk-dcd3-jab"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-dcd3-n-kj-l0" value="*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="tk-dcd3-n-kj"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-dcd3-n-kj-l1" value="jabatan_pic_id 1" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="tk-dcd3-n-kj"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-dcd3-n1" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §13.6; UML)&lt;br&gt;• Segitiga kosong ungu = generalisasi; di Odoo &lt;code&gt;_inherit = [mixin, …]&lt;/code&gt;. Kelas ungu «AbstractModel» tidak punya tabel sendiri.&lt;br&gt;• Panah terbuka = asosiasi &lt;b&gt;berarah&lt;/b&gt; (dapat dinavigasi dari pemilik field): Many2one atau Many2many. Label = nama field.&lt;br&gt;• Belah ketupat hitam = komposisi: One2many di induk + Many2one di anak (dua arah, anak ikut terhapus).&lt;br&gt;• Garis putus-putus = asosiasi turunan (field &lt;code&gt;compute&lt;/code&gt;). Garis polos tanpa panah = dua arah (One2many + Many2one).&lt;br&gt;• &lt;code&gt;+&lt;/code&gt; publik, &lt;code&gt;#&lt;/code&gt; internal (diawali garis bawah di Odoo). «override» = method warisan yang diisi ulang. {abstract} = wajib diisi turunan. @model = method kelas (&lt;code&gt;@api.model&lt;/code&gt;).&lt;br&gt;• Referensi ke model bawaan Odoo (res.users, ir.attachment, res.currency) ditulis sebagai atribut bertipe." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="798" width="760" height="140" as="geometry"/></mxCell><mxCell id="tk-dcd3-n2" value="&lt;b&gt;Field warisan tidak ditulis ulang&lt;/b&gt;: lihat DCD 1/3. &lt;code&gt;periode_id&lt;/code&gt; berasal dari &lt;code&gt;period.mixin&lt;/code&gt;.&lt;br&gt;&lt;b&gt;Query dari SSD&lt;/b&gt; (katalog operasi) menjadi method &lt;code&gt;get_*&lt;/code&gt; / &lt;code&gt;daftar_*&lt;/code&gt;; &lt;b&gt;command&lt;/b&gt; menjadi &lt;code&gt;action_*&lt;/code&gt;. Constraint AB-10–12 sebagai &lt;code&gt;@api.constrains&lt;/code&gt; (&lt;code&gt;_check_*&lt;/code&gt;)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="820" y="798" width="560" height="140" as="geometry"/></mxCell><mxCell id="tk-dcd3-n3" value="Design class diagram (masuk proposal). Diturunkan dari conceptual model (CM-1–3) + katalog operasi SSD. Rincian: rancangan/design-class-tata-kelola.md · Draf 13 Nov 2026 · Febriyan" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="958" width="1300" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
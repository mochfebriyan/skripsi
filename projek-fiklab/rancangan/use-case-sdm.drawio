<mxfile host="app.diagrams.net"><diagram id="sdm-uc1" name="UC TO-BE (1-4) - Kompetensi dan Pengesahan Dokumen SDM"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1380" pageHeight="970" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sdm-uc1-title" value="Use case TO-BE 1/4 · Kompetensi (dipakai PKG-04, 10, 14), pengesahan dokumen SDM, dan hierarki aktor" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1290" height="36" as="geometry"/></mxCell><mxCell id="sdm-uc1-sys" value="Sistem LabFIK Compliance · Modul SDM &amp; Kompetensi" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=8;fillColor=#FFFFFF;strokeColor=#4E9A6B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="60" width="500" height="860" as="geometry"/></mxCell><mxCell id="sdm-uc1-p1" value="Kompetensi (PKG-04, PKG-10, PKG-14)" style="shape=folder;tabWidth=300;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#EEFAF3;strokeColor=#4E9A6B;" vertex="1" parent="1"><mxGeometry x="360" y="100" width="440" height="320" as="geometry"/></mxCell><mxCell id="sdm-uc1-uc03" value="&lt;font style='font-size:9px' color='#2F6B45'&gt;«CRUDL»&lt;/font&gt;&lt;br&gt;&lt;b&gt;UC-SDM-03&lt;/b&gt;&lt;br&gt;Kelola Bukti Kompetensi" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="134" width="290" height="58" as="geometry"/></mxCell><mxCell id="sdm-uc1-uc01" value="&lt;font style='font-size:9px' color='#2F6B45'&gt;«CRUDL»&lt;/font&gt;&lt;br&gt;&lt;b&gt;UC-SDM-01&lt;/b&gt;&lt;br&gt;Kelola Kompetensi" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="204" width="290" height="58" as="geometry"/></mxCell><mxCell id="sdm-uc1-uc02" value="&lt;font style='font-size:9px' color='#2F6B45'&gt;«CRUDL»&lt;/font&gt;&lt;br&gt;&lt;b&gt;UC-SDM-02&lt;/b&gt;&lt;br&gt;Kelola Syarat Kompetensi Jabatan" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="274" width="290" height="58" as="geometry"/></mxCell><mxCell id="sdm-uc1-uc04" value="&lt;font style='font-size:9px' color='#2F6B45'&gt;«report»&lt;/font&gt;&lt;br&gt;&lt;b&gt;UC-SDM-04&lt;/b&gt;&lt;br&gt;Lihat Matriks Kompetensi" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="344" width="290" height="58" as="geometry"/></mxCell><mxCell id="sdm-uc1-p2" value="Pengesahan Dokumen SDM · memakai UC Tata Kelola" style="shape=folder;tabWidth=300;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#F2F2F2;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="360" y="440" width="440" height="460" as="geometry"/></mxCell><mxCell id="sdm-uc1-tk01" value="&lt;b&gt;UC-01&lt;/b&gt; (Tata Kelola)&lt;br&gt;Ajukan Dokumen" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2F2F2;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="420" y="474" width="290" height="58" as="geometry"/></mxCell><mxCell id="sdm-uc1-tk02" value="&lt;b&gt;UC-02&lt;/b&gt; (Tata Kelola)&lt;br&gt;Terbitkan Dokumen Resmi" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2F2F2;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="420" y="544" width="290" height="58" as="geometry"/></mxCell><mxCell id="sdm-uc1-tk03" value="&lt;b&gt;UC-03&lt;/b&gt; (Tata Kelola)&lt;br&gt;Unggah Dokumen Bertanda Tangan" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2F2F2;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="420" y="614" width="290" height="58" as="geometry"/></mxCell><mxCell id="sdm-uc1-tk04" value="&lt;b&gt;UC-04&lt;/b&gt; (Tata Kelola)&lt;br&gt;Kembalikan Dokumen" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2F2F2;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="420" y="684" width="290" height="58" as="geometry"/></mxCell><mxCell id="sdm-uc1-tk05" value="&lt;b&gt;UC-05&lt;/b&gt; (Tata Kelola)&lt;br&gt;Sahkan Dokumen" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2F2F2;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="420" y="754" width="290" height="58" as="geometry"/></mxCell><mxCell id="sdm-uc1-tk06" value="&lt;b&gt;UC-06&lt;/b&gt; (Tata Kelola)&lt;br&gt;Cabut Dokumen" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2F2F2;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="420" y="824" width="290" height="58" as="geometry"/></mxCell><mxCell id="sdm-uc1-pnl" value="Pengelola Lab" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=3;fillColor=#EEFAF3;" vertex="1" parent="1"><mxGeometry x="200" y="330" width="30" height="60" as="geometry"/></mxCell><mxCell id="sdm-uc1-lab" value="Laboran/PLP" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="30" height="60" as="geometry"/></mxCell><mxCell id="sdm-uc1-kal" value="KaLab" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="610" width="30" height="60" as="geometry"/></mxCell><mxCell id="sdm-uc1-a-pnl-uc03" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="sdm-uc1-pnl" target="sdm-uc1-uc03"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc1-a-pnl-tk01" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="sdm-uc1-pnl" target="sdm-uc1-tk01"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc1-a-pnl-tk02" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="sdm-uc1-pnl" target="sdm-uc1-tk02"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc1-a-pnl-tk03" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="sdm-uc1-pnl" target="sdm-uc1-tk03"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc1-a-kal-uc01" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="sdm-uc1-kal" target="sdm-uc1-uc01"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc1-a-kal-uc02" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="sdm-uc1-kal" target="sdm-uc1-uc02"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc1-a-kal-uc04" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="sdm-uc1-kal" target="sdm-uc1-uc04"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc1-a-kal-tk04" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="sdm-uc1-kal" target="sdm-uc1-tk04"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc1-a-kal-tk05" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="sdm-uc1-kal" target="sdm-uc1-tk05"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc1-a-kal-tk06" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="sdm-uc1-kal" target="sdm-uc1-tk06"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc1-g-lab-pnl" value="" style="endArrow=block;endFill=0;endSize=14;html=1;strokeColor=#333333;" edge="1" parent="1" source="sdm-uc1-lab" target="sdm-uc1-pnl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc1-g-kal-pnl" value="" style="endArrow=block;endFill=0;endSize=14;html=1;strokeColor=#333333;" edge="1" parent="1" source="sdm-uc1-kal" target="sdm-uc1-pnl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc1-n0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §4.2–4.3)&lt;br&gt;• Aktor miring hijau = &lt;b&gt;aktor abstrak&lt;/b&gt;; panah segitiga kosong = generalisasi (turunan mewarisi use case induk)&lt;br&gt;• «CRUDL» = kelola data (buat, lihat, ubah, hapus, daftar) dengan satu pola; «report» = hanya membaca&lt;br&gt;• Package dan elips &lt;b&gt;abu-abu putus-putus&lt;/b&gt; = use case milik modul Tata Kelola yang dipakai ulang, tidak dirancang ulang&lt;br&gt;• Tanpa «include»/«extend»: setiap use case satu sesi dan berdiri sendiri (§4.3.1, §4.5)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="870" y="60" width="460" height="150" as="geometry"/></mxCell><mxCell id="sdm-uc1-n1" value="&lt;b&gt;Cara baca&lt;/b&gt;&lt;br&gt;• &lt;i&gt;Pengelola Lab&lt;/i&gt; = peran pencatat: KaLab atau Laboran/PLP. Semua use case &lt;i&gt;Pengelola Lab&lt;/i&gt; juga bisa dilakukan KaLab dan Laboran.&lt;br&gt;• Kelola master Kompetensi dan syarat jabatan hanya oleh &lt;b&gt;KaLab&lt;/b&gt;; bukti kompetensi dicatat keduanya.&lt;br&gt;• Surat Tugas (UC-SDM-07, 08), Otorisasi (UC-SDM-13), dan Rencana Pelatihan (UC-SDM-17) diajukan, disahkan, dan dicabut lewat use case Tata Kelola di package bawah. Kelengkapan tiap jenis dokumen SDM diperiksa saat &lt;b&gt;UC-01 Ajukan&lt;/b&gt;; otorisasi lama diganti saat &lt;b&gt;UC-05 Sahkan&lt;/b&gt;.&lt;br&gt;• UC-02 menerbitkan Surat Tugas dan Rencana Pelatihan sebagai PDF untuk ditandatangani (Pelengkap)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="870" y="230" width="460" height="230" as="geometry"/></mxCell><mxCell id="sdm-uc1-n2" value="&lt;b&gt;Bukan aktor&lt;/b&gt;: Dekan, Wadek, Koor Prodi (hanya menandatangani; dicatat sebagai pengesah atau penyetuju pengecualian), asisten praktikum, dan penilai monev (menerima PDF). Tidak ada aktor Penjadwal: status berlaku dihitung dari tanggal (kontrak Core K-3). Kedaluwarsa Rencana Pelatihan berperiode memakai UC-07 Tata Kelola (Pelengkap modul itu)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="870" y="480" width="460" height="130" as="geometry"/></mxCell><mxCell id="sdm-uc1-n3" value="&lt;b&gt;[KONFIRMASI]&lt;/b&gt; Nomor UC-01–06 dirujuk dari use-case-tata-kelola.md (Febriyan, 14 Nov 2026). Bila Tata Kelola menomori ulang, rujukan di halaman ini ikut diubah." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="870" y="630" width="460" height="70" as="geometry"/></mxCell><mxCell id="sdm-uc1-n4" value="Sumber: activity A1–A3 dan state machine S1–S3 (proses-bisnis-sdm.md), kebutuhan KF-SDM-01–43 (kebutuhan-sdm.md), use case pengesahan UC-01–06 Tata Kelola (branch febriyan-skripsi). Rincian: use-case-sdm.md · Draf 15 Nov 2026 · Zahir" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="870" y="720" width="460" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="sdm-uc2" name="UC TO-BE (2-4) - Penugasan Petugas (PKG-04)"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1380" pageHeight="670" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sdm-uc2-title" value="Use case TO-BE 2/4 · Penugasan Petugas sesuai Kompetensi (PKG-04)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1290" height="36" as="geometry"/></mxCell><mxCell id="sdm-uc2-sys" value="Sistem LabFIK Compliance · Modul SDM &amp; Kompetensi" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=8;fillColor=#FFFFFF;strokeColor=#4E9A6B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="60" width="500" height="520" as="geometry"/></mxCell><mxCell id="sdm-uc2-p1" value="Penugasan Petugas (PKG-04)" style="shape=folder;tabWidth=300;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#EEFAF3;strokeColor=#4E9A6B;" vertex="1" parent="1"><mxGeometry x="360" y="100" width="440" height="460" as="geometry"/></mxCell><mxCell id="sdm-uc2-uc06" value="&lt;b&gt;UC-SDM-06&lt;/b&gt;&lt;br&gt;Catat Hasil Seleksi Asisten" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="134" width="290" height="58" as="geometry"/></mxCell><mxCell id="sdm-uc2-uc07" value="&lt;b&gt;UC-SDM-07&lt;/b&gt;&lt;br&gt;Susun Surat Tugas" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="204" width="290" height="58" as="geometry"/></mxCell><mxCell id="sdm-uc2-uc09" value="&lt;b&gt;UC-SDM-09&lt;/b&gt;&lt;br&gt;Catat Orientasi Petugas Baru" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="274" width="290" height="58" as="geometry"/></mxCell><mxCell id="sdm-uc2-uc05" value="&lt;b&gt;UC-SDM-05&lt;/b&gt;&lt;br&gt;Tetapkan Kebutuhan Petugas" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="344" width="290" height="58" as="geometry"/></mxCell><mxCell id="sdm-uc2-uc08" value="&lt;b&gt;UC-SDM-08&lt;/b&gt;&lt;br&gt;Buat Revisi Surat Tugas" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="414" width="290" height="58" as="geometry"/></mxCell><mxCell id="sdm-uc2-uc10" value="&lt;font style='font-size:9px' color='#2F6B45'&gt;«report»&lt;/font&gt;&lt;br&gt;&lt;b&gt;UC-SDM-10&lt;/b&gt;&lt;br&gt;Lihat Daftar Petugas per Sesi" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="484" width="290" height="58" as="geometry"/></mxCell><mxCell id="sdm-uc2-pnl" value="Pengelola Lab" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=3;fillColor=#EEFAF3;" vertex="1" parent="1"><mxGeometry x="200" y="200" width="30" height="60" as="geometry"/></mxCell><mxCell id="sdm-uc2-kal" value="KaLab" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="410" width="30" height="60" as="geometry"/></mxCell><mxCell id="sdm-uc2-a-pnl-uc06" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="sdm-uc2-pnl" target="sdm-uc2-uc06"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc2-a-pnl-uc07" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="sdm-uc2-pnl" target="sdm-uc2-uc07"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc2-a-pnl-uc09" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="sdm-uc2-pnl" target="sdm-uc2-uc09"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc2-a-kal-uc05" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="sdm-uc2-kal" target="sdm-uc2-uc05"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc2-a-kal-uc08" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="sdm-uc2-kal" target="sdm-uc2-uc08"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc2-a-kal-uc10" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="sdm-uc2-kal" target="sdm-uc2-uc10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc2-n0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §4.2–4.3)&lt;br&gt;• Aktor miring hijau = &lt;b&gt;aktor abstrak&lt;/b&gt;; panah segitiga kosong = generalisasi (turunan mewarisi use case induk)&lt;br&gt;• «CRUDL» = kelola data (buat, lihat, ubah, hapus, daftar) dengan satu pola; «report» = hanya membaca&lt;br&gt;• Package dan elips &lt;b&gt;abu-abu putus-putus&lt;/b&gt; = use case milik modul Tata Kelola yang dipakai ulang, tidak dirancang ulang&lt;br&gt;• Tanpa «include»/«extend»: setiap use case satu sesi dan berdiri sendiri (§4.3.1, §4.5)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="870" y="60" width="460" height="150" as="geometry"/></mxCell><mxCell id="sdm-uc2-n1" value="&lt;b&gt;Cara baca&lt;/b&gt;&lt;br&gt;• Hierarki aktor di halaman 1/4: KaLab juga &lt;i&gt;Pengelola Lab&lt;/i&gt;.&lt;br&gt;• UC-SDM-06 mencakup pengecualian syarat (alasan + penyetuju di luar sistem) dan pembuatan Personel asisten bila belum ada. Calon yang tidak lulus tidak dicatat.&lt;br&gt;• UC-SDM-07 dan 08 menghasilkan Surat Tugas bergaris (asisten → kelas, laboran → ruang); pengajuan dan pengesahannya lewat halaman 1/4.&lt;br&gt;• UC-SDM-10 menampilkan status S1–S4 setiap sesi terlaksana dan syarat yang gagal." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="870" y="230" width="460" height="190" as="geometry"/></mxCell><mxCell id="sdm-uc2-n2" value="&lt;b&gt;[KONFIRMASI]&lt;/b&gt; KB-3: Surat Tugas &lt;b&gt;ditolak&lt;/b&gt; saat diajukan bila ada asisten tanpa seleksi lulus (dipakai sebagai default). K7: pengesah Surat Tugas." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="870" y="440" width="460" height="60" as="geometry"/></mxCell><mxCell id="sdm-uc2-n3" value="Sumber: activity A1–A3 dan state machine S1–S3 (proses-bisnis-sdm.md), kebutuhan KF-SDM-01–43 (kebutuhan-sdm.md), use case pengesahan UC-01–06 Tata Kelola (branch febriyan-skripsi). Rincian: use-case-sdm.md · Draf 15 Nov 2026 · Zahir" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="870" y="520" width="460" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="sdm-uc3" name="UC TO-BE (3-4) - Otorisasi Personel (PKG-10)"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1380" pageHeight="680" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sdm-uc3-title" value="Use case TO-BE 3/4 · Otorisasi Personel untuk Tugas/Alat Berkewenangan Khusus (PKG-10)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1290" height="36" as="geometry"/></mxCell><mxCell id="sdm-uc3-sys" value="Sistem LabFIK Compliance · Modul SDM &amp; Kompetensi" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=8;fillColor=#FFFFFF;strokeColor=#4E9A6B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="60" width="500" height="520" as="geometry"/></mxCell><mxCell id="sdm-uc3-p1" value="Otorisasi Personel (PKG-10)" style="shape=folder;tabWidth=300;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#EEFAF3;strokeColor=#4E9A6B;" vertex="1" parent="1"><mxGeometry x="360" y="100" width="440" height="460" as="geometry"/></mxCell><mxCell id="sdm-uc3-uc12" value="&lt;b&gt;UC-SDM-12&lt;/b&gt;&lt;br&gt;Catat Asesmen Keterampilan" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="134" width="290" height="58" as="geometry"/></mxCell><mxCell id="sdm-uc3-uc14" value="&lt;b&gt;UC-SDM-14&lt;/b&gt;&lt;br&gt;Catat Pemicu Evaluasi Ulang" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="204" width="290" height="58" as="geometry"/></mxCell><mxCell id="sdm-uc3-uc15" value="&lt;b&gt;UC-SDM-15&lt;/b&gt;&lt;br&gt;Putuskan Evaluasi Ulang Otorisasi" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="274" width="290" height="58" as="geometry"/></mxCell><mxCell id="sdm-uc3-uc11" value="&lt;font style='font-size:9px' color='#2F6B45'&gt;«CRUDL»&lt;/font&gt;&lt;br&gt;&lt;b&gt;UC-SDM-11&lt;/b&gt;&lt;br&gt;Kelola Tugas/Alat Berkewenangan Khusus" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="344" width="290" height="58" as="geometry"/></mxCell><mxCell id="sdm-uc3-uc13" value="&lt;b&gt;UC-SDM-13&lt;/b&gt;&lt;br&gt;Susun Otorisasi" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="414" width="290" height="58" as="geometry"/></mxCell><mxCell id="sdm-uc3-uc16" value="&lt;font style='font-size:9px' color='#2F6B45'&gt;«report»&lt;/font&gt;&lt;br&gt;&lt;b&gt;UC-SDM-16&lt;/b&gt;&lt;br&gt;Lihat Daftar Operator Sah" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="484" width="290" height="58" as="geometry"/></mxCell><mxCell id="sdm-uc3-pnl" value="Pengelola Lab" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=3;fillColor=#EEFAF3;" vertex="1" parent="1"><mxGeometry x="200" y="200" width="30" height="60" as="geometry"/></mxCell><mxCell id="sdm-uc3-kal" value="KaLab" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="410" width="30" height="60" as="geometry"/></mxCell><mxCell id="sdm-uc3-a-pnl-uc12" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="sdm-uc3-pnl" target="sdm-uc3-uc12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc3-a-pnl-uc14" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="sdm-uc3-pnl" target="sdm-uc3-uc14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc3-a-pnl-uc15" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="sdm-uc3-pnl" target="sdm-uc3-uc15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc3-a-kal-uc11" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="sdm-uc3-kal" target="sdm-uc3-uc11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc3-a-kal-uc13" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="sdm-uc3-kal" target="sdm-uc3-uc13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc3-a-kal-uc16" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="sdm-uc3-kal" target="sdm-uc3-uc16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc3-n0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §4.2–4.3)&lt;br&gt;• Aktor miring hijau = &lt;b&gt;aktor abstrak&lt;/b&gt;; panah segitiga kosong = generalisasi (turunan mewarisi use case induk)&lt;br&gt;• «CRUDL» = kelola data (buat, lihat, ubah, hapus, daftar) dengan satu pola; «report» = hanya membaca&lt;br&gt;• Package dan elips &lt;b&gt;abu-abu putus-putus&lt;/b&gt; = use case milik modul Tata Kelola yang dipakai ulang, tidak dirancang ulang&lt;br&gt;• Tanpa «include»/«extend»: setiap use case satu sesi dan berdiri sendiri (§4.3.1, §4.5)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="870" y="60" width="460" height="150" as="geometry"/></mxCell><mxCell id="sdm-uc3-n1" value="&lt;b&gt;Cara baca&lt;/b&gt;&lt;br&gt;• UC-SDM-11 mencakup penetapan &lt;b&gt;pelaksana&lt;/b&gt; tiap tugas/alat (penyebut PKG-10) dan cara pembatasan akses (Pelengkap).&lt;br&gt;• UC-SDM-12: asesmen &lt;i&gt;layak&lt;/i&gt; langsung membuat Bukti Kompetensi.&lt;br&gt;• Evaluasi ulang dipecah dua karena ada jeda: pemicu dicatat saat terjadi (status &lt;i&gt;Terbuka&lt;/i&gt;), keputusan diambil setelah personel dinilai ulang (S2).&lt;br&gt;• Keputusan diperpanjang/dibatasi/naik level diwujudkan dengan Otorisasi baru (UC-SDM-13); dicabut lewat UC-06 Cabut Dokumen (halaman 1/4)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="870" y="230" width="460" height="200" as="geometry"/></mxCell><mxCell id="sdm-uc3-n2" value="&lt;b&gt;[KONFIRMASI]&lt;/b&gt; KP-1: keputusan &lt;i&gt;tetap berlaku&lt;/i&gt; di UC-SDM-15 (dipakai sebagai default). KB-1: penyebut = pelaksana yang ditetapkan KaLab." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="870" y="450" width="460" height="60" as="geometry"/></mxCell><mxCell id="sdm-uc3-n3" value="Sumber: activity A1–A3 dan state machine S1–S3 (proses-bisnis-sdm.md), kebutuhan KF-SDM-01–43 (kebutuhan-sdm.md), use case pengesahan UC-01–06 Tata Kelola (branch febriyan-skripsi). Rincian: use-case-sdm.md · Draf 15 Nov 2026 · Zahir" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="870" y="530" width="460" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="sdm-uc4" name="UC TO-BE (4-4) - Pelatihan PLP (PKG-14) dan Status Monev"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1380" pageHeight="680" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sdm-uc4-title" value="Use case TO-BE 4/4 · Pelatihan PLP/Laboran (PKG-14) dan Status Monev SDM" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1290" height="36" as="geometry"/></mxCell><mxCell id="sdm-uc4-sys" value="Sistem LabFIK Compliance · Modul SDM &amp; Kompetensi" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=8;fillColor=#FFFFFF;strokeColor=#4E9A6B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="60" width="500" height="580" as="geometry"/></mxCell><mxCell id="sdm-uc4-p1" value="Pelatihan PLP/Laboran (PKG-14)" style="shape=folder;tabWidth=300;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#EEFAF3;strokeColor=#4E9A6B;" vertex="1" parent="1"><mxGeometry x="360" y="100" width="440" height="390" as="geometry"/></mxCell><mxCell id="sdm-uc4-uc18" value="&lt;b&gt;UC-SDM-18&lt;/b&gt;&lt;br&gt;Catat Realisasi Pelatihan" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="134" width="290" height="58" as="geometry"/></mxCell><mxCell id="sdm-uc4-uc19" value="&lt;b&gt;UC-SDM-19&lt;/b&gt;&lt;br&gt;Catat Evaluasi Efektivitas Pelatihan" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="204" width="290" height="58" as="geometry"/></mxCell><mxCell id="sdm-uc4-uc17" value="&lt;b&gt;UC-SDM-17&lt;/b&gt;&lt;br&gt;Susun Rencana Pelatihan" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="274" width="290" height="58" as="geometry"/></mxCell><mxCell id="sdm-uc4-uc20" value="&lt;b&gt;UC-SDM-20&lt;/b&gt;&lt;br&gt;Batalkan Item Pelatihan" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="344" width="290" height="58" as="geometry"/></mxCell><mxCell id="sdm-uc4-uc21" value="&lt;font style='font-size:9px' color='#2F6B45'&gt;«report»&lt;/font&gt;&lt;br&gt;&lt;b&gt;UC-SDM-21&lt;/b&gt;&lt;br&gt;Lihat Rekap Pelatihan Personel" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="414" width="290" height="58" as="geometry"/></mxCell><mxCell id="sdm-uc4-p2" value="Status Monev (PKG-04, PKG-10, PKG-14)" style="shape=folder;tabWidth=300;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#EEFAF3;strokeColor=#4E9A6B;" vertex="1" parent="1"><mxGeometry x="360" y="510" width="440" height="110" as="geometry"/></mxCell><mxCell id="sdm-uc4-uc22" value="&lt;font style='font-size:9px' color='#2F6B45'&gt;«report»&lt;/font&gt;&lt;br&gt;&lt;b&gt;UC-SDM-22&lt;/b&gt;&lt;br&gt;Lihat Status Monev SDM" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="544" width="290" height="58" as="geometry"/></mxCell><mxCell id="sdm-uc4-pnl" value="Pengelola Lab" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=3;fillColor=#EEFAF3;" vertex="1" parent="1"><mxGeometry x="200" y="160" width="30" height="60" as="geometry"/></mxCell><mxCell id="sdm-uc4-kal" value="KaLab" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="420" width="30" height="60" as="geometry"/></mxCell><mxCell id="sdm-uc4-a-pnl-uc18" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="sdm-uc4-pnl" target="sdm-uc4-uc18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc4-a-pnl-uc19" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="sdm-uc4-pnl" target="sdm-uc4-uc19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc4-a-kal-uc17" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="sdm-uc4-kal" target="sdm-uc4-uc17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc4-a-kal-uc20" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="sdm-uc4-kal" target="sdm-uc4-uc20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc4-a-kal-uc21" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="sdm-uc4-kal" target="sdm-uc4-uc21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc4-a-kal-uc22" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="sdm-uc4-kal" target="sdm-uc4-uc22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc4-n0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §4.2–4.3)&lt;br&gt;• Aktor miring hijau = &lt;b&gt;aktor abstrak&lt;/b&gt;; panah segitiga kosong = generalisasi (turunan mewarisi use case induk)&lt;br&gt;• «CRUDL» = kelola data (buat, lihat, ubah, hapus, daftar) dengan satu pola; «report» = hanya membaca&lt;br&gt;• Package dan elips &lt;b&gt;abu-abu putus-putus&lt;/b&gt; = use case milik modul Tata Kelola yang dipakai ulang, tidak dirancang ulang&lt;br&gt;• Tanpa «include»/«extend»: setiap use case satu sesi dan berdiri sendiri (§4.3.1, §4.5)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="870" y="60" width="460" height="150" as="geometry"/></mxCell><mxCell id="sdm-uc4-n1" value="&lt;b&gt;Cara baca&lt;/b&gt;&lt;br&gt;• UC-SDM-17 mencakup kebutuhan kompetensi (diisi awal dari matriks) dan item pelatihan dalam satu draf rencana; pengesahannya lewat halaman 1/4.&lt;br&gt;• UC-SDM-19: evaluasi &lt;i&gt;efektif&lt;/i&gt; langsung membuat Bukti Kompetensi, sehingga kebutuhan tahun berikutnya berkurang (K4).&lt;br&gt;• UC-SDM-22: persentase PKG-04 dan PKG-10, kriteria tertinggi K1–K4 PKG-14 yang lengkap secara data, daftar unit yang belum memenuhi, dan tautan bukti. Hasilnya diserahkan ke penilai sebagai PDF; skor akhir PKG-14 ditetapkan penilai." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="870" y="230" width="460" height="200" as="geometry"/></mxCell><mxCell id="sdm-uc4-n2" value="&lt;b&gt;[KONFIRMASI]&lt;/b&gt; KU-2: revisi Rencana Pelatihan setelah disahkan tidak dirancang; pelatihan pengganti masuk rencana tahun berikutnya." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="870" y="450" width="460" height="60" as="geometry"/></mxCell><mxCell id="sdm-uc4-n3" value="Sumber: activity A1–A3 dan state machine S1–S3 (proses-bisnis-sdm.md), kebutuhan KF-SDM-01–43 (kebutuhan-sdm.md), use case pengesahan UC-01–06 Tata Kelola (branch febriyan-skripsi). Rincian: use-case-sdm.md · Draf 15 Nov 2026 · Zahir" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="870" y="530" width="460" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
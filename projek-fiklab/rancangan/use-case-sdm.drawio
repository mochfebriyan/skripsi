ew Roman;" vertex="1" parent="1"><mxGeometry x="400" y="234" width="290" height="58" as="geometry"/></mxCell><mxCell id="sdm-uc4-uc20" value="&lt;b&gt;UC-SDM-20&lt;/b&gt;&lt;br&gt;Batalkan Item Pelatihan" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="400" y="304" width="290" height="58" as="geometry"/></mxCell><mxCell id="sdm-uc4-uc21" value="&lt;font style='font-size:10px'&gt;«report»&lt;/font&gt;&lt;br&gt;&lt;b&gt;UC-SDM-21&lt;/b&gt;&lt;br&gt;Lihat Rekap Pelatihan Personel" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="400" y="374" width="290" height="58" as="geometry"/></mxCell><mxCell id="sdm-uc4-p2" value="Status Monev (PKG-04, PKG-10, PKG-14)" style="shape=folder;tabWidth=300;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="340" y="470" width="440" height="110" as="geometry"/></mxCell><mxCell id="sdm-uc4-uc22" value="&lt;font style='font-size:10px'&gt;«report»&lt;/font&gt;&lt;br&gt;&lt;b&gt;UC-SDM-22&lt;/b&gt;&lt;br&gt;Lihat Status Monev SDM" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="400" y="504" width="290" height="58" as="geometry"/></mxCell><mxCell id="sdm-uc4-pnl" value="Pengelola Lab" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="180" y="120" width="30" height="60" as="geometry"/></mxCell><mxCell id="sdm-uc4-kal" value="KaLab" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="180" y="380" width="30" height="60" as="geometry"/></mxCell><mxCell id="sdm-uc4-a-pnl-18" value="" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" parent="1" source="sdm-uc4-pnl" target="sdm-uc4-uc18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc4-a-pnl-19" value="" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" parent="1" source="sdm-uc4-pnl" target="sdm-uc4-uc19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc4-a-kal-17" value="" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" parent="1" source="sdm-uc4-kal" target="sdm-uc4-uc17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc4-a-kal-20" value="" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" parent="1" source="sdm-uc4-kal" target="sdm-uc4-uc20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc4-a-kal-21" value="" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" parent="1" source="sdm-uc4-kal" target="sdm-uc4-uc21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-uc4-a-kal-22" value="" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" parent="1" source="sdm-uc4-kal" target="sdm-uc4-uc22"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="sdm-uc-notes" name="Catatan UC TO-BE (bahan kerja)"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="1328" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sdm-uc-notes-title" value="Catatan use case diagram modul SDM (bahan kerja, tidak disisipkan ke naskah)" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1100" height="36" as="geometry"/></mxCell><mxCell id="sdm-uc-notes-legend" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §4.2–4.3)&lt;br&gt;• Nama aktor miring = &lt;b&gt;aktor abstrak&lt;/b&gt;; panah segitiga kosong = generalisasi (turunan mewarisi use case induk)&lt;br&gt;• «CRUDL» = kelola data (buat, lihat, ubah, hapus, daftar) dengan satu pola; «report» = hanya membaca&lt;br&gt;• Tanpa «include»/«extend»: setiap use case satu sesi dan berdiri sendiri (§4.3.1, §4.5)&lt;br&gt;• Gaya polos hitam-putih (CLAUDE.md bagian 5); semua use case milik modul SDM" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1100" height="100" as="geometry"/></mxCell><mxCell id="sdm-uc-notes-src" value="Sumber: activity A1–A4 dan state machine S1–S4 (proses-bisnis-sdm.md), kebutuhan KF-SDM-01–43 (kebutuhan-sdm.md). Rincian: use-case-sdm.md · Draf 15 Nov 2026, direvisi 17 Nov 2026 (pengesahan dokumen SDM sebagai use case sendiri, gaya hitam-putih) · Zahir" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="166" width="1100" height="50" as="geometry"/></mxCell><mxCell id="sdm-uc-notes-h0" value="&lt;b&gt;Use case TO-BE 1/4 · Kompetensi (dipakai PKG-04, 10, 14), pengesahan dokumen SDM, dan hierarki aktor&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="236" width="1100" height="24" as="geometry"/></mxCell><mxCell id="sdm-uc-notes-n0-0" value="&lt;b&gt;Cara baca&lt;/b&gt;&lt;br&gt;• &lt;i&gt;Pengelola Lab&lt;/i&gt; = peran pencatat: KaLab atau Laboran/PLP. Semua use case &lt;i&gt;Pengelola Lab&lt;/i&gt; juga bisa dilakukan KaLab dan Laboran.&lt;br&gt;• Kelola master Kompetensi dan syarat jabatan hanya oleh &lt;b&gt;KaLab&lt;/b&gt;; bukti kompetensi dicatat keduanya.&lt;br&gt;• &lt;b&gt;Dokumen SDM&lt;/b&gt; = Surat Tugas (UC-SDM-07, 08), Otorisasi (UC-SDM-13), Rencana Pelatihan (UC-SDM-17). Ketiganya diajukan, disahkan, dan dicabut lewat package Pengesahan Dokumen SDM. Kelengkapan tiap jenis diperiksa di UC-SDM-23; dokumen lama diganti di UC-SDM-27.&lt;br&gt;• UC-SDM-24 menerbitkan Surat Tugas dan Rencana Pelatihan sebagai PDF untuk ditandatangani (Pelengkap)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="266" width="1100" height="166" as="geometry"/></mxCell><mxCell id="sdm-uc-notes-n0-1" value="&lt;b&gt;Bukan aktor&lt;/b&gt;: Dekan, Wadek, Koor Prodi (hanya menandatangani; dicatat sebagai pengesah atau penyetuju pengecualian), asisten praktikum, dan penilai monev (menerima PDF). Tidak ada aktor Penjadwal: status berlaku dihitung dari tanggal (kontrak Core K-3)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="442" width="1100" height="58" as="geometry"/></mxCell><mxCell id="sdm-uc-notes-h1" value="&lt;b&gt;Use case TO-BE 2/4 · Penugasan Petugas sesuai Kompetensi (PKG-04)&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="1100" height="24" as="geometry"/></mxCell><mxCell id="sdm-uc-notes-n1-0" value="&lt;b&gt;Cara baca&lt;/b&gt;&lt;br&gt;• Hierarki aktor di halaman 1/4: KaLab juga &lt;i&gt;Pengelola Lab&lt;/i&gt;.&lt;br&gt;• UC-SDM-06 mencakup pengecualian syarat (alasan + penyetuju di luar sistem) dan pembuatan Personel asisten bila belum ada. Calon yang tidak lulus tidak dicatat.&lt;br&gt;• UC-SDM-07 dan 08 menghasilkan Surat Tugas bergaris (asisten → kelas, laboran → ruang); pengajuan dan pengesahannya lewat halaman 1/4.&lt;br&gt;• UC-SDM-10 menampilkan status S1–S4 setiap sesi terlaksana dan syarat yang gagal." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="1100" height="148" as="geometry"/></mxCell><mxCell id="sdm-uc-notes-n1-1" value="&lt;b&gt;[KONFIRMASI]&lt;/b&gt; KB-3: Surat Tugas &lt;b&gt;ditolak&lt;/b&gt; saat diajukan bila ada asisten tanpa seleksi lulus (dipakai sebagai default). K7: pengesah Surat Tugas." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="708" width="1100" height="40" as="geometry"/></mxCell><mxCell id="sdm-uc-notes-h2" value="&lt;b&gt;Use case TO-BE 3/4 · Otorisasi Personel untuk Tugas/Alat Berkewenangan Khusus (PKG-10)&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="768" width="1100" height="24" as="geometry"/></mxCell><mxCell id="sdm-uc-notes-n2-0" value="&lt;b&gt;Cara baca&lt;/b&gt;&lt;br&gt;• UC-SDM-11 mencakup penetapan &lt;b&gt;pelaksana&lt;/b&gt; tiap tugas/alat (penyebut PKG-10) dan cara pembatasan akses (Pelengkap).&lt;br&gt;• UC-SDM-12: asesmen &lt;i&gt;layak&lt;/i&gt; langsung membuat Bukti Kompetensi.&lt;br&gt;• Evaluasi ulang dipecah dua karena ada jeda: pemicu dicatat saat terjadi (status &lt;i&gt;Terbuka&lt;/i&gt;), keputusan diambil setelah personel dinilai ulang (S2).&lt;br&gt;• Keputusan diperpanjang/dibatasi/naik level diwujudkan dengan Otorisasi baru (UC-SDM-13); dicabut lewat UC-SDM-28 Cabut Dokumen SDM (halaman 1/4)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="798" width="1100" height="166" as="geometry"/></mxCell><mxCell id="sdm-uc-notes-n2-1" value="&lt;b&gt;[KONFIRMASI]&lt;/b&gt; KP-1: keputusan &lt;i&gt;tetap berlaku&lt;/i&gt; di UC-SDM-15 (default). KU-1: pemicu dan keputusan di hari berbeda. KB-1: penyebut = pelaksana yang ditetapkan KaLab." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="974" width="1100" height="58" as="geometry"/></mxCell><mxCell id="sdm-uc-notes-h3" value="&lt;b&gt;Use case TO-BE 4/4 · Pelatihan PLP/Laboran (PKG-14) dan Status Monev SDM&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1052" width="1100" height="24" as="geometry"/></mxCell><mxCell id="sdm-uc-notes-n3-0" value="&lt;b&gt;Cara baca&lt;/b&gt;&lt;br&gt;• UC-SDM-17 mencakup kebutuhan kompetensi (diisi awal dari matriks) dan item pelatihan dalam satu draf rencana; pengesahannya lewat halaman 1/4.&lt;br&gt;• UC-SDM-19: evaluasi &lt;i&gt;efektif&lt;/i&gt; langsung membuat Bukti Kompetensi, sehingga kebutuhan tahun berikutnya berkurang (K4).&lt;br&gt;• UC-SDM-22: persentase PKG-04 dan PKG-10, kriteria tertinggi K1–K4 PKG-14 yang lengkap secara data, daftar unit yang belum memenuhi, dan tautan bukti. Hasilnya diserahkan ke penilai sebagai PDF; skor akhir PKG-14 ditetapkan penilai." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="1082" width="1100" height="148" as="geometry"/></mxCell><mxCell id="sdm-uc-notes-n3-1" value="&lt;b&gt;[KONFIRMASI]&lt;/b&gt; KU-2: revisi Rencana Pelatihan setelah disahkan tidak dirancang; pelatihan pengganti masuk rencana tahun berikutnya. KU-3: laporan bukti memuat rekaman pendukung (orientasi, pembatasan akses)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="1240" width="1100" height="58" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
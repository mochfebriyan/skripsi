<mxfile host="app.diagrams.net" type="device"><diagram id="core-mdl-1" name="Model Core (1-1) - Mixin, Master, dan Transaksi"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1710" pageHeight="2096" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="core-mdl-frame" value="MODEL CORE · labfik_core (mixin, master, dan transaksi)" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingTop=10;fontSize=22;fontStyle=1;fillColor=#F2F2F2;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1630" height="2036" as="geometry"/></mxCell><mxCell id="core-mdl-row1" value="Baris 1 · AbstractModel (mixin): perilaku bersama, tanpa tabel sendiri. Dipakai lewat _inherit = ['labfik.…mixin']" style="text;html=1;fontSize=12;fontStyle=3;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="1570" height="24" as="geometry"/></mxCell><mxCell id="core-mdl-apv" value="&lt;font style='font-size:10px'&gt;«AbstractModel»&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;i&gt;labfik.approval.mixin&lt;/i&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Siklus pengesahan · dirancang Tata Kelola&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#6C4A87'&gt;&lt;b&gt;{_inherit: mail.thread}&lt;/b&gt;&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=70;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="370" height="424" as="geometry"/></mxCell><mxCell id="core-mdl-apv-a" value="+ state: Selection {draf, diajukan, disahkan,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;diganti, dicabut, kedaluwarsa} = draf&lt;br&gt;+ penyusun_id: hr.employee&lt;br&gt;+ tanggal_ajukan: Datetime (readonly)&lt;br&gt;+ berkas_ttd: Binary [0..1]&lt;br&gt;+ pengesah_id: hr.employee [0..1] (readonly)&lt;br&gt;+ pencatat_id: res.users [0..1] (readonly)&lt;br&gt;+ tanggal_sah: Date [0..1] (readonly)&lt;br&gt;+ log_ids: labfik.approval.log [*] {compute}" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="core-mdl-apv"><mxGeometry x="0" y="70" width="370" height="143" as="geometry"/></mxCell><mxCell id="core-mdl-apv-s" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;html=1;" vertex="1" parent="core-mdl-apv"><mxGeometry x="0" y="213" width="370" height="8" as="geometry"/></mxCell><mxCell id="core-mdl-apv-m" value="+ action_ajukan()&lt;br&gt;+ action_unggah_ttd(berkas)&lt;br&gt;+ action_kembalikan(alasan)&lt;br&gt;+ action_sahkan(pengesah, tanggal_sah)&lt;br&gt;+ action_cabut(alasan)&lt;br&gt;+ unlink() «override»&lt;br&gt;# _jenis_dokumen(): str {abstract}&lt;br&gt;# _cek_kelengkapan(): list {abstract}&lt;br&gt;# _cek_wewenang(pengesah)&lt;br&gt;# _sebelum_ajukan() {hook}&lt;br&gt;# _sebelum_disahkan() {hook}&lt;br&gt;# _dokumen_diganti(): recordset {hook}&lt;br&gt;# _setelah_disahkan() {hook}" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="core-mdl-apv"><mxGeometry x="0" y="221" width="370" height="203" as="geometry"/></mxCell><mxCell id="core-mdl-prd" value="&lt;font style='font-size:10px'&gt;«AbstractModel»&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;i&gt;labfik.period.mixin&lt;/i&gt;&lt;/b
metry"/></mxCell><mxCell id="core-mdl-wwn" value="&lt;font style='font-size:10px'&gt;«Core» model baru [M]&lt;/font&gt;&lt;br&gt;&lt;b&gt;labfik.jabatan.wewenang&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Wewenang Jabatan · dirancang Tata Kelola&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#6C4A87'&gt;&lt;b&gt;{_name baru; anak hr.job}&lt;/b&gt;&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=70;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1260" y="644" width="370" height="304" as="geometry"/></mxCell><mxCell id="core-mdl-wwn-a" value="+ jabatan_id: hr.job&lt;br&gt;+ tindakan: Selection {menyusun, mengesahkan}&lt;br&gt;+ jenis_dokumen: Selection&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(modul lain menambah lewat selection_add)&lt;br&gt;&lt;i&gt;unique(jabatan_id, tindakan, jenis_dokumen)&lt;/i&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="core-mdl-wwn"><mxGeometry x="0" y="70" width="370" height="83" as="geometry"/></mxCell><mxCell id="core-mdl-row3" value="Baris 3 · Master bersama: ruang, periode, mata kuliah, kelas" style="text;html=1;fontSize=12;fontStyle=3;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="60" y="988" width="1570" height="24" as="geometry"/></mxCell><mxCell id="core-mdl-rng" value="&lt;font style='font-size:10px'&gt;«Core» model baru [M]&lt;/font&gt;&lt;br&gt;&lt;b&gt;labfik.ruang&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Ruang Lab · dirancang Tata Kelola&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#6C4A87'&gt;&lt;b&gt;{_name baru}&lt;/b&gt;&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=70;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="1018" width="370" height="198" as="geometry"/></mxCell><mxCell id="core-mdl-rng-a" value="+ kode: Char&lt;br&gt;+ name: Char&lt;br&gt;+ kapasitas: Integer" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="core-mdl-rng"><mxGeometry x="0" y="70" width="370" height="53" as="geometry"/></mxCell><mxCell id="core-mdl-per" value="&lt;font style='font-size:10px'&gt;«Core» model baru [M]&lt;/font&gt;&lt;br&gt;&lt;b&gt;labfik.periode&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Periode · dirancang Tata Kelola&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#6C4A87'&gt;&lt;b&gt;{_name baru}&lt;/b&gt;&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=70;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="460" y="1018" width="370" height="198" as="geometry"/></mxCell><mxCell id="core-mdl-per-a" value="+ name: Char&lt;br&gt;+ jenis: Selection {semester, tahun_anggaran}&lt;br&gt;+ tanggal_mulai: Date&lt;br&gt;+ tanggal_selesai: Date" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="core-mdl-per"><mxGeometry x="0" y="70" width="370" height="68" as="geometry"/></mxCell><mxCell id="core-mdl-mk" value="&lt;font style='font-size:10px'&gt;«Core» model baru [M]&lt;/font&gt;&lt;br&gt;&lt;b&gt;labfik.mata.kuliah&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Mata Kuliah · dirancang Praktikum&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#6C4A87'&gt;&lt;b&gt;{_name baru}&lt;/b&gt;&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=70;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="860" y="1018" width="370" height="198" as="geometry"/></mxCell><mxCell id="core-mdl-mk-a" value="+ kode: Char «unique»&lt;br&gt;+ name: Char&lt;br&gt;+ prodi: Selection&lt;br&gt;+ semester: Integer&lt;br&gt;&lt;i&gt;tipe field: [USULAN PENULIS]&lt;/i&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="core-mdl-mk"><mxGeometry x="0" y="70" width="370" height="83" as="geometry"/></mxCell><mxCell id="core-mdl-kls" value="&lt;font style='font-size:10px'&gt;«Core» model baru [M]&lt;/font&gt;&lt;br&gt;&lt;b&gt;labfik.kelas&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Kelas · dirancang Praktikum&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#6C4A87'&gt;&lt;b&gt;{_name baru}&lt;/b&gt;&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=70;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1260" y="1018" width="370" height="198" as="geometry"/></mxCell><mxCell id="core-mdl-kls-a" value="+ mata_kuliah_id: labfik.mata.kuliah&lt;br&gt;+ periode_id: labfik.periode&lt;br&gt;+ name: Char&lt;br&gt;+ jumlah_mahasiswa: Integer&lt;br&gt;+ dosen_koordinator_id: hr.employee&lt;br&gt;+ dosen_ids: hr.employee [*]&lt;br&gt;&lt;i&gt;unique(mata_kuliah_id, periode_id, name)&lt;/i&gt;&lt;br&gt;&lt;i&gt;tipe field: [USULAN PENULIS]&lt;/i&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="core-mdl-kls"><mxGeometry x="0" y="70" width="370" height="128" as="geometry"/></mxCell><mxCell id="core-mdl-row4" value="Baris 4 · Transaksi Core: riwayat pengesahan dan sesi praktikum" style="text;html=1;fontSize=12;fontStyle=3;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="60" y="1256" width="1570" height="24" as="geometry"/></mxCell><mxCell id="core-mdl-log" value="&lt;font style='font-size:10px'&gt;«Core» model baru [T]&lt;/font&gt;&lt;br&gt;&lt;b&gt;labfik.approval.log&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Riwayat Pengesahan · dirancang Tata Kelola&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#6C4A87'&gt;&lt;b&gt;{_name baru; ditulis approval.mixin}&lt;/b&gt;&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=70;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="1286" width="370" height="330" as="geometry"/></mxCell><mxCell id="core-mdl-log-a" value="+ res_model: Char&lt;br&gt;+ res_id: Integer&lt;br&gt;+ kejadian: Selection {diajukan, dikembalikan,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;berkas_diunggah, disahkan, diganti, dicabut, kedaluwarsa}&lt;br&gt;+ waktu: Datetime&lt;br&gt;+ pelaku_id: res.users [0..1]&lt;br&gt;+ pengesah_id: hr.employee [0..1]&lt;br&gt;+ alasan: Text [0..1]&lt;br&gt;+ berkas: Binary [0..1]" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="core-mdl-log"><mxGeometry x="0" y="70" width="370" height="143" as="geometry"/></mxCell><mxCell id="core-mdl-log-s" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;html=1;" vertex="1" parent="core-mdl-log"><mxGeometry x="0" y="213" width="370" height="8" as="geometry"/></mxCell><mxCell id="core-mdl-log-m" value="+ write() «override» (selalu ditolak)&lt;br&gt;+ unlink() «override» (selalu ditolak)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="core-mdl-log"><mxGeometry x="0" y="221" width="370" height="109" as="geometry"/></mxCell><mxCell id="core-mdl-ses" value="&lt;font style='font-size:10px'&gt;«Core» model baru [T]&lt;/font&gt;&lt;br&gt;&lt;b&gt;labfik.sesi&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Sesi Praktikum · dirancang Praktikum&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#6C4A87'&gt;&lt;b&gt;{_name baru; tidak mewarisi op.session}&lt;/b&gt;&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=70;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="460" y="1286" width="370" height="330" as="geometry"/></mxCell><mxCell id="core-mdl-ses-a" value="+ kelas_id: labfik.kelas&lt;br&gt;+ pertemuan_ke: Integer&lt;br&gt;+ jenis_pertemuan: Selection {praktikum, uts, uas}&lt;br&gt;+ moda: Selection {luring, daring}&lt;br&gt;+ tanggal: Date&lt;br&gt;+ jam_mulai: Float&lt;br&gt;+ jam_selesai: Float&lt;br&gt;+ ruang_id: labfik.ruang&lt;br&gt;+ state: Selection {terjadwal, terlaksana, batal}&lt;br&gt;+ sesi_asal_id: labfik.sesi [0..1] (bila pengganti)&lt;br&gt;+ is_terpublikasi, is_ditunda, is_diganti: Boolean {compute}&lt;br&gt;&lt;i&gt;tipe field: [USULAN PENULIS]&lt;/i&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="core-mdl-ses"><mxGeometry x="0" y="70" width="370" height="188" as="geometry"/></mxCell><mxCell id="core-mdl-sesi-aturan" value="&lt;b&gt;Aturan pakai bersama transaksi Core&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;labfik.sesi&lt;/b&gt; [USULAN PENULIS; KONFIRMASI kelompok]&lt;br&gt;• Dibangkitkan hanya oleh PKG-15 (Praktikum), atau sebagai sesi pengganti lewat Perubahan Sesi PKG-18.&lt;br&gt;• Satu Sesi asli per (kelas, pertemuan).&lt;br&gt;• Hanya modul Praktikum yang mengubah &lt;code&gt;state&lt;/code&gt;.&lt;br&gt;• Modul lain &lt;b&gt;tidak menambah field&lt;/b&gt; ke &lt;code&gt;labfik.sesi&lt;/code&gt;; buat model sendiri yang merujuk &lt;code&gt;sesi_id&lt;/code&gt; (mis. penugasan petugas di SDM).&lt;br&gt;• Sesi yang sudah punya jurnal atau penugasan tidak boleh dihapus.&lt;br&gt;• Status lain dihitung, tidak disimpan: terpublikasi = jadwal periode disahkan; ditunda = ada perubahan yang belum diputuskan; diganti = ada sesi yang merujuk sesi ini lewat &lt;code&gt;sesi_asal_id&lt;/code&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;labfik.approval.log&lt;/b&gt;&lt;br&gt;• Tidak diisi langsung oleh modul: setiap baris dibuat &lt;code&gt;approval.mixin&lt;/code&gt; saat status dokumen berubah.&lt;br&gt;• Satu tabel untuk semua dokumen yang disahkan (&lt;code&gt;res_model&lt;/code&gt; + &lt;code&gt;res_id&lt;/code&gt;); tidak bisa diubah atau dihapus." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="860" y="1286" width="770" height="330" as="geometry"/></mxCell><mxCell id="core-mdl-leg" value="&lt;b&gt;Notasi&lt;/b&gt; (UML class diagram, Wazlawick 2024 §13.6)&lt;br&gt;• Ungu, nama miring «AbstractModel» = mixin; tidak punya tabel sendiri. Model lain memakainya dengan &lt;code&gt;_inherit = ['labfik.approval.mixin', …]&lt;/code&gt; dan mewarisi field serta method-nya.&lt;br&gt;• Abu-abu «Odoo» diperluas = model bawaan Odoo yang ditambah field dengan &lt;code&gt;_inherit&lt;/code&gt; tanpa &lt;code&gt;_name&lt;/code&gt;; nama model tetap &lt;code&gt;hr.employee&lt;/code&gt; / &lt;code&gt;hr.job&lt;/code&gt;.&lt;br&gt;• Putih «Core» model baru = model dengan &lt;code&gt;_name&lt;/code&gt; sendiri di &lt;code&gt;labfik_core&lt;/code&gt;.&lt;br&gt;• Relasi ditulis sebagai field: &lt;code&gt;nama_id: model&lt;/code&gt; = Many2one; &lt;code&gt;[*]&lt;/code&gt; = One2many/Many2many; &lt;code&gt;[0..1]&lt;/code&gt; = boleh kosong.&lt;br&gt;• &lt;code&gt;+&lt;/code&gt; publik, &lt;code&gt;#&lt;/code&gt; internal. {abstract} = wajib diisi model turunan; {hook} = boleh diisi; «override» = mengganti method bawaan; {compute}/{related} = dihitung, tidak diisi pengguna.&lt;br&gt;• [M] master, [T] transaksi. Sesi adalah satu-satunya transaksi bisnis di Core; Riwayat Pengesahan adalah log teknis milik approval.mixin." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="60" y="1656" width="370" height="360" as="geometry"/></mxCell><mxCell id="core-mdl-use" value="&lt;b&gt;Cara memakai Core&lt;/b&gt;&lt;br&gt;• Addon modul cukup &lt;code&gt;depends: ['labfik_core']&lt;/code&gt;; &lt;code&gt;labfik_core&lt;/code&gt; sendiri hanya &lt;code&gt;depends: ['hr', 'mail']&lt;/code&gt;.&lt;br&gt;• Pakai, warisi, atau perluas dari addon modulmu; &lt;b&gt;jangan membuat versi sendiri&lt;/b&gt; dan jangan mengubah Core. Butuh perubahan? Usulkan ke perancangnya (kolom &quot;dirancang&quot;).&lt;br&gt;• Semua rujukan orang ke &lt;code&gt;hr.employee&lt;/code&gt;. Asisten lab = &lt;code&gt;hr.employee&lt;/code&gt; jenis &lt;i&gt;asisten&lt;/i&gt;, jabatan &lt;b&gt;Asisten Praktikum&lt;/b&gt;. Pihak eksternal tidak dicatat.&lt;br&gt;• Pengesahan: isi {abstract}/{hook}, jangan override &lt;code&gt;action_ajukan()&lt;/code&gt;/&lt;code&gt;action_sahkan()&lt;/code&gt;. Wewenang lewat &lt;code&gt;labfik.jabatan.wewenang&lt;/code&gt; (tambah &lt;code&gt;jenis_dokumen&lt;/code&gt; dengan &lt;code&gt;selection_add&lt;/code&gt;).&lt;br&gt;• Tidak ada di Core: &lt;code&gt;labfik.controlled.mixin&lt;/code&gt; (dihapus); Dokumen Induk, Versi, KPI (di &lt;code&gt;labfik_org&lt;/code&gt;, pakai modul jembatan bila perlu)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="460" y="1656" width="370" height="360" as="geometry"/></mxCell><mxCell id="core-mdl-grp" value="&lt;b&gt;Grup akses Core&lt;/b&gt; (&lt;code&gt;res.groups&lt;/code&gt;, data XML &lt;code&gt;labfik_core&lt;/code&gt;; bukan model)&lt;br&gt;&lt;br&gt;&lt;code&gt;base.group_user&lt;/code&gt;&lt;br&gt;&amp;nbsp;└ &lt;b&gt;labfik_pengguna&lt;/b&gt;: membaca dokumen yang sudah &lt;i&gt;disahkan&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;└ &lt;b&gt;labfik_laboran&lt;/b&gt;: mencatat dokumen, realisasi, rekaman bukti&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;└ &lt;b&gt;labfik_kalab&lt;/b&gt;: semua master; mengembalikan, mengesahkan, mencabut&lt;br&gt;&lt;br&gt;• Grup lebih tinggi mewarisi hak grup di bawahnya (&lt;code&gt;implied_ids&lt;/code&gt;).&lt;br&gt;• Grup ≠ jabatan. Siapa yang berwenang &lt;b&gt;mengesahkan sebagai pejabat&lt;/b&gt; diatur &lt;code&gt;labfik.jabatan.wewenang&lt;/code&gt;, bukan grup; karena itu Dekan tidak perlu akun.&lt;br&gt;• Aturan penempatan: grup masuk Core bila dirujuk kode Core atau dipakai lebih dari satu modul; selain itu di modul pemakainya. Contoh: &lt;code&gt;labfik_dosen&lt;/code&gt;, &lt;code&gt;labfik_asisten&lt;/code&gt; ada di &lt;code&gt;labfik_praktikum&lt;/code&gt;, bukan Core." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="860" y="1656" width="370" height="360" as="geometry"/></mxCell><mxCell id="core-mdl-src" value="&lt;b&gt;Sumber&lt;/b&gt;: rancangan/kontrak-core.md (rangkuman branch febriyan-, herrens-, zahir-skripsi) · 15 November 2026 · disusun Febriyan&lt;br&gt;Model rancangan Tata Kelola sudah final (DCD). Mata Kuliah, Kelas, dan Sesi dari Praktikum: nama field ditetapkan, tipe field &lt;b&gt;[USULAN PENULIS]&lt;/b&gt; sampai DCD Praktikum.&lt;br&gt;&lt;b&gt;[KONFIRMASI kelompok]&lt;/b&gt; penempatan semua model ini di &lt;code&gt;labfik_core&lt;/code&gt;. Tampilan belum dicek di draw.io; struktur lolos validate.py." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1260" y="1656" width="370" height="360" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
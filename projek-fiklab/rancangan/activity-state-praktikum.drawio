#000000;" vertex="1" parent="1"><mxGeometry x="880" y="311" width="28" height="28" as="geometry"/></mxCell><mxCell id="prk-stm-s2-t0" value="ajukan [tidak bentrok]" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;fontFamily=Times New Roman;" edge="1" parent="1" source="prk-stm-s2-init" target="prk-stm-s2-aju"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prk-stm-s2-t1" value="setujui [jabatan berwenang: KaLab ∧ tidak bentrok]&lt;br&gt;/ perbarui jadwal terpadu atau ubah Sesi (S1)" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;fontFamily=Times New Roman;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-stm-s2-aju" target="prk-stm-s2-set"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="305" y="65"/></Array></mxGeometry></mxCell><mxCell id="prk-stm-s2-t2" value="tolak [alasan terisi] / catat alasan" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;fontFamily=Times New Roman;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-stm-s2-aju" target="prk-stm-s2-tol"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prk-stm-s2-t3" value="tarik kembali [oleh pengaju] *" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;fontFamily=Times New Roman;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-stm-s2-aju" target="prk-stm-s2-tar"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="305" y="325"/></Array></mxGeometry></mxCell><mxCell id="prk-stm-s2-tf1" value="" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;fontFamily=Times New Roman;" edge="1" parent="1" source="prk-stm-s2-set" target="prk-stm-s2-f1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prk-stm-s2-tf2" value="" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;fontFamily=Times New Roman;" edge="1" parent="1" source="prk-stm-s2-tol" target="prk-stm-s2-f2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prk-stm-s2-tf3" value="" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;fontFamily=Times New Roman;" edge="1" parent="1" source="prk-stm-s2-tar" target="prk-stm-s2-f3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prk-stm-s2-ket" value="* transisi yang ditemukan melalui tabel status × transisi" style="text;html=1;fontSize=11;align=left;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="420" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="prk-stm-s3" name="State Machine TO-BE (3-3) - Survei Kepuasan"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1390" pageHeight="352" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="prk-stm-s3-init" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="50" y="108" width="24" height="24" as="geometry"/></mxCell><mxCell id="prk-stm-s3-dra" value="Draf" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="130" y="95" width="150" height="50" as="geometry"/></mxCell><mxCell id="prk-stm-s3-tet" value="Ditetapkan&lt;br&gt;&lt;font style='font-size:10px;font-weight:normal'&gt;(K1–K2 lengkap)&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="470" y="95" width="160" height="50" as="geometry"/></mxCell><mxCell id="prk-stm-s3-eva" value="Dievaluasi&lt;br&gt;&lt;font style='font-size:10px;font-weight:normal'&gt;(K3 lengkap)&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="830" y="95" width="160" height="50" as="geometry"/></mxCell><mxCell id="prk-stm-s3-sel" value="Siklus Selesai&lt;br&gt;&lt;font style='font-size:10px;font-weight:normal'&gt;(K4 lengkap)&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="1190" y="95" width="160" height="50" as="geometry"/></mxCell><mxCell id="prk-stm-s3-f1" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1256" y="250" width="28" height="28" as="geometry"/></mxCell><mxCell id="prk-stm-s3-t0" value="buat" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;fontFamily=Times New Roman;" edge="1" parent="1" source="prk-stm-s3-init" target="prk-stm-s3-dra"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prk-stm-s3-t1" value="tetapkan [enam aspek ∧ butir terbuka&lt;br&gt;∧ target respons ∧ jabatan berwenang]" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;fontFamily=Times New Roman;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-stm-s3-dra" target="prk-stm-s3-tet"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="205" y="40"/><mxPoint x="550" y="40"/></Array></mxGeometry></mxCell><mxCell id="prk-stm-s3-t2" value="batalkan penetapan&lt;br&gt;[sebelum tanggal buka] *" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;fontFamily=Times New Roman;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-stm-s3-tet" target="prk-stm-s3-dra"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="550" y="200"/><mxPoint x="205" y="200"/></Array></mxGeometry></mxCell><mxCell id="prk-stm-s3-t3" value="catat evaluasi + RTL&lt;br&gt;[tanggal tutup terlewati]" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;fontFamily=Times New Roman;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-stm-s3-tet" target="prk-stm-s3-eva"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prk-stm-s3-t4" value="nilai efektivitas semua RTL&lt;br&gt;[survei periode berikutnya dievaluasi]" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;fontFamily=Times New Roman;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-stm-s3-eva" target="prk-stm-s3-sel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prk-stm-s3-t5" value="" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;fontFamily=Times New Roman;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="prk-stm-s3-sel" target="prk-stm-s3-f1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prk-stm-s3-ket" value="* transisi yang ditemukan melalui tabel status × transisi" style="text;html=1;fontSize=11;align=left;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="40" y="298" width="420" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="prk-act-notes" name="Catatan TO-BE (bahan kerja) - Activity dan State Machine"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="2068" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="prk-act-notes-title" value="Catatan diagram activity dan state machine (bahan kerja, tidak disisipkan ke naskah)" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1200" height="36" as="geometry"/></mxCell><mxCell id="prk-act-notes-legend" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §3.2): «user» = aktor memakai sistem; «service» = dikerjakan sistem otomatis; «manual» = di luar sistem; «call behavior» (simbol garpu ⋔) = memanggil activity lain; ◇ = keputusan/gabungan, kondisi ditulis [guard] di panah; ⧗ = menunggu waktu; bar hitam = fork/join. Gaya polos hitam-putih (CLAUDE.md bagian 5)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1260" height="60" as="geometry"/></mxCell><mxCell id="prk-act-notes-legend2" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §3.3): &lt;code&gt;event [guard] / efek&lt;/code&gt;. Status akhir = status dengan panah ke simpul akhir ◉. Tanda &lt;b&gt;*&lt;/b&gt; di akhir label = transisi yang &lt;b&gt;baru ditemukan&lt;/b&gt; lewat tabel status × transisi (proses-bisnis-praktikum.md bagian 3) dan belum ada di analisis maupun kebutuhan." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="1260" height="50" as="geometry"/></mxCell><mxCell id="prk-act-notes-h0" value="&lt;b&gt;A1 · Persiapan Jadwal dan Modul Periode (PKG-15)&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="410" height="40" as="geometry"/></mxCell><mxCell id="prk-act-notes-n0-0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §3.2): «user» = aktor memakai sistem; «service» = dikerjakan sistem otomatis; «manual» = di luar sistem; «call behavior» (simbol garpu ⋔) = memanggil activity lain; ◇ = keputusan/gabungan, kondisi ditulis [guard] di panah; ⧗ = menunggu waktu; bar hitam = fork/join. Gaya polos hitam-putih (CLAUDE.md bagian 5)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="246" width="410" height="150" as="geometry"/></mxCell><mxCell id="prk-act-notes-n0-1" value="&lt;b&gt;Kaitan ke kriteria PKG-15&lt;/b&gt;&lt;br&gt;C1 jadwal sah: &lt;i&gt;Sahkan dokumen (A1 Tata Kelola)&lt;/i&gt; + &lt;i&gt;Catat tanggal publikasi&lt;/i&gt;; sesi periode itu terbaca terpublikasi (&lt;i&gt;is_terpublikasi&lt;/i&gt;) (KF-PRK-06)&lt;br&gt;C2 tanpa bentrok: &lt;i&gt;Periksa bentrok ruang&lt;/i&gt;; kelas yang bentrok tidak dibangkitkan dan hanya ditampilkan, tidak disimpan [ASUMSI] (KF-PRK-04)&lt;br&gt;C3 kapasitas: &lt;i&gt;Periksa kapasitas ruang&lt;/i&gt;, hanya peringatan (KF-PRK-05)&lt;br&gt;C4 modul berlaku: &lt;i&gt;Terbitkan versi modul&lt;/i&gt; + &lt;i&gt;Ganti versi modul lama&lt;/i&gt; (KF-PRK-12, 13)&lt;br&gt;Rekaman konflik (bukti 5, KF-PRK-11) diambil dari penolakan pemakaian beralasan bentrok (A2) dan sesi yang diganti (A4)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="406" width="410" height="200" as="geometry"/></mxCell><mxCell id="prk-act-notes-n0-2" value="&lt;b&gt;Jadwal disusun tim jadwal fakultas&lt;/b&gt; (di luar sistem); KaLab hanya menyetujui (keterangan Herrens, 14 Nov 2026). &lt;b&gt;[ASUMSI]&lt;/b&gt; Jadwal masuk lewat &lt;b&gt;impor berkas&lt;/b&gt; (Excel/CSV: kode MK, kelas, hari, jam, ruang, dosen), tanpa API. Jadwal berupa &lt;b&gt;pola mingguan tetap per kelas&lt;/b&gt; selama satu semester (mis. Senin 13.00 untuk 16 pertemuan); satu baris per kelas. Pertemuan 8 (UTS) dan 16 (UAS) tetap di kelas pada jadwal yang sama (ujian atau presentasi proyek), jadi ikut dibangkitkan dengan jenis UTS/UAS. Jalan pengganti: laboran mengisi pola mingguan per kelas." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="616" width="410" height="150" as="geometry"/></mxCell><mxCell id="prk-act-notes-n0-3" value="&lt;b&gt;«call behavior»&lt;/b&gt; memanggil activity &lt;b&gt;A1 Pengesahan Dokumen&lt;/b&gt; milik modul Tata Kelola (&lt;code&gt;labfik.approval.mixin&lt;/code&gt;): ajukan, unggah PDF bertanda tangan, sahkan. Tidak digambar ulang." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="776" width="410" height="80" as="geometry"/></mxCell><mxCell id="prk-act-notes-n0-4" value="&lt;b&gt;Tidak digambar&lt;/b&gt; (§3.4, cukup dikelola): data Mata Kuliah dan Kelas («CRUDL»)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="866" width="410" height="50" as="geometry"/></mxCell><mxCell id="prk-act-notes-n0-5" value="&lt;b&gt;[KONFIRMASI]&lt;/b&gt; Bentuk dan isi berkas jadwal dari fakultas, dan kapan dikirim (P2)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="926" width="410" height="50" as="geometry"/></mxCell><mxCell id="prk-act-notes-n0-6" value="Draf 14 Nov 2026 · Herrens · sumber: analisis PKG-15–20, studi dokumen (POB 2025), kebutuhan KF-PRK" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="986" width="410" height="50" as="geometry"/></mxCell><mxCell id="prk-act-notes-h1" value="&lt;b&gt;A2 · Pemakaian Lab di Luar Praktikum (PKG-15)&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="465" y="200" width="410" height="40" as="geometry"/></mxCell><mxCell id="prk-act-notes-n1-0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §3.2): «user» = aktor memakai sistem; «service» = dikerjakan sistem otomatis; «manual» = di luar sistem; «call behavior» (simbol garpu ⋔) = memanggil activity lain; ◇ = keputusan/gabungan, kondisi ditulis [guard] di panah; ⧗ = menunggu waktu; bar hitam = fork/join. Gaya polos hitam-putih (CLAUDE.md bagian 5)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="465" y="246" width="410" height="150" as="geometry"/></mxCell><mxCell id="prk-act-notes-n1-1" value="&lt;b&gt;Kaitan ke kriteria PKG-15&lt;/b&gt;&lt;br&gt;Bukti 1 jadwal terpadu: &lt;i&gt;Perbarui jadwal terpadu&lt;/i&gt; (KF-PRK-10)&lt;br&gt;Bukti 2 persetujuan pemakaian: &lt;i&gt;Setujui / Tolak pemakaian lab&lt;/i&gt; (KF-PRK-09)&lt;br&gt;Bukti 5 rekaman konflik: &lt;i&gt;Tolak pemakaian lab&lt;/i&gt; beralasan bentrok (&lt;i&gt;karena_bentrok&lt;/i&gt;) (KF-PRK-09, 11). Bentrok saat dicatat hanya ditampilkan agar waktunya diubah; pengajuan baru tersimpan bila tidak bentrok" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="465" y="406" width="410" height="130" as="geometry"/></mxCell><mxCell id="prk-act-notes-n1-2" value="&lt;b&gt;Pengguna lab tidak punya akun Odoo&lt;/b&gt; (keterangan Herrens, 16 Nov 2026): permintaannya disampaikan langsung ke laboran, laboran yang mencatat pengajuan dan menyampaikan keputusan. Penyetuju = KaLab. Status pengajuan mengikuti state machine S2." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="465" y="546" width="410" height="90" as="geometry"/></mxCell><mxCell id="prk-act-notes-n1-3" value="&lt;b&gt;Cek ulang saat disetujui&lt;/b&gt; (AB-PRK-01): dua pengajuan untuk ruang dan jam yang sama bisa sama-sama Diajukan. &lt;i&gt;Setujui pemakaian lab&lt;/i&gt; memeriksa bentrok lagi; bila sudah ada yang disetujui lebih dulu, KaLab menolak dengan &lt;i&gt;karena_bentrok&lt;/i&gt;." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="465" y="646" width="410" height="90" as="geometry"/></mxCell><mxCell id="prk-act-notes-n1-4" value="&lt;b&gt;[KONFIRMASI]&lt;/b&gt; Jenis pemakaian di luar praktikum dan contoh kejadian bentrok (wawancara P3)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="465" y="746" width="410" height="50" as="geometry"/></mxCell><mxCell id="prk-act-notes-n1-5" value="Draf 14 Nov 2026 · Herrens · sumber: analisis PKG-15–20, studi dokumen (POB 2025), kebutuhan KF-PRK" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="465" y="806" width="410" height="50" as="geometry"/></mxCell><mxCell id="prk-act-notes-h2" value="&lt;b&gt;A3 · Pelaksanaan Satu Sesi Praktikum (PKG-16, 17, 18)&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="890" y="200" width="410" height="40" as="geometry"/></mxCell><mxCell id="prk-act-notes-n2-0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §3.2): «user» = aktor memakai sistem; «service» = dikerjakan sistem otomatis; «manual» = di luar sistem; «call behavior» (simbol garpu ⋔) = memanggil activity lain; ◇ = keputusan/gabungan, kondisi ditulis [guard] di panah; ⧗ = menunggu waktu; bar hitam = fork/join. Gaya polos hitam-putih (CLAUDE.md bagian 5)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="890" y="246" width="410" height="150" as="geometry"/></mxCell><mxCell id="prk-act-notes-n2-1" value="&lt;b&gt;Kaitan ke kriteria&lt;/b&gt;&lt;br&gt;PKG-16 S1–S4: &lt;i&gt;Mulai pemeriksaan&lt;/i&gt; s.d. &lt;i&gt;Tetapkan keputusan kesiapan&lt;/i&gt;, sebelum ⧗ jam mulai (KF-PRK-15–18)&lt;br&gt;PKG-17 B1–B3: butir bahan dari modul + &lt;i&gt;Setujui substitusi bahan&lt;/i&gt; (KF-PRK-16, 19, 20)&lt;br&gt;PKG-18 C1–C5: &lt;i&gt;Isi jurnal&lt;/i&gt; s.d. &lt;i&gt;Ubah status sesi&lt;/i&gt; (KF-PRK-22–26)&lt;br&gt;&lt;i&gt;Buat butir pemeriksaan&lt;/i&gt; juga membaca alat ruang dari master Alat Core: alat tidak tersedia menjadi peringatan, jumlah PC tersedia menjadi isian awal (hanya dibaca, KF-PRK-52, O)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="890" y="406" width="410" height="150" as="geometry"/></mxCell><mxCell id="prk-act-notes-n2-2" value="&lt;b&gt;Penilaian praktikan (PKG-19) tidak dicatat per sesi&lt;/b&gt;: tugas punya tenggat sendiri dan tidak setiap sesi ada tugas. Penilaian dilihat lewat tautan LeADS per kelas (KF-PRK-31); impor Excel bila tersedia (KF-PRK-50). Keputusan 14 Nov 2026." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="890" y="566" width="410" height="80" as="geometry"/></mxCell><mxCell id="prk-act-notes-n2-3" value="&lt;b&gt;Validasi jurnal&lt;/b&gt; (KF-PRK-25): jam selesai &amp;gt; jam mulai; satu jurnal terkirim per sesi; presensi dosen dan laboran terisi. Identitas sesi diambil dari Sesi, tidak diketik ulang." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="890" y="656" width="410" height="80" as="geometry"/></mxCell><mxCell id="prk-act-notes-n2-4" value="&lt;b&gt;Pengisi Jurnal&lt;/b&gt; (aktor abstrak): asisten yang bertugas; untuk kelas tanpa asisten, dosen yang mengajar [ASUMSI]." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="890" y="746" width="410" height="60" as="geometry"/></mxCell><mxCell id="prk-act-notes-n2-5" value="&lt;b&gt;[KONFIRMASI]&lt;/b&gt; Pemeriksaan per sesi atau per ruang per hari (P8). Siapa pengisi jurnal kelas tanpa asisten (P10, P13)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="890" y="816" width="410" height="60" as="geometry"/></mxCell><mxCell id="prk-act-notes-n2-6" value="Draf 14 Nov 2026 · Herrens · sumber: analisis PKG-15–20, studi dokumen (POB 2025), kebutuhan KF-PRK" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="890" y="886" width="410" height="50" as="geometry"/></mxCell><mxCell id="prk-act-notes-h3" value="&lt;b&gt;A4 · Perubahan Sesi (PKG-18)&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1066" width="410" height="40" as="geometry"/></mxCell><mxCell id="prk-act-notes-n3-0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §3.2): «user» = aktor memakai sistem; «service» = dikerjakan sistem otomatis; «manual» = di luar sistem; «call behavior» (simbol garpu ⋔) = memanggil activity lain; ◇ = keputusan/gabungan, kondisi ditulis [guard] di panah; ⧗ = menunggu waktu; bar hitam = fork/join. Gaya polos hitam-putih (CLAUDE.md bagian 5)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="1112" width="410" height="150" as="geometry"/></mxCell><mxCell id="prk-act-notes-n3-1" value="&lt;b&gt;Kaitan ke kriteria PKG-18&lt;/b&gt;&lt;br&gt;C2 (atau perubahan sah): &lt;i&gt;Setujui perubahan sesi&lt;/i&gt; (KF-PRK-28)&lt;br&gt;Bukti 6 perubahan disetujui, bukti 7 penggantian sesi: &lt;i&gt;Bangkitkan sesi pengganti&lt;/i&gt; (rujuk sesi asal)&lt;br&gt;Sesi tertunda dihitung memenuhi hanya bila pengganti terlaksana sebelum periode ditutup" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="1272" width="410" height="110" as="geometry"/></mxCell><mxCell id="prk-act-notes-n3-2" value="&lt;b&gt;Ubah status sesi asal&lt;/b&gt;: dengan pengganti atau batal menjadi &lt;i&gt;batal&lt;/i&gt; (pengganti terbaca lewat &lt;i&gt;is_diganti&lt;/i&gt;); daring: state tetap, moda menjadi daring (lihat S1)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="1392" width="410" height="70" as="geometry"/></mxCell><mxCell id="prk-act-notes-n3-3" value="&lt;b&gt;Pengaju utama&lt;/b&gt;: dosen pengampu (kelas jadi daring atau jadwal diubah; keterangan Herrens, 14 Nov 2026). Juga dipanggil dari A3 (keputusan tunda). Penyetuju = KaLab." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="1472" width="410" height="60" as="geometry"/></mxCell><mxCell id="prk-act-notes-n3-4" value="&lt;b&gt;[KONFIRMASI]&lt;/b&gt; Sesi daring dianggap sah? (pengaturan KaLab, KF-PRK-43; wawancara P12)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="1542" width="410" height="50" as="geometry"/></mxCell><mxCell id="prk-act-notes-n3-5" value="Draf 14 Nov 2026 · Herrens · sumber: analisis PKG-15–20, studi dokumen (POB 2025), kebutuhan KF-PRK" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="1602" width="410" height="50" as="geometry"/></mxCell><mxCell id="prk-act-notes-h4" value="&lt;b&gt;A5 · Survei Kepuasan Pengguna per Periode (PKG-20)&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="465" y="1066" width="410" height="40" as="geometry"/></mxCell><mxCell id="prk-act-notes-n4-0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §3.2): «user» = aktor memakai sistem; «service» = dikerjakan sistem otomatis; «manual» = di luar sistem; «call behavior» (simbol garpu ⋔) = memanggil activity lain; ◇ = keputusan/gabungan, kondisi ditulis [guard] di panah; ⧗ = menunggu waktu; bar hitam = fork/join. Gaya polos hitam-putih (CLAUDE.md bagian 5)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="465" y="1112" width="410" height="150" as="geometry"/></mxCell><mxCell id="prk-act-notes-n4-1" value="&lt;b&gt;Kaitan ke kriteria PKG-20&lt;/b&gt; (berurutan)&lt;br&gt;K1 ditetapkan: &lt;i&gt;Susun survei&lt;/i&gt; + &lt;i&gt;Tetapkan survei&lt;/i&gt; (KF-PRK-33, 34)&lt;br&gt;K2 enam aspek + target respons: &lt;i&gt;Periksa kelengkapan survei&lt;/i&gt;&lt;br&gt;K3 dilaksanakan dan dianalisis: &lt;i&gt;Isi survei&lt;/i&gt;, &lt;i&gt;Hitung rekap&lt;/i&gt;, &lt;i&gt;Catat evaluasi&lt;/i&gt; (KF-PRK-35, 36, 38)&lt;br&gt;K4 perbaikan dan efektivitas: &lt;i&gt;Tetapkan RTL&lt;/i&gt;, &lt;i&gt;Nilai efektivitas&lt;/i&gt; (KF-PRK-36, 37)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="465" y="1272" width="410" height="150" as="geometry"/></mxCell><mxCell id="prk-act-notes-n4-2" value="&lt;b&gt;Isi survei&lt;/b&gt; dilakukan banyak responden secara anonim lewat tautan addon &lt;code&gt;survey&lt;/code&gt;, selama survei dibuka." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="465" y="1432" width="410" height="60" as="geometry"/></mxCell><mxCell id="prk-act-notes-n4-3" value="&lt;b&gt;Periksa kelengkapan&lt;/b&gt; = guard transisi &lt;i&gt;tetapkan&lt;/i&gt; di S3: survei yang belum lengkap tetap Draf; KaLab melengkapinya lalu menetapkan ulang." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="465" y="1502" width="410" height="70" as="geometry"/></mxCell><mxCell id="prk-act-notes-n4-4" value="&lt;b&gt;⧗ Survei periode berikutnya dianalisis&lt;/b&gt;: K4 baru bisa lengkap pada periode kedua." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="465" y="1582" width="410" height="60" as="geometry"/></mxCell><mxCell id="prk-act-notes-n4-5" value="&lt;b&gt;[KONFIRMASI]&lt;/b&gt; Waktu survei, responden, dan siapa yang menindaklanjuti (P16, P17)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="465" y="1652" width="410" height="50" as="geometry"/></mxCell><mxCell id="prk-act-notes-n4-6" value="Draf 14 Nov 2026 · Herrens · sumber: analisis PKG-15–20, studi dokumen (POB 2025), kebutuhan KF-PRK" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="465" y="1712" width="410" height="50" as="geometry"/></mxCell><mxCell id="prk-act-notes-h5" value="&lt;b&gt;S1 · State machine Sesi praktikum (&lt;code&gt;labfik.sesi.state&lt;/code&gt;, Core: terjadwal / terlaksana / batal)&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="890" y="1066" width="410" height="40" as="geometry"/></mxCell><mxCell id="prk-act-notes-n5-0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §3.3): &lt;code&gt;event [guard] / efek&lt;/code&gt;. &lt;code&gt;/nama&lt;/code&gt; = atribut turunan {compute}, bukan state." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="890" y="1112" width="410" height="60" as="geometry"/></mxCell><mxCell id="prk-act-notes-n5-1" value="&lt;b&gt;Atribut hitung, bukan state&lt;/b&gt; (Wazlawick §9.3.1; kontrak Core C-9, keputusan I-1, 15 Nov 2026):&lt;br&gt;• &lt;i&gt;is_terpublikasi&lt;/i&gt; = Penetapan Jadwal periode itu disahkan (dulu Rencana/Terpublikasi)&lt;br&gt;• &lt;i&gt;is_ditunda&lt;/i&gt; = ada Perubahan Sesi yang masih diajukan&lt;br&gt;• &lt;i&gt;is_terlewat&lt;/i&gt; = tanggal lewat, belum ada jurnal&lt;br&gt;• &lt;i&gt;is_diganti&lt;/i&gt; = ada sesi lain dengan sesi_asal_id = sesi ini" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="890" y="1182" width="410" height="120" as="geometry"/></mxCell><mxCell id="prk-act-notes-n5-2" value="&lt;b&gt;Akibatnya&lt;/b&gt;: jadwal dicabut (KF-PRK-45) dan perubahan ditolak (KF-PRK-46) tidak lagi mengubah state; keduanya terbaca otomatis dari &lt;i&gt;is_terpublikasi&lt;/i&gt; dan &lt;i&gt;is_ditunda&lt;/i&gt;. Status disamakan dengan modul SDM; hanya Praktikum yang mengubah state." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="890" y="1312" width="410" height="80" as="geometry"/></mxCell><mxCell id="prk-act-notes-n5-3" value="Pemetaan 6 status → 3 status diterima Herrens, 16 Nov 2026. Draf 14 Nov 2026 · Herrens · sumber: analisis PKG-15–20, studi dokumen (POB 2025), kebutuhan KF-PRK" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="890" y="1402" width="410" height="50" as="geometry"/></mxCell><mxCell id="prk-act-notes-h6" value="&lt;b&gt;S2 · State machine pengajuan dengan persetujuan sederhana: Pemakaian Lab dan Perubahan Sesi&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1792" width="410" height="40" as="geometry"/></mxCell><mxCell id="prk-act-notes-n6-0" value="&lt;b&gt;Dipakai oleh&lt;/b&gt; dua objek dengan pola sama: &lt;code&gt;labfik.praktikum.pemakaian&lt;/code&gt; (A2) dan &lt;code&gt;labfik.praktikum.perubahan&lt;/code&gt; (A4). Guard &lt;i&gt;tidak bentrok&lt;/i&gt; saat &lt;i&gt;ajukan&lt;/i&gt; hanya untuk pemakaian lab; saat &lt;i&gt;setujui&lt;/i&gt; berlaku untuk pemakaian dan perubahan berpengganti (AB-PRK-01, diperiksa ulang karena pengajuan lain bisa disetujui lebih dulu). Tanpa PDF bertanda tangan (kontrak Core b)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="1838" width="410" height="100" as="geometry"/></mxCell><mxCell id="prk-act-notes-n6-1" value="&lt;b&gt;[KONFIRMASI]&lt;/b&gt; Pemakaian yang sudah disetujui lalu batal dipakai: perlu status &lt;i&gt;Dibatalkan&lt;/i&gt;? Draf 14 Nov 2026 · Herrens · sumber: analisis PKG-15–20, studi dokumen (POB 2025), kebutuhan KF-PRK" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="1948" width="410" height="70" as="geometry"/></mxCell><mxCell id="prk-act-notes-h7" value="&lt;b&gt;S3 · State machine Survei kepuasan per periode (perluasan &lt;code&gt;survey.survey&lt;/code&gt;) dan kaitannya dengan K1–K4&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="465" y="1792" width="410" height="40" as="geometry"/></mxCell><mxCell id="prk-act-notes-n7-0" value="&lt;b&gt;Status turunan&lt;/b&gt; (§9.3.1): selama Ditetapkan, &lt;i&gt;Belum dibuka / Dibuka / Ditutup&lt;/i&gt; dihitung dari tanggal buka–tutup, tidak disimpan. Kriteria K1–K4 dihitung &lt;code&gt;labfik.criteria.mixin&lt;/code&gt;." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="465" y="1838" width="410" height="80" as="geometry"/></mxCell><mxCell id="prk-act-notes-n7-1" value="&lt;b&gt;[KONFIRMASI]&lt;/b&gt; Bolehkah penetapan dibatalkan setelah survei dibuka (mis. butir salah)? Asumsi: tidak; buat survei baru. Draf 14 Nov 2026 · Herrens · sumber: analisis PKG-15–20, studi dokumen (POB 2025), kebutuhan KF-PRK" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="465" y="1928" width="410" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
e=9;strokeColor=#000000;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Times New Roman;exitX=0.5;exitY=0.6878;exitDx=0;exitDy=0;entryX=0.5;entryY=0.6878;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-ssd10-ui" target="sdm-ssd10-ct"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sdm-ssd10-m7" value="dto_unit_monev (syarat per unit + tautan rekaman bukti)" style="html=1;endArrow=open;endSize=9;dashed=1;strokeColor=#000000;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Times New Roman;exitX=0.5;exitY=0.7778;exitDx=0;exitDy=0;entryX=0.5;entryY=0.7778;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-ssd10-ui" target="sdm-ssd10-a0"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="sdm-ssd-notes" name="Catatan SSD TO-BE (bahan kerja)"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="866" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sdm-ssd-notes-title" value="Catatan system sequence diagram modul SDM (bahan kerja, tidak disisipkan ke naskah)" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1100" height="36" as="geometry"/></mxCell><mxCell id="sdm-ssd-notes-legend" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, Bab 7)&lt;br&gt;• Panah hitam kepala terbuka: &lt;i&gt;system event&lt;/i&gt; (aktor → antarmuka)&lt;br&gt;• Panah putus-putus: &lt;i&gt;system return&lt;/i&gt; (antarmuka → aktor)&lt;br&gt;• Panah kepala segitiga penuh: operasi sistem ke kontroler. &lt;b&gt;Command&lt;/b&gt; &lt;code&gt;op(args)&lt;/code&gt; mengubah data tanpa nilai balik; &lt;b&gt;query&lt;/b&gt; &lt;code&gt;dto = op(args)&lt;/code&gt; hanya membaca (CQS, §7.1)&lt;br&gt;• &lt;code&gt;dto_x&lt;/code&gt; = data majemuk (lihat kamus DTO), &lt;code&gt;*&lt;/code&gt; = koleksi, &lt;i&gt;terpilih&lt;/i&gt; = pilihan dari daftar (§7.3)&lt;br&gt;• Stateless: &lt;code&gt;user_id&lt;/code&gt; dikirim ke setiap operasi yang membutuhkannya (§7.5)&lt;br&gt;• &lt;code&gt;opt «exception»&lt;/code&gt; / &lt;code&gt;opt «variant»&lt;/code&gt;: alur alternatif; &lt;code&gt;ref&lt;/code&gt;: use case lain (§7.6)&lt;br&gt;Sumber: expanded-use-case-sdm.md (alur lengkap, AB-SDM-01–28); katalog operasi dan kamus DTO di ssd-sdm.md · Draf 19 Nov 2026 · Zahir" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="1100" height="150" as="geometry"/></mxCell><mxCell id="sdm-ssd-notes-pre1" value="&lt;b&gt;SSD-1 · UC-SDM-06 Catat Hasil Seleksi Asisten&lt;/b&gt;&lt;br&gt;&lt;b&gt;Prakondisi&lt;/b&gt;: pengguna sudah teridentifikasi dan &lt;code&gt;user_id&lt;/code&gt; diketahui antarmuka. Mata kuliah dan periode terdaftar. Seleksi sendiri dilakukan di luar sistem." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="236" width="1100" height="50" as="geometry"/></mxCell><mxCell id="sdm-ssd-notes-pre2" value="&lt;b&gt;SSD-2 · UC-SDM-07 Susun Surat Tugas&lt;/b&gt;&lt;br&gt;&lt;b&gt;Prakondisi&lt;/b&gt;: pengguna sudah teridentifikasi dan &lt;code&gt;user_id&lt;/code&gt; diketahui antarmuka. Periode, kelas, dan ruang terdaftar di Core." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="296" width="1100" height="50" as="geometry"/></mxCell><mxCell id="sdm-ssd-notes-pre3" value="&lt;b&gt;SSD-3 · UC-SDM-12 Catat Asesmen Keterampilan&lt;/b&gt;&lt;br&gt;&lt;b&gt;Prakondisi&lt;/b&gt;: pengguna sudah teridentifikasi dan &lt;code&gt;user_id&lt;/code&gt; diketahui antarmuka. Tugas/alat dan personel terdaftar. Uji keterampilan dilakukan di luar sistem." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="356" width="1100" height="50" as="geometry"/></mxCell><mxCell id="sdm-ssd-notes-pre4" value="&lt;b&gt;SSD-4 · UC-SDM-13 Susun Otorisasi&lt;/b&gt;&lt;br&gt;&lt;b&gt;Prakondisi&lt;/b&gt;: pengguna sudah teridentifikasi dan &lt;code&gt;user_id&lt;/code&gt; diketahui antarmuka. Tugas/alat terdaftar." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="416" width="1100" height="50" as="geometry"/></mxCell><mxCell id="sdm-ssd-notes-pre5" value="&lt;b&gt;SSD-5 · UC-SDM-15 Putuskan Evaluasi Ulang Otorisasi&lt;/b&gt;&lt;br&gt;&lt;b&gt;Prakondisi&lt;/b&gt;: pengguna sudah teridentifikasi dan &lt;code&gt;user_id&lt;/code&gt; diketahui antarmuka. Ada evaluasi ulang berstatus Terbuka (UC-SDM-14). Personel sudah dinilai ulang di luar sistem." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="476" width="1100" height="50" as="geometry"/></mxCell><mxCell id="sdm-ssd-notes-pre6" value="&lt;b&gt;SSD-6 · UC-SDM-17 Susun Rencana Pelatihan&lt;/b&gt;&lt;br&gt;&lt;b&gt;Prakondisi&lt;/b&gt;: pengguna sudah teridentifikasi dan &lt;code&gt;user_id&lt;/code&gt; diketahui antarmuka. Periode tahunan terdaftar; kompetensi wajib jabatan dan bukti kompetensi sudah tercatat." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="536" width="1100" height="50" as="geometry"/></mxCell><mxCell id="sdm-ssd-notes-pre7" value="&lt;b&gt;SSD-7 · UC-SDM-19 Catat Evaluasi Efektivitas Pelatihan&lt;/b&gt;&lt;br&gt;&lt;b&gt;Prakondisi&lt;/b&gt;: pengguna sudah teridentifikasi dan &lt;code&gt;user_id&lt;/code&gt; diketahui antarmuka. Ada realisasi pelatihan yang belum dievaluasi (UC-SDM-18)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="596" width="1100" height="50" as="geometry"/></mxCell><mxCell id="sdm-ssd-notes-pre8" value="&lt;b&gt;SSD-8 · UC-SDM-23 Ajukan Dokumen SDM&lt;/b&gt;&lt;br&gt;&lt;b&gt;Prakondisi&lt;/b&gt;: pengguna sudah teridentifikasi dan &lt;code&gt;user_id&lt;/code&gt; diketahui antarmuka. Ada dokumen SDM (Surat Tugas, Otorisasi, Rencana Pelatihan) berstatus Draf yang disusun aktor." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="656" width="1100" height="50" as="geometry"/></mxCell><mxCell id="sdm-ssd-notes-pre9" value="&lt;b&gt;SSD-9 · UC-SDM-27 Sahkan Dokumen SDM&lt;/b&gt;&lt;br&gt;&lt;b&gt;Prakondisi&lt;/b&gt;: pengguna sudah teridentifikasi dan &lt;code&gt;user_id&lt;/code&gt; diketahui antarmuka. Aktor adalah KaLab (AB-SDM-08). Ada dokumen SDM Diajukan yang sudah ditandatangani di luar sistem." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="716" width="1100" height="50" as="geometry"/></mxCell><mxCell id="sdm-ssd-notes-pre10" value="&lt;b&gt;SSD-10 · UC-SDM-22 Lihat Status Monev SDM&lt;/b&gt;&lt;br&gt;&lt;b&gt;Prakondisi&lt;/b&gt;: pengguna sudah teridentifikasi dan &lt;code&gt;user_id&lt;/code&gt; diketahui antarmuka. —" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="776" width="1100" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
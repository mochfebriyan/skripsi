 x="-8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-dcd4-jur-ptg" value="" style="endArrow=none;startArrow=diamondThin;startFill=1;startSize=16;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#333333;fontSize=10;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="prk-dcd4-jur" target="prk-dcd4-ptg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prk-dcd4-jur-ptg-l0" value="1" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-dcd4-jur-ptg"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-dcd4-jur-ptg-l1" value="petugas_ids 1..*" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-dcd4-jur-ptg"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-dcd4-jur-lgb" value="" style="endArrow=none;startArrow=diamondThin;startFill=1;startSize=16;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#333333;fontSize=10;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="prk-dcd4-jur" target="prk-dcd4-lgb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="890" y="339"/><mxPoint x="890" y="378"/></Array></mxGeometry></mxCell><mxCell id="prk-dcd4-jur-lgb-l0" value="1" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-dcd4-jur-lgb"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-dcd4-jur-lgb-l1" value="logbook_ids 1..*" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-dcd4-jur-lgb"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-dcd4-pnl-kls" value="" style="endArrow=open;endFill=0;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#555555;fontSize=10;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="prk-dcd4-pnl" target="prk-dcd4-kls"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prk-dcd4-pnl-kls-l0" value="0..1" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-dcd4-pnl-kls"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="-8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-dcd4-pnl-kls-l1" value="kelas_id 1" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-dcd4-pnl-kls"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-dcd4-pnl-bn" value="" style="endArrow=none;startArrow=diamondThin;startFill=1;startSize=16;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#333333;fontSize=10;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="prk-dcd4-pnl" target="prk-dcd4-bn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prk-dcd4-pnl-bn-l0" value="1" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-dcd4-pnl-bn"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-dcd4-pnl-bn-l1" value="baris_ids *" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-dcd4-pnl-bn"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-dcd4-n0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §13.6; CLAUDE.md bagian 5)&lt;br&gt;• Ungu «AbstractModel» (nama miring) = &lt;i&gt;mixin&lt;/i&gt; tanpa tabel; segitiga kosong ungu = &lt;code&gt;_inherit = [mixin, …]&lt;/code&gt;.&lt;br&gt;• «Odoo» abu-abu = model bawaan; «Core» / «SDM» abu-abu putus-putus = model addon lain yang dipakai. Tepi merah = model hasil desain tanpa padanan 1:1 di CM. Segitiga merah putus-putus = &lt;code&gt;_inherit&lt;/code&gt; tanpa &lt;code&gt;_name&lt;/code&gt; baru (perluasan model milik addon lain).&lt;br&gt;• Panah terbuka = Many2one/Many2many berarah, label = nama field + multiplisitas. Belah ketupat hitam = One2many + Many2one (anak ikut terhapus). Putus-putus = field/rujukan &lt;code&gt;compute&lt;/code&gt; atau pemanggilan method.&lt;br&gt;• Atribut bertipe hanya untuk model bawaan Odoo (hr.employee, ir.attachment, survey.*). Field warisan mixin tidak ditulis ulang.&lt;br&gt;• &lt;code&gt;+&lt;/code&gt; publik (&lt;code&gt;action_*&lt;/code&gt;, &lt;code&gt;get_*&lt;/code&gt;), &lt;code&gt;#&lt;/code&gt; internal (&lt;code&gt;_…&lt;/code&gt;), @model, @constrains, «override», {abstract}, {hook}. (O) = lapis Pelengkap." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="717" width="760" height="170" as="geometry"/></mxCell><mxCell id="prk-dcd4-n1" value="&lt;b&gt;Template Method&lt;/b&gt; &lt;code&gt;action_kirim()&lt;/code&gt;: 1. Sesi terjadwal, &lt;code&gt;is_terpublikasi&lt;/code&gt;, tanggal ≤ hari ini, belum ada jurnal terkirim (AB-PRK-17) · 2. &lt;code&gt;get_kekurangan()&lt;/code&gt; kosong: presensi dosen dan laboran, asisten bila &lt;code&gt;sesi.berasisten&lt;/code&gt;, jumlah_hadir, modul_id, ≥ 1 log book (AB-PRK-19) · 3. tulis state = terkirim, waktu_kirim, pengirim_id · 4. &lt;code&gt;sesi._tandai_terlaksana()&lt;/code&gt; (hanya Praktikum yang mengubah state Sesi).&lt;br&gt;• &lt;code&gt;sesuai_penugasan&lt;/code&gt; membaca &lt;code&gt;sesi.get_petugas_ditugaskan()&lt;/code&gt; (asisten lewat kelas, laboran lewat ruang, Surat Tugas disahkan dan berlaku pada tanggal sesi). Hanya penanda (AB-PRK-20).&lt;br&gt;• &lt;code&gt;terlambat&lt;/code&gt;, &lt;code&gt;durasi_memenuhi&lt;/code&gt;, &lt;code&gt;lengkap&lt;/code&gt; membaca pengaturan dari &lt;code&gt;ir.config_parameter&lt;/code&gt;. BerkasNilai CM → &lt;code&gt;berkas_nilai_ids&lt;/code&gt; (riwayat lampiran)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="820" y="717" width="760" height="170" as="geometry"/></mxCell><mxCell id="prk-dcd4-n2" value="Design class diagram (masuk proposal Bab II 2.3). Diturunkan dari conceptual model CM-1–4, katalog operasi SSD, AB-PRK-01–34, kontrak Core 16 Nov 2026. Rincian: rancangan/design-class-praktikum.md · Draf 16 Nov 2026 · Herrens" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="907" width="1540" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="prk-dcd5" name="DCD TO-BE (5-5) - Survei dan Status Monev"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="937" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="prk-dcd5-title" value="DCD 5/5 · Survei kepuasan (PKG-20) dan status monev praktikum · labfik_praktikum" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="6" width="1700" height="30" as="geometry"/></mxCell><mxCell id="prk-dcd5-cri" value="«AbstractModel»&lt;br&gt;&lt;b&gt;&lt;i&gt;labfik.criteria.mixin&lt;/i&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Core · rincian: DCD Tata Kelola&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=55;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="330" height="124" as="geometry"/></mxCell><mxCell id="prk-dcd5-cri-a" value="+ kriteria_tertinggi: Integer {compute}" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="prk-dcd5-cri"><mxGeometry x="0" y="55" width="330" height="23" as="geometry"/></mxCell><mxCell id="prk-dcd5-cri-s" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;html=1;" vertex="1" parent="prk-dcd5-cri"><mxGeometry x="0" y="78" width="330" height="8" as="geometry"/></mxCell><mxCell id="prk-dcd5-cri-m" value="+ get_kriteria(tanggal_acuan): dict&lt;br&gt;# _cek_k1(tanggal) … _cek_k4(tanggal) {abstract}" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="prk-dcd5-cri"><mxGeometry x="0" y="86" width="330" height="38" as="geometry"/></mxCell><mxCell id="prk-dcd5-per" value="«Core»&lt;br&gt;&lt;b&gt;labfik.periode&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Periode [M]&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=55;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="234" width="240" height="78" as="geometry"/></mxCell><mxCell id="prk-dcd5-per-a" value="&lt;i&gt;rincian: DCD-1&lt;/i&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="prk-dcd5-per"><mxGeometry x="0" y="55" width="240" height="23" as="geometry"/></mxCell><mxCell id="prk-dcd5-mon" value="«AbstractModel»&lt;br&gt;&lt;b&gt;&lt;i&gt;labfik.praktikum.monev&lt;/i&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Status Monev Praktikum [R] (layanan, tanpa tabel)&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=55;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#9B2C44;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="362" width="380" height="169" as="geometry"/></mxCell><mxCell id="prk-dcd5-mon-a" value="&lt;i&gt;(tidak menyimpan data)&lt;/i&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="prk-dcd5-mon"><mxGeometry x="0" y="55" width="380" height="23" as="geometry"/></mxCell><mxCell id="prk-dcd5-mon-s" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;html=1;" vertex="1" parent="prk-dcd5-mon"><mxGeometry x="0" y="78" width="380" height="8" as="geometry"/></mxCell><mxCell id="prk-dcd5-mon-m" value="@model + get_status(periode, tanggal_acuan): dict&lt;br&gt;@model + terbitkan_laporan_bukti(periode,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;tanggal_acuan): report&lt;br&gt;@model # _persentase(pkg, periode): dict (AB-PRK-32)&lt;br&gt;@model # _status_pkg19(periode): dict (AB-PRK-33)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="prk-dcd5-mon"><mxGeometry x="0" y="86" width="380" height="83" as="geometry"/></mxCell><mxCell id="prk-dcd5-srv" value="«Odoo»&lt;br&gt;&lt;b&gt;survey.survey&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Survei Kepuasan [T]&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#6C4A87'&gt;{_inherit: survey.survey, labfik.criteria.mixin} di labfik_praktikum&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=70;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="440" y="60" width="440" height="379" as="geometry"/></mxCell><mxCell id="prk-dcd5-srv-a" value="+ jenis_responden: Selection {praktikan, dosen, asisten}&lt;br&gt;+ populasi: Integer&lt;br&gt;+ target_response_rate: Float (%)&lt;br&gt;+ tanggal_buka, tanggal_tutup: Date&lt;br&gt;+ status_lab: Selection {draf, ditetapkan,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;dievaluasi, siklus_selesai} {compute, store}&lt;br&gt;+ status_buka: Selection {compute}&lt;br&gt;+ penetap_id: hr.employee [0..1] (readonly)&lt;br&gt;+ tanggal_tetap: Date [0..1] (readonly)&lt;br&gt;+ response_rate: Float {compute}&lt;br&gt;&lt;i&gt;bawaan dipakai: title, question_ids, answer_done_count,&lt;/i&gt;&lt;br&gt;&lt;i&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;access_mode = public (anonim)&lt;/i&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="prk-dcd5-srv"><mxGeometry x="0" y="70" width="440" height="188" as="geometry"/></mxCell><mxCell id="prk-dcd5-srv-s" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;html=1;" vertex="1" parent="prk-dcd5-srv"><mxGeometry x="0" y="258" width="440" height="8" as="geometry"/></mxCell><mxCell id="prk-dcd5-srv-m" value="+ action_tetapkan() (AB-PRK-26)&lt;br&gt;+ action_batalkan_penetapan() (O, AB-PRK-27)&lt;br&gt;+ get_kekurangan_penetapan(): list (AB-PRK-26)&lt;br&gt;+ get_rekap(): dict&lt;br&gt;+ get_survei_berikutnya(): survey.survey&lt;br&gt;# _cek_k1() … _cek_k4() «override» (AB-PRK-34)&lt;br&gt;# _create_answer() «override» (AB-PRK-28)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="prk-dcd5-srv"><mxGeometry x="0" y="266" width="440" height="113" as="geometry"/></mxCell><mxCell id="prk-dcd5-q" value="«Odoo»&lt;br&gt;&lt;b&gt;survey.question&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Butir Survei&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#6C4A87'&gt;{_inherit} di labfik_praktikum&lt;/font&gt;" style="swimlane;fontSty
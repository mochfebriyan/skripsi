;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-dcd3-mod-msw"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-dcd3-mod-mbh" value="" style="endArrow=none;startArrow=diamondThin;startFill=1;startSize=16;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#333333;fontSize=10;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="prk-dcd3-mod" target="prk-dcd3-mbh"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1206" y="522"/><mxPoint x="1152" y="522"/></Array></mxGeometry></mxCell><mxCell id="prk-dcd3-mod-mbh-l0" value="1" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=top;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-dcd3-mod-mbh"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-dcd3-mod-mbh-l1" value="bahan_ids *" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-dcd3-mod-mbh"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-dcd3-mod-mk" value="" style="endArrow=open;endFill=0;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#555555;fontSize=10;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="prk-dcd3-mod" target="prk-dcd3-mk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prk-dcd3-mod-mk-l0" value="*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-dcd3-mod-mk"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-dcd3-mod-mk-l1" value="mata_kuliah_id 1" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-dcd3-mod-mk"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-dcd3-mod-per" value="" style="endArrow=open;endFill=0;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#555555;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="prk-dcd3-mod" target="prk-dcd3-per"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prk-dcd3-mod-per-l0" value="*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-dcd3-mod-per"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-dcd3-mod-per-l1" value="periode_id 1" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-dcd3-mod-per"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-dcd3-mbh-bhn" value="" style="endArrow=open;endFill=0;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#555555;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="prk-dcd3-mbh" target="prk-dcd3-bhn"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="574"/><mxPoint x="1300" y="381"/></Array></mxGeometry></mxCell><mxCell id="prk-dcd3-mbh-bhn-l0" value="*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-dcd3-mbh-bhn"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-dcd3-mbh-bhn-l1" value="bahan_id 1" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-dcd3-mbh-bhn"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-dcd3-n0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §13.6; CLAUDE.md bagian 5)&lt;br&gt;• Ungu «AbstractModel» (nama miring) = &lt;i&gt;mixin&lt;/i&gt; tanpa tabel; segitiga kosong ungu = &lt;code&gt;_inherit = [mixin, …]&lt;/code&gt;.&lt;br&gt;• «Odoo» abu-abu = model bawaan; «Core» / «SDM» abu-abu putus-putus = model addon lain yang dipakai. Tepi merah = model hasil desain tanpa padanan 1:1 di CM. Segitiga merah putus-putus = &lt;code&gt;_inherit&lt;/code&gt; tanpa &lt;code&gt;_name&lt;/code&gt; baru (perluasan model milik addon lain).&lt;br&gt;• Panah terbuka = Many2one/Many2many berarah, label = nama field + multiplisitas. Belah ketupat hitam = One2many + Many2one (anak ikut terhapus). Putus-putus = field/rujukan &lt;code&gt;compute&lt;/code&gt; atau pemanggilan method.&lt;br&gt;• Atribut bertipe hanya untuk model bawaan Odoo (hr.employee, ir.attachment, survey.*). Field warisan mixin tidak ditulis ulang.&lt;br&gt;• &lt;code&gt;+&lt;/code&gt; publik (&lt;code&gt;action_*&lt;/code&gt;, &lt;code&gt;get_*&lt;/code&gt;), &lt;code&gt;#&lt;/code&gt; internal (&lt;code&gt;_…&lt;/code&gt;), @model, @constrains, «override», {abstract}, {hook}. (O) = lapis Pelengkap." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="778" width="760" height="170" as="geometry"/></mxCell><mxCell id="prk-dcd3-n1" value="&lt;b&gt;Kunci&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Butir: satu model, bukan empat subkelas.&lt;/b&gt; Generalisasi CM (ButirUtilitas, StasiunKerja, Software, Bahan) diwujudkan dengan &lt;code&gt;kategori&lt;/code&gt; + &lt;code&gt;_cek_isian_kategori()&lt;/code&gt; (field wajib per kategori) dan tampilan per kategori. Subkelas Odoo (&lt;code&gt;_inherits&lt;/code&gt;) akan membuat lima tabel untuk satu daftar butir.&lt;br&gt;• SubstitusiBahan dan PersetujuanSubstitusi (kejadian 0..1) menjadi field di butir; &lt;code&gt;action_setujui_substitusi()&lt;/code&gt; hanya untuk dosen kelas Sesi itu (AB-PRK-16).&lt;br&gt;• &lt;code&gt;get_form(sesi)&lt;/code&gt; membentuk butir dari &lt;code&gt;sesi.get_modul_berlaku()&lt;/code&gt; + kategori tetap (AB-PRK-14), tanpa menyimpan. &lt;code&gt;/versi_berlaku&lt;/code&gt; CM → &lt;code&gt;get_berlaku(mata_kuliah, tanggal)&lt;/code&gt;." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="820" y="778" width="760" height="170" as="geometry"/></mxCell><mxCell id="prk-dcd3-n2" value="Design class diagram (masuk proposal Bab II 2.3). Diturunkan dari conceptual model CM-1–4, katalog operasi SSD, AB-PRK-01–34, kontrak Core 16 Nov 2026. Rincian: rancangan/design-class-praktikum.md · Draf 16 Nov 2026 · Herrens" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="968" width="1540" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="prk-dcd4" name="DCD TO-BE (4-5) - Jurnal, Penilaian, Pengaturan"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="967" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="prk-dcd4-title" value="DCD 4/5 · Jurnal sesi (PKG-18), penilaian kelas (PKG-19), pengaturan · labfik_praktikum" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="6" width="1700" height="30" as="geometry"/></mxCell><mxCell id="prk-dcd4-ses" value="«Core»&lt;br&gt;&lt;b&gt;labfik.sesi&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Sesi [T] · rincian: DCD-1&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=55;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="280" height="78" as="geometry"/></mxCell><mxCell id="prk-dcd4-ses-a" value="&lt;i&gt;get_petugas_ditugaskan()&lt;/i&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="prk-dcd4-ses"><mxGeometry x="0" y="55" width="280" height="23" as="geometry"/></mxCell><mxCell id="prk-dcd4-pgs" value="«SDM»&lt;br&gt;&lt;b&gt;labfik.sdm.penugasan&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Baris Penugasan [T] · labfik_sdm&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=55;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="188" width="280" height="138" as="geometry"/></mxCell><mxCell id="prk-dcd4-pgs-a" value="+ employee_id: hr.employee&lt;br&gt;+ peran: Selection {asisten, laboran}&lt;br&gt;+ kelas_id / ruang_id (sasaran)&lt;br&gt;+ berlaku_mulai, berlaku_sampai: Date&lt;br&gt;&lt;i&gt;surat_tugas_id.state = disahkan&lt;/i&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="prk-dcd4-pgs"><mxGeometry x="0" y="55" width="280" height="83" as="geometry"/></mxCell><mxCell id="prk-dcd4-kls" value="«Core»&lt;br&gt;&lt;b&gt;labfik.kelas&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Kelas [M] · rincian: DCD-1&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=55;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="376" width="280" height="78" as="geometry"/></mxCell><mxCell id="prk-dcd4-kls-a" value="&lt;i&gt;dosen_ids, dosen_koordinator_id&lt;/i&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="prk-dcd4-kls"><mxGeometry x="0" y="55" width="280" height="23" as="geometry"/></mxCell><mxCell id="prk-dcd4-cfg" value="«Odoo»&lt;br&gt;&lt;b&gt;res.config.settings&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Pengaturan Praktikum&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#6C4A87'&gt;{_inherit} di labfik_praktikum&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=70;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="504" width="280" height="153" as="geometry"/></mxCell><mxCell id="prk-dcd4-cfg-a" value="+ prk_ambang_durasi: Float (%)&lt;br&gt;+ prk_batas_hari_jurnal: Integer&lt;br&gt;+ prk_sesi_daring_sah: Boolean&lt;br&gt;+ prk_batas_lulus: Float = 60&lt;br&gt;&lt;i&gt;config_parameter → ir.config_parameter&lt;/i&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="prk-dcd4-cfg"><mxGeometry x="0" y="70" width="280" height="83" as="geometry"/></mxCell><mxCell id="prk-dcd4-jur" value="&lt;b&gt;labfik.praktikum.jurnal&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Jurnal Sesi [T]&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#6C4A87'&gt;{inherit: evidence}&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=55;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="440" y="60" width="380" height="349" as="geometry"/></mxCell><mxCell id="prk-dcd4-jur-a" value="+ jam_mulai_aktual, jam_selesai_aktual: Float&lt;br&gt;+ topik: Text&lt;br&gt;+ jumlah_hadir: Integer&lt;br&gt;+ tautan_presensi: Char [0..1]&lt;br&gt;+ kendala: Text [0..1]&lt;br&gt;+ state: Selection {draf, terkirim} = draf&lt;br&gt;+ waktu_kirim: Datetime [0..1] (readonly)&lt;br&gt;+ pengirim_id: hr.employee [0..1] (readonly)&lt;br&gt;+ terlambat: Boolean {compute, store} (O)&lt;br&gt;+ durasi_memenuhi: Boolean {compute}&lt;br&gt;&lt;i&gt;bukti_ids (warisan) = foto&lt;/i&gt;&lt;br&gt;&lt;i&gt;_sql_constraints: unique(sesi_id)&lt;/i&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="prk-dcd4-jur"><mxGeometry x="0" y="55" width="380" height="188" as="geometry"/></mxCell><mxCell id="prk-dcd4-jur-s" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;html=1;" vertex="1" parent="prk-dcd4-jur"><mxGeometry x="0" y="243" width="380" height="8" as="geometry"/></mxCell><mxCell id="prk-dcd4-jur-m" value="@model + get_konteks(sesi): dict&lt;br&gt;+ action_kirim() (AB-PRK-17, 19)&lt;br&gt;+ get_kekurangan(): list (AB-PRK-19)&lt;br&gt;# _cek_jam() @constrains (AB-PRK-18)&lt;br&gt;# _cek_sesi() @constrains (AB-PRK-17)&lt;br&gt;# _boleh_dikoreksi() «override»" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="prk-dcd4-jur"><mxGeometry x="0" y="251" width="380" height="98" as="geometry"/></mxCell><mxCell id="prk-dcd4-pnl" value="&lt;b&gt;labfik.praktikum.penilaian&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Penilaian Kelas [T]&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#6C4A87'&gt;{inherit: evidence}&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=55;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="440" y="459" width="380" height="184" as="geometry"/></mxCell><mxCell id="prk-dcd4-pnl-a" value="+ tautan_leads: Char&lt;br&gt;+ ada_rubrik: Boolean {compute}&lt;br&gt;+ berbukti: Boolean {compute, store}&lt;br&gt;+ berkas_nilai_ids: ir.attachment [*] (O, riwayat)&lt;br&gt;&lt;i&gt;_sql_constraints: unique(kelas_id)&lt;/i&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="prk-dcd4-pnl"><mxGeometry x="0" y="55" width="380" height="83" as="geometry"/></mxCell><mxCell id="prk-dcd4-pnl-s" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;html=1;" vertex="1" parent="prk-dcd4-pnl"><mxGeometry x="0" y="138" width="380" height="8" as="geometry"/></mxCell><mxCell id="prk-dcd4-pnl-m" value="+ action_impor_nilai(berkas) (O, AB-PRK-24)&lt;br&gt;+ get_status_praktikan(): list (O, AB-PRK-25)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="prk-dcd4-pnl"><mxGeometry x="0" y="146" width="380" height="38" as="geometry"/></mxCell><mxCell id="prk-dcd4-mod" value="&lt;b&gt;labfik.praktikum.modul&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Versi Modul [T] · rincian: DCD-3&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="920" y="60" width="300" height="63" as="geometry"/></mxCell><mxCell id="prk-dcd4-mod-a" value="&lt;i&gt;rubrik&lt;/i&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="prk-dcd4-mod"><mxGeometry x="0" y="40" width="300" height="23" as="geometry"/></mxCell><mxCell id="prk-dcd4-ptg" value="&lt;b&gt;labfik.praktikum.jurnal.petugas&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Presensi Petugas [T]&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="920" y="173" width="320" height="108" as="geometry"/></mxCell><mxCell id="prk-dcd4-ptg-a" value="+ employee_id: hr.employee&lt;br&gt;+ peran: Selection {dosen, laboran, asisten}&lt;br&gt;+ kehadiran: Selection {penuh, sebagian, tidak}&lt;br&gt;+ sesuai_penugasan: Boolean {compute} (O)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="prk-dcd4-ptg"><mxGeometry x="0" y="40" width="320" height="68" as="geometry"/></mxCell><mxCell id="prk-dcd4-lgb" value="&lt;b&gt;labfik.praktikum.jurnal.logbook&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Entri Log Book [T]&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="920" y="331" width="300" height="93" as="geometry"/></mxCell><mxCell id="prk-dcd4-lgb-a" value="+ waktu: Float (widget jam)&lt;br&gt;+ uraian: Text&lt;br&gt;&lt;i&gt;_order = 'waktu'&lt;/i&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" ver
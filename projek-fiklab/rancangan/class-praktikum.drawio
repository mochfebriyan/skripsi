=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-dcd2-job-wwn"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-dcd2-pgm-job" value="" style="endArrow=open;endFill=0;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#555555;dashed=1;fontSize=10;exitX=1;exitY=0.06;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="prk-dcd2-pgm" target="prk-dcd2-job"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="241"/><mxPoint x="480" y="40"/><mxPoint x="1530" y="40"/></Array></mxGeometry></mxCell><mxCell id="prk-dcd2-pgm-job-l1" value="pemutus.job_id.punya_wewenang()" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-dcd2-pgm-job"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-dcd2-n0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §13.6; CLAUDE.md bagian 5)&lt;br&gt;• Ungu «AbstractModel» (nama miring) = &lt;i&gt;mixin&lt;/i&gt; tanpa tabel; segitiga kosong ungu = &lt;code&gt;_inherit = [mixin, …]&lt;/code&gt;.&lt;br&gt;• «Odoo» abu-abu = model bawaan; «Core» / «SDM» abu-abu putus-putus = model addon lain yang dipakai. Tepi merah = model hasil desain tanpa padanan 1:1 di CM. Segitiga merah putus-putus = &lt;code&gt;_inherit&lt;/code&gt; tanpa &lt;code&gt;_name&lt;/code&gt; baru (perluasan model milik addon lain).&lt;br&gt;• Panah terbuka = Many2one/Many2many berarah, label = nama field + multiplisitas. Belah ketupat hitam = One2many + Many2one (anak ikut terhapus). Putus-putus = field/rujukan &lt;code&gt;compute&lt;/code&gt; atau pemanggilan method.&lt;br&gt;• Atribut bertipe hanya untuk model bawaan Odoo (hr.employee, ir.attachment, survey.*). Field warisan mixin tidak ditulis ulang.&lt;br&gt;• &lt;code&gt;+&lt;/code&gt; publik (&lt;code&gt;action_*&lt;/code&gt;, &lt;code&gt;get_*&lt;/code&gt;), &lt;code&gt;#&lt;/code&gt; internal (&lt;code&gt;_…&lt;/code&gt;), @model, @constrains, «override», {abstract}, {hook}. (O) = lapis Pelengkap." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="643" width="760" height="170" as="geometry"/></mxCell><mxCell id="prk-dcd2-n1" value="&lt;b&gt;Template Method&lt;/b&gt; &lt;code&gt;action_putuskan(hasil, alasan, karena_bentrok, pengganti)&lt;/code&gt;, urutan tetap di mixin:&lt;br&gt;1. state harus &lt;i&gt;diajukan&lt;/i&gt; · 2. &lt;code&gt;_cek_wewenang(pemutus)&lt;/code&gt; → &lt;code&gt;pemutus.job_id.punya_wewenang('mengesahkan', self._jenis_pengajuan())&lt;/code&gt; (AB-PRK-10) · 3. bila ditolak: alasan wajib (AB-PRK-10), tulis state, pemutus, tanggal, &lt;code&gt;karena_bentrok&lt;/code&gt;, selesai · 4. bila disetujui: &lt;code&gt;_sebelum_disetujui(pengganti)&lt;/code&gt; {hook} (cek bentrok, AB-PRK-01; Sesi masih terjadwal, AB-PRK-12) · 5. tulis state, pemutus, tanggal · 6. &lt;code&gt;_efek_disetujui(pengganti)&lt;/code&gt; {hook} · 7. &lt;code&gt;_beri_tahu()&lt;/code&gt; (O).&lt;br&gt;Efek Perubahan Sesi: &lt;i&gt;pindah&lt;/i&gt; → &lt;code&gt;sesi._ganti(…)&lt;/code&gt; membuat Sesi pengganti (sesi_asal_id) dan Sesi asal batal; &lt;i&gt;daring&lt;/i&gt; → moda daring; &lt;i&gt;batal&lt;/i&gt; → Sesi batal. Efek Pemakaian Lab: tidak ada (masuk jadwal terpadu lewat state)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="820" y="643" width="800" height="170" as="geometry"/></mxCell><mxCell id="prk-dcd2-n2" value="Design class diagram (masuk proposal Bab II 2.3). Diturunkan dari conceptual model CM-1–4, katalog operasi SSD, AB-PRK-01–34, kontrak Core 16 Nov 2026. Rincian: rancangan/design-class-praktikum.md · Draf 16 Nov 2026 · Herrens" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="833" width="1580" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="prk-dcd3" name="DCD TO-BE (3-5) - Versi Modul dan Kesiapan"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1028" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="prk-dcd3-title" value="DCD 3/5 · Versi modul dan pemeriksaan kesiapan (PKG-15 C4, PKG-16, PKG-17) · labfik_praktikum" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="6" width="1700" height="30" as="geometry"/></mxCell><mxCell id="prk-dcd3-ses" value="«Core»&lt;br&gt;&lt;b&gt;labfik.sesi&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Sesi [T] · rincian: DCD-1&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=55;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="260" height="78" as="geometry"/></mxCell><mxCell id="prk-dcd3-ses-a" value="&lt;i&gt;get_modul_berlaku()&lt;/i&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="prk-dcd3-ses"><mxGeometry x="0" y="55" width="260" height="23" as="geometry"/></mxCell><mxCell id="prk-dcd3-ksp" value="&lt;b&gt;labfik.praktikum.kesiapan&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Pemeriksaan Kesiapan [T]&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#6C4A87'&gt;{inherit: evidence}&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=55;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="440" y="60" width="340" height="259" as="geometry"/></mxCell><mxCell id="prk-dcd3-ksp-a" value="+ waktu_periksa: Datetime&lt;br&gt;+ keputusan: Selection {siap,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;siap_setelah_perbaikan, tunda}&lt;br&gt;+ tepat_waktu: Boolean {compute, store}&lt;br&gt;&lt;i&gt;pelapor_id (warisan) = pemeriksa&lt;/i&gt;&lt;br&gt;&lt;i&gt;_sql_constraints: unique(sesi_id)&lt;/i&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="prk-dcd3-ksp"><mxGeometry x="0" y="55" width="340" height="98" as="geometry"/></mxCell><mxCell id="prk-dcd3-ksp-s" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;html=1;" vertex="1" parent="prk-dcd3-ksp"><mxGeometry x="0" y="153" width="340" height="8" as="geometry"/></mxCell><mxCell id="prk-dcd3-ksp-m" value="@model + get_form(sesi): list&lt;br&gt;@model + get_keputusan_tersedia(hasil_butir): list&lt;br&gt;@model + catat(sesi, hasil_butir, keputusan)&lt;br&gt;# _cek_keputusan() @constrains (AB-PRK-15, 16)&lt;br&gt;# _compute_tepat_waktu() (AB-PRK-13)&lt;br&gt;# _boleh_dikoreksi() «override»" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="prk-dcd3-ksp"><mxGeometry x="0" y="161" width="340" height="98" as="geometry"/></mxCell><mxCell id="prk-dcd3-but" value="&lt;b&gt;labfik.praktikum.kesiapan.butir&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Butir Pemeriksaan [T]&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="440" y="369" width="380" height="349" as="geometry"/></mxCell><mxCell id="prk-dcd3-but-a" value="+ kategori: Selection {stasiun_kerja, jaringan,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;listrik, proyektor_audio, software, bahan}&lt;br&gt;+ hasil: Selection {baik, diperbaiki, bermasalah}&lt;br&gt;+ keterangan: Text [0..1]&lt;br&gt;+ jumlah_berfungsi: Integer [0..1] (stasiun kerja)&lt;br&gt;+ jumlah_dibutuhkan: Float {compute}&lt;br&gt;+ lisensi_sah: Boolean (software berbayar)&lt;br&gt;+ jumlah_tersedia: Float [0..1] (bahan)&lt;br&gt;+ kondisi_baik, berlabel: Boolean (bahan)&lt;br&gt;+ tanggal_kedaluwarsa: Date [0..1] (bahan)&lt;br&gt;+ alasan_substitusi: Text [0..1]&lt;br&gt;+ penyetuju_id: hr.employee [0..1] (readonly)&lt;br&gt;+ waktu_setuju: Datetime [0..1] (readonly)&lt;br&gt;+ status_substitusi: Selection {tidak_ada,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;menunggu, disetujui} {compute}" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="prk-dcd3-but"><mxGeometry x="0" y="40" width="380" height="233" as="geometry"/></mxCell><mxCell id="prk-dcd3-but-s" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;html=1;" vertex="1" parent="prk-dcd3-but"><mxGeometry x="0" y="273" width="380" height="8" as="geometry"/></mxCell><mxCell id="prk-dcd3-but-m" value="+ action_setujui_substitusi() (AB-PRK-16)&lt;br&gt;# _cek_isian_kategori() @constrains&lt;br&gt;# _cek_substitusi() @constrains (AB-PRK-16)&lt;br&gt;# _compute_jumlah_dibutuhkan()" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="prk-dcd3-but"><mxGeometry x="0" y="281" width="380" height="68" as="geometry"/></mxCell><mxCell id="prk-dcd3-mod" value="&lt;b&gt;labfik.praktikum.modul&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Versi Modul [T]&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#6C4A87'&gt;{inherit: mail.thread}&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=55;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="900" y="60" width="360" height="289" as="geometry"/></mxCell><mxCell id="prk-dcd3-mod-a" value="+ nomor_versi: Char&lt;br&gt;+ berkas: Binary [0..1]&lt;br&gt;+ tautan_leads: Char [0..1]&lt;br&gt;+ rubrik: Binary [0..1]&lt;br&gt;+ tanggal_terbit: Date [0..1] (readonly)&lt;br&gt;+ state: Selection {draf, berlaku, diganti} = draf&lt;br&gt;+ penerbit_id: hr.employee&lt;br&gt;&lt;i&gt;_sql_constraints: unique(mata_kuliah_id,&lt;/i&gt;&lt;br&gt;&lt;i&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;periode_id, nomor_versi)&lt;/i&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="prk-dcd3-mod"><mxGeometry x="0" y="55" width="360" height="143" as="geometry"/></mxCell><mxCell id="prk-dcd3-mod-s" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;html=1;" vertex="1" parent="prk-dcd3-mod"><mxGeometry x="0" y="198" width="360" height="8" as="geometry"/></mxCell><mxCell id="prk-dcd3-mod-m" value="+ action_terbitkan() (AB-PRK-07, 08, 09)&lt;br&gt;@model + get_berlaku(mata_kuliah, tanggal): modul&lt;br&gt;# _cek_pengampu(employee): bool (AB-PRK-09)&lt;br&gt;# _cek_isi() @constrains (AB-PRK-08)&lt;br&gt;+ unlink() «override» (hanya draf)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="prk-dcd3-mod"><mxGeometry x="0" y="206" width="360" height="83" as="geometry"/></mxCell><mxCell id="prk-dcd3-msw" value="&lt;b&gt;labfik.praktikum.modul.software&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Kebutuhan Software [T]&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="900" y="399" width="280" height="93" as="geometry"/></mxCell><mxCell id="prk-dcd3-msw-a" value="+ name: Char&lt;br&gt;+ versi: Char&lt;br&gt;+ berbayar: Boolean = False" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="prk-dcd3-msw"><mxGeometry x="0" y="40" width="280" height="53" as="geometry"/></mxCell><mxCell id="prk-dcd3-mbh" value="&lt;b&gt;labfik.praktikum.modul.bahan&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Kebutuhan Bahan [T]&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="900" y="542" width="280" height="63" as="geometry"/></mxCell><mxCell id="prk-dcd3-mbh-a" value="+ jumlah_per_mahasiswa: Float" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="prk-dcd3-mbh"><mxGeometry x="0" y="40" width="280" height="23" as="geometry"/></mxCell><mxCell id="prk-dcd3-mk" value="«Core»&lt;br&gt;&lt;b&gt;labfik.mata.kuliah&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Mata Kuliah [M]&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=55;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1340" y="60" width="240" height="78" as="geometry"/></mxCell><mxCell id="prk-dcd3-mk-a" value="&lt;i&gt;rincian: DCD-1&lt;/i&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="prk-dcd3-mk"><mxGeometry x="0" y="55" width="240" height="23" as="geometry"/></mxCell><mxCell id="prk-dcd3-per" value="«Core»&lt;br&gt;&lt;b&gt;labfik.periode&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Periode [M]&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=55;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1340" y="188" width="240" height="78" as="geometry"/></mxCell><mxCell id="prk-dcd3-per-a" value="&lt;i&gt;rincian: DCD-1&lt;/i&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="prk-dcd3-per"><mxGeometry x="0" y="55" width="240" height="23" as="geometry"/></mxCell><mxCell id="prk-dcd3-bhn" value="«Core»&lt;br&gt;&lt;b&gt;labfik.bahan&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Bahan Praktikum [M] (C-13)&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=55;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1340" y="316" width="240" height="93" as="geometry"/></mxCell><mxCell id="prk-dcd3-bhn-a" value="+ kode, name, satuan: Char&lt;br&gt;+ jenis: Selection" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="prk-dcd3-bhn"><mxGeometry x="0" y="55" width="240" height="38" as="geometry"/></mxCell><mxCell id="prk-dcd3-ksp-ses" value=""
et"/></mxGeometry></mxCell><mxCell id="prk-dcd1-ses-self" value="" style="endArrow=open;endFill=0;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#555555;fontSize=10;exitX=1;exitY=0.1;exitDx=0;exitDy=0;entryX=0.82;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="prk-dcd1-ses" target="prk-dcd1-ses"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="790" y="90"/><mxPoint x="790" y="35"/><mxPoint x="700" y="35"/></Array></mxGeometry></mxCell><mxCell id="prk-dcd1-ses-self-l0" value="pengganti 0..1" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-dcd1-ses-self"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-dcd1-ses-self-l1" value="sesi_asal_id 0..1" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-dcd1-ses-self"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-dcd1-sesx-ses" value="" style="endArrow=block;endFill=0;endSize=14;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#9B2C44;dashed=1;fontSize=10;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="prk-dcd1-sesx" target="prk-dcd1-ses"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prk-dcd1-sesx-ses-l1" value="«_inherit»" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-dcd1-sesx-ses"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-dcd1-jdw-apv" value="" style="endArrow=block;endFill=0;endSize=14;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#6C4A87;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="prk-dcd1-jdw" target="prk-dcd1-apv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prk-dcd1-jdw-per" value="" style="endArrow=open;endFill=0;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#555555;fontSize=10;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="prk-dcd1-jdw" target="prk-dcd1-per"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1399" y="651"/><mxPoint x="250" y="651"/></Array></mxGeometry></mxCell><mxCell id="prk-dcd1-jdw-per-l0" value="*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=top;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-dcd1-jdw-per"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-dcd1-jdw-per-l1" value="periode_id 1 (unik)" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=top;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-dcd1-jdw-per"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="8" y="2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-dcd1-imp-impb" value="" style="endArrow=none;startArrow=diamondThin;startFill=1;startSize=16;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#333333;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="prk-dcd1-imp" target="prk-dcd1-impb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prk-dcd1-imp-impb-l0" value="1" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=top;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-dcd1-imp-impb"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-dcd1-imp-impb-l1" value="baris_ids *" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-dcd1-imp-impb"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-dcd1-imp-per" value="" style="endArrow=open;endFill=0;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#555555;fontSize=10;exitX=0.97;exitY=0;exitDx=0;exitDy=0;entryX=0.35;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="prk-dcd1-imp" target="prk-dcd1-per"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2020" y="40"/><mxPoint x="1240" y="40"/><mxPoint x="1240" y="666"/><mxPoint x="145" y="666"/></Array></mxGeometry></mxCell><mxCell id="prk-dcd1-imp-per-l0" value="*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-dcd1-imp-per"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-dcd1-imp-per-l1" value="periode_id 1" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=top;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-dcd1-imp-per"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="8" y="2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-dcd1-n0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §13.6; CLAUDE.md bagian 5)&lt;br&gt;• Ungu «AbstractModel» (nama miring) = &lt;i&gt;mixin&lt;/i&gt; tanpa tabel; segitiga kosong ungu = &lt;code&gt;_inherit = [mixin, …]&lt;/code&gt;.&lt;br&gt;• «Odoo» abu-abu = model bawaan; «Core» / «SDM» abu-abu putus-putus = model addon lain yang dipakai. Tepi merah = model hasil desain tanpa padanan 1:1 di CM. Segitiga merah putus-putus = &lt;code&gt;_inherit&lt;/code&gt; tanpa &lt;code&gt;_name&lt;/code&gt; baru (perluasan model milik addon lain).&lt;br&gt;• Panah terbuka = Many2one/Many2many berarah, label = nama field + multiplisitas. Belah ketupat hitam = One2many + Many2one (anak ikut terhapus). Putus-putus = field/rujukan &lt;code&gt;compute&lt;/code&gt; atau pemanggilan method.&lt;br&gt;• Atribut bertipe hanya untuk model bawaan Odoo (hr.employee, ir.attachment, survey.*). Field warisan mixin tidak ditulis ulang.&lt;br&gt;• &lt;code&gt;+&lt;/code&gt; publik (&lt;code&gt;action_*&lt;/code&gt;, &lt;code&gt;get_*&lt;/code&gt;), &lt;code&gt;#&lt;/code&gt; internal (&lt;code&gt;_…&lt;/code&gt;), @model, @constrains, «override», {abstract}, {hook}. (O) = lapis Pelengkap." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="701" width="760" height="170" as="geometry"/></mxCell><mxCell id="prk-dcd1-n1" value="&lt;b&gt;Kunci&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Core vs Praktikum.&lt;/b&gt; Field yang tersimpan di &lt;code&gt;labfik.sesi&lt;/code&gt; ada di &lt;code&gt;labfik_core&lt;/code&gt; (kontrak C-9). Field hitung yang membutuhkan Penetapan Jadwal, Perubahan, Jurnal, dan penugasan SDM ditambahkan &lt;code&gt;labfik_praktikum&lt;/code&gt; lewat &lt;code&gt;_inherit&lt;/code&gt;, karena Core tidak bergantung ke modul fungsional. Hanya &lt;code&gt;is_diganti&lt;/code&gt; yang dihitung di Core.&lt;br&gt;• &lt;code&gt;/sesi_asal&lt;/code&gt; di CM menjadi field tersimpan &lt;code&gt;sesi_asal_id&lt;/code&gt; (Core tidak bisa membaca Perubahan Sesi).&lt;br&gt;• &lt;code&gt;is_terpublikasi&lt;/code&gt; = Penetapan Jadwal periode kelas berstatus disahkan; tidak memakai &lt;i&gt;hook&lt;/i&gt; &lt;code&gt;_setelah_disahkan()&lt;/code&gt;.&lt;br&gt;• Impor = &lt;i&gt;wizard&lt;/i&gt;: &lt;code&gt;action_pratinjau()&lt;/code&gt; mengisi status per baris tanpa membuat Sesi (query SSD); &lt;code&gt;action_impor()&lt;/code&gt; membangkitkan 16 Sesi per kelas yang berstatus siap." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="820" y="701" width="760" height="170" as="geometry"/></mxCell><mxCell id="prk-dcd1-n2" value="Design class diagram (masuk proposal Bab II 2.3). Diturunkan dari conceptual model CM-1–4, katalog operasi SSD, AB-PRK-01–34, kontrak Core 16 Nov 2026. Rincian: rancangan/design-class-praktikum.md · Draf 16 Nov 2026 · Herrens" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="891" width="1540" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="prk-dcd2" name="DCD TO-BE (2-5) - Pengajuan"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1740" pageHeight="893" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="prk-dcd2-title" value="DCD 2/5 · Pengajuan: pemakaian lab dan perubahan sesi (PKG-15, PKG-18) · labfik_praktikum" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="6" width="1700" height="30" as="geometry"/></mxCell><mxCell id="prk-dcd2-mt" value="«Odoo»&lt;br&gt;&lt;b&gt;mail.thread&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;pelacakan perubahan dan chatter&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=55;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;" vertex=
        <mxCell id="tk-act-a1-35" value="[valid]" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="tk-act-a1-d6" target="tk-act-a1-us">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-a1-36" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="tk-act-a1-us" target="tk-act-a1-jj">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-a1-37" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="tk-act-a1-jj" target="tk-act-a1-en">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-a1-note0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §3.2)&lt;br&gt;• Putih «user» = aktor memakai sistem&lt;br&gt;• Abu-abu «service» = dikerjakan sistem otomatis&lt;br&gt;• Krem putus-putus «manual» = di luar sistem&lt;br&gt;• Ungu «call behavior» = memanggil diagram lain&lt;br&gt;• ◇ keputusan/gabungan; kondisi ditulis [guard] di panah&lt;br&gt;• ⧗ = menunggu waktu tertentu&lt;br&gt;• Bar hitam = jalur paralel (fork/join)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="1220" y="70" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-a1-note1" value="&lt;b&gt;Aturan bisnis&lt;/b&gt;&lt;br&gt;• &lt;i&gt;Periksa kelengkapan&lt;/i&gt; = &lt;code&gt;_cek_kelengkapan()&lt;/code&gt;, isinya berbeda per jenis dokumen (KF-24).&lt;br&gt;• &lt;i&gt;Sahkan dokumen&lt;/i&gt; hanya tersedia bagi jabatan yang berwenang untuk jenis dokumen itu; &lt;i&gt;Validasi pengesahan&lt;/i&gt; memastikan berkas bertanda tangan ada (KF-33).&lt;br&gt;• Tahap pemeriksaan aktif/tidak diatur per jenis dokumen (KF-32).&lt;br&gt;• Semua langkah tercatat di riwayat (KF-34)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="1220" y="236" width="320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-a1-note2" value="&lt;b&gt;[KONFIRMASI]&lt;/b&gt; Bila Dekan/Pemeriksa tidak login, aksi di lajur mereka yang bertanda «user» dilakukan KaLab atas nama mereka; berkas bertanda tangan menjadi buktinya." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="1220" y="392" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-a1-note3" value="&lt;b&gt;Tanpa tanda tangan digital&lt;/b&gt; (brief, batasan 3). Pengesahan lintas hari: &lt;i&gt;Cetak → Tanda tangani → Unggah&lt;/i&gt; adalah sesi terpisah, karena itu &lt;i&gt;Terbitkan dokumen resmi&lt;/i&gt; dan &lt;i&gt;Sahkan dokumen&lt;/i&gt; adalah aksi tersendiri." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="1220" y="488" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-a1-note4" value="Status dokumen di sepanjang alur ini: lihat &lt;b&gt;S1&lt;/b&gt;.&lt;br&gt;Draf 13 Nov 2026 · Febriyan" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="1220" y="594" width="320" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

        <mxCell id="tk-act-a4-11" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tk-act-a4-ev" target="tk-act-a4-sk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-a4-12" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="tk-act-a4-sk" target="tk-act-a4-d2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-a4-13" value="[struktur tetap, masa SK berjalan]" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="tk-act-a4-d2" target="tk-act-a4-m1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="620" y="952" />
              <mxPoint x="620" y="516" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="tk-act-a4-14" value="[perlu perubahan atau masa SK berakhir]" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="tk-act-a4-d2" target="tk-act-a4-tt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-a4-15" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="tk-act-a4-tt" target="tk-act-a4-en">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-a4-note0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §3.2)&lt;br&gt;• Putih «user» = aktor memakai sistem&lt;br&gt;• Abu-abu «service» = dikerjakan sistem otomatis&lt;br&gt;• Krem putus-putus «manual» = di luar sistem&lt;br&gt;• Ungu «call behavior» = memanggil diagram lain&lt;br&gt;• ◇ keputusan/gabungan; kondisi ditulis [guard] di panah&lt;br&gt;• ⧗ = menunggu waktu tertentu&lt;br&gt;• Bar hitam = jalur paralel (fork/join)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="680" y="70" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-a4-note1" value="&lt;b&gt;Kaitan ke kriteria PKG-03&lt;/b&gt;&lt;br&gt;K1 disahkan: &lt;i&gt;Sahkan dokumen (A1)&lt;/i&gt;&lt;br&gt;K2 lengkap: &lt;i&gt;Lengkapi uraian jabatan&lt;/i&gt; (tugas, wewenang, atasan, pengganti)&lt;br&gt;K3 dijalankan: &lt;i&gt;Catat rapat koordinasi&lt;/i&gt;&lt;br&gt;K4 dievaluasi: &lt;i&gt;Catat evaluasi struktur&lt;/i&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="680" y="236" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-a4-note2" value="&lt;b&gt;Siklus berikutnya&lt;/b&gt;: setelah &lt;i&gt;Tutup masa SK&lt;/i&gt;, SK baru disusun dari awal diagram ini; evaluasi ditautkan ke SK baru. SK lama berstatus Diganti atau Kedaluwarsa (lihat S1)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="680" y="362" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-a4-note3" value="&lt;b&gt;[KONFIRMASI]&lt;/b&gt; Frekuensi rapat koordinasi dan evaluasi struktur belum diketahui (wawancara KaLab)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="680" y="458" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-a4-note4" value="Draf 13 Nov 2026 · Febriyan" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="680" y="534" width="320" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

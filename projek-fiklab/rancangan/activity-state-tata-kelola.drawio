  <diagram id="tk-act-notes" name="Catatan TO-BE (bahan kerja) - Activity dan State Machine">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1160" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="tk-act-notes-title" value="Catatan diagram activity dan state machine (bahan kerja, tidak disisipkan ke naskah)" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1200" height="36" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-notes-legend" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §3.2): «user» = aktor memakai sistem; «service» = dikerjakan sistem otomatis; «manual» = di luar sistem; «call behavior» (simbol garpu) = memanggil activity lain; ◇ = keputusan/gabungan, kondisi ditulis [guard] di panah; ⧗ = menunggu waktu; bar hitam = fork/join. Gaya polos hitam-putih (keputusan Febriyan, 16 Nov 2026)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-notes-src" value="Sumber: kebutuhan-tata-kelola.md (KF-01–45), brief Tata Kelola (cakupan Inti + Pelengkap). Draf 14 Nov 2026, tata letak 16 Nov 2026 · Febriyan" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="40" y="132" width="1220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-notes-h0" value="&lt;b&gt;A1 · Pengesahan Dokumen (dipanggil oleh A2, A3, A4)&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-notes-n0-0" value="&lt;b&gt;Aturan&lt;/b&gt;&lt;br&gt;• &lt;i&gt;Periksa kelengkapan isi&lt;/i&gt;: isinya berbeda per jenis dokumen (KF-01, KF-30).&lt;br&gt;• &lt;i&gt;Periksa berkas dan wewenang&lt;/i&gt;: PDF bertanda tangan harus ada dan pengesah tercatat harus memegang jabatan yang berwenang untuk jenis dokumen itu (KF-05).&lt;br&gt;• &lt;i&gt;Ganti status dokumen lama&lt;/i&gt;: versi/revisi sebelumnya menjadi Diganti (KF-08).&lt;br&gt;• Setiap kejadian (diajukan, dikembalikan, berkas diunggah, disahkan) dicatat sebagai riwayat (KF-07)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="40" y="226" width="400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-notes-n0-1" value="&lt;b&gt;Pejabat penanda tangan bukan aktor sistem&lt;/b&gt; (keputusan 14 Nov 2026). Bisa Dekan atau KaLab sendiri; bila KaLab, lajur KaLab dan lajur pejabat diperankan orang yang sama. Pemeriksaan isi menyatu dengan penandatanganan; tidak ada tahap &lt;i&gt;Diperiksa&lt;/i&gt;." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="40" y="386" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-notes-n0-2" value="&lt;b&gt;Terbitkan dokumen PDF&lt;/b&gt;: rencana tahunan (KF-35, Inti); rencana pengembangan (KF-41) dan SK (KF-26) di lapis Pelengkap. Bila belum dibangun, PDF disiapkan di luar sistem seperti SOP/IK." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="40" y="486" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-notes-n0-3" value="Status dokumen di sepanjang alur ini: lihat &lt;b&gt;S1&lt;/b&gt;." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="40" y="576" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-notes-h1" value="&lt;b&gt;A2 · Siklus Dokumen SOP/IK (PKG-02)&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="460" y="180" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-notes-n1-0" value="&lt;b&gt;Kaitan ke kriteria PKG-02&lt;/b&gt;&lt;br&gt;S1 terdaftar: &lt;i&gt;Daftarkan dokumen induk&lt;/i&gt; (KF-10)&lt;br&gt;S2 disahkan: &lt;i&gt;Unggah versi&lt;/i&gt; (KF-11) + &lt;i&gt;Sahkan dokumen (A1)&lt;/i&gt;&lt;br&gt;S3 mutakhir: &lt;i&gt;Tinjau ulang&lt;/i&gt; (KF-14) + tanggal tinjau (KF-15, lihat &lt;b&gt;S2&lt;/b&gt;)&lt;br&gt;S4 tersedia: &lt;i&gt;Catat distribusi&lt;/i&gt; (KF-12)&lt;br&gt;S5 disosialisasikan: &lt;i&gt;Catat sosialisasi&lt;/i&gt; (KF-13)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="460" y="226" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-notes-n1-1" value="&lt;b&gt;Di luar sistem&lt;/b&gt;: naskah SOP/IK disusun di Word/Docs (keputusan 13 Nov 2026). Sistem mengelola versi, pengesahan, distribusi, sosialisasi, dan tinjau ulang." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="460" y="346" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-notes-n1-2" value="&lt;b&gt;Tanpa pengingat terjadwal&lt;/b&gt;: &lt;i&gt;Tandai versi perlu ditinjau&lt;/i&gt; adalah penanda yang dihitung dari tanggal (KF-15), bukan notifikasi. &lt;i&gt;Tinjau ulang&lt;/i&gt; juga boleh dilakukan sebelum tanggalnya tiba." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="460" y="426" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-notes-n1-3" value="Pengguna Lab membaca versi berlaku (KF-17, Pelengkap); tidak digambar karena bukan bagian alur ini." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="460" y="516" width="400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-notes-h2" value="&lt;b&gt;A3 · Siklus Rencana Tahunan dan Rencana Pengembangan (PKG-01, PKG-13)&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="880" y="180" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-notes-n2-0" value="&lt;b&gt;Kaitan ke kriteria PKG-01 / PKG-13&lt;/b&gt;&lt;br&gt;K1 disahkan: &lt;i&gt;Sahkan dokumen (A1)&lt;/i&gt;&lt;br&gt;K2 lengkap: &lt;i&gt;Susun item rencana&lt;/i&gt; (+ &lt;i&gt;Catat temuan gap&lt;/i&gt; untuk PKG-13), dicek saat diajukan (KF-30)&lt;br&gt;K3 dijalankan: &lt;i&gt;Isi realisasi item&lt;/i&gt; (KF-31)&lt;br&gt;K4 ditinjau: &lt;i&gt;Catat tinjauan rencana&lt;/i&gt; (KF-32) (+ &lt;i&gt;Catat ukuran manfaat&lt;/i&gt; untuk PKG-13, KF-40)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="880" y="226" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-notes-n2-1" value="&lt;b&gt;Siklus berikutnya&lt;/b&gt;: rencana periode berikutnya dimulai lagi dari awal diagram ini sebagai rekaman baru. Keputusan tinjauan ditautkan ke rencana itu (KF-32)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="880" y="356" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-notes-n2-2" value="&lt;b&gt;Pelengkap&lt;/b&gt;: &lt;i&gt;Buat revisi rencana&lt;/i&gt; (KF-37). Bila tidak dibangun, cabang [perlu revisi rencana] tidak ada. &lt;b&gt;Renstra&lt;/b&gt; tidak punya siklus: diunggah (KF-28) lalu &lt;i&gt;Sahkan dokumen (A1)&lt;/i&gt;. Tidak digambar (§3.4)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="880" y="436" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-notes-n2-3" value="&lt;b&gt;[KONFIRMASI KaLab]&lt;/b&gt; Periode lapor realisasi per triwulan atau per semester." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="880" y="536" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-notes-h3" value="&lt;b&gt;A4 · Siklus Struktur Organisasi (PKG-03), satu masa SK&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-notes-n3-0" value="&lt;b&gt;Kaitan ke kriteria PKG-03&lt;/b&gt;&lt;br&gt;K1 disahkan: &lt;i&gt;Susun SK&lt;/i&gt; (KF-21) + &lt;i&gt;Sahkan dokumen (A1)&lt;/i&gt;&lt;br&gt;K2 lengkap: &lt;i&gt;Lengkapi data jabatan&lt;/i&gt;: tugas, wewenang, atasan, pengganti (KF-20)&lt;br&gt;K3 dijalankan: &lt;i&gt;Catat rapat koordinasi&lt;/i&gt; (KF-22)&lt;br&gt;K4 dievaluasi: &lt;i&gt;Catat evaluasi struktur&lt;/i&gt; (KF-23)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="40" y="696" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-notes-n3-1" value="&lt;b&gt;Struktur diubah&lt;/b&gt;: SK revisi disusun dan disahkan; SK lama menjadi Diganti (S1). Evaluasi ditautkan ke SK atau jabatan yang direvisi. &lt;b&gt;Masa SK berakhir&lt;/b&gt;: SK baru dimulai dari awal diagram." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="40" y="816" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-notes-n3-2" value="Satu lajur saja: semua tugas sistem di alur ini sudah ada di A1. Status kriteria K1–K4 dihitung saat dibaca (KF-44), bukan tugas di alur." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="40" y="906" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-notes-n3-3" value="&lt;b&gt;[KONFIRMASI KaLab]&lt;/b&gt; Frekuensi rapat koordinasi dan evaluasi struktur." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="40" y="976" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-notes-h4" value="&lt;b&gt;S1 · Status dokumen yang disahkan (labfik.approval.mixin): Renstra, Rencana, SK Penetapan, Versi SOP/IK&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="460" y="650" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-notes-n4-0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §3.3): &lt;code&gt;event [guard] / efek&lt;/code&gt;. Tanda * = transisi yang tidak ada di analisis PKG dan baru ditemukan lewat tabel status × transisi. Transisi &lt;i&gt;when(periode berakhir)&lt;/i&gt; = lapis Pelengkap (Penjadwal, KF-09)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="460" y="696" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-notes-n4-1" value="&lt;b&gt;Penyatuan status&lt;/b&gt; dari analisis: PKG-01 draf/diajukan/disahkan/kedaluwarsa; PKG-02 berlaku → &lt;b&gt;Disahkan&lt;/b&gt;; PKG-13 selesai → &lt;b&gt;Kedaluwarsa&lt;/b&gt;; Diperiksa dihapus (keputusan 14 Nov 2026)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="460" y="786" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-notes-n4-2" value="&lt;b&gt;Berlaku untuk&lt;/b&gt;: Renstra, Rencana, SK Penetapan → semua transisi. Versi SOP/IK → semua kecuali &lt;i&gt;Kedaluwarsa&lt;/i&gt; (tidak berperiode; kemutakhirannya di &lt;b&gt;S2&lt;/b&gt;). Tanpa KF-09, status tetap Disahkan, tetapi K1 &quot;masih berlaku&quot; dihitung dari tanggal periode (KF-44)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="460" y="866" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-notes-n4-3" value="&lt;b&gt;[ASUMSI]&lt;/b&gt; Dicabut, Diganti, dan Kedaluwarsa adalah status akhir. Dokumen tidak diaktifkan kembali; yang dibuat adalah revisi atau dokumen periode baru." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="460" y="956" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-notes-h5" value="&lt;b&gt;S2 · Kemutakhiran versi SOP/IK yang sedang berlaku (rincian status Disahkan di S1)&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="880" y="650" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-notes-n5-0" value="&lt;b&gt;Kaitan ke PKG-02 S3 (mutakhir)&lt;/b&gt;: versi berlaku memenuhi S3 selama berada di &lt;i&gt;Mutakhir&lt;/i&gt;, yaitu tanggal tinjau berikutnya belum terlewati. &lt;b&gt;[ASUMSI]&lt;/b&gt; Tinjauan dengan hasil &lt;i&gt;perlu revisi&lt;/i&gt; tidak mengubah sub-status dan tidak memperbarui tanggal tinjau; tinjauan itu memicu penyusunan versi baru (A2)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="880" y="696" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-notes-n5-1" value="&lt;b&gt;Implementasi&lt;/b&gt; (Wazlawick §9.3, &lt;i&gt;modal class&lt;/i&gt;, transisi stabil): sub-status &lt;b&gt;tidak&lt;/b&gt; disimpan sebagai field &lt;code&gt;state&lt;/code&gt;. &lt;i&gt;Perlu Ditinjau&lt;/i&gt; dihitung dari tanggal tinjau berikutnya &amp;lt; hari ini (KF-15). Tanpa pengingat terjadwal." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="880" y="796" width="400" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

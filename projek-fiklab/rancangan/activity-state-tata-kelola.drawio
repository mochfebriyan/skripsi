-a4-a1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-act-a4-5" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="tk-act-a4-a1" target="tk-act-a4-m1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-act-a4-6" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="tk-act-a4-m1" target="tk-act-a4-rk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-act-a4-7" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="tk-act-a4-rk" target="tk-act-a4-d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-act-a4-8" value="[belum waktunya evaluasi]" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tk-act-a4-d1" target="tk-act-a4-m1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="656"/><mxPoint x="390" y="508"/></Array></mxGeometry></mxCell><mxCell id="tk-act-a4-9" value="[waktunya evaluasi]" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="tk-act-a4-d1" target="tk-act-a4-ev"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-act-a4-10" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="tk-act-a4-ev" target="tk-act-a4-d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-act-a4-11" value="[struktur tetap ∧&lt;br&gt;masa SK berjalan]" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="tk-act-a4-d2" target="tk-act-a4-m1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="430" y="804"/><mxPoint x="430" y="516"/></Array></mxGeometry></mxCell><mxCell id="tk-act-a4-12" value="[struktur perlu diubah]" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tk-act-a4-d2" target="tk-act-a4-m0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="70" y="804"/><mxPoint x="70" y="212"/></Array></mxGeometry></mxCell><mxCell id="tk-act-a4-13" value="[masa SK berakhir]" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="tk-act-a4-d2" target="tk-act-a4-en"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-act-a4-note0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §3.2)&lt;br&gt;• Putih «user» = aktor memakai sistem&lt;br&gt;• Abu-abu «service» = dikerjakan sistem otomatis&lt;br&gt;• Krem putus-putus «manual» = di luar sistem&lt;br&gt;• Ungu «call behavior» = memanggil activity lain&lt;br&gt;• ◇ keputusan/gabungan; kondisi ditulis [guard] di panah&lt;br&gt;• ⧗ = menunggu waktu tertentu&lt;br&gt;• Bar hitam = fork/join: semua cabang dikerjakan, urutannya bebas; alur lanjut setelah semua cabang selesai" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="500" y="70" width="320" height="165" as="geometry"/></mxCell><mxCell id="tk-act-a4-note1" value="&lt;b&gt;Kaitan ke kriteria PKG-03&lt;/b&gt;&lt;br&gt;K1 disahkan: &lt;i&gt;Susun SK&lt;/i&gt; (KF-21) + &lt;i&gt;Sahkan dokumen (A1)&lt;/i&gt;&lt;br&gt;K2 lengkap: &lt;i&gt;Lengkapi data jabatan&lt;/i&gt;: tugas, wewenang, atasan, pengganti (KF-20)&lt;br&gt;K3 dijalankan: &lt;i&gt;Catat rapat koordinasi&lt;/i&gt; (KF-22)&lt;br&gt;K4 dievaluasi: &lt;i&gt;Catat evaluasi struktur&lt;/i&gt; (KF-23)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="500" y="251" width="320" height="120" as="geometry"/></mxCell><mxCell id="tk-act-a4-note2" value="&lt;b&gt;Struktur diubah&lt;/b&gt;: SK revisi disusun dan disahkan; SK lama menjadi Diganti (S1). Evaluasi ditautkan ke SK atau jabatan yang direvisi. &lt;b&gt;Masa SK berakhir&lt;/b&gt;: SK baru dimulai dari awal diagram." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="500" y="387" width="320" height="90" as="geometry"/></mxCell><mxCell id="tk-act-a4-note3" value="Satu lajur saja: semua tugas sistem di alur ini sudah ada di A1. Status kriteria K1–K4 dihitung saat dibaca (KF-44), bukan tugas di alur." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="500" y="493" width="320" height="70" as="geometry"/></mxCell><mxCell id="tk-act-a4-note4" value="&lt;b&gt;[KONFIRMASI KaLab]&lt;/b&gt; Frekuensi rapat koordinasi dan evaluasi struktur.&lt;br&gt;Sumber: kebutuhan-tata-kelola.md (KF-01–45), brief Tata Kelola (cakupan Inti + Pelengkap).&lt;br&gt;Draf 14 Nov 2026 · Febriyan" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="500" y="579" width="320" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="tk-stm-s1" name="State Machine TO-BE (1-2) - Status Dokumen"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tk-stm-s1-title" value="S1 · Status dokumen yang disahkan (&lt;code&gt;labfik.approval.mixin&lt;/code&gt;): Renstra, Rencana, SK Penetapan, Versi SOP/IK" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1500" height="40" as="geometry"/></mxCell><mxCell id="tk-stm-s1-init" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="50" y="238" width="24" height="24" as="geometry"/></mxCell><mxCell id="tk-stm-s1-draf" value="Draf" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="130" y="225" width="150" height="50" as="geometry"/></mxCell><mxCell id="tk-stm-s1-aju" value="Diajukan" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="540" y="225" width="150" height="50" as="geometry"/></mxCell><mxCell id="tk-stm-s1-sah" value="Disahkan&lt;br&gt;&lt;font style='font-size:10px;font-weight:normal'&gt;(berlaku)&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="980" y="225" width="160" height="50" as="geometry"/></mxCell><mxCell id="tk-stm-s1-gnt" value="Diganti" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#EEEEEE;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1340" y="100" width="150" height="50" as="geometry"/></mxCell><mxCell id="tk-stm-s1-cbt" value="Dicabut" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#EEEEEE;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1340" y="225" width="150" height="50" as="geometry"/></mxCell><mxCell id="tk-stm-s1-kdl" value="Kedaluwarsa" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#EEEEEE;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1340" y="350" width="150" height="50" as="geometry"/></mxCell><mxCell id="tk-stm-s1-f0" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="191" y="400" width="28" height="28" as="geometry"/></mxCell><mxCell id="tk-stm-s1-f1" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1580" y="111" width="28" height="28" as="geometry"/></mxCell><mxCell id="tk-stm-s1-f2" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1580" y="236" width="28" height="28" as="geometry"/></mxCell><mxCell id="tk-stm-s1-f3" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1580" y="361" width="28" height="28" as="geometry"/></mxCell><mxCell id="tk-stm-s1-t0" value="buat" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="tk-stm-s1-init" target="tk-stm-s1-draf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-stm-s1-t1" value="ajukan [isi lengkap]&lt;br&gt;/ catat riwayat" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="tk-stm-s1-draf" target="tk-stm-s1-aju"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-stm-s1-t2" value="kembalikan / catat alasan" style="endArrow=open;endSize=9;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9B2C44;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="tk-stm-s1-aju" target="tk-stm-s1-draf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-stm-s1-t3" value="unggah berkas bertanda tangan&lt;br&gt;/ catat riwayat" style="endArrow=open;endSize=9;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9B2C44;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tk-stm-s1-aju" target="tk-stm-s1-aju"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="575" y="160"/><mxPoint x="655" y="160"/></Array></mxGeometry></mxCell><mxCell id="tk-stm-s1-t4" value="sahkan [berkas ada ∧ pengesah berwenang]&lt;br&gt;/ catat pengesah, pencatat, tanggal sah;&lt;br&gt;dokumen lama → Diganti" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tk-stm-s1-aju" target="tk-stm-s1-sah"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-stm-s1-t5" value="revisi / versi baru disahkan" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tk-stm-s1-sah" target="tk-stm-s1-gnt"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="125"/></Array></mxGeometry></mxCell><mxCell id="tk-stm-s1-t6" value="cabut / catat alasan" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tk-stm-s1-sah" target="tk-stm-s1-cbt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-stm-s1-t7" value="when(periode berakhir)&lt;br&gt;[dokumen berperiode]" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tk-stm-s1-sah" target="tk-stm-s1-kdl"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="375"/></Array></mxGeometry></mxCell><mxCell id="tk-stm-s1-t8" value="hapus [belum pernah diajukan]" style="endArrow=open;endSize=9;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9B2C44;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tk-stm-s1-draf" target="tk-stm-s1-f0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-stm-s1-tf1" value="" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="tk-stm-s1-gnt" target="tk-stm-s1-f1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-stm-s1-tf2" value="" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="tk-stm-s1-cbt" target="tk-stm-s1-f2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-stm-s1-tf3" value="" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="tk-stm-s1-kdl" target="tk-stm-s1-f3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-stm-s1-n1" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §3.3): &lt;code&gt;event [guard] / efek&lt;/code&gt;. Abu-abu = status akhir. &lt;font color='#9B2C44'&gt;&lt;b&gt;Garis merah&lt;/b&gt;&lt;/font&gt; = transisi yang tidak ada di analisis PKG dan baru ditemukan lewat tabel status × transisi. &lt;b&gt;Garis putus-putus&lt;/b&gt; = lapis Pelengkap (Penjadwal, KF-09)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="560" height="90" as="geometry"/></mxCell><mxCell id="tk-stm-s1-n2" value="&lt;b&gt;Penyatuan status&lt;/b&gt; dari analisis:&lt;br&gt;• PKG-01: draf/diajukan/disahkan/kedaluwarsa&lt;br&gt;• PKG-02: berlaku → &lt;b&gt;Disahkan&lt;/b&gt;&lt;br&gt;• PKG-13: selesai → &lt;b&gt;Kedaluwarsa&lt;/b&gt;&lt;br&gt;• Diperiksa dihapus (keputusan 14 Nov 2026)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="620" y="480" width="400" height="110" as="geometry"/></mxCell><mxCell id="tk-stm-s1-n3" value="&lt;b&gt;Berlaku untuk&lt;/b&gt;: Renstra, Rencana, SK Penetapan → semua transisi.&lt;br&gt;Versi SOP/IK → semua kecuali &lt;i&gt;Kedaluwarsa&lt;/i&gt; (tidak berperiode; kemutakhirannya di &lt;b&gt;S2&lt;/b&gt;).&lt;br&gt;Tanpa KF-09, status tetap Disahkan, tetapi K1 &quot;masih berlaku&quot; dihitung dari tanggal periode (KF-44)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1040" y="480" width="470" height="110" as="geometry"/></mxCell><mxCell id="tk-stm-s1-n4" value="&lt;b&gt;[ASUMSI]&lt;/b&gt; Dicabut, Diganti, dan Kedaluwarsa adalah status akhir. Dokumen tidak diaktifkan kembali; yang dibuat adalah revisi atau dokumen periode baru.&lt;br&gt;Draf 14 Nov 2026 · Febriyan" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="560" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="tk-stm-s2" name="State Machine TO-BE (2-2) - Kemutakhiran Versi SOP-IK"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tk-stm-s2-title" value="S2 · Kemutakhiran versi SOP/IK yang sedang berlaku (rincian status Disahkan di S1)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1400" height="40" as="geometry"/></mxCell><mxCell id="tk-stm-s2-pre" value="Diajukan (S1)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="235" width="150" height="50" as="geometry"/></mxCell><mxCell id="tk-stm-s2-cmp" value="Disahkan (S1)" style="swimlane;rounded=1;arcSize=6;html=1;startSize=30;fontStyle=1;fontSize=13;fillColor=#F5F0FF;strokeColor=#333333;swimlaneFillColor=#FFFFFF;collapsible=0;container=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="280" y="80" width="820" height="360" as="geometry"/></mxCell><mxCell id="tk-stm-s2-init" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="320" y="248" width="24" height="24" as="geometry"/></mxCell><mxCell id="tk-stm-s2-mut" value="Mutakhir" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="235" width="160" height="50" as="geometry"/></mxCell><mxCell id="tk-stm-s2-ptn" value="Perlu Ditinjau" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="840" y="235" width="170" height="50" as="geometry"/></mxCell><mxCell id="tk-stm-s2-gnt" value="Diganti" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#EEEEEE;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1220" y="140" width="150" height="50" as="geometry"/></mxCell><mxCell id="tk-stm-s2-cbt" value="Dicabut" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#EEEEEE;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1220" y="330" width="150" height="50" as="geometry"/></mxCell><mxCell id="tk-stm-s2-t0" value="sahkan (S1)" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tk-stm-s2-pre" target="tk-stm-s2-cmp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-stm-s2-t1" value="/ hitung tanggal tinjau" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="tk-stm-s2-init" target="tk-stm-s2-mut"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-stm-s2-t2" value="when(tanggal tinjau terlewati)" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tk-stm-s2-mut" target="tk-stm-s2-ptn"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="170"/><mxPoint x="925" y="170"/></Array></mxGeometry></mxCell><mxCell id="tk-stm-s2-t3" value="tinjau [hasil = tetap berlaku]&lt;br&gt;/ perbarui tanggal tinjau" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tk-stm-s2-ptn" target="tk-stm-s2-mut"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-stm-s2-t4" value="tinjau [hasil = tetap berlaku]&lt;br&gt;/ perbarui tanggal tinjau" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="tk-stm-s2-mut" target="tk-stm-s2-mut"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="360"/><mxPoint x="380" y="360"/><mxPoint x="380" y="275"/></Array></mxGeometry></mxCell><mxCell id="tk-stm-s2-t5" value="versi baru disahkan" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tk-stm-s2-cmp" target="tk-stm-s2-gnt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-stm-s2-t6" value="cabut" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tk-stm-s2-cmp" target="tk-stm-s2-cbt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-stm-s2-n1" value="&lt;b&gt;Kaitan ke PKG-02 S3 (mutakhir)&lt;/b&gt;: versi berlaku memenuhi S3 selama berada di &lt;i&gt;Mutakhir&lt;/i&gt;, yaitu tanggal tinjau berikutnya belum terlewati.&lt;br&gt;&lt;b&gt;[ASUMSI]&lt;/b&gt; Tinjauan dengan hasil &lt;i&gt;perlu revisi&lt;/i&gt; tidak mengubah sub-status dan tidak memperbarui tanggal tinjau. Tinjauan itu memicu penyusunan versi baru (A2)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="560" height="110" as="geometry"/></mxCell><mxCell id="tk-stm-s2-n2" value="&lt;b&gt;Implementasi&lt;/b&gt; (Wazlawick §9.3, &lt;i&gt;modal class&lt;/i&gt;, transisi stabil): sub-status &lt;b&gt;tidak&lt;/b&gt; disimpan sebagai field &lt;code&gt;state&lt;/code&gt;. &lt;i&gt;Perlu Ditinjau&lt;/i&gt; dihitung dari tanggal tinjau berikutnya &amp;lt; hari ini (KF-15). Tanpa pengingat terjadwal." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="620" y="480" width="500" height="90" as="geometry"/></mxCell><mxCell id="tk-stm-s2-n3" value="Draf 14 Nov 2026 · Febriyan" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1140" y="480" width="220" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
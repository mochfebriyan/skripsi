        <mxCell id="tk-act-a3-note0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §3.2)&lt;br&gt;• Putih «user» = aktor memakai sistem&lt;br&gt;• Abu-abu «service» = dikerjakan sistem otomatis&lt;br&gt;• Krem putus-putus «manual» = di luar sistem&lt;br&gt;• Ungu «call behavior» = memanggil diagram lain&lt;br&gt;• ◇ keputusan/gabungan; kondisi ditulis [guard] di panah&lt;br&gt;• ⧗ = menunggu waktu tertentu&lt;br&gt;• Bar hitam = jalur paralel (fork/join)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="1120" y="70" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-a3-note1" value="&lt;b&gt;Kaitan ke kriteria PKG-01 / PKG-13&lt;/b&gt;&lt;br&gt;K1 disahkan: &lt;i&gt;Sahkan dokumen (A1)&lt;/i&gt;&lt;br&gt;K2 lengkap: &lt;i&gt;Susun item rencana&lt;/i&gt; (+ &lt;i&gt;analisis gap&lt;/i&gt; untuk PKG-13), dicek saat diajukan&lt;br&gt;K3 dijalankan: &lt;i&gt;Isi realisasi item&lt;/i&gt;&lt;br&gt;K4 ditinjau: &lt;i&gt;Catat tinjauan&lt;/i&gt;, &lt;i&gt;Tetapkan keputusan perbaikan&lt;/i&gt; (+ &lt;i&gt;Ukur manfaat&lt;/i&gt; untuk PKG-13)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="1120" y="236" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-a3-note2" value="&lt;b&gt;Siklus berikutnya&lt;/b&gt;: keputusan perbaikan ditautkan ke rencana periode berikutnya, yang dimulai lagi dari awal diagram ini (record rencana baru)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="1120" y="372" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-a3-note3" value="&lt;b&gt;Temuan&lt;/b&gt;: &lt;i&gt;Kirim pengingat realisasi&lt;/i&gt; belum ada di daftar kebutuhan (kandidat KF baru, opsional)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="1120" y="458" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-a3-note4" value="Draf 13 Nov 2026 · Febriyan" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="1120" y="534" width="320" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

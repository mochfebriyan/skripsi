#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tk-act-a3-d2" target="tk-act-a3-ct"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="915" y="878"/></Array></mxGeometry></mxCell><mxCell id="tk-act-a3-15" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="tk-act-a3-ct" target="tk-act-a3-d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-act-a3-16" value="[jenis = pengembangan]" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tk-act-a3-d3" target="tk-act-a3-um"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-act-a3-17" value="[jenis = tahunan]" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="tk-act-a3-d3" target="tk-act-a3-m3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-act-a3-18" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tk-act-a3-um" target="tk-act-a3-m3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-act-a3-19" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="tk-act-a3-m3" target="tk-act-a3-en"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-act-a3-note0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §3.2)&lt;br&gt;• Putih «user» = aktor memakai sistem&lt;br&gt;• Abu-abu «service» = dikerjakan sistem otomatis&lt;br&gt;• Krem putus-putus «manual» = di luar sistem&lt;br&gt;• Ungu «call behavior» = memanggil activity lain&lt;br&gt;• ◇ keputusan/gabungan; kondisi ditulis [guard] di panah&lt;br&gt;• ⧗ = menunggu waktu tertentu&lt;br&gt;• Bar hitam = fork/join: semua cabang dikerjakan, urutannya bebas; alur lanjut setelah semua cabang selesai" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1090" y="70" width="320" height="165" as="geometry"/></mxCell><mxCell id="tk-act-a3-note1" value="&lt;b&gt;Kaitan ke kriteria PKG-01 / PKG-13&lt;/b&gt;&lt;br&gt;K1 disahkan: &lt;i&gt;Sahkan dokumen (A1)&lt;/i&gt;&lt;br&gt;K2 lengkap: &lt;i&gt;Susun item rencana&lt;/i&gt; (+ &lt;i&gt;Catat temuan gap&lt;/i&gt; untuk PKG-13), dicek saat diajukan (KF-30)&lt;br&gt;K3 dijalankan: &lt;i&gt;Isi realisasi item&lt;/i&gt; (KF-31)&lt;br&gt;K4 ditinjau: &lt;i&gt;Catat tinjauan rencana&lt;/i&gt; (KF-32) (+ &lt;i&gt;Catat ukuran manfaat&lt;/i&gt; untuk PKG-13, KF-40)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1090" y="251" width="320" height="130" as="geometry"/></mxCell><mxCell id="tk-act-a3-note2" value="&lt;b&gt;Siklus berikutnya&lt;/b&gt;: rencana periode berikutnya dimulai lagi dari awal diagram ini sebagai rekaman baru. Keputusan tinjauan ditautkan ke rencana itu (KF-32)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1090" y="397" width="320" height="80" as="geometry"/></mxCell><mxCell id="tk-act-a3-note3" value="&lt;b&gt;Pelengkap&lt;/b&gt;: &lt;i&gt;Buat revisi rencana&lt;/i&gt; (KF-37). Bila tidak dibangun, cabang [perlu revisi rencana] tidak ada.&lt;br&gt;&lt;b&gt;Renstra&lt;/b&gt; tidak punya siklus: diunggah (KF-28) lalu &lt;i&gt;Sahkan dokumen (A1)&lt;/i&gt;. Tidak digambar (§3.4)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1090" y="493" width="320" height="100" as="geometry"/></mxCell><mxCell id="tk-act-a3-note4" value="&lt;b&gt;[KONFIRMASI KaLab]&lt;/b&gt; Periode lapor realisasi per triwulan atau per semester.&lt;br&gt;Sumber: kebutuhan-tata-kelola.md (KF-01–45), brief Tata Kelola (cakupan Inti + Pelengkap).&lt;br&gt;Draf 14 Nov 2026 · Febriyan" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1090" y="609" width="320" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="tk-act-a4" name="Activity TO-BE (4-4) - Siklus Struktur"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="860" pageHeight="1032" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tk-act-a4-lane-k" value="KaLab" style="swimlane;html=1;startSize=34;fillColor=#F5F0FF;strokeColor=#9673A6;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;collapsible=0;container=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="420" height="902" as="geometry"/></mxCell><mxCell id="tk-act-a4-title" value="A4 · Siklus Struktur Organisasi (PKG-03), satu masa SK" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1100" height="40" as="geometry"/></mxCell><mxCell id="tk-act-a4
        </mxCell>
        <mxCell id="tk-stm-s1-t11" value="hapus [belum pernah diajukan]" style="endArrow=open;endSize=9;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9B2C44;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tk-stm-s1-draf" target="tk-stm-s1-f0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tk-stm-s1-tf1" value="" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="tk-stm-s1-gnt" target="tk-stm-s1-f1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tk-stm-s1-tf2" value="" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="tk-stm-s1-cbt" target="tk-stm-s1-f2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tk-stm-s1-tf3" value="" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="tk-stm-s1-kdl" target="tk-stm-s1-f3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tk-stm-s1-n1" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §3.3): &lt;code&gt;event [guard] / efek&lt;/code&gt;. Abu-abu = status akhir. &lt;font color=&#39;#9B2C44&#39;&gt;&lt;b&gt;Garis merah&lt;/b&gt;&lt;/font&gt; = transisi yang &lt;b&gt;baru ditemukan&lt;/b&gt; lewat tabel status × transisi dan belum ada di analisis maupun class diagram sebelumnya." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tk-stm-s1-n2" value="&lt;b&gt;Penyatuan status&lt;/b&gt; dari tiga analisis yang berbeda:&lt;br&gt;• PKG-01: draf/diajukan/disahkan/kedaluwarsa&lt;br&gt;• PKG-02: draf/diajukan/&lt;b&gt;berlaku&lt;/b&gt;/dicabut → berlaku = Disahkan&lt;br&gt;• PKG-13: draf/diajukan/disahkan/diganti/&lt;b&gt;selesai&lt;/b&gt; → selesai = Kedaluwarsa&lt;br&gt;• Diperiksa: dari dokumen lab (Disusun/Diperiksa/Disahkan)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="620" y="580" width="470" height="110" as="geometry" />
        </mxCell>
        <mxCell id="tk-stm-s1-n3" value="&lt;b&gt;Berlaku untuk&lt;/b&gt;: Rencana (semua jenis), SK Penetapan → semua transisi.&lt;br&gt;Versi SOP/IK → semua kecuali &lt;i&gt;Kedaluwarsa&lt;/i&gt; (tidak berperiode; kemutakhirannya diatur jadwal tinjau ulang, lihat S2)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="1110" y="580" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="tk-stm-s1-n4" value="&lt;b&gt;[KONFIRMASI]&lt;/b&gt; Apakah dokumen Dicabut/Kedaluwarsa boleh diaktifkan kembali? Untuk sekarang dianggap status akhir; dokumen baru dibuat sebagai revisi." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="40" y="670" width="560" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="tk-stm-s2" name="State Machine S2 - Kemutakhiran Versi SOP-IK">

;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="tk-act-a1-us" target="tk-act-a1-gv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-act-a1-29" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="tk-act-a1-gv" target="tk-act-a1-cr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-act-a1-30" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="tk-act-a1-cr" target="tk-act-a1-en"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-act-a1-note0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §3.2)&lt;br&gt;• Putih «user» = aktor memakai sistem&lt;br&gt;• Abu-abu «service» = dikerjakan sistem otomatis&lt;br&gt;• Krem putus-putus «manual» = di luar sistem&lt;br&gt;• Ungu «call behavior» = memanggil activity lain&lt;br&gt;• ◇ keputusan/gabungan; kondisi ditulis [guard] di panah&lt;br&gt;• ⧗ = menunggu waktu tertentu&lt;br&gt;• Bar hitam = fork/join: semua cabang dikerjakan, urutannya bebas; alur lanjut setelah semua cabang selesai" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1230" y="70" width="320" height="165" as="geometry"/></mxCell><mxCell id="tk-act-a1-note1" value="&lt;b&gt;Aturan&lt;/b&gt;&lt;br&gt;• &lt;i&gt;Periksa kelengkapan isi&lt;/i&gt;: isinya berbeda per jenis dokumen (KF-01, KF-30).&lt;br&gt;• &lt;i&gt;Periksa berkas dan wewenang&lt;/i&gt;: PDF bertanda tangan harus ada dan pengesah tercatat harus memegang jabatan yang berwenang untuk jenis dokumen itu (KF-05).&lt;br&gt;• &lt;i&gt;Ganti status dokumen lama&lt;/i&gt;: versi/revisi sebelumnya menjadi Diganti (KF-08).&lt;br&gt;• Setiap kejadian (diajukan, dikembalikan, berkas diunggah, disahkan) dicatat sebagai riwayat (KF-07)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1230" y="251" width="320" height="170" as="geometry"/></mxCell><mxCell id="tk-act-a1-note2" value="&lt;b&gt;Pejabat penanda tangan bukan aktor sistem&lt;/b&gt; (keputusan 14 Nov 2026). Bisa Dekan atau KaLab sendiri; bila KaLab, lajur KaLab dan lajur pejabat diperankan orang yang sama. Pemeriksaan isi menyatu dengan penandatanganan; tidak ada tahap &lt;i&gt;Diperiksa&lt;/i&gt;." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1230" y="437" width="320" height="100" as="geometry"/></mxCell><mxCell id="tk-act-a1-note3" value="&lt;b&gt;Terbitkan dokumen PDF&lt;/b&gt;: rencana tahunan (KF-35, Inti); rencana pengembangan (KF-41) dan SK (KF-26) di lapis Pelengkap. Bila belum dibangun, PDF disiapkan di luar sistem seperti SOP/IK." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1230" y="553" width="320" height="90" as="geometry"/></mxCell><mxCell id="tk-act-a1-note4" value="Status dokumen di sepanjang alur ini: lihat &lt;b&gt;S1&lt;/b&gt;.&lt;br&gt;Sumber: kebutuhan-tata-kelola.md (KF-01–45), brief Tata Kelola (cakupan Inti + Pelengkap).&lt;br&gt;Draf 14 Nov 2026 · Febriyan" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1230" y="659" width="320" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="tk-act-a2" name="Activity TO-BE (2-4) - Siklus SOP-IK"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1624" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tk-act-a2-lane-l" value="Laboran / PLP" style="swimlane;html=1;startSize=34;fillColor=#F5F0FF;strokeColor=#9673A6;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;collapsible=0;container=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="480" height="1494" as="geometry"/></mxCell><mxCell id="tk-act-a2-lane-k" value="KaLab" style="swimlane;html=1;startSize=34;fillColor=#F5F0FF;strokeColor=#9673A6;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;collapsible=0;container=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="520" y="70" width="250" height="1494" as="geometry"/></mxCell><mxCell id="tk-act-a2-lane-s" value="Sistem" style="swimlane;html=1;startSize=34;fillColor=#F5F0FF;strokeColor=#9673A6;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;collapsible=0;container=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="770" y="70" width="290" height="1494" as="geometry"/></mxCell><mxCell id="tk-act-a2-title" value="A2 · Siklus Dokumen SOP/IK (PKG-02)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1100" height="40" as="geometry"/></mxCell><mxCell id="tk-act-a2-st" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="268" y="126" width="24" height="24" as="geometry"/></mxCell><mxCell id="tk-act-a2-d1" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="263" y="195" width="34" height="34" as="geometry"/></mxCell><mxCell id="tk-act-a2-di" value="&lt;font style='font-size:9px' color='#6C4A87'&gt;«user»&lt;/font&gt;&lt;br&gt;Daftarkan dokumen induk" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="300" y="263" width="200" height="46" as="geometry"/></mxCell><mxCell id="tk-act-a2-m1" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="263" y="343" width="34" height="34" as="geometry"/></mxCell><mxCell id="tk-act-a2-sn" value="&lt;font style='font-size:9px' color='#6C4A87'&gt;«manual»&lt;/font&gt;&lt;br&gt;Susun naskah SOP/IK" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF8E7;strokeColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="180" y="411" width="200" height="46" as="geometry"/></mxCell><mxCell id="tk-act-a2-uv" value="&lt;font style='font-size:9px' color='#6C4A87'&gt;«user»&lt;/font&gt;&lt;br&gt;Unggah versi dokumen" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="180" y="485" width="200" height="46" as="geometry"/></mxCell><mxCell id="tk-act-a2-a1" value="&lt;font style='font-size:9px' color='#6C4A87'&gt;«call behavior»&lt;/font&gt;&lt;br&gt;Sahkan dokumen (A1)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F5F0FF;strokeColor=#6C4A87;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="180" y="557" width="200" height="50" as="geometry"/></mxCell><mxCell id="tk-act-a2-ht" value="&lt;font style='font-size:9px' color='#6C4A87'&gt;«service»&lt;/font&gt;&lt;br&gt;Hitung tanggal tinjau berikutnya" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#EEEEEE;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="815" y="633" width="200" height="46" as="geometry"/></mxCell><mxCell id="tk-act-a2-fk" value="" style="html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="70" y="727" width="420" height="6" as="geometry"/></mxCell><mxCell id="tk-act-a2-cd" value=
        <mxCell id="tk-act-a2-25" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="tk-act-a2-uc" target="tk-act-a2-en">

t="tk-act-a2-pj"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-act-a2-20" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tk-act-a2-pj" target="tk-act-a2-m2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1036" y="1248"/><mxPoint x="1036" y="952"/></Array></mxGeometry></mxCell><mxCell id="tk-act-a2-21" value="[perlu revisi]" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tk-act-a2-d2" target="tk-act-a2-m1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="64" y="1248"/><mxPoint x="64" y="360"/></Array></mxGeometry></mxCell><mxCell id="tk-act-a2-22" value="[tidak diperlukan lagi]" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tk-act-a2-d2" target="tk-act-a2-cb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-act-a2-23" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tk-act-a2-cb" target="tk-act-a2-uc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-act-a2-24" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="tk-act-a2-uc" target="tk-act-a2-en"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-act-a2-note0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §3.2)&lt;br&gt;• Putih «user» = aktor memakai sistem&lt;br&gt;• Abu-abu «service» = dikerjakan sistem otomatis&lt;br&gt;• Krem putus-putus «manual» = di luar sistem&lt;br&gt;• Ungu «call behavior» = memanggil activity lain&lt;br&gt;• ◇ keputusan/gabungan; kondisi ditulis [guard] di panah&lt;br&gt;• ⧗ = menunggu waktu tertentu&lt;br&gt;• Bar hitam = fork/join: semua cabang dikerjakan, urutannya bebas; alur lanjut setelah semua cabang selesai" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1100" y="70" width="320" height="165" as="geometry"/></mxCell><mxCell id="tk-act-a2-note1" value="&lt;b&gt;Kaitan ke kriteria PKG-02&lt;/b&gt;&lt;br&gt;S1 terdaftar: &lt;i&gt;Daftarkan dokumen induk&lt;/i&gt; (KF-10)&lt;br&gt;S2 disahkan: &lt;i&gt;Unggah versi&lt;/i&gt; (KF-11) + &lt;i&gt;Sahkan dokumen (A1)&lt;/i&gt;&lt;br&gt;S3 mutakhir: &lt;i&gt;Tinjau ulang&lt;/i&gt; (KF-14) + tanggal tinjau (KF-15, lihat &lt;b&gt;S2&lt;/b&gt;)&lt;br&gt;S4 tersedia: &lt;i&gt;Catat distribusi&lt;/i&gt; (KF-12)&lt;br&gt;S5 disosialisasikan: &lt;i&gt;Catat sosialisasi&lt;/i&gt; (KF-13)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1100" y="251" width="320" height="120" as="geometry"/></mxCell><mxCell id="tk-act-a2-note2" value="&lt;b&gt;Di luar sistem&lt;/b&gt;: naskah SOP/IK disusun di Word/Docs (keputusan 13 Nov 2026). Sistem mengelola versi, pengesahan, distribusi, sosialisasi, dan tinjau ulang." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1100" y="387" width="320" height="80" as="geometry"/></mxCell><mxCell id="tk-act-a2-note3" value="&lt;b&gt;Tanpa pengingat terjadwal&lt;/b&gt;: &lt;i&gt;Tandai versi perlu ditinjau&lt;/i&gt; adalah penanda yang dihitung dari tanggal (KF-15), bukan notifikasi. &lt;i&gt;Tinjau ulang&lt;/i&gt; juga boleh dilakukan sebelum tanggalnya tiba." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1100" y="483" width="320" height="90" as="geometry"/></mxCell><mxCell id="tk-act-a2-note4" value="Pengguna Lab membaca versi berlaku (KF-17, Pelengkap); tidak digambar karena bukan bagian alur ini.&lt;br&gt;Sumber: kebutuhan-tata-kelola.md (KF-01–45), brief Tata Kelola (cakupan Inti + Pelengkap).&lt;br&gt;Draf 14 Nov 2026 · Febriyan" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1100" y="589" width="320" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="tk-act-a3" name="Activity TO-BE (3-4) - Siklus Rencana"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="1328" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tk-act-a3-lane-k" value="KaLab" style="swimlane;html=1;startSize=34;fillColor=#F5F0FF;strokeColor=#9673A6;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;collapsible=0;container=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="470" height="1198" as="geometry"/></mxCell><mxCell id="tk-act-a3-lane-p" value="PIC item (Laboran / KaLab)" style="swimlane;html=1;startSize=34;fillColor=#F5F0FF;strokeColor=#9673A6;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;collapsible=0;container=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="510" y="70" width="270" height="1198" as="geometry"/></mxCell><mxCell id="tk-act-a3-lane-s" value="Sistem" style="swimlane;html=1;startSize=34;fillColor=#F5F0FF;strokeColor=#9673A6;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;collapsible=0;container=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="780" y="70" width="270" height="1198" as="geometry"/></mxCell><mxCell id="tk-act-a3-title" value="A3 · Siklus Rencana Tahunan dan Rencana Pengembangan (PKG-01, PKG-13)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1100" height="40" as="geometry"/></mxCell><mxCell id="tk-act-a3-st" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="263" y="126" width="24" height="24" as="geometry"/></mxCell><mxCell id="tk-act-a3-d1" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="258" y="195" width="34" height="34" as="geometry"/></mxCell><mxCell id="tk-act-a3-cg" value="&lt;font style='font-size:9px' color='#6C4A87'&gt;«user»&lt;/font&gt;&lt;br&gt;Catat temuan gap" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="292" y="263" width="200" height="46" as="geometry"/></mxCell><mxCell id="tk-act-a3-m1" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="258" y="343" width="34" height="34" as="geometry"/></mxCell><mxCell id="tk-act-a3-si" value="&lt;font style='font-size:9px' color='#6C4A87'&gt;«user»&lt;/font&gt;&lt;br&gt;Susun item rencana" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="175" y="411" width="200" height="46" as="geometry"/></mxCell><mxCell id=
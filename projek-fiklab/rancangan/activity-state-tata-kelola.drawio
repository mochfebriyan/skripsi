        </mxCell>
        <mxCell id="tk-act-a2-note0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §3.2)&lt;br&gt;• Putih «user» = aktor memakai sistem&lt;br&gt;• Abu-abu «service» = dikerjakan sistem otomatis&lt;br&gt;• Krem putus-putus «manual» = di luar sistem&lt;br&gt;• Ungu «call behavior» = memanggil diagram lain&lt;br&gt;• ◇ keputusan/gabungan; kondisi ditulis [guard] di panah&lt;br&gt;• ⧗ = menunggu waktu tertentu&lt;br&gt;• Bar hitam = jalur paralel (fork/join)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="1120" y="70" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-a2-note1" value="&lt;b&gt;Kaitan ke kriteria PKG-02&lt;/b&gt;&lt;br&gt;S1 terdaftar: &lt;i&gt;Daftarkan dokumen induk&lt;/i&gt;&lt;br&gt;S2 disahkan: &lt;i&gt;Sahkan dokumen (A1)&lt;/i&gt;&lt;br&gt;S3 mutakhir: &lt;i&gt;Tinjau ulang&lt;/i&gt; + jadwal (lihat &lt;b&gt;S2&lt;/b&gt;)&lt;br&gt;S4 tersedia: &lt;i&gt;Catat distribusi&lt;/i&gt;&lt;br&gt;S5 disosialisasikan: &lt;i&gt;Catat sosialisasi&lt;/i&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="1120" y="236" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-a2-note2" value="&lt;b&gt;Di luar sistem&lt;/b&gt;: naskah SOP/IK tetap disusun di Word/Docs (keputusan 13 Nov 2026). Sistem hanya mengelola versi, pengesahan, distribusi, sosialisasi, dan tinjau ulang." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="1120" y="362" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-a2-note3" value="Pengguna Lab hanya melihat versi berlaku (KF-16); tidak digambar karena bukan bagian alur ini.&lt;br&gt;&lt;i&gt;Cabut dokumen&lt;/i&gt; hanya oleh jabatan berwenang." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="1120" y="458" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tk-act-a2-note4" value="Draf 13 Nov 2026 · Febriyan" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="1120" y="544" width="320" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

        <mxCell id="tk-stm-s2-n1" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" value="&lt;b&gt;Kaitan ke PKG-02 S3 (mutakhir)&lt;/b&gt;: versi dihitung &lt;b&gt;mutakhir&lt;/b&gt; selama tidak berada di &lt;i&gt;Perlu Ditinjau&lt;/i&gt;.&lt;br&gt;&lt;b&gt;[KONFIRMASI]&lt;/b&gt; Apakah &lt;i&gt;Menunggu Revisi&lt;/i&gt; masih dihitung mutakhir? Usulan penulis: ya sampai tenggat revisi, karena tinjauan sudah dilakukan." vertex="1">
          <mxGeometry height="90" width="560" x="40" y="540" as="geometry" />
        </mxCell>
        <mxCell id="tk-stm-s2-n2" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" value="&lt;b&gt;Implementasi&lt;/b&gt; (Wazlawick §9.3, &lt;i&gt;modal class&lt;/i&gt;): sub-status ini &lt;b&gt;tidak&lt;/b&gt; disimpan di field &lt;code&gt;state&lt;/code&gt;. &lt;i&gt;Perlu Ditinjau&lt;/i&gt; = &lt;code&gt;is_perlu_tinjau&lt;/code&gt; {compute}; &lt;i&gt;Menunggu Revisi&lt;/i&gt; = hasil tinjauan terakhir &lt;code&gt;perlu_revisi&lt;/code&gt; dan belum ada versi baru yang disahkan." vertex="1">
          <mxGeometry height="90" width="520" x="620" y="540" as="geometry" />
        </mxCell>

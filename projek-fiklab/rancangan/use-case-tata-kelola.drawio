"1200" y="300" width="30" height="60" as="geometry"/></mxCell><mxCell id="tk-uc1-a-pny-21" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc1-pny" target="tk-uc1-uc21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc1-a-pny-22" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc1-pny" target="tk-uc1-uc22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc1-a-pny-25" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc1-pny" target="tk-uc1-uc25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc1-a-pny-26" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc1-pny" target="tk-uc1-uc26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc1-a-pmr-23" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc1-pmr" target="tk-uc1-uc23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc1-a-pmr-24" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc1-pmr" target="tk-uc1-uc24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc1-a-pgs-24" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc1-pgs" target="tk-uc1-uc24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc1-a-pgs-27" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc1-pgs" target="tk-uc1-uc27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc1-a-pgs-28" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc1-pgs" target="tk-uc1-uc28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc1-a-jdw-31" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc1-jdw" target="tk-uc1-uc31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc1-a-jdw-32" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc1-jdw" target="tk-uc1-uc32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc1-g-lab-pny" value="" style="endArrow=block;endFill=0;endSize=14;html=1;strokeColor=#333333;" edge="1" parent="1" source="tk-uc1-lab" target="tk-uc1-pny"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc1-g-kal-pny" value="" style="endArrow=block;endFill=0;endSize=14;html=1;strokeColor=#333333;" edge="1" parent="1" source="tk-uc1-kal" target="tk-uc1-pny"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc1-g-kal-pgs" value="" style="endArrow=block;endFill=0;endSize=14;html=1;strokeColor=#333333;" edge="1" parent="1" source="tk-uc1-kal" target="tk-uc1-pgs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc1-g-dek-pgs" value="" style="endArrow=block;endFill=0;endSize=14;html=1;strokeColor=#333333;" edge="1" parent="1" source="tk-uc1-dek" target="tk-uc1-pgs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc1-n1" value="&lt;b&gt;Cara baca&lt;/b&gt;&lt;br&gt;• Aktor miring (ungu) = &lt;b&gt;peran abstrak&lt;/b&gt;. Panah segitiga kosong = generalisasi: KaLab dan Laboran berperan sebagai Penyusun; KaLab dan Dekan sebagai Pengesah, sesuai wewenang jabatan per jenis dokumen.&lt;br&gt;• «system» Penjadwal = pemicu berbasis waktu (Wazlawick §4.3.2).&lt;br&gt;• Use case di sini dipakai oleh dokumen dari UC-03 (SK), UC-08 (versi SOP/IK), dan UC-16 (rencana) di halaman 2/3 dan 3/3. Tidak memakai «include» karena pengajuan dan pengesahan terjadi di sesi dan hari yang berbeda (§4.5)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="620" height="120" as="geometry"/></mxCell><mxCell id="tk-uc1-n2" value="&lt;b&gt;Di luar sistem&lt;/b&gt; (tugas «manual» di A1): cetak dokumen dan tanda tangan basah. Tanpa tanda tangan digital.&lt;br&gt;&lt;b&gt;[KONFIRMASI]&lt;/b&gt; Bila Dekan tidak login, UC-27 dilakukan KaLab atas nama Dekan dengan berkas bertanda tangan sebagai bukti." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="680" y="770" width="440" height="100" as="geometry"/></mxCell><mxCell id="tk-uc1-n3" value="Diturunkan dari activity A1–A4 dan state machine S1–S2 (rancangan/proses-bisnis-tata-kelola.md) dengan aturan Wazlawick 2024 §4.3–4.6, §4.8.2. Rincian: rancangan/use-case-tata-kelola.md · Draf 13 Nov 2026 · Febriyan" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="910" width="1080" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="tk-uc2" name="UC TO-BE (2-3) - Struktur dan Dokumen"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="830" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tk-uc2-sys" value="Sistem LabFIK Compliance — Modul Tata Kelola &amp; Dokumen" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=8;fillColor=#FFFFFF;strokeColor=#9673A6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="60" width="860" height="600" as="geometry"/></mxCell><mxCell id="tk-uc2-p1" value="Struktur Organisasi (PKG-03)" style="shape=folder;tabWidth=270;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#F5F0FF;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeom
<mxfile host="app.diagrams.net"><diagram id="tk-uc1" name="UC TO-BE (1-3) - Pengesahan Dokumen"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="880" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tk-uc1-title" value="Use case TO-BE 1/3 · Pengesahan Dokumen (dipakai semua dokumen) dan hierarki aktor" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1100" height="36" as="geometry"/></mxCell><mxCell id="tk-uc1-sys" value="Sistem LabFIK Compliance · Modul Tata Kelola &amp; Dokumen" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=8;fillColor=#FFFFFF;strokeColor=#9673A6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="60" width="760" height="560" as="geometry"/></mxCell><mxCell id="tk-uc1-p1" value="Pengesahan Dokumen" style="shape=folder;tabWidth=270;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#F5F0FF;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="430" y="100" width="340" height="460" as="geometry"/></mxCell><mxCell id="tk-uc1-uc01" value="&lt;b&gt;UC-01&lt;/b&gt;&lt;br&gt;Ajukan Dokumen" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="475" y="134" width="250" height="58" as="geometry"/></mxCell><mxCell id="tk-uc1-uc02" value="&lt;b&gt;UC-02&lt;/b&gt;&lt;br&gt;Terbitkan Dokumen Resmi" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="475" y="204" width="250" height="58" as="geometry"/></mxCell><mxCell id="tk-uc1-uc03" value="&lt;b&gt;UC-03&lt;/b&gt;&lt;br&gt;Unggah Dokumen Bertanda Tangan" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="475" y="274" width="250" height="58" as="geometry"/></mxCell><mxCell id="tk-uc1-uc04" value="&lt;b&gt;UC-04&lt;/b&gt;&lt;br&gt;Kembalikan Dokumen" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="475" y="344" width="250" height="58" as="geometry"/></mxCell><mxCell id="tk-uc1-uc05" value="&lt;b&gt;UC-05&lt;/b&gt;&lt;br&gt;Sahkan Dokumen" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="475" y="414" width="250" height="58" as="geometry"/></mxCell><mxCell id="tk-uc1-uc06" value="&lt;b&gt;UC-06&lt;/b&gt;&lt;br&gt;Cabut Dokumen" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="475" y="484" width="250" height="58" as="geometry"/></mxCell><mxCell id="tk-uc1-p2" value="Otomatis (berbasis waktu)" style="shape=folder;tabWidth=270;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#F5F0FF;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="800" y="100" width="330" height="110" as="geometry"/></mxCell><mxCell id="tk-uc1-uc07" value="&lt;b&gt;UC-07&lt;/b&gt;&lt;br&gt;Kedaluwarsakan Dokumen Berperiode" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="840" y="134" width="250" height="58" as="geometry"/></mxCell><mxCell id="tk-uc1-pgn" value="Pengguna Lab&lt;br&gt;(dosen, asisten)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="90" width="30" height="60" as="geometry"/></mxCell><mxCell id="tk-uc1-pnl" value="Pengelola Lab" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=3;fillColor=#F5F0FF;" vertex="1" parent="1"><mxGeometry x="260" y="200" width="30" height="60" as="geometry"/></mxCell><mxCell id="tk-uc1-lab" value="Laboran/PLP" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="400" width="30" height="60" as="geometry"/></mxCell><mxCell id="tk-uc1-kal" value="KaLab" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="420" width="30" height="60" as="geometry"/></mxCell><mxCell id="tk-uc1-jdw" value="«system»&lt;br&gt;Penjadwal" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;fillColor=#EEEEEE;" vertex="1" parent="1"><mxGeometry x="1240" y="150" width="30" height="60" as="geometry"/></mxCell><mxCell id="tk-uc1-a-pnl-01" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc1-pnl" target="tk-uc1-uc01"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc1-a-pnl-02" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc1-pnl" target="tk-uc1-uc02"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc1-a-pnl-03" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc1-pnl" target="tk-uc1-uc03"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc1-a-kal-04" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc1-kal" target="tk-uc1-uc04"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc1-a-kal-05" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc1-kal" target="tk-uc1-uc05"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc1-a-kal-06" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc1-kal" target="tk-uc1-uc06"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc1-a-jdw-07" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc1-jdw" target="tk-uc1-uc07"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc1-g-pnl-pgn" value="" style="endArrow=block;endFill=0;endSize=14;html=1;strokeColor=#333333;" edge="1" parent="1" source="tk-uc1-pnl" target="tk-uc1-pgn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc1-g-lab-pnl" value="" style="endArrow=block;endFill=0;endSize=14;html=1;strokeColor=#333333;" edge="1" parent="1" source="tk-uc1-lab" target="tk-uc1-pnl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc1-g-kal-pnl" value="" style="endArrow=block;endFill=0;endSize=14;html=1;strokeColor=#333333;" edge="1" parent="1" source="tk-uc1-kal" target="tk-uc1-pnl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc1-n0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §4.2–4.3)&lt;br&gt;• Aktor miring ungu = &lt;b&gt;aktor abstrak&lt;/b&gt;; panah segitiga kosong = generalisasi (turunan mewarisi use case induk)&lt;br&gt;• Aktor abu-abu «system» = pemicu berbasis waktu&lt;br&gt;• «CRUDL» = kelola data (buat, lihat, ubah, hapus, daftar) dengan satu pola; «report» = hanya membaca&lt;br&gt;• Tanpa «include»/«extend»: setiap use case satu sesi dan berdiri sendiri (§4.3.1, §4.5)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="600" height="105" as="geometry"/></mxCell><mxCell id="tk-uc1-n1" value="&lt;b&gt;Cara baca&lt;/b&gt;&lt;br&gt;• &lt;i&gt;Pengelola Lab&lt;/i&gt; = peran penyusun dokumen: KaLab (rencana, SK, Renstra) atau Laboran (SOP/IK). Pengelola Lab juga &lt;i&gt;Pengguna Lab&lt;/i&gt;, jadi bisa membaca dokumen berlaku (UC-19).&lt;br&gt;• Kembalikan, sahkan, dan cabut hanya oleh &lt;b&gt;KaLab&lt;/b&gt;, sebagai pencatat pengesahan.&lt;br&gt;• Dokumen yang memakai use case ini dibuat di UC-10 (SK), UC-15 (versi SOP/IK), UC-22 (Renstra), dan UC-23 (rencana)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="660" y="650" width="500" height="120" as="geometry"/></mxCell><mxCell id="tk-uc1-n2" value="&lt;b&gt;Bukan aktor&lt;/b&gt;: Dekan dan pejabat penanda tangan (tanda tangan di kertas, dicatat sebagai pengesah), penilai monev (menerima PDF), dan pihak eksternal. Keputusan 14 Nov 2026.&lt;br&gt;Diturunkan dari activity A1–A4 dan state machine S1–S2 (proses-bisnis-tata-kelola.md), kebutuhan KF-01–45. Rincian: use-case-tata-kelola.md · Draf 14 Nov 2026 · Febriyan" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="1120" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="tk-uc2" name="UC TO-BE (2-3) - Struktur dan Pengendalian Dokumen"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="920" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tk-uc2-title" value="Use case TO-BE 2/3 · Struktur Organisasi (PKG-03) dan Pengendalian Dokumen SOP/IK (PKG-02)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1100" height="36" as="geometry"/></mxCell><mxCell id="tk-uc2-sys" value="Sistem LabFIK Compliance · Modul Tata Kelola &amp; Dokumen" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=8;fillColor=#FFFFFF;strokeColor=#9673A6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="60" width="880" height="610" as="geometry"/></mxCell><mxCell id="tk-uc2-p1" value="Struktur Organisasi (PKG-03)" style="shape=folder;tabWidth=270;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#F5F0FF;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="330" y="100" width="370" height="460" as="geometry"/></mxCell><mxCell id="tk-uc2-uc08" value="&lt;font style='font-size:9px' color='#6C4A87'&gt;«CRUDL»&lt;/font&gt;&lt;br&gt;&lt;b&gt;UC-08&lt;/b&gt;&lt;br&gt;Kelola Personel" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="390" y="134" width="250" height="58" as="geometry"/></mxCell><mxCell id="tk-uc2-uc09" value="&lt;font style='font-size:9px' color='#6C4A87'&gt;«CRUDL»&lt;/font&gt;&lt;br&gt;&lt;b&gt;UC-09&lt;/b&gt;&lt;br&gt;Kelola Jabatan" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="390" y="204" width="250" height="58" as="geometry"/></mxCell><mxCell id="tk-uc2-uc10" value="&lt;b&gt;UC-10&lt;/b&gt;&lt;br&gt;Susun SK Penetapan Pengelola" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="390" y="274" width="250" height="58" as="geometry"/></mxCell><mxCell id="tk-uc2-uc11" value="&lt;b&gt;UC-11&lt;/b&gt;&lt;br&gt;Catat Rapat Koordinasi" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="390" y="344" width="250" height="58" as="geometry"/></mxCell><mxCell id="tk-uc2-uc12" value="&lt;b&gt;UC-12&lt;/b&gt;&lt;br&gt;Catat Evaluasi Struktur" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="390" y="414" width="250" height="58" as="geometry"/></mxCell><mxCell id="tk-uc2-uc13" value="&lt;font style='font-size:9px' color='#6C4A87'&gt;«report»&lt;/font&gt;&lt;br&gt;&lt;b&gt;UC-13&lt;/b&gt;&lt;br&gt;Lihat Laporan Struktur Organisasi" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="390" y="484" width="250" height="58" as="geometry"/></mxCell><mxCell id="tk-uc2-p2" value="Pengendalian Dokumen (PKG-02)" style="shape=folder;tabWidth=270;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#F5F0FF;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="780" y="100" width="370" height="530" as="geometry"/></mxCell><mxCell id="tk-uc2-uc14" value="&lt;font style='font-size:9px' color='#6C4A87'&gt;«CRUDL»&lt;/font&gt;&lt;br&gt;&lt;b&gt;UC-14&lt;/b&gt;&lt;br&gt;Kelola Dokumen Induk" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="840" y="134" width="250" height="58" as="geometry"/></mxCell><mxCell id="tk-uc2-uc15" value="&lt;b&gt;UC-15&lt;/b&gt;&lt;br&gt;Unggah Versi Dokumen" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="840" y="204" width="250" height="58" as="geometry"/></mxCell><mxCell id="tk-uc2-uc16" value="&lt;b&gt;UC-16&lt;/b&gt;&lt;br&gt;Catat Distribusi Dokumen" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="840" y="274" width="250" height="58" as="geometry"/></mxCell><mxCell id="tk-uc2-uc17" value="&lt;b&gt;UC-17&lt;/b&gt;&lt;br&gt;Catat Sosialisasi Dokumen" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="840" y="344" width="250" height="58" as="geometry"/></mxCell><mxCell id="tk-uc2-uc18" value="&lt;b&gt;UC-18&lt;/b&gt;&lt;br&gt;Tinjau Ulang Dokumen" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="840" y="414" width="250" height="58" as="geometry"/></mxCell><mxCell id="tk-uc2-uc20" value="&lt;font style='font-size:9px' color='#6C4A87'&gt;«report»&lt;/font&gt;&lt;br&gt;&lt;b&gt;UC-20&lt;/b&gt;&lt;br&gt;Lihat Laporan Pengendalian Dokumen" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="840" y="484" width="250" height="58" as="geometry"/></mxCell><mxCell id="tk-uc2-uc19" value="&lt;b&gt;UC-19&lt;/b&gt;&lt;br&gt;Baca Dokumen Berlaku" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="840" y="554" width="250" height="58" as="geometry"/></mxCell><mxCell id="tk-uc2-kal" value="KaLab" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150" y="330" width="30" height="60" as="geometry"/></mxCell><mxCell id="tk-uc2-pnl" value="Pengelola Lab" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=3;fillColor=#F5F0FF;" vertex="1" parent="1"><mxGeometry x="1270" y="130" width="30" height="60" as="geometry"/></mxCell><mxCell id="tk-uc2-lab" value="Laboran/PLP" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1270" y="330" width="30" height="60" as="geometry"/></mxCell><mxCell id="tk-uc2-pgn" value="Pengguna Lab&lt;br&gt;(dosen, asisten)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1270" y="540" width="30" height="60" as="geometry"/></mxCell><mxCell id="tk-uc2-a-kal-08" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc2-kal" target="tk-uc2-uc08"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc2-a-kal-09" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc2-kal" target="tk-uc2-uc09"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc2-a-kal-10" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc2-kal" target="tk-uc2-uc10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc2-a-kal-11" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc2-kal" target="tk-uc2-uc11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc2-a-kal-12" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc2-kal" target="tk-uc2-uc12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc2-a-kal-13" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc2-kal" target="tk-uc2-uc13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc2-a-pnl-14" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc2-pnl" target="tk-uc2-uc14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc2-a-pnl-18" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc2-pnl" target="tk-uc2-uc18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc2-a-pnl-20" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc2-pnl" target="tk-uc2-uc20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc2-a-lab-15" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc2-lab" target="tk-uc2-uc15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc2-a-lab-16" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc2-lab" target="tk-uc2-uc16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc2-a-lab-17" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc2-lab" target="tk-uc2-uc17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc2-a-pgn-19" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc2-pgn" target="tk-uc2-uc19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc2-g-lab-pnl" value="" style="endArrow=block;endFill=0;endSize=14;html=1;strokeColor=#333333;" edge="1" parent="1" source="tk-uc2-lab" target="tk-uc2-pnl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc2-n0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §4.2–4.3)&lt;br&gt;• Aktor miring ungu = &lt;b&gt;aktor abstrak&lt;/b&gt;; panah segitiga kosong = generalisasi (turunan mewarisi use case induk)&lt;br&gt;• Aktor abu-abu «system» = pemicu berbasis waktu&lt;br&gt;• «CRUDL» = kelola data (buat, lihat, ubah, hapus, daftar) dengan satu pola; «report» = hanya membaca&lt;br&gt;• Tanpa «include»/«extend»: setiap use case satu sesi dan berdiri sendiri (§4.3.1, §4.5)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="600" height="105" as="geometry"/></mxCell><mxCell id="tk-uc2-n1" value="&lt;b&gt;Cara baca&lt;/b&gt;&lt;br&gt;• KaLab juga turunan &lt;i&gt;Pengelola Lab&lt;/i&gt; dan &lt;i&gt;Pengguna Lab&lt;/i&gt; (halaman 1/3), jadi KaLab juga bisa melakukan UC-14, 18, dan 19.&lt;br&gt;• SK (UC-10) dan versi dokumen (UC-15) diajukan dan disahkan lewat halaman 1/3.&lt;br&gt;• UC-13 memuat bagan organisasi, uraian tugas, dan matriks kewenangan. UC-20 memuat daftar induk, riwayat revisi, serta rekaman distribusi, sosialisasi, dan tinjau ulang." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="660" y="700" width="520" height="130" as="geometry"/></mxCell><mxCell id="tk-uc2-n2" value="Diturunkan dari activity A1–A4 dan state machine S1–S2 (proses-bisnis-tata-kelola.md), kebutuhan KF-01–45. Rincian: use-case-tata-kelola.md · Draf 14 Nov 2026 · Febriyan" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="1140" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="tk-uc3" name="UC TO-BE (3-3) - Perencanaan dan Status Monev"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="930" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tk-uc3-title" value="Use case TO-BE 3/3 · Perencanaan (PKG-01, PKG-13) dan Status Monev" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1100" height="36" as="geometry"/></mxCell><mxCell id="tk-uc3-sys" value="Sistem LabFIK Compliance · Modul Tata Kelola &amp; Dokumen" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=8;fillColor=#FFFFFF;strokeColor=#9673A6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="60" width="880" height="610" as="geometry"/></mxCell><mxCell id="tk-uc3-p1" value="Perencanaan (PKG-01, PKG-13)" style="shape=folder;tabWidth=270;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#F5F0FF;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="330" y="100" width="370" height="530" as="geometry"/></mxCell><mxCell id="tk-uc3-uc21" value="&lt;font style='font-size:9px' color='#6C4A87'&gt;«CRUDL»&lt;/font&gt;&lt;br&gt;&lt;b&gt;UC-21&lt;/b&gt;&lt;br&gt;Kelola KPI" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="390" y="134" width="250" height="58" as="geometry"/></mxCell><mxCell id="tk-uc3-uc22" value="&lt;font style='font-size:9px' color='#6C4A87'&gt;«CRUDL»&lt;/font&gt;&lt;br&gt;&lt;b&gt;UC-22&lt;/b&gt;&lt;br&gt;Kelola Renstra" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="390" y="204" width="250" height="58" as="geometry"/></mxCell><mxCell id="tk-uc3-uc23" value="&lt;b&gt;UC-23&lt;/b&gt;&lt;br&gt;Susun Rencana" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="390" y="274" width="250" height="58" as="geometry"/></mxCell><mxCell id="tk-uc3-uc24" value="&lt;b&gt;UC-24&lt;/b&gt;&lt;br&gt;Buat Revisi Rencana" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="390" y="344" width="250" height="58" as="geometry"/></mxCell><mxCell id="tk-uc3-uc25" value="&lt;b&gt;UC-25&lt;/b&gt;&lt;br&gt;Isi Realisasi Rencana" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="390" y="414" width="250" height="58" as="geometry"/></mxCell><mxCell id="tk-uc3-uc26" value="&lt;b&gt;UC-26&lt;/b&gt;&lt;br&gt;Catat Tinjauan Rencana" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="390" y="484" width="250" height="58" as="geometry"/></mxCell><mxCell id="tk-uc3-uc27" value="&lt;font style='font-size:9px' color='#6C4A87'&gt;«report»&lt;/font&gt;&lt;br&gt;&lt;b&gt;UC-27&lt;/b&gt;&lt;br&gt;Lihat Laporan Rencana" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="390" y="554" width="250" height="58" as="geometry"/></mxCell><mxCell id="tk-uc3-p2" value="Status Monev" style="shape=folder;tabWidth=270;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#F5F0FF;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="780" y="100" width="370" height="110" as="geometry"/></mxCell><mxCell id="tk-uc3-uc28" value="&lt;font style='font-size:9px' color='#6C4A87'&gt;«report»&lt;/font&gt;&lt;br&gt;&lt;b&gt;UC-28&lt;/b&gt;&lt;br&gt;Lihat Status Monev" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="840" y="134" width="250" height="58" as="geometry"/></mxCell><mxCell id="tk-uc3-kal" value="KaLab" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150" y="300" width="30" height="60" as="geometry"/></mxCell><mxCell id="tk-uc3-pnl" value="Pengelola Lab&lt;br&gt;(PIC item)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=3;fillColor=#F5F0FF;" vertex="1" parent="1"><mxGeometry x="1270" y="420" width="30" height="60" as="geometry"/></mxCell><mxCell id="tk-uc3-a-kal-21" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc3-kal" target="tk-uc3-uc21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc3-a-kal-22" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc3-kal" target="tk-uc3-uc22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc3-a-kal-23" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc3-kal" target="tk-uc3-uc23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc3-a-kal-24" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc3-kal" target="tk-uc3-uc24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc3-a-kal-26" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc3-kal" target="tk-uc3-uc26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc3-a-kal-27" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc3-kal" target="tk-uc3-uc27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc3-a-kal-28" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc3-kal" target="tk-uc3-uc28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc3-a-pnl-25" value="" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="tk-uc3-pnl" target="tk-uc3-uc25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-uc3-n0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §4.2–4.3)&lt;br&gt;• Aktor miring ungu = &lt;b&gt;aktor abstrak&lt;/b&gt;; panah segitiga kosong = generalisasi (turunan mewarisi use case induk)&lt;br&gt;• Aktor abu-abu «system» = pemicu berbasis waktu&lt;br&gt;• «CRUDL» = kelola data (buat, lihat, ubah, hapus, daftar) dengan satu pola; «report» = hanya membaca&lt;br&gt;• Tanpa «include»/«extend»: setiap use case satu sesi dan berdiri sendiri (§4.3.1, §4.5)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="600" height="105" as="geometry"/></mxCell><mxCell id="tk-uc3-n1" value="&lt;b&gt;Cara baca&lt;/b&gt;&lt;br&gt;• UC-23 mencakup rencana tahunan dan rencana pengembangan (temuan gap + item program).&lt;br&gt;• Renstra (UC-22) dan rencana (UC-23) diajukan dan disahkan lewat halaman 1/3.&lt;br&gt;• UC-25 dilakukan PIC item: Laboran atau KaLab.&lt;br&gt;• UC-26 mencakup ukuran manfaat untuk rencana pengembangan.&lt;br&gt;• UC-28: persentase PKG-02 dan kriteria tertinggi K1–K4 dengan tautan bukti; hasilnya diserahkan ke penilai sebagai PDF." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="660" y="700" width="520" height="140" as="geometry"/></mxCell><mxCell id="tk-uc3-n2" value="Diturunkan dari activity A1–A4 dan state machine S1–S2 (proses-bisnis-tata-kelola.md), kebutuhan KF-01–45. Rincian: use-case-tata-kelola.md · Draf 14 Nov 2026 · Febriyan" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="1140" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
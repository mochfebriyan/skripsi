  <diagram id="tk-met-notes" name="Catatan Metode TO-BE (bahan kerja)">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="970" pageHeight="314" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="tk-met-notes-title" value="Catatan alur metode perancangan (bahan kerja, tidak disisipkan ke naskah)" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="900" height="36" as="geometry" />
        </mxCell>
        <mxCell id="tk-met-notes-legend" value="&lt;b&gt;Notasi&lt;/b&gt; (UML activity diagram)&lt;br&gt;• Kotak sudut bulat = aksi (tahap metode); teks dalam kurung = hasil tahap.&lt;br&gt;• Kotak sudut siku = object node (masukan).&lt;br&gt;• «bahan kerja» = hasil tahap tidak dimuat di subbab 2.3, hanya dipakai untuk menurunkan method dan kelas." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="900" height="80" as="geometry" />
        </mxCell>
        <mxCell id="tk-met-notes-src" value="&lt;b&gt;Sumber&lt;/b&gt;&lt;br&gt;• Wazlawick (2024), bab 3–4, 6–9, 13; CLAUDE.md bagian 4 (langkah 4–10). Draf 18 Nov 2026 · Febriyan&lt;br&gt;• Gambar 2.3 naskah Bab II (subbab 2.2.4)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="900" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tk-met-notes-konf" value="&lt;b&gt;Isu terbuka&lt;/b&gt;&lt;br&gt;• Iterasi antar-tahap (kembali ke tahap sebelumnya saat menemukan transisi atau aturan baru) tidak digambar agar ringkas; dijelaskan di paragraf naskah bila perlu." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="40" y="224" width="900" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

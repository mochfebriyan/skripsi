        </mxCell>
        <mxCell id="tk-pkg1-core" parent="1" style="shape=folder;tabWidth=110;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=20;spacingRight=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;" value="«Core»&lt;br&gt;&lt;b&gt;labfik_core&lt;/b&gt;&lt;br&gt;• Master bersama: personel (hr.employee), jabatan (hr.job), ruang, periode, mata kuliah, kelas, sesi&lt;br&gt;• Mixin: approval, period, criteria, evidence&lt;br&gt;• Riwayat pengesahan (approval.log)" vertex="1">

        <mxCell id="tk-pkg1-org" parent="1" style="shape=folder;tabWidth=110;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=20;spacingRight=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;" value="&lt;b&gt;labfik_org&lt;/b&gt;&lt;br&gt;Tata Kelola dan Dokumen (PKG-01, 02, 03, 13)&lt;br&gt;• Dokumen Induk dan versi SOP/IK&lt;br&gt;• Distribusi, sosialisasi, tinjau ulang&lt;br&gt;• Renstra, rencana, item, temuan gap&lt;br&gt;• SK penetapan, rapat, evaluasi struktur&lt;br&gt;• Realisasi, tinjauan, KPI&lt;br&gt;• Status monev" vertex="1">

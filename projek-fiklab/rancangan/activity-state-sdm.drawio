"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-stm-s3-t5" value="when(setiap realisasi punya&lt;br&gt;evaluasi efektivitas)" style="endArrow=open;endSize=8;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;fontFamily=Times New Roman;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-stm-s3-mnv" target="sdm-stm-s3-dev"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="305"/></Array></mxGeometry></mxCell><mxCell id="sdm-stm-s3-tf1" value="" style="endArrow=open;endSize=8;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;fontFamily=Times New Roman;" edge="1" parent="1" source="sdm-stm-s3-btl" target="sdm-stm-s3-f1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-stm-s3-tf2" value="" style="endArrow=open;endSize=8;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;fontFamily=Times New Roman;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-stm-s3-tl" target="sdm-stm-s3-f2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-stm-s3-ket" value="* transisi yang ditemukan melalui tabel status × transisi (proses-bisnis-sdm.md bagian 4)" style="text;html=1;fontSize=11;align=left;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="30" y="540" width="600" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="sdm-stm-s4" name="State Machine TO-BE (4-4) - Surat Tugas dan Rencana Pelatihan"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="360" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sdm-stm-s4-init" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="168" width="22" height="22" as="geometry"/></mxCell><mxCell id="sdm-stm-s4-draf" value="Draf" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="100" y="154" width="140" height="50" as="geometry"/></mxCell><mxCell id="sdm-stm-s4-aju" value="Diajukan" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="470" y="154" width="140" height="50" as="geometry"/></mxCell><mxCell id="sdm-stm-s4-sah" value="Disahkan" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="880" y="154" width="140" height="50" as="geometry"/></mxCell><mxCell id="sdm-stm-s4-gnt" value="Diganti" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="1210" y="54" width="140" height="50" as="geometry"/></mxCell><mxCell id="sdm-stm-s4-cbt" value="Dicabut" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="1210" y="254" width="140" height="50" as="geometry"/></mxCell><mxCell id="sdm-stm-s4-f0" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="157" y="300" width="26" height="26" as="geometry"/></mxCell><mxCell id="sdm-stm-s4-f1" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1400" y="66" width="26" height="26" as="geometry"/></mxCell><mxCell id="sdm-stm-s4-f2" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1400" y="266" width="26" height="26" as="geometry"/></mxCell><mxCell id="sdm-stm-s4-t0" value="buat" style="endArrow=open;endSize=8;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;fontFamily=Times New Roman;" edge="1" parent="1" source="sdm-stm-s4-init" target="sdm-stm-s4-draf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-stm-s4-t1" value="ajukan [kelengkapan per jenis]&lt;br&gt;/ catat riwayat; rencana: bekukan kebutuhan" style="endArrow=open;endSize=8;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;fontFamily=Times New Roman;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-stm-s4-draf" target="sdm-stm-s4-aju"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-stm-s4-t2" value="kembalikan / catat alasan" style="endArrow=open;endSize=8;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;fontFamily=Times New Roman;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-stm-s4-aju" target="sdm-stm-s4-draf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-stm-s4-t3" value="unggah berkas bertanda tangan / catat riwayat" style="endArrow=open;endSize=8;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;fontFamily=Times New Roman;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-stm-s4-aju" target="sdm-stm-s4-aju"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="505" y="110"/><mxPoint x="575" y="110"/></Array></mxGeometry></mxCell><mxCell id="sdm-stm-s4-t4" value="sahkan [berkas ada ∧ pengesah berwenang]&lt;br&gt;/ catat pengesah, pencatat, tanggal sah" style="endArrow=open;endSize=8;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;fontFamily=Times New Roman;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-stm-s4-aju" target="sdm-stm-s4-sah"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-stm-s4-t5" value="revisi surat tugas disahkan&lt;br&gt;[surat tugas]" style="endArrow=open;endSize=8;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;fontFamily=Times New Roman;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-stm-s4-sah" target="sdm-stm-s4-gnt"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="79"/></Array></mxGeometry></mxCell><mxCell id="sdm-stm-s4-t6" value="cabut / catat alasan" style="endArrow=open;endSize=8;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;fontFamily=Times New Roman;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-stm-s4-sah" target="sdm-stm-s4-cbt"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="279"/></Array></mxGeometry></mxCell><mxCell id="sdm-stm-s4-t7" value="hapus [belum pernah diajukan]" style="endArrow=open;endSize=8;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;fontFamily=Times New Roman;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-stm-s4-draf" target="sdm-stm-s4-f0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-stm-s4-tf1" value="" style="endArrow=open;endSize=8;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;fontFamily=Times New Roman;" edge="1" parent="1" source="sdm-stm-s4-gnt" target="sdm-stm-s4-f1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-stm-s4-tf2" value="" style="endArrow=open;endSize=8;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;fontFamily=Times New Roman;" edge="1" parent="1" source="sdm-stm-s4-cbt" target="sdm-stm-s4-f2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="sdm-act-notes" name="Catatan TO-BE (bahan kerja) - Activity dan State Machine"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="1850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sdm-act-notes-title" value="Catatan diagram activity dan state machine modul SDM (bahan kerja, tidak disisipkan ke naskah)" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1240" height="36" as="geometry"/></mxCell><mxCell id="sdm-act-notes-legend" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §3.2): «user» = aktor memakai sistem; «service» = dikerjakan sistem otomatis; «manual» = di luar sistem; «call behavior» (simbol garpu) = memanggil activity lain di modul ini; ◇ = keputusan/gabungan, kondisi ditulis [guard] di panah; ⧗ = menunggu kejadian atau waktu. Gaya polos hitam-putih (CLAUDE.md bagian 5)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1260" height="60" as="geometry"/></mxCell><mxCell id="sdm-act-notes-src" value="Sumber: kebutuhan-sdm.md (KF-SDM-01–43), brief-sdm.md (cakupan Inti + Pelengkap), kontrak-core-sdm.md, analisis PKG-04/10/14. Draf 14 Nov 2026, direvisi 17 Nov 2026 (pengesahan dokumen SDM digambar sendiri, gaya hitam-putih) · Zahir" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="132" width="1260" height="40" as="geometry"/></mxCell><mxCell id="sdm-act-notes-h0" value="&lt;b&gt;A1 · Seleksi Asisten dan Penugasan Petugas Praktikum (PKG-04), satu periode&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="400" height="40" as="geometry"/></mxCell><mxCell id="sdm-act-notes-n0-0" value="&lt;b&gt;Kaitan ke PKG-04&lt;/b&gt;&lt;br&gt;S1 kebutuhan: &lt;i&gt;Tetapkan kebutuhan petugas&lt;/i&gt; (KF-SDM-09)&lt;br&gt;S2 penugasan sah: &lt;i&gt;Susun surat tugas&lt;/i&gt; + &lt;i&gt;Sahkan dokumen SDM (A4)&lt;/i&gt; (KF-SDM-10, 06, 11, 43)&lt;br&gt;S3 kompetensi: Bukti Kompetensi (CRUDL, KF-SDM-03), dicek sistem&lt;br&gt;S4 syarat internal: &lt;i&gt;Catat hasil seleksi&lt;/i&gt; (KF-SDM-07, 08)&lt;br&gt;Status S1–S4 per sesi &lt;b&gt;dihitung saat dibaca&lt;/b&gt; (KF-SDM-12), bukan tugas." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="236" width="400" height="120" as="geometry"/></mxCell><mxCell id="sdm-act-notes-n0-1" value="&lt;b&gt;Surat tugas&lt;/b&gt; berisi baris asisten → kelas dan laboran → ruang, dengan rentang berlaku. &lt;i&gt;Buat revisi surat tugas&lt;/i&gt; (pengganti) = Pelengkap (KF-SDM-14). Calon yang &lt;b&gt;tidak lulus&lt;/b&gt; tidak dicatat; seleksinya sendiri di luar sistem (POB 2025)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="366" width="400" height="80" as="geometry"/></mxCell><mxCell id="sdm-act-notes-n0-2" value="&lt;b&gt;[KONFIRMASI]&lt;/b&gt; K7: pengesah surat tugas. KB-3: surat tugas &lt;b&gt;ditolak&lt;/b&gt; saat diajukan bila ada asisten tanpa seleksi lulus (default). K2: penyetuju pengecualian (Koor Prodi atau KaLab)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="456" width="400" height="70" as="geometry"/></mxCell><mxCell id="sdm-act-notes-h1" value="&lt;b&gt;A2 · Otorisasi PLP/Laboran untuk Tugas/Alat Berkewenangan Khusus (PKG-10)&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="470" y="190" width="400" height="40" as="geometry"/></mxCell><mxCell id="sdm-act-notes-n1-0" value="&lt;b&gt;Kaitan ke PKG-10&lt;/b&gt;&lt;br&gt;Penyebut: &lt;i&gt;Tetapkan pelaksana tugas/alat&lt;/i&gt; (KF-SDM-18, 19)&lt;br&gt;S1 kompetensi: &lt;i&gt;Catat asesmen&lt;/i&gt; / bukti yang ada (KF-SDM-20, 21)&lt;br&gt;S2 otorisasi berlaku: &lt;i&gt;Susun otorisasi&lt;/i&gt; + &lt;i&gt;Sahkan dokumen SDM (A4)&lt;/i&gt; (KF-SDM-22, 23, 24)&lt;br&gt;S3 pemula disupervisi: kelengkapan saat diajukan (KF-SDM-23)&lt;br&gt;S4 evaluasi ulang: &lt;i&gt;Catat evaluasi ulang&lt;/i&gt; (KF-SDM-25)&lt;br&gt;Status S1–S4 per pasangan dihitung saat dibaca (KF-SDM-26)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="470" y="236" width="400" height="130" as="geometry"/></mxCell><mxCell id="sdm-act-notes-n1-1" value="&lt;b&gt;Otorisasi lama diganti&lt;/b&gt; di dalam A4 (&lt;i&gt;Ganti status dokumen lama&lt;/i&gt;): otorisasi berlaku untuk pasangan personel × tugas/alat yang sama menjadi Diganti (KF-SDM-24).&lt;br&gt;⧗ Pemicu (masa berlaku habis, alat berubah, insiden, lama tidak aktif) dicatat manual; &lt;b&gt;tidak ada penjadwal&lt;/b&gt; (kontrak Core K-3)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="470" y="376" width="400" height="90" as="geometry"/></mxCell><mxCell id="sdm-act-notes-n1-2" value="&lt;b&gt;Temuan&lt;/b&gt; (tabel status × transisi S2): keputusan &lt;i&gt;tetap berlaku&lt;/i&gt; belum ada di KF-SDM-25. &lt;b&gt;[KONFIRMASI]&lt;/b&gt; KP-1 (keputusan &lt;i&gt;tetap berlaku&lt;/i&gt;); KU-1 (pemicu dan keputusan di hari berbeda; use case sudah dipecah dua); KB-1 (penyebut = pelaksana yang ditetapkan KaLab)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="470" y="476" width="400" height="80" as="geometry"/></mxCell><mxCell id="sdm-act-notes-h2" value="&lt;b&gt;A3 · Siklus Pelatihan PLP/Laboran (PKG-14), satu tahun&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="900" y="190" width="400" height="40" as="geometry"/></mxCell><mxCell id="sdm-act-notes-n2-0" value="&lt;b&gt;Kaitan ke PKG-14&lt;/b&gt;&lt;br&gt;K1: &lt;i&gt;Buat rencana&lt;/i&gt;, &lt;i&gt;Isi kebutuhan&lt;/i&gt;, &lt;i&gt;Lengkapi kebutuhan&lt;/i&gt;, &lt;i&gt;Sahkan dokumen SDM (A4)&lt;/i&gt; (KF-SDM-29, 30, 32)&lt;br&gt;K2: &lt;i&gt;Susun item pelatihan&lt;/i&gt; (KF-SDM-31), dicek saat diajukan&lt;br&gt;K3: &lt;i&gt;Catat realisasi&lt;/i&gt; + bukti penerapan (KF-SDM-33)&lt;br&gt;K4: &lt;i&gt;Catat evaluasi efektivitas&lt;/i&gt;, &lt;i&gt;Buat bukti kompetensi&lt;/i&gt; (KF-SDM-34, 35)&lt;br&gt;Kriteria tertinggi dihitung saat dibaca (KF-SDM-36)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="900" y="236" width="400" height="120" as="geometry"/></mxCell><mxCell id="sdm-act-notes-n2-1" value="&lt;b&gt;Pembekuan kebutuhan&lt;/b&gt; terjadi di A4 saat rencana diajukan (KF-SDM-32). &lt;i&gt;Tandai item batal&lt;/i&gt; = Pelengkap (KF-SDM-37). &lt;b&gt;Siklus berikutnya&lt;/b&gt;: bukti kompetensi baru mengubah matriks, sehingga kebutuhan tahun depan ikut diperbarui (K4)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="900" y="366" width="400" height="80" as="geometry"/></mxCell><mxCell id="sdm-act-notes-n2-2" value="&lt;b&gt;[KONFIRMASI]&lt;/b&gt; K10: pengesah rencana pelatihan (KaLab / Wadek Bidang Keuangan dan Umum). Wawancara no. 12: kapan dan oleh siapa efektivitas dinilai. KU-2: revisi rencana setelah disahkan tidak dirancang." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="900" y="456" width="400" height="70" as="geometry"/></mxCell><mxCell id="sdm-act-notes-h3" value="&lt;b&gt;A4 · Pengesahan Dokumen SDM: Surat Tugas, Otorisasi, Rencana Pelatihan (dipanggil A1, A2, A3)&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="400" height="40" as="geometry"/></mxCell><mxCell id="sdm-act-notes-n3-0" value="&lt;b&gt;Periksa kelengkapan dokumen&lt;/b&gt;, isinya per jenis: Surat Tugas = ≥1 baris lengkap dan setiap asisten punya seleksi lulus (KF-SDM-11); Otorisasi = kompetensi terbukti, lingkup terisi, supervisor berwenang bila terbimbing (KF-SDM-23); Rencana Pelatihan = semua PLP/teknisi tercantum dan item lengkap, lalu &lt;b&gt;kebutuhan dibekukan&lt;/b&gt; (KF-SDM-32)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="776" width="400" height="100" as="geometry"/></mxCell><mxCell id="sdm-act-notes-n3-1" value="&lt;b&gt;Periksa berkas dan wewenang&lt;/b&gt;: PDF bertanda tangan harus ada dan pengesah tercatat harus memegang jabatan yang berwenang untuk jenis dokumen itu (KF-SDM-43). &lt;b&gt;Ganti status dokumen lama&lt;/b&gt;: surat tugas yang direvisi, atau otorisasi berlaku untuk pasangan yang sama, menjadi Diganti (KF-SDM-14, 24). Setiap kejadian dicatat sebagai riwayat (KF-SDM-06)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="886" width="400" height="100" as="geometry"/></mxCell><mxCell id="sdm-act-notes-n3-2" value="&lt;b&gt;Terbitkan dokumen PDF&lt;/b&gt; hanya untuk Surat Tugas dan Rencana Pelatihan, lapis Pelengkap (KF-SDM-17, 39). Otorisasi disiapkan di luar sistem. &lt;b&gt;Pejabat penanda tangan bukan aktor&lt;/b&gt;: KaLab, Wadek, atau Koor Prodi; bila KaLab sendiri, lajur KaLab dan lajur pejabat diperankan orang yang sama. Mekanisme teknis: &lt;code&gt;labfik.approval.mixin&lt;/code&gt; (Core)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="996" width="400" height="100" as="geometry"/></mxCell><mxCell id="sdm-act-notes-n3-3" value="Status dokumen di alur ini: &lt;b&gt;S1&lt;/b&gt; (Otorisasi) dan &lt;b&gt;S4&lt;/b&gt; (Surat Tugas, Rencana Pelatihan). Pencabutan dokumen yang berlaku: A2 &lt;i&gt;Cabut otorisasi&lt;/i&gt;, S1, S4." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="1106" width="400" height="50" as="geometry"/></mxCell><mxCell id="sdm-act-notes-h4" value="&lt;b&gt;S1 · Otorisasi Personel (labfik.sdm.otorisasi): approval.mixin + masa berlaku sendiri&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="470" y="730" width="400" height="40" as="geometry"/></mxCell><mxCell id="sdm-act-notes-n4-0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §3.3): &lt;code&gt;event [guard] / efek&lt;/code&gt;. Status akhir = status yang berpanah ke ◉. Tanda * = transisi yang baru ditemukan lewat tabel status × transisi. Kotak bertajuk = status komposit." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="470" y="776" width="400" height="60" as="geometry"/></mxCell><mxCell id="sdm-act-notes-n4-1" value="&lt;b&gt;Berlaku / Lewat masa berlaku&lt;/b&gt; adalah transisi stabil (§9.3.1): tidak disimpan di &lt;code&gt;state&lt;/code&gt;, tetapi dihitung dari &lt;code&gt;berlaku_sampai&lt;/code&gt; (&lt;code&gt;is_berlaku&lt;/code&gt;). Tidak ada status &lt;i&gt;Kedaluwarsa&lt;/i&gt; dan tidak ada penjadwal, karena Otorisasi tidak memakai &lt;code&gt;period.mixin&lt;/code&gt; (kontrak Core K-3). PKG-10 S2 hanya terpenuhi di sub-status &lt;b&gt;Berlaku&lt;/b&gt;." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="470" y="846" width="400" height="100" as="geometry"/></mxCell><mxCell id="sdm-act-notes-n4-2" value="&lt;b&gt;Temuan&lt;/b&gt;: otorisasi yang &lt;code&gt;berlaku_sampai&lt;/code&gt;-nya sudah lewat sebelum disahkan langsung masuk &lt;i&gt;Lewat masa berlaku&lt;/i&gt;; kandidat aturan bisnis &lt;code&gt;berlaku_sampai ≥ hari ini&lt;/code&gt; saat diajukan (langkah 7). &lt;b&gt;[ASUMSI]&lt;/b&gt; Diganti dan Dicabut adalah status akhir; perubahan lingkup, level, atau masa berlaku dibuat sebagai otorisasi baru (&lt;i&gt;superseding&lt;/i&gt;, §11.9.2)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="470" y="956" width="400" height="90" as="geometry"/></mxCell><mxCell id="sdm-act-notes-h5" value="&lt;b&gt;S2 · Evaluasi Ulang Otorisasi (labfik.sdm.evaluasi.otorisasi), PKG-10 S4&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="900" y="730" width="400" height="40" as="geometry"/></mxCell><mxCell id="sdm-act-notes-n5-0" value="&lt;b&gt;PKG-10 S4&lt;/b&gt; gagal selama ada evaluasi ulang berstatus &lt;b&gt;Terbuka&lt;/b&gt; pada pasangan itu (KF-SDM-26). Status ini field &lt;code&gt;status&lt;/code&gt; milik model evaluasi ulang." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="900" y="776" width="400" height="60" as="geometry"/></mxCell><mxCell id="sdm-act-notes-n5-1" value="&lt;b&gt;Temuan&lt;/b&gt;: keputusan &lt;i&gt;tetap berlaku&lt;/i&gt; tidak ada di analisis PKG-10 dan KF-SDM-25. Tanpa keputusan itu, pemicu yang tidak butuh perubahan (mis. alat diganti, kompetensi tetap memadai) membuat evaluasi terbuka selamanya &lt;b&gt;[KONFIRMASI KP-1]&lt;/b&gt;. &lt;b&gt;[ASUMSI]&lt;/b&gt; Keputusan yang berubah dicatat sebagai evaluasi ulang baru (rekaman bukti tidak dihapus)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="900" y="846" width="400" height="90" as="geometry"/></mxCell><mxCell id="sdm-act-notes-h6" value="&lt;b&gt;S3 · Item Pelatihan dalam Rencana Pelatihan (labfik.sdm.item.pelatihan), PKG-14 K3–K4&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1270" width="400" height="40" as="geometry"/></mxCell><mxCell id="sdm-act-notes-n6-0" value="&lt;b&gt;Kaitan ke PKG-14&lt;/b&gt;: K3 dihitung dari item &lt;b&gt;Terlaksana&lt;/b&gt; yang setiap pesertanya punya realisasi dan bukti penerapan; item &lt;b&gt;Batal&lt;/b&gt; tidak dihitung (KF-SDM-37, Pelengkap). K4 dihitung dari item &lt;b&gt;Dievaluasi&lt;/b&gt;. Sub-status Terlaksana dihitung dari data (§9.3.1); yang disimpan hanya &lt;i&gt;rencana / terlaksana / batal&lt;/i&gt;." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="1316" width="400" height="100" as="geometry"/></mxCell><mxCell id="sdm-act-notes-n6-1" value="&lt;b&gt;[ASUMSI]&lt;/b&gt; Batal adalah status akhir; item tidak bisa batal setelah ada realisasi. Pelatihan pengganti masuk rencana tahun berikutnya; revisi rencana setelah disahkan tidak dirancang &lt;b&gt;[KONFIRMASI KU-2]&lt;/b&gt;." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="1426" width="400" height="70" as="geometry"/></mxCell><mxCell id="sdm-act-notes-h7" value="&lt;b&gt;S4 · Surat Tugas dan Rencana Pelatihan (labfik.sdm.surat.tugas, labfik.sdm.rencana.pelatihan): approval.mixin&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="470" y="1270" width="400" height="40" as="geometry"/></mxCell><mxCell id="sdm-act-notes-n7-0" value="&lt;b&gt;Kelengkapan per jenis&lt;/b&gt;: lihat catatan A4. Pada Rencana Pelatihan, pengajuan sekaligus membekukan daftar kebutuhan (KF-SDM-32). &lt;b&gt;Diganti&lt;/b&gt; hanya untuk Surat Tugas yang direvisi (Pelengkap, KF-SDM-14); revisi Rencana Pelatihan tidak dirancang (KU-2)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="470" y="1316" width="400" height="80" as="geometry"/></mxCell><mxCell id="sdm-act-notes-n7-1" value="&lt;b&gt;Tanpa status Kedaluwarsa&lt;/b&gt;: modul SDM tidak memakai penjadwal (kontrak Core K-3). Rencana Pelatihan yang periodenya sudah lewat tetap &lt;i&gt;Disahkan&lt;/i&gt;; &quot;masih berlaku&quot; untuk K1 dihitung dari periode (&lt;code&gt;period.mixin.is_berlaku&lt;/code&gt;). &lt;b&gt;[ASUMSI]&lt;/b&gt; Diganti dan Dicabut adalah status akhir." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="470" y="1406" width="400" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
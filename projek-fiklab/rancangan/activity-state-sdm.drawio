<mxfile host="app.diagrams.net"><diagram id="sdm-act-a1" name="Activity TO-BE (1-3) - Seleksi dan Penugasan Petugas"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="1328" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sdm-act-a1-lane-k" value="KaLab" style="swimlane;html=1;startSize=34;fillColor=#EEFAF3;strokeColor=#4E9A6B;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;collapsible=0;container=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="460" height="1198" as="geometry"/></mxCell><mxCell id="sdm-act-a1-lane-l" value="Laboran / PLP" style="swimlane;html=1;startSize=34;fillColor=#EEFAF3;strokeColor=#4E9A6B;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;collapsible=0;container=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="500" y="70" width="300" height="1198" as="geometry"/></mxCell><mxCell id="sdm-act-a1-lane-s" value="Sistem" style="swimlane;html=1;startSize=34;fillColor=#EEFAF3;strokeColor=#4E9A6B;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;collapsible=0;container=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="800" y="70" width="300" height="1198" as="geometry"/></mxCell><mxCell id="sdm-act-a1-lane-x" value="Penyetuju pengecualian (di luar sistem)" style="swimlane;html=1;startSize=34;fillColor=#F2F2F2;strokeColor=#999999;dashed=1;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;collapsible=0;container=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1100" y="70" width="260" height="1198" as="geometry"/></mxCell><mxCell id="sdm-act-a1-title" value="A1 · Seleksi Asisten dan Penugasan Petugas Praktikum (PKG-04), satu periode" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1100" height="40" as="geometry"/></mxCell><mxCell id="sdm-act-a1-st" value="" style="ellipse;html=
k" target="sdm-act-a3-t2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-act-a3-15" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="sdm-act-a3-t2" target="sdm-act-a3-ce"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-act-a3-16" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="sdm-act-a3-ce" target="sdm-act-a3-d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-act-a3-17" value="[efektif]" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="sdm-act-a3-d2" target="sdm-act-a3-bk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-act-a3-18" value="[perlu pengembangan]" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="sdm-act-a3-d2" target="sdm-act-a3-m3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-act-a3-19" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-act-a3-bk" target="sdm-act-a3-m3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="1248"/></Array></mxGeometry></mxCell><mxCell id="sdm-act-a3-20" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="sdm-act-a3-m3" target="sdm-act-a3-d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-act-a3-21" value="[masih ada item terjadwal]" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-act-a3-d3" target="sdm-act-a3-m1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="685" y="1322"/><mxPoint x="685" y="582"/></Array></mxGeometry></mxCell><mxCell id="sdm-act-a3-22" value="[semua item selesai / batal]" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="sdm-act-a3-d3" target="sdm-act-a3-en"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-act-a3-note0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §3.2)&lt;br&gt;• Putih «user» = aktor memakai sistem&lt;br&gt;• Abu-abu «service» = dikerjakan sistem otomatis&lt;br&gt;• Krem putus-putus «manual» = di luar sistem&lt;br&gt;• Ungu «call behavior» = memanggil activity lain&lt;br&gt;• ◇ keputusan/gabungan; kondisi ditulis [guard] di panah&lt;br&gt;• ⧗ = menunggu kejadian/waktu tertentu&lt;br&gt;• Lajur abu-abu putus-putus = pihak di luar sistem" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1140" y="70" width="340" height="150" as="geometry"/></mxCell><mxCell id="sdm-act-a3-note1" value="&lt;b&gt;«call behavior» Sahkan dokumen (TK-A1)&lt;/b&gt; = activity &lt;i&gt;A1 Pengesahan Dokumen&lt;/i&gt; modul Tata Kelola (&lt;code&gt;labfik.approval.mixin&lt;/code&gt; di Core): ajukan → periksa kelengkapan → terbitkan/cetak → tanda tangan di luar sistem → unggah PDF → sahkan (cek wewenang) → dokumen lama diganti. Tidak digambar ulang di modul SDM." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1140" y="236" width="340" height="100" as="geometry"/></mxCell><mxCell id="sdm-act-a3-note2" value="&lt;b&gt;Kaitan ke PKG-14&lt;/b&gt;&lt;br&gt;K1: &lt;i&gt;Buat rencana&lt;/i&gt;, &lt;i&gt;Isi kebutuhan&lt;/i&gt;, &lt;i&gt;Lengkapi kebutuhan&lt;/i&gt;, &lt;i&gt;Sahkan&lt;/i&gt; (KF-SDM-29, 30, 32)&lt;br&gt;K2: &lt;i&gt;Susun item pelatihan&lt;/i&gt; (KF-SDM-31), dicek saat diajukan&lt;br&gt;K3: &lt;i&gt;Catat realisasi&lt;/i&gt; + bukti penerapan (KF-SDM-33)&lt;br&gt;K4: &lt;i&gt;Catat evaluasi efektivitas&lt;/i&gt;, &lt;i&gt;Buat bukti kompetensi&lt;/i&gt; (KF-SDM-34, 35)&lt;br&gt;Kriteria tertinggi dihitung saat dibaca (KF-SDM-36)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1140" y="352" width="340" height="130" as="geometry"/></mxCell><mxCell id="sdm-act-a3-note3" value="&lt;b&gt;Pembekuan kebutuhan&lt;/b&gt; terjadi di dalam TK-A1 saat diajukan (&lt;i&gt;hook&lt;/i&gt; &lt;code&gt;_sebelum_ajukan()&lt;/code&gt;, KF-SDM-32).&lt;br&gt;&lt;i&gt;Tandai item batal&lt;/i&gt; = Pelengkap (KF-SDM-37).&lt;br&gt;&lt;b&gt;Siklus berikutnya&lt;/b&gt;: bukti kompetensi baru mengubah matriks, sehingga kebutuhan tahun depan (A3 berikutnya) ikut diperbarui." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1140" y="498" width="340" height="100" as="geometry"/></mxCell><mxCell id="sdm-act-a3-note4" value="&lt;b&gt;[KONFIRMASI]&lt;/b&gt; K10: pengesah rencana pelatihan (KaLab / Wadek Bidang Keuangan dan Umum). Wawancara no. 12: kapan dan oleh siapa efektivitas dinilai." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1140" y="614" width="340" height="70" as="geometry"/></mxCell><mxCell id="sdm-act-a3-note5" value="Sumber: kebutuhan-sdm.md (KF-SDM), brief-sdm.md, analisis PKG-04/10/14 · Draf 14 Nov 2026 · Zahir" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1140" y="700" width="340" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="sdm-stm-s1" name="State Machine TO-BE (1-3) - Otorisasi"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sdm-stm-s1-title" value="S1 · State machine Otorisasi Personel (&lt;code&gt;approval.mixin.state&lt;/code&gt; + masa berlaku sendiri), PKG-10" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1500" height="40" as="geometry"/></mxCell><mxCell id="sdm-stm-s1-init" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="50" y="238" width="24" height="24" as="geometry"/></mxCell><mxCell id="sdm-stm-s1-draf" value="Draf" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="130" y="225" width="150" height="50" as="geometry"/></mxCell><mxCell id="sdm-stm-s1-aju" value="Diajukan" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="225" width="150" height="50" as="geometry"/></mxCell><mxCell id="sdm-stm-s1-sah" value="Disahkan" style="swimlane;rounded=1;arcSize=6;html=1;startSize=30;fontStyle=1;fontSize=13;fillColor=#EEFAF3;strokeColor=#4E9A6B;swimlaneFillColor=#FFFFFF;collapsible=0;container=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="800" y="110" width="420" height="290" as="geometry"/></mxCell><mxCell id="sdm-stm-s1-ini2" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="830" y="250" width="24" height="24" as="geometry"/></mxCell><mxCell id="sdm-stm-s1-brl" value="Berlaku" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="900" y="237" width="130" height="50" as="geometry"/></mxCell><mxCell id="sdm-stm-s1-lwt" value="Lewat masa berlaku" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1060" y="330" width="140" height="50" as="geometry"/></mxCell><mxCell id="sdm-stm-s1-gnt" value="Diganti" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#EEEEEE;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1330" y="120" width="150" height="50" as="geometry"/></mxCell><mxCell id="sdm-stm-s1-cbt" value="Dicabut" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#EEEEEE;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1330" y="330" width="150" height="50" as="geometry"/></mxCell><mxCell id="sdm-stm-s1-f0" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="191" y="400" width="28" height="28" as="geometry"/></mxCell><mxCell id="sdm-stm-s1-f1" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1570" y="131" width="28" height="28" as="geometry"/></mxCell><mxCell id="sdm-stm-s1-f2" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1570" y="341" width="28" height="28" as="geometry"/></mxCell><mxCell id="sdm-stm-s1-t0" value="buat" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="sdm-stm-s1-init" target="sdm-stm-s1-draf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-stm-s1-t1" value="ajukan [kompetensi terbukti ∧ lingkup terisi&lt;br&gt;∧ supervisor berwenang bila terbimbing]&lt;br&gt;/ catat riwayat" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-stm-s1-draf" target="sdm-stm-s1-aju"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-stm-s1-t2" value="kembalikan / catat alasan" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-stm-s1-aju" target="sdm-stm-s1-draf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-stm-s1-t3" value="sahkan [berkas TTD ada ∧ pengesah berwenang]&lt;br&gt;/ catat pengesah; otorisasi lama&lt;br&gt;pasangan sama → Diganti" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.48;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-stm-s1-aju" target="sdm-stm-s1-sah"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-stm-s1-t4" value="/ tetapkan berlaku_mulai,&lt;br&gt;berlaku_sampai" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="sdm-stm-s1-ini2" target="sdm-stm-s1-brl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-stm-s1-t5" value="when(hari ini &amp;gt; berlaku_sampai)" style="endArrow=open;endSize=9;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9B2C44;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-stm-s1-brl" target="sdm-stm-s1-lwt"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="965" y="355"/></Array></mxGeometry></mxCell><mxCell id="sdm-stm-s1-t6" value="otorisasi baru pasangan sama disahkan&lt;br&gt;(perpanjang / batasi / naik level)" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.05;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-stm-s1-sah" target="sdm-stm-s1-gnt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-stm-s1-t7" value="cabut [evaluasi ulang: dicabut]&lt;br&gt;/ catat alasan" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.76;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-stm-s1-sah" target="sdm-stm-s1-cbt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-stm-s1-t8" value="hapus [belum pernah diajukan]" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-stm-s1-draf" target="sdm-stm-s1-f0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-stm-s1-tf1" value="" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="sdm-stm-s1-gnt" target="sdm-stm-s1-f1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-stm-s1-tf2" value="" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="sdm-stm-s1-cbt" target="sdm-stm-s1-f2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-stm-s1-n1" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §3.3): &lt;code&gt;event [guard] / efek&lt;/code&gt;. Abu-abu = status akhir. &lt;font color='#9B2C44'&gt;&lt;b&gt;Garis merah&lt;/b&gt;&lt;/font&gt; = transisi yang &lt;b&gt;baru ditemukan&lt;/b&gt; lewat tabel status × transisi (proses-bisnis-sdm.md bagian 4). Kotak hijau = status komposit." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="560" height="80" as="geometry"/></mxCell><mxCell id="sdm-stm-s1-n2" value="&lt;b&gt;Berlaku / Lewat masa berlaku&lt;/b&gt; adalah transisi stabil (§9.3.1): &lt;b&gt;tidak&lt;/b&gt; disimpan di &lt;code&gt;state&lt;/code&gt;, tetapi dihitung dari &lt;code&gt;berlaku_sampai&lt;/code&gt; (&lt;code&gt;is_berlaku&lt;/code&gt;). Tidak ada status &lt;i&gt;Kedaluwarsa&lt;/i&gt; dan tidak ada penjadwal, karena Otorisasi tidak memakai &lt;code&gt;period.mixin&lt;/code&gt; (kontrak Core K-3). PKG-10 S2 hanya terpenuhi di sub-status &lt;b&gt;Berlaku&lt;/b&gt;." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="620" y="470" width="520" height="110" as="geometry"/></mxCell><mxCell id="sdm-stm-s1-n3" value="&lt;b&gt;Unggah berkas&lt;/b&gt; (Diajukan → Diajukan) mengikuti S1 Tata Kelola dan tidak digambar ulang.&lt;br&gt;&lt;b&gt;[ASUMSI]&lt;/b&gt; Diganti dan Dicabut adalah status akhir; otorisasi baru dibuat sebagai rekaman baru." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1160" y="470" width="420" height="90" as="geometry"/></mxCell><mxCell id="sdm-stm-s1-n4" value="Sumber: kebutuhan-sdm.md (KF-SDM), brief-sdm.md, analisis PKG-04/10/14 · Draf 14 Nov 2026 · Zahir" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="560" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="sdm-stm-s2" name="State Machine TO-BE (2-3) - Evaluasi Ulang Otorisasi"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="580" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sdm-stm-s2-title" value="S2 · State machine Evaluasi Ulang Otorisasi (PKG-10 S4)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1200" height="40" as="geometry"/></mxCell><mxCell id="sdm-stm-s2-init" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="50" y="188" width="24" height="24" as="geometry"/></mxCell><mxCell id="sdm-stm-s2-trb" value="Terbuka" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="160" y="175" width="150" height="50" as="geometry"/></mxCell><mxCell id="sdm-stm-s2-ptn" value="Diputuskan" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#EEEEEE;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="700" y="175" width="150" height="50" as="geometry"/></mxCell><mxCell id="sdm-stm-s2-f1" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="960" y="186" width="28" height="28" as="geometry"/></mxCell><mxCell id="sdm-stm-s2-t0" value="catat pemicu" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="sdm-stm-s2-init" target="sdm-stm-s2-trb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-stm-s2-t1" value="putuskan [keputusan ∈ {diperpanjang, dibatasi, naik level}]&lt;br&gt;/ susun otorisasi baru (A2)" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-stm-s2-trb" target="sdm-stm-s2-ptn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-stm-s2-t2" value="putuskan [keputusan = dicabut] / cabut otorisasi" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-stm-s2-trb" target="sdm-stm-s2-ptn"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="235" y="300"/><mxPoint x="775" y="300"/></Array></mxGeometry></mxCell><mxCell id="sdm-stm-s2-t3" value="putuskan [keputusan = tetap berlaku]" style="endArrow=open;endSize=9;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9B2C44;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-stm-s2-trb" target="sdm-stm-s2-ptn"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="235" y="120"/><mxPoint x="775" y="120"/></Array></mxGeometry></mxCell><mxCell id="sdm-stm-s2-tf" value="" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="sdm-stm-s2-ptn" target="sdm-stm-s2-f1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-stm-s2-n1" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §3.3): &lt;code&gt;event [guard] / efek&lt;/code&gt;. Abu-abu = status akhir. &lt;font color='#9B2C44'&gt;&lt;b&gt;Garis merah&lt;/b&gt;&lt;/font&gt; = transisi yang &lt;b&gt;baru ditemukan&lt;/b&gt; lewat tabel status × transisi (proses-bisnis-sdm.md bagian 4). Kotak hijau = status komposit." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="520" height="80" as="geometry"/></mxCell><mxCell id="sdm-stm-s2-n2" value="&lt;b&gt;PKG-10 S4&lt;/b&gt; gagal selama ada evaluasi ulang berstatus &lt;b&gt;Terbuka&lt;/b&gt; pada pasangan itu (KF-SDM-26).&lt;br&gt;Status ini adalah field &lt;code&gt;status&lt;/code&gt; milik &lt;code&gt;labfik.sdm.evaluasi.otorisasi&lt;/code&gt; (transisi stabil, §9.3.1)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="580" y="360" width="460" height="80" as="geometry"/></mxCell><mxCell id="sdm-stm-s2-n3" value="&lt;b&gt;[ASUMSI]&lt;/b&gt; Diputuskan adalah status akhir: keputusan yang berubah dicatat sebagai evaluasi ulang baru (rekaman bukti tidak dihapus, &lt;code&gt;evidence.mixin&lt;/code&gt;).&lt;br&gt;Sumber: kebutuhan-sdm.md (KF-SDM), brief-sdm.md, analisis PKG-04/10/14 · Draf 14 Nov 2026 · Zahir" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="520" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="sdm-stm-s3" name="State Machine TO-BE (3-3) - Item Pelatihan"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sdm-stm-s3-title" value="S3 · State machine Item Pelatihan dalam Rencana Pelatihan (PKG-14 K3–K4)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1300" height="40" as="geometry"/></mxCell><mxCell id="sdm-stm-s3-init" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="50" y="238" width="24" height="24" as="geometry"/></mxCell><mxCell id="sdm-stm-s3-rnc" value="Direncanakan" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="140" y="225" width="160" height="50" as="geometry"/></mxCell><mxCell id="sdm-stm-s3-tl" value="Terlaksana" style="swimlane;rounded=1;arcSize=6;html=1;startSize=30;fontStyle=1;fontSize=13;fillColor=#EEFAF3;strokeColor=#4E9A6B;swimlaneFillColor=#FFFFFF;collapsible=0;container=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="560" y="110" width="440" height="260" as="geometry"/></mxCell><mxCell id="sdm-stm-s3-ini2" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="590" y="228" width="24" height="24" as="geometry"/></mxCell><mxCell id="sdm-stm-s3-mnv" value="Menunggu evaluasi" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="660" y="215" width="140" height="50" as="geometry"/></mxCell><mxCell id="sdm-stm-s3-dev" value="Dievaluasi" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="840" y="300" width="130" height="50" as="geometry"/></mxCell><mxCell id="sdm-stm-s3-btl" value="Batal" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#EEEEEE;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="140" y="420" width="160" height="50" as="geometry"/></mxCell><mxCell id="sdm-stm-s3-f0" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="400" y="120" width="28" height="28" as="geometry"/></mxCell><mxCell id="sdm-stm-s3-f1" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="206" y="530" width="28" height="28" as="geometry"/></mxCell><mxCell id="sdm-stm-s3-f2" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1080" y="226" width="28" height="28" as="geometry"/></mxCell><mxCell id="sdm-stm-s3-t0" value="tambah item [rencana Draf]" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="sdm-stm-s3-init" target="sdm-stm-s3-rnc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-stm-s3-t1" value="catat realisasi [rencana Disahkan]&lt;br&gt;(peserta pertama)" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-stm-s3-rnc" target="sdm-stm-s3-tl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-stm-s3-t2" value="tandai batal [alasan diisi]" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-stm-s3-rnc" target="sdm-stm-s3-btl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-stm-s3-t3" value="hapus item [rencana masih Draf]" style="endArrow=open;endSize=9;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9B2C44;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-stm-s3-rnc" target="sdm-stm-s3-f0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="220" y="134"/></Array></mxGeometry></mxCell><mxCell id="sdm-stm-s3-t4" value="" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="sdm-stm-s3-ini2" target="sdm-stm-s3-mnv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-stm-s3-t5" value="when(setiap realisasi punya&lt;br&gt;evaluasi efektivitas)" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-stm-s3-mnv" target="sdm-stm-s3-dev"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="730" y="325"/></Array></mxGeometry></mxCell><mxCell id="sdm-stm-s3-tf1" value="" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="sdm-stm-s3-btl" target="sdm-stm-s3-f1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-stm-s3-tf2" value="" style="endArrow=open;endSize=9;html=1;rounded=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.45;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-stm-s3-tl" target="sdm-stm-s3-f2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-stm-s3-n1" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §3.3): &lt;code&gt;event [guard] / efek&lt;/code&gt;. Abu-abu = status akhir. &lt;font color='#9B2C44'&gt;&lt;b&gt;Garis merah&lt;/b&gt;&lt;/font&gt; = transisi yang &lt;b&gt;baru ditemukan&lt;/b&gt; lewat tabel status × transisi (proses-bisnis-sdm.md bagian 4). Kotak hijau = status komposit." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="540" height="80" as="geometry"/></mxCell><mxCell id="sdm-stm-s3-n2" value="&lt;b&gt;Kaitan ke PKG-14&lt;/b&gt;: K3 dihitung dari item &lt;b&gt;Terlaksana&lt;/b&gt; yang setiap pesertanya punya realisasi dan bukti penerapan; item &lt;b&gt;Batal&lt;/b&gt; tidak dihitung (KF-SDM-37, Pelengkap). K4 dihitung dari item &lt;b&gt;Dievaluasi&lt;/b&gt;.&lt;br&gt;Sub-status Terlaksana dihitung dari data (transisi stabil, §9.3.1); hanya &lt;i&gt;rencana/terlaksana/batal&lt;/i&gt; yang disimpan." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="600" y="420" width="480" height="110" as="geometry"/></mxCell><mxCell id="sdm-stm-s3-n3" value="&lt;b&gt;Status Rencana Pelatihan&lt;/b&gt; mengikuti S1 Tata Kelola (draf → diajukan → disahkan → diganti/dicabut/kedaluwarsa); tidak digambar ulang. &lt;b&gt;[ASUMSI]&lt;/b&gt; Batal adalah status akhir; item tidak bisa batal setelah ada realisasi.&lt;br&gt;Sumber: kebutuhan-sdm.md (KF-SDM), brief-sdm.md, analisis PKG-04/10/14 · Draf 14 Nov 2026 · Zahir" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="600" y="550" width="480" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
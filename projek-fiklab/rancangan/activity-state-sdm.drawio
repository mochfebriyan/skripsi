oint x="950" y="730"/></Array></mxGeometry></mxCell><mxCell id="sdm-act-a2-12" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="sdm-act-a2-m1" target="sdm-act-a2-so"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-act-a2-13" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="sdm-act-a2-so" target="sdm-act-a2-a1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-act-a2-14" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-act-a2-a1" target="sdm-act-a2-go"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="190" y="952"/></Array></mxGeometry></mxCell><mxCell id="sdm-act-a2-15" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="sdm-act-a2-go" target="sdm-act-a2-m2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-act-a2-16" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="sdm-act-a2-m2" target="sdm-act-a2-te"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-act-a2-17" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-act-a2-te" target="sdm-act-a2-ce"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="1174"/></Array></mxGeometry></mxCell><mxCell id="sdm-act-a2-18" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="sdm-act-a2-ce" target="sdm-act-a2-d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-act-a2-19" value="[diperpanjang / dibatasi / naik level]" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-act-a2-d3" target="sdm-act-a2-m1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="360" y="1248"/><mxPoint x="360" y="730"/></Array></mxGeometry></mxCell><mxCell id="sdm-act-a2-20" value="[tetap berlaku]" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-act-a2-d3" target="sdm-act-a2-m2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="685" y="1248"/><mxPoint x="685" y="1026"/></Array></mxGeometry></mxCell><mxCell id="sdm-act-a2-21" value="[dicabut]" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-act-a2-d3" target="sdm-act-a2-cb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="455" y="1322"/></Array></mxGeometry></mxCell><mxCell id="sdm-act-a2-22" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="sdm-act-a2-cb" target="sdm-act-a2-en"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-act-a2-note0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §3.2)&lt;br&gt;• Putih «user» = aktor memakai sistem&lt;br&gt;• Abu-abu «service» = dikerjakan sistem otomatis&lt;br&gt;• Krem putus-putus «manual» = di luar sistem&lt;br&gt;• Ungu «call behavior» = memanggil activity lain&lt;br&gt;• ◇ keputusan/gabungan; kondisi ditulis [guard] di panah&lt;br&gt;• ⧗ = menunggu kejadian/waktu tertentu&lt;br&gt;• Lajur abu-abu putus-putus = pihak di luar sistem" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1140" y="70" width="340" height="150" as="geometry"/></mxCell><mxCell id="sdm-act-a2-note1" value="&lt;b&gt;«call behavior» Sahkan dokumen (TK-A1)&lt;/b&gt; = activity &lt;i&gt;A1 Pengesahan Dokumen&lt;/i&gt; modul Tata Kelola (&lt;code&gt;labfik.approval.mixin&lt;/code&gt; di Core): ajukan → periksa kelengkapan → terbitkan/cetak → tanda tangan di luar sistem → unggah PDF → sahkan (cek wewenang) → dokumen lama diganti. Tidak digambar ulang di modul SDM." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1140" y="236" width="340" height="100" as="geometry"/></mxCell><mxCell id="sdm-act-a2-note2" value="&lt;b&gt;Kaitan ke PKG-10&lt;/b&gt;&lt;br&gt;Penyebut: &lt;i&gt;Tetapkan pelaksana tugas/alat&lt;/i&gt; (KF-SDM-18, 19)&lt;br&gt;S1 kompetensi: &lt;i&gt;Catat asesmen&lt;/i&gt; / bukti yang ada (KF-SDM-20, 21)&lt;br&gt;S2 otorisasi berlaku: &lt;i&gt;Susun otorisasi&lt;/i&gt; + &lt;i&gt;Sahkan&lt;/i&gt; (KF-SDM-22, 23, 24)&lt;br&gt;S3 pemula disupervisi: guard kelengkapan saat diajukan (KF-SDM-23)&lt;br&gt;S4 evaluasi ulang: &lt;i&gt;Catat evaluasi ulang&lt;/i&gt; (KF-SDM-25)&lt;br&gt;Status S1–S4 per pasangan dihitung saat dibaca (KF-SDM-26)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1140" y="352" width="340" height="140" as="geometry"/></mxCell><mxCell id="sdm-act-a2-note3" value="&lt;b&gt;Temuan&lt;/b&gt; (tabel status × transisi S2): keputusan &lt;i&gt;tetap berlaku&lt;/i&gt; belum ada di KF-SDM-25 (mis. alat diganti tetapi kompetensi masih memadai).&lt;br&gt;⧗ pemicu dicatat manual; &lt;b&gt;tidak ada penjadwal&lt;/b&gt; (kontrak Core K-3)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1140" y="508" width="340" height="90" as="geometry"/></mxCell><mxCell id="sdm-act-a2-note4" value="&lt;b&gt;[KONFIRMASI]&lt;/b&gt; KB-1 penyebut = pelaksana yang ditetapkan KaLab. Wawancara no. 16–18: alat mana yang wajib izin, cara uji, dan masa berlaku." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1140" y="614" width="340" height="70" as="geometry"/></mxCell><mxCell id="sdm-act-a2-note5" value="Sumber: kebutuhan-sdm.md (KF-SDM), brief-sdm.md, analisis PKG-04/10/14 · Draf 14 Nov 2026 · Zahir" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1140" y="700" width="340" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="sdm-act-a3" name="Activity TO-BE (3-3) - Siklus Pelatihan PLP"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="1550" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sdm-act-a3-lane-k" value="KaLab" style="swimlane;html=1;startSize=34;fillColor=#EEFAF3;strokeColor=#4E9A6B;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;collapsible=0;container=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="300" height="1420" as="geometry"/></mxCell><mxCell id="sdm-act-a3-lane-l" value="Laboran / PLP (peserta, pencatat)" style="swimlane;html=1;startSize=34;fillColor=#EEFAF3;strokeColor=#4E9A6B;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;collapsible=0;container=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="340" y="70" width="460" height="1420" as="geometry"/></mxCell><mxCell id="sdm-act-a3-lane-s" value="Sistem" style="swimlane;html=1;startSize=34;fillColor=#EEFAF3;strokeColor=#4E9A6B;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;collapsible=0;container=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="800" y="70" width="300" height="1420" as="geometry"/></mxCell><mxCell id="sdm-act-a3-title" value="A3 · Siklus Pelatihan PLP/Laboran (PKG-14), satu tahun" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1100" height="40" as="geometry"/></mxCell><mxCell id="sdm-act-a3-st" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="178" y="126" width="24" height="24" as="geometry"/></mxCell><mxCell id="sdm-act-a3-br" value="&lt;font style='font-size:9px' color='#6C4A87'&gt;«user»&lt;/font&gt;&lt;br&gt;Buat rencana pelatihan" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="90" y="189" width="200" height="46" as="geometry"/></mxCell><mxCell id="sdm-act-a3-ik" value="&lt;font style='font-size:9px' color='#6C4A87'&gt;«service»&lt;/font&gt;&lt;br&gt;Isi kebutuhan dari matriks kompetensi" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#EEEEEE;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="850" y="263" width="200" height="46" as="geometry"/></mxCell><mxCell id="sdm-act-a3-lk" value="&lt;font style='font-size:9px' color='#6C4A87'&gt;«user»&lt;/font&gt;&lt;br&gt;Lengkapi kebutuhan kompetensi" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="90" y="337" width="200" height="46" as="geometry"/></mxCell><mxCell id="sdm-act-a3-si" value="&lt;font style='font-size:9px' color='#6C4A87'&gt;«user»&lt;/font&gt;&lt;br&gt;Susun item pelatihan" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="90" y="411" width="200" height="46" as="geometry"/></mxCell><mxCell id="sdm-act-a3-a1" value="&lt;font style='font-size:9px' color='#6C4A87'&gt;«call behavior»&lt;/font&gt;&lt;br&gt;Sahkan dokumen (TK-A1)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F5F0FF;strokeColor=#6C4A87;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="90" y="483" width="200" height="50" as="geometry"/></mxCell><mxCell id="sdm-act-a3-m1" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="438" y="565" width="34" height="34" as="geometry"/></mxCell><mxCell id="sdm-act-a3-te" value="Jadwal item pelatihan tiba" style="shape=collate;html=1;fillColor=#FFFFFF;strokeColor=#333333;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="444" y="642" width="22" height="28" as="geometry"/></mxCell><mxCell id="sdm-act-a3-d1" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="438" y="713" width="34" height="34
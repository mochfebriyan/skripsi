try"></mxGeometry></mxCell><mxCell id="sdm-act-a1-11" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-act-a1-bp" target="sdm-act-a1-d2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="804"/></Array></mxGeometry></mxCell><mxCell id="sdm-act-a1-12" value="[masih ada calon]" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-act-a1-d2" target="sdm-act-a1-m0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="804"/><mxPoint x="470" y="286"/></Array></mxGeometry></mxCell><mxCell id="sdm-act-a1-13" value="[seleksi selesai]" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="sdm-act-a1-d2" target="sdm-act-a1-su"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-act-a1-14" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="sdm-act-a1-su" target="sdm-act-a1-a1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-act-a1-15" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="sdm-act-a1-a1" target="sdm-act-a1-m2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-act-a1-16" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="sdm-act-a1-m2" target="sdm-act-a1-d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-act-a1-17" value="[perlu pengganti]" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-act-a1-d3" target="sdm-act-a1-rv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-act-a1-18" value="" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdm-act-a1-rv" target="sdm-act-a1-m2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="385" y="1026"/></Array></mxGeometry></mxCell><mxCell id="sdm-act-a1-19" value="[periode berakhir]" style="endArrow=open;endSize=9;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="sdm-act-a1-d3" target="sdm-act-a1-en"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sdm-act-a1-note0" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, §3.2)&lt;br&gt;• Putih «user» = aktor memakai sistem&lt;br&gt;• Abu-abu «service» = dikerjakan sistem otomatis&lt;br&gt;• Krem putus-putus «manual» = di luar sistem&lt;br&gt;• Ungu «call behavior» = memanggil activity lain&lt;br&gt;• ◇ keputusan/gabungan; kondisi ditulis [guard] di panah&lt;br&gt;• ⧗ = menunggu kejadian/waktu tertentu&lt;br&gt;• Lajur abu-abu putus-putus = pihak di luar sistem" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1400" y="70" width="340" height="150" as="geometry"/></mxCell><mxCell id="sdm-act-a1-note1" value="&lt;b&gt;«call behavior» Sahkan dokumen (TK-A1)&lt;/b&gt; = activity &lt;i&gt;A1 Pengesahan Dokumen&lt;/i&gt; modul Tata Kelola (&lt;code&gt;labfik.approval.mixin&lt;/code&gt; di Core): ajukan → periksa kelengkapan → terbitkan/cetak → tanda tangan di luar sistem → unggah PDF → sahkan (cek wewenang) → dokumen lama diganti. Tidak digambar ulang di modul SDM." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1400" y="236" width="340" height="100" as="geometry"/></mxCell><mxCell id="sdm-act-a1-note2" value="&lt;b&gt;Kaitan ke PKG-04&lt;/b&gt;&lt;br&gt;S1 kebutuhan: &lt;i&gt;Tetapkan kebutuhan petugas&lt;/i&gt; (KF-SDM-09)&lt;br&gt;S2 penugasan sah: &lt;i&gt;Susun surat tugas&lt;/i&gt; + &lt;i&gt;Sahkan&lt;/i&gt; (KF-SDM-10, 06, 11, 43)&lt;br&gt;S3 kompetensi: Bukti Kompetensi (CRUDL, KF-SDM-03), dicek sistem&lt;br&gt;S4 syarat internal: &lt;i&gt;Catat hasil seleksi&lt;/i&gt; (KF-SDM-07, 08)&lt;br&gt;Status S1–S4 per sesi &lt;b&gt;dihitung saat dibaca&lt;/b&gt; (KF-SDM-12), bukan tugas." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1400" y="352" width="340" height="130" as="geometry"/></mxCell><mxCell id="sdm-act-a1-note3" value="&lt;b&gt;Surat tugas&lt;/b&gt; berisi baris asisten → kelas dan laboran → ruang, dengan rentang berlaku. &lt;i&gt;Revisi surat tugas&lt;/i&gt; (pengganti) = Pelengkap (KF-SDM-14).&lt;br&gt;Calon yang &lt;b&gt;tidak lulus&lt;/b&gt; tidak dicatat; seleksinya sendiri di luar sistem (POB 2025)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1400" y="498" width="340" height="90" as="geometry"/></mxCell><mxCell id="sdm-act-a1-note4" value="&lt;b&gt;[KONFIRMASI]&lt;/b&gt; K7: siapa pengesah surat tugas. KB-3: surat tugas &lt;b&gt;ditolak&lt;/b&gt; bila ada asisten tanpa seleksi lulus untuk MK kelasnya (default; alternatif: hanya peringatan). K2: penyetuju pengecualian (Koor Prodi/KaLab?)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1400" y="604" width="340" height="90" as="geometry"/></mxCell><mxCell id="sdm-act-a1-note5" value="Sumber: kebutuhan-sdm.md (KF-SDM), brief-sdm.md, analisis PKG-04/10/14 · Draf 14 Nov 2026 · Zahir" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1400" y="710" width="340" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="sdm-act-a2" name="Activity TO-BE (2-3) - Otorisasi Personel"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="1550" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sdm-act-a2-lane-k" value="KaLab" style="swimlane;html=1;startSize=34;fillColor=#EEFAF3;strokeColor=#4E9A6B;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;collapsible=0;container=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="300" height="1420" as="geometry"/></mxCell><mxCell id="sdm-act-a2-lane-l" value="Laboran / PLP (penilai, pencatat)" style="swimlane;html=1;startSize=34;fillColor=#EEFAF3;strokeColor=#4E9A6B;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;collapsible=0;container=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="340" y="70" width="460" height="1420" as="geometry"/></mxCell><mxCell id="sdm-act-a2-lane-s" value="Sistem" style="swimlane;html=1;startSize=34;fillColor=#EEFAF3;strokeColor=#4E9A6B;fontStyle=1;fontSize=13;swimlaneFillColor=#FFFFFF;collapsible=0;container=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="800" y="70" width="300" height="1420" as="geometry"/></mxCell><mxCell id="sdm-act-a2-title" value="A2 · Otorisasi PLP/Laboran untuk Tugas/Alat Berkewenangan Khusus (PKG-10)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1100" height="40" as="geometry"/></mxCell><mxCell id="sdm-act-a2-st" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="178" y="126" width="24" height="24" as="geometry"/></mxCell><mxCell id="sdm-act-a2-tp" value="&lt;font style='font-size:9px' color='#6C4A87'&gt;«user»&lt;/font&gt;&lt;br&gt;Tetapkan pelaksana tugas/alat" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="90" y="189" width="200" height="46" as="geometry"/></mxCell><mxCell id="sdm-act-a2-d1" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="438" y="269" width="34" height="34" as="geometry"/></mxCell><mxCell id="sdm-act-a2-m0" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="438" y="343" width="34" height="34" as="geometry"/></mxCell><mxCell id="sdm-act-a2-uj" value="&lt;font style='font-size:9px' color='#6C4A87'&gt;«manual»&lt;/font&gt;&lt;br&gt;Uji keterampilan personel" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF8E7;strokeColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="355" y="411" width="200" height="46" as="geometry"/></mxCell><mxCell id="sdm-act-a2-ca" value="&lt;font style='font-size:9px' color='#6C4A87'&gt;«user»&lt;/font&gt;&lt;br&gt;Catat asesmen keterampilan" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="355" y="485" width="200" height="46" as="geometry"/></mxCell><mxCell id="sdm-act-a2-d2" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="438" y="565" width="34" height="34" as="geometry"/></mxCell><mxCell id="sdm-act-a2-pg" value="&lt;font style='font-size:9px' color='#6C4A87'&gt;«manual»&lt;/font&gt;&lt;br&gt;Ikuti pengembangan kompetensi" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF8E7;strokeColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="585" y="559" width="200" height="46" as="geometry"/></mxCell><mxCell id="sdm-act-a2-bk" value="&lt;font style='font-size:9px' color='#6C4A87'&gt;«service»&lt;/font&gt;&lt;br&gt;Buat bukti kompetensi" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#EEEEEE;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="850" y="633" width="200" height="46" as="geometry"/></mxCell><mxCell id="sdm-act-a2-m1" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="173" y="713" width="34" height="34" as="geometry"/></mxCell><mxCell id="sdm-act-a2-so" value="&lt;font style='font-size:9px' color='#6C4A87'&gt;«user»&lt;/font&gt;&lt;br&gt;Susun otorisasi" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="90" y="781" width="200" height="46" as="geometry"/></mxCell><mxCell id="sdm-act-a2-a1" value="&lt;font style='font-size:9px' color='#6C4A87'&gt;«call behavior»&lt;/font&gt;&lt;br&gt;Sahkan dokumen (TK-A1)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F5F0FF;strokeColor=#6C4A87;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="90" y="853" width="200" height="50" as="geometry"/></mxCell><mxCell id="sdm-act-a2-go" value="&lt;font style='font-size:9px' color='#6C4A87'&gt;«service»&lt;/font&gt;&lt;br&gt;Ganti otorisasi lama" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#EEEEEE;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="850" y="929" width="200" height="46" as="geometry"/></mxCell><mxCell id="sdm-act-a2-m2" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="933" y="1009" width="34" height="34" as="geometry"/></mxCell><mxCell id="sdm-act-a2-te" value="Muncul pemicu evaluasi ulang" style="shape=collate;html=1;fillColor=#FFFFFF;strokeColor=#333333;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="939" y="1086" width="22" height="28" as="geometry"/></mxCell><mxCell id="sdm-act-a2-ce" value="&lt;font style='font-size:9px' color='#6C4A87'&gt;«user»&lt;/font&gt;&lt;br&gt;Catat evaluasi ulang otorisasi" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="355" y="1151" width="200" height="46" as="geometry"/></mxCell><mxCell id="sdm-act-a2-d3" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="438" y="1231" width="34" height="34" as="geometry"/></mxCell><mxCell id="sdm-act-a2-cb" value="&lt;font style='font-size:9px' color='#6C4A87'&gt;«user»&lt;/font&gt;&lt;br&gt;Cabut otorisasi" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="90" y="1299" width="200" height="46" as="geometry"/></mxCell><mxCell id="sdm-act-a2-en" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="176" y="1382" width="28" height="28" as="geometry"/></mxCell><mxCell id="sdm-act-a2-1" value
olor=#FFFFFF;" connectable="0" vertex="1" parent="tk-cm3-i-rea"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-cm3-i-rea-l1" value="*" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="tk-cm3-i-rea"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-cm3-rea-per1" value="" style="endArrow=none;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#444444;fontSize=10;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tk-cm3-rea" target="tk-cm3-per"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tk-cm3-rea-per1-l0" value="*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="tk-cm3-rea-per1"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-cm3-rea-per1-l1" value="1 pelapor" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="tk-cm3-rea-per1"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-cm3-rea-per2" value="" style="endArrow=none;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#444444;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tk-cm3-rea" target="tk-cm3-per"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="1290"/><mxPoint x="1100" y="1290"/></Array></mxGeometry></mxCell><mxCell id="tk-cm3-rea-per2-l0" value="*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="tk-cm3-rea-per2"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-cm3-rea-per2-l1" value="0..1 pic_tindak_lanjut" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="tk-cm3-rea-per2"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-cm3-k-jab" value="" style="endArrow=none;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#444444;fontSize=10;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tk-cm3-kpi" target="tk-cm3-jab"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1250" y="860"/><mxPoint x="1250" y="930"/></Array></mxGeometry></mxCell><mxCell id="tk-cm3-k-jab-l0" value="*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="tk-cm3-k-jab"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-cm3-k-jab-l1" value="1 jabatan_pic" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="tk-cm3-k-jab"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="tk-cm3-n1" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, Bab 8–9)&lt;br&gt;• Hanya konsep, atribut primitif, dan asosiasi: &lt;b&gt;tanpa method, tanpa detail Odoo&lt;/b&gt;.&lt;br&gt;• Garis polos = asosiasi; label di ujung = &lt;i&gt;peran&lt;/i&gt; dan multiplisitas. Belah ketupat hitam = komposisi (bagian–keseluruhan).&lt;br&gt;• Segitiga kosong ungu = generalisasi. Nama miring = konsep abstrak.&lt;br&gt;• &lt;code&gt;/nama&lt;/code&gt; = atribut/asosiasi turunan (dihitung). «unique» = nilai tidak boleh kembar. &lt;code&gt;[*]&lt;/code&gt; = banyak nilai.&lt;br&gt;• Kotak abu-abu putus-putus = konsep yang dirinci di halaman lain." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="1330" width="640" height="110" as="geometry"/></mxCell><mxCell id="tk-cm3-n2" value="&lt;b&gt;Pola analisis&lt;/b&gt; (Wazlawick Bab 11)&lt;br&gt;• &lt;i&gt;Specification class&lt;/i&gt; (§11.3): KPI adalah definisi indikator; ItemRencana memberi target per periode.&lt;br&gt;• Satu konsep Rencana untuk semua jenis (dibedakan atribut &lt;code&gt;jenis&lt;/code&gt;, transisi stabil §9.3.1). Atribut khusus pengembangan (&lt;code&gt;nilai_risiko&lt;/code&gt;, &lt;code&gt;nilai_manfaat&lt;/code&gt;, TemuanGap, UkuranManfaat) hanya terisi untuk jenis pengembangan.&lt;br&gt;• &lt;code&gt;/prioritas&lt;/code&gt; = turunan dari nilai_risiko × nilai_manfaat [USULAN PENULIS].&lt;br&gt;• &lt;code&gt;/kriteria_tertinggi&lt;/code&gt; = K1–K4 berurutan (PKG-01/13)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="700" y="1330" width="620" height="130" as="geometry"/></mxCell><mxCell id="tk-cm3-n3" value="&lt;b&gt;Enumerasi lain&lt;/b&gt;: KomponenAnggaran {pemeliharaan, k3, perangkat_lunak, infrastruktur, pelatihan, riset_pkm, audit_mutu}; Frekuensi {bulanan, triwulanan, semesteran, tahunan}.&lt;br&gt;&lt;b&gt;Invarian&lt;/b&gt;: status_capaian = tidak_relevan ⇒ alasan ≠ kosong (AB-10); bukti minimal 1 (AB-12)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1340" y="1330" width="400" height="120" as="geometry"/></mxCell><mxCell id="tk-cm3-n4" value="Bahan kerja (tidak masuk proposal). Sumber: expanded use case, kamus DTO SSD. Rincian: rancangan/conceptual-model-tata-kelola.md · Draf 13 Nov 2026 · Febriyan" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="1480" width="1300" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
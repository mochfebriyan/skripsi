usulkan dicabut, memuat jabatan yang berwenang mencabut" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="115" y="726" width="620" height="22" as="geometry"/></mxCell><mxCell id="tk-ssd6-r14" value="ref" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=40;height=22;fontSize=11;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="75" y="744" width="740" height="38" as="geometry"/></mxCell><mxCell id="tk-ssd6-rt14" value="UC-28 Cabut Dokumen" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="115" y="748" width="690" height="30" as="geometry"/></mxCell><mxCell id="tk-ssd6-fr1" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=54;height=22;fontSize=11;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="704" width="855" height="112" as="geometry"/></mxCell><mxCell id="tk-ssd6-gd1" value="«variant» V2 [hasil = tidak_diperlukan] · langkah 5" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="82" y="704" width="765" height="22" as="geometry"/></mxCell><mxCell id="tk-ssd6-m15" value="MSG catatan wajib" style="html=1;endArrow=open;endSize=9;dashed=1;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.8382;exitDx=0;exitDy=0;entryX=0.5;entryY=0.8382;entryDx=0;entryDy=0;" edge="1" parent="1" source="tk-ssd6-ui" target="tk-ssd6-a0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-ssd6-t16" value="kembali ke pengiriman dto_hasil_tinjau" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="115" y="888" width="620" height="22" as="geometry"/></mxCell><mxCell id="tk-ssd6-fr2" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=54;height=22;fontSize=11;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="832" width="855" height="98" as="geometry"/></mxCell><mxCell id="tk-ssd6-gd2" value="«exception» E1 [catatan kosong ∧ hasil ≠ tetap_berlaku] · langkah 5" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="82" y="832" width="765" height="22" as="geometry"/></mxCell><mxCell id="tk-ssd6-legend" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, Bab 7)&lt;br&gt;• Panah hitam penuh: &lt;i&gt;system event&lt;/i&gt; (aktor → antarmuka)&lt;br&gt;• Panah hitam putus-putus: &lt;i&gt;system return&lt;/i&gt; (antarmuka → aktor)&lt;br&gt;• Panah ungu, kepala segitiga: operasi sistem ke kontroler. &lt;b&gt;Command&lt;/b&gt; &lt;code&gt;op(args)&lt;/code&gt; mengubah data tanpa nilai balik; &lt;b&gt;query&lt;/b&gt; &lt;code&gt;dto = op(args)&lt;/code&gt; hanya membaca (CQS, §7.1)&lt;br&gt;• &lt;code&gt;dto_x&lt;/code&gt; = data majemuk (lihat kamus DTO), &lt;code&gt;*&lt;/code&gt; = koleksi, &lt;i&gt;terpilih&lt;/i&gt; = pilihan dari daftar (§7.3)&lt;br&gt;• Stateless: &lt;code&gt;user_id&lt;/code&gt; dikirim ke setiap operasi yang membutuhkannya (§7.5)&lt;br&gt;• &lt;code&gt;opt «exception»&lt;/code&gt; / &lt;code&gt;opt «variant»&lt;/code&gt;: alur alternatif; &lt;code&gt;ref&lt;/code&gt;: use case lain (§7.6)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="905" y="120" width="330" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="tk-ssd7" name="SSD-7 UC-16 Susun Rencana"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1255" pageHeight="1718" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tk-ssd7-title" value="SSD-7 · UC-16 Susun Rencana" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1100" height="32" as="geometry"/></mxCell><mxCell id="tk-ssd7-pre" value="&lt;b&gt;Prakondisi&lt;/b&gt;: pengguna sudah login dan &lt;code&gt;user_id&lt;/code&gt; diketahui antarmuka. Periode yang akan direncanakan tersedia." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="835" height="52" as="geometry"/></mxCell><mxCell id="tk-ssd7-a0" value=":KaLab" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=12;fontStyle=1;size=60;participant=umlActor;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="130" height="1558" as="geometry"/></mxCell><mxCell id="tk-ssd7-ui" value=":Antarmuka" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=12;fontStyle=1;size=60;participant=umlBoundary;" vertex="1" parent="1"><mxGeometry x="360" y="120" width="130" height="1558" as="geometry"/></mxCell><mxCell id="tk-ssd7-ct" value=":Kontroler" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=12;fontStyle=1;size=60;participant=umlControl;" vertex="1" parent="1"><mxGeometry x="720" y="120" width="130" height="1558" as="geometry"/></mxCell><mxCell id="tk-ssd7-m1" value="dto_rencana_baru" style="html=1;endArrow=open;endSize=9;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.0642;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0642;entryDx=0;entryDy=0;" edge="1" parent="1" source="tk-ssd7-a0" target="tk-ssd7-ui"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-s
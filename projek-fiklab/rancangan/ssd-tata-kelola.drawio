Size=11;align=left;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="82" y="610" width="1125" height="22" as="geometry"/></mxCell><mxCell id="tk-ssd2-m19" value="MSG alasan wajib" style="html=1;endArrow=open;endSize=9;dashed=1;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.8592;exitDx=0;exitDy=0;entryX=0.5;entryY=0.8592;entryDx=0;entryDy=0;" edge="1" parent="1" source="tk-ssd2-ui" target="tk-ssd2-a0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-ssd2-t20" value="kembali ke pengiriman alasan" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="115" y="960" width="620" height="22" as="geometry"/></mxCell><mxCell id="tk-ssd2-fr1" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=54;height=22;fontSize=11;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="904" width="1215" height="98" as="geometry"/></mxCell><mxCell id="tk-ssd2-gd1" value="«exception» E1 [alasan kosong, AB-05] · langkah 3" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="82" y="904" width="1125" height="22" as="geometry"/></mxCell><mxCell id="tk-ssd2-legend" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, Bab 7)&lt;br&gt;• Panah hitam penuh: &lt;i&gt;system event&lt;/i&gt; (aktor → antarmuka)&lt;br&gt;• Panah hitam putus-putus: &lt;i&gt;system return&lt;/i&gt; (antarmuka → aktor)&lt;br&gt;• Panah ungu, kepala segitiga: operasi sistem ke kontroler. &lt;b&gt;Command&lt;/b&gt; &lt;code&gt;op(args)&lt;/code&gt; mengubah data tanpa nilai balik; &lt;b&gt;query&lt;/b&gt; &lt;code&gt;dto = op(args)&lt;/code&gt; hanya membaca (CQS, §7.1)&lt;br&gt;• &lt;code&gt;dto_x&lt;/code&gt; = data majemuk (lihat kamus DTO), &lt;code&gt;*&lt;/code&gt; = koleksi, &lt;i&gt;terpilih&lt;/i&gt; = pilihan dari daftar (§7.3)&lt;br&gt;• Stateless: &lt;code&gt;user_id&lt;/code&gt; dikirim ke setiap operasi yang membutuhkannya (§7.5)&lt;br&gt;• &lt;code&gt;opt «exception»&lt;/code&gt; / &lt;code&gt;opt «variant»&lt;/code&gt;: alur alternatif; &lt;code&gt;ref&lt;/code&gt;: use case lain (§7.6)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1265" y="120" width="330" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="tk-ssd3" name="SSD-3 UC-26 Unggah Dokumen Bertanda Tangan"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1615" pageHeight="1022" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tk-ssd3-title" value="SSD-3 · UC-26 Unggah Dokumen Bertanda Tangan" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1100" height="32" as="geometry"/></mxCell><mxCell id="tk-ssd3-pre" value="&lt;b&gt;Prakondisi&lt;/b&gt;: pengguna sudah login dan &lt;code&gt;user_id&lt;/code&gt; diketahui antarmuka. Dokumen Diajukan (pemeriksaan tidak aktif) atau Diperiksa; rencana/SK sudah diterbitkan (UC-25)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1195" height="52" as="geometry"/></mxCell><mxCell id="tk-ssd3-a0" value=":Penyusun" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=12;fontStyle=1;size=60;participant=umlActor;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="130" height="862" as="geometry"/></mxCell><mxCell id="tk-ssd3-ui" value=":Antarmuka" style="shape=umlLifeline;perime
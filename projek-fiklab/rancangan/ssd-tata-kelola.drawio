  <diagram id="tk-ssd-notes" name="Catatan SSD TO-BE (bahan kerja)">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="746" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="tk-ssd-notes-title" value="Catatan system sequence diagram (bahan kerja, tidak disisipkan ke naskah)" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="14" width="1100" height="36" as="geometry" />
        </mxCell>
        <mxCell id="tk-ssd-notes-legend" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, Bab 7)&lt;br&gt;• Panah hitam penuh: &lt;i&gt;system event&lt;/i&gt; (aktor → antarmuka)&lt;br&gt;• Panah hitam putus-putus: &lt;i&gt;system return&lt;/i&gt; (antarmuka → aktor)&lt;br&gt;• Panah kepala segitiga penuh: operasi sistem ke kontroler. &lt;b&gt;Command&lt;/b&gt; &lt;code&gt;op(args)&lt;/code&gt; mengubah data tanpa nilai balik; &lt;b&gt;query&lt;/b&gt; &lt;code&gt;dto = op(args)&lt;/code&gt; hanya membaca (CQS, §7.1)&lt;br&gt;• &lt;code&gt;dto_x&lt;/code&gt; = data majemuk (lihat kamus DTO), &lt;code&gt;*&lt;/code&gt; = koleksi, &lt;i&gt;terpilih&lt;/i&gt; = pilihan dari daftar (§7.3)&lt;br&gt;• Stateless: &lt;code&gt;user_id&lt;/code&gt; dikirim ke setiap operasi yang membutuhkannya (§7.5)&lt;br&gt;• &lt;code&gt;opt «exception»&lt;/code&gt; / &lt;code&gt;opt «variant»&lt;/code&gt;: alur alternatif; &lt;code&gt;ref&lt;/code&gt;: use case lain (§7.6)&lt;br&gt;Sumber: expanded-use-case-tata-kelola.md; kamus DTO di ssd-tata-kelola.md · Draf 14 Nov 2026 · Febriyan" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="40" y="66" width="1100" height="150" as="geometry" />
        </mxCell>
        <mxCell id="tk-ssd-notes-pre1" value="&lt;b&gt;SSD-1 · UC-01 Ajukan Dokumen&lt;/b&gt;&lt;br&gt;&lt;b&gt;Prakondisi&lt;/b&gt;: pengguna sudah teridentifikasi dan &lt;code&gt;user_id&lt;/code&gt; diketahui antarmuka. Ada dokumen Draf yang disusun aktor." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="40" y="236" width="1100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tk-ssd-notes-pre2" value="&lt;b&gt;SSD-2 · UC-03 Unggah Dokumen Bertanda Tangan&lt;/b&gt;&lt;br&gt;&lt;b&gt;Prakondisi&lt;/b&gt;: pengguna sudah teridentifikasi dan &lt;code&gt;user_id&lt;/code&gt; diketahui antarmuka. Ada dokumen Diajukan. Rencana dan SK sudah diterbitkan (UC-02) lalu ditandatangani di luar sistem." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="40" y="296" width="1100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tk-ssd-notes-pre3" value="&lt;b&gt;SSD-3 · UC-05 Sahkan Dokumen&lt;/b&gt;&lt;br&gt;&lt;b&gt;Prakondisi&lt;/b&gt;: pengguna sudah teridentifikasi dan &lt;code&gt;user_id&lt;/code&gt; diketahui antarmuka. Aktor adalah KaLab (AB-06). Ada dokumen Diajukan." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="40" y="356" width="1100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tk-ssd-notes-pre4" value="&lt;b&gt;SSD-4 · UC-15 Unggah Versi Dokumen&lt;/b&gt;&lt;br&gt;&lt;b&gt;Prakondisi&lt;/b&gt;: pengguna sudah teridentifikasi dan &lt;code&gt;user_id&lt;/code&gt; diketahui antarmuka. Dokumen Induk terdaftar (UC-14)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="40" y="416" width="1100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tk-ssd-notes-pre5" value="&lt;b&gt;SSD-5 · UC-18 Tinjau Ulang Dokumen&lt;/b&gt;&lt;br&gt;&lt;b&gt;Prakondisi&lt;/b&gt;: pengguna sudah teridentifikasi dan &lt;code&gt;user_id&lt;/code&gt; diketahui antarmuka. Ada versi Disahkan." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="40" y="476" width="1100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tk-ssd-notes-pre6" value="&lt;b&gt;SSD-6 · UC-23 Susun Rencana&lt;/b&gt;&lt;br&gt;&lt;b&gt;Prakondisi&lt;/b&gt;: pengguna sudah teridentifikasi dan &lt;code&gt;user_id&lt;/code&gt; diketahui antarmuka. KPI dan Personel terdaftar." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="40" y="536" width="1100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tk-ssd-notes-pre7" value="&lt;b&gt;SSD-7 · UC-25 Isi Realisasi Rencana&lt;/b&gt;&lt;br&gt;&lt;b&gt;Prakondisi&lt;/b&gt;: pengguna sudah teridentifikasi dan &lt;code&gt;user_id&lt;/code&gt; diketahui antarmuka. Ada rencana Disahkan dengan item milik aktor." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="40" y="596" width="1100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tk-ssd-notes-pre8" value="&lt;b&gt;SSD-8 · UC-28 Lihat Status Monev&lt;/b&gt;&lt;br&gt;&lt;b&gt;Prakondisi&lt;/b&gt;: pengguna sudah teridentifikasi dan &lt;code&gt;user_id&lt;/code&gt; diketahui antarmuka. —" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="40" y="656" width="1100" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-ssd7-m30" value="dto_rencana" style="html=1;endArrow=open;endSize=9;dashed=1;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.7946;exitDx=0;exitDy=0;entryX=0.5;entryY=0.7946;entryDx=0;entryDy=0;" edge="1" parent="1" source="tk-ssd7-ui" target="tk-ssd7-a0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-ssd7-fr2" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=54;height=22;fontSize=11;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="1154" width="855" height="244" as="geometry"/></mxCell><mxCell id="tk-ssd7-gd2" value="«variant» V3 [melanjutkan draf] · menggantikan langkah 1" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="82" y="1154" width="765" height="22" as="geometry"/></mxCell><mxCell id="tk-ssd7-m31" value="periode_induk, MSG" style="html=1;endArrow=open;endSize=9;dashed=1;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.8524;exitDx=0;exitDy=0;entryX=0.5;entryY=0.8524;entryDx=0;entryDy=0;" edge="1" parent="1" source="tk-ssd7-ui" target="tk-ssd7-a0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-ssd7-fr3" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=54;height=22;fontSize=11;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="1414" width="855" height="74" as="geometry"/></mxCell><mxCell id="tk-ssd7-gd3" value="«exception» E1 [periode di luar rencana induk] · langkah 1" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="82" y="1414" width="765" height="22" as="geometry"/></mxCell><mxCell id="tk-ssd7-m32" value="item_bermasalah*, MSG" style="html=1;endArrow=open;endSize=9;dashed=1;strokeColor=#333333;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;exitX=0.5;exitY=0.9101;exitDx=0;exitDy=0;entryX=0.5;entryY=0.9101;entryDx=0;entryDy=0;" edge="1" parent="1" source="tk-ssd7-ui" target="tk-ssd7-a0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tk-ssd7-fr4" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=54;height=22;fontSize=11;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="1504" width="855" height="74" as="geometry"/></mxCell><mxCell id="tk-ssd7-gd4" value="«exception» E2 [PIC bukan personel aktif] · langkah 5" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="82" y="1504" width="765" height="22" as="geometry"/></mxCell><mxCell id="tk-ssd7-legend" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, Bab 7)&lt;br&gt;• Panah hitam penuh: &lt;i&gt;system event&lt;/i&gt; (aktor → antarmuka)&lt;br&gt;• Panah hitam putus-putus: &lt;i&gt;system return&lt;/i&gt; (antarmuka → aktor)&lt;br&gt;• Panah ungu, kepala segitiga: operasi sistem ke kontroler. &lt;b&gt;Command&lt;/b&gt; &lt;code&gt;op(args)&lt;/code&gt; mengubah data tanpa nilai balik; &lt;b&gt;query&lt;/b&gt; &lt;code&gt;dto = op(args)&lt;/code&gt; hanya membaca (CQS, §7.1)&lt;br&gt;• &lt;code&gt;dto_x&lt;/code&gt; = data majemuk (lihat kamus DTO), &lt;code&gt;*&lt;/code&gt; = koleksi, &lt;i&gt;terpilih&lt;/i&gt; = pilihan dari daftar (§7.3)&lt;br&gt;• Stateless: &lt;code&gt;user_id&lt;/code&gt; dikirim ke setiap operasi yang membutuhkannya (§7.5)&lt;br&gt;• &lt;code&gt;opt «exception»&lt;/code&gt; / &lt;code&gt;opt «variant»&lt;/code&gt;: alur alternatif; &lt;code&gt;ref&lt;/code&gt;: use case lain (§7.6)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="905" y="120" width="330" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="tk-ssd8" name="SSD-8 UC-18 Isi Realisasi Rencana"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1255" pageHeight="1022" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tk-ssd8-title" value="SSD-8 · UC-18 Isi Realisasi Rencana" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1100" height="32" as="geometry"/></mxCell><mxCell id="tk-ssd8-pre" value="&lt;b&gt;Prakondisi&lt;/b&gt;: pengguna sudah login dan &lt;code&gt;user_id&lt;/code&gt; diketahui antarmuka. Rencana Disahkan dan masih berlaku (AB-10)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="835" height="52" as="geometry"/></mxCell><mxCell id="tk-ssd8-a0" value=":PIC (Laboran/KaLab)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=12;fontStyle=1;size=60;participant=umlActor;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="130" height="862" as="geometry"/></mxCell><mxCell id="tk-ssd8-ui" value=":Antarmuka" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=12;fontStyle=1;size=60;participant=umlBoundary;" vertex="1" parent="1"><mxGeometry x="360" y="120" width="130" height="862" as="geometry"/></mxCell><mxCell id="tk-ssd8-ct" value=":Kontroler" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=12;fontStyle=1;size=60;participant=umlControl;" vertex="1" parent="1"><mxGeometry x="720" y="120" width="130" height="862" as="geometry"/></mxCell><mxCell id="tk-ssd8-m1" v
e=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-cm2-vm-psl"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-cm2-vm-ksw" value="" style="endArrow=none;startArrow=diamondThin;startFill=1;startSize=16;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#333333;fontSize=10;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.38;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="prk-cm2-vm" target="prk-cm2-ksw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prk-cm2-vm-ksw-l0" value="1" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=top;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-cm2-vm-ksw"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-cm2-vm-ksw-l1" value="* software" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-cm2-vm-ksw"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-cm2-vm-kbh" value="" style="endArrow=none;startArrow=diamondThin;startFill=1;startSize=16;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#333333;fontSize=10;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="prk-cm2-vm" target="prk-cm2-kbh"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="888" y="220"/><mxPoint x="1210" y="220"/></Array></mxGeometry></mxCell><mxCell id="prk-cm2-vm-kbh-l0" value="1" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=top;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-cm2-vm-kbh"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-cm2-vm-kbh-l1" value="* bahan" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-cm2-vm-kbh"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-cm2-kbh-bhn" value="" style="endArrow=none;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#444444;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="prk-cm2-kbh" target="prk-cm2-bhn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prk-cm2-kbh-bhn-l0" value="*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-cm2-kbh-bhn"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-cm2-kbh-bhn-l1" value="1 bahan" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-cm2-kbh-bhn"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-cm2-n1" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, Bab 8–11)&lt;br&gt;• Hanya konsep, atribut primitif, dan asosiasi: &lt;b&gt;tanpa method, tanpa detail Odoo&lt;/b&gt;, tanpa atribut &lt;code&gt;*_id&lt;/code&gt;.&lt;br&gt;• Garis polos = asosiasi; label di ujung = &lt;i&gt;peran&lt;/i&gt; + multiplisitas. Belah ketupat hitam = komposisi (bagian–keseluruhan).&lt;br&gt;• Segitiga kosong biru = generalisasi; nama miring «abstract» = konsep abstrak.&lt;br&gt;• &lt;code&gt;/nama&lt;/code&gt; = atribut/asosiasi turunan (dihitung, hanya dibaca); panah terbuka = asosiasi turunan satu arah.&lt;br&gt;• Kotak abu-abu putus-putus = konsep yang dirinci di halaman/dokumen lain. (O) = lapis Pelengkap.&lt;br&gt;• Tipe primitif: Date, DateTime, Jam, Natural, Real, Persen, Boolean, String, Text, URL, Berkas, Interval&amp;lt;T&amp;gt; (CM-1)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="640" height="125" as="geometry"/></mxCell><mxCell id="prk-cm2-n2" value="&lt;b&gt;Keputusan pemodelan&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Generalisasi butir&lt;/b&gt; (§9.2.1): tiap jenis butir punya atribut sendiri, dan butir tidak berganti jenis. Tanpa subkelas, atribut seperti &lt;code&gt;lisensi_sah&lt;/code&gt; atau &lt;code&gt;berlabel&lt;/code&gt; menjadi opsional bergantung kategori (§11.2).&lt;br&gt;• &lt;b&gt;SubstitusiBahan&lt;/b&gt; dan &lt;b&gt;PersetujuanSubstitusi&lt;/b&gt; = kejadian (§9.3.2); &lt;code&gt;/status_persetujuan&lt;/code&gt; = disetujui bila ada persetujuan.&lt;br&gt;• &lt;b&gt;KebutuhanBahan → Bahan&lt;/b&gt; = &lt;i&gt;specification class&lt;/i&gt; (§11.3): nama dan satuan diambil dari master Bahan Core.&lt;br&gt;• &lt;code&gt;/versi_berlaku [periode]&lt;/code&gt; = versi berstatus berlaku untuk periode itu; diganti oleh versi baru (&lt;i&gt;superseding&lt;/i&gt;, §11.9.2; AB-PRK-07)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="700" y="880" width="560" height="150" as="geometry"/></mxCell><mxCell id="prk-cm2-n3" value="&lt;b&gt;Turunan dan invarian&lt;/b&gt;&lt;br&gt;• &lt;code&gt;/tepat_waktu&lt;/code&gt; = waktu_periksa &amp;lt; sesi.tanggal + sesi.jam.awal (AB-PRK-13, PKG-16 S1).&lt;br&gt;• ButirStasiunKerja &lt;code&gt;/jumlah_dibutuhkan&lt;/code&gt; = sesi.kelas.jumlah_mahasiswa; ButirBahan = kebutuhan.jumlah_per_mahasiswa × jumlah mahasiswa.&lt;br&gt;• Butir software dan bahan dibentuk dari /versi_berlaku pada tanggal sesi (AB-PRK-14).&lt;br&gt;• keputusan = siap ⇒ tidak ada butir bermasalah dan semua substitusi disetujui (AB-PRK-15, 16).&lt;br&gt;• VersiModul: berkas atau tautan_leads terisi; nomor_versi unik per (MK, periode) (AB-PRK-08).&lt;br&gt;• penyetuju = dosen kelas sesi itu; penerbit = dosen pengampu MK (AB-PRK-09, 16)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1280" y="880" width="420" height="190" as="geometry"/></mxCell><mxCell id="prk-cm2-n4" value="Bahan kerja (tidak masuk proposal). Sumber: kamus DTO dan katalog operasi ssd-praktikum.md; AB-PRK-01–34 expanded-use-case-praktikum.md; kontrak-core.md (16 Nov 2026). Rincian: rancangan/conceptual-model-praktikum.md · Draf 16 Nov 2026 · Herrens" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="1085" width="1220" height="42" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="prk-cm3" name="CM TO-BE (3-4) - Pelaksanaan Sesi dan Penilaian"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1240" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="prk-cm3-title" value="CM-3 · Conceptual model: pelaksanaan sesi (PKG-18) dan penilaian individual (PKG-19)" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="4" width="1500" height="30" as="geometry"/></mxCell><mxCell id="prk-cm3-ses" value="&lt;b&gt;Sesi&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=27;horizontalStack=
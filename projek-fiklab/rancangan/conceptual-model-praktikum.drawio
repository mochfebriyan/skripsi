k"><mxGeometry x="0" y="27" width="200" height="23" as="geometry"/></mxCell><mxCell id="prk-cm4-jtb" value="&lt;b&gt;JawabanTerbuka&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=27;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="540" y="640" width="200" height="50" as="geometry"/></mxCell><mxCell id="prk-cm4-jtb-a" value="teks: Text" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="prk-cm4-jtb"><mxGeometry x="0" y="27" width="200" height="23" as="geometry"/></mxCell><mxCell id="prk-cm4-ev" value="&lt;b&gt;EvaluasiSurvei&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=27;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="860" y="120" width="240" height="50" as="geometry"/></mxCell><mxCell id="prk-cm4-ev-a" value=" " style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="prk-cm4-ev"><mxGeometry x="0" y="27" width="240" height="23" as="geometry"/></mxCell><mxCell id="prk-cm4-rb" value="&lt;b&gt;RekamanBukti&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=27;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FAFAFA
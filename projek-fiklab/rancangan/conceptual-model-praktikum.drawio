oint x="20" y="210"/><mxPoint x="20" y="570"/><mxPoint x="88" y="570"/></Array></mxGeometry></mxCell><mxCell id="prk-cm3-pgs-kls-l0" value="*" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-cm3-pgs-kls"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="-8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-cm3-pgs-kls-l1" value="0..1 kelas_sasaran" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-cm3-pgs-kls"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-cm3-kls-pnk" value="" style="endArrow=none;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#444444;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="prk-cm3-kls" target="prk-cm3-pnk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prk-cm3-kls-pnk-l0" value="1" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-cm3-kls-pnk"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-cm3-kls-pnk-l1" value="0..1 penilaian" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-cm3-kls-pnk"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-cm3-pnk-rb" value="" style="endArrow=block;endFill=0;endSize=14;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#6C8EBF;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=1;entryY=0.45;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="prk-cm3-pnk" target="prk-cm3-rb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="610"/><mxPoint x="1100" y="87"/></Array></mxGeometry></mxCell><mxCell id="prk-cm3-pnk-bn" value="" style="endArrow=none;startArrow=diamondThin;startFill=1;startSize=16;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#333333;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="prk-cm3-pnk" target="prk-cm3-bn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prk-cm3-pnk-bn-l0" value="1" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=top;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-cm3-pnk-bn"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-cm3-pnk-bn-l1" value="* baris" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-cm3-pnk-bn"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-cm3-pnk-bk" value="" style="endArrow=none;startArrow=diamondThin;startFill=1;startSize=16;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#333333;fontSize=10;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="prk-cm3-pnk" target="prk-cm3-bk"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="920" y="654"/></Array></mxGeometry></mxCell><mxCell id="prk-cm3-pnk-bk-l0" value="1" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-cm3-pnk-bk"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-cm3-pnk-bk-l1" value="{ordered} * berkas" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#FFFFFF;" connectable="0" vertex="1" parent="prk-cm3-pnk-bk"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="8" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="prk-cm3-n1" value="&lt;b&gt;Notasi&lt;/b&gt; (Wazlawick 2024, Bab 8–11)&lt;br&gt;• Hanya konsep, atribut primitif, dan asosiasi: &lt;b&gt;tanpa method, tanpa detail Odoo&lt;/b&gt;, tanpa atribut &lt;code&gt;*_id&lt;/code&gt;.&lt;br&gt;• Garis polos = asosiasi; label di ujung = &lt;i&gt;peran&lt;/i&gt; + multiplisitas. Belah ketupat hitam = komposisi (bagian–keseluruhan).&lt;br&gt;• Segitiga kosong biru = generalisasi; nama miring «abstract» = konsep abstrak.&lt;br&gt;• &lt;code&gt;/nama&lt;/code&gt; = atribut/asosiasi turunan (dihitung, hanya dibaca); panah terbuka = asosiasi turunan satu arah.&lt;br&gt;• Kotak abu-abu putus-putus = konsep yang dirinci di halaman/dokumen lain. (O) = lapis Pelengkap.&lt;br&gt;• Tipe primitif: Date, DateTime, Jam, Natural, Real, Persen, Boolean, String, Text, URL, Berkas, Interval&amp;lt;T&amp;gt; (CM-1)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="640" height="125" as="geometry"/></mxCell><mxCell id="prk-cm3-n2" value="&lt;b&gt;Keputusan pemodelan&lt;/b&gt;&lt;br&gt;• &lt;b&gt;PengirimanJurnal&lt;/b&gt; = kejadian (§9.3.2): jurnal draf belum punya waktu kirim dan pengirim. &lt;code&gt;/status&lt;/code&gt; = terkirim bila ada pengiriman.&lt;br&gt;• Foto kegiatan = &lt;code&gt;bukti&lt;/code&gt; warisan RekamanBukti. Presensi petugas merujuk Personel (kontrak Core I-8).&lt;br&gt;• &lt;b&gt;BerkasNilai {ordered}&lt;/b&gt; = riwayat impor (pola &lt;i&gt;history&lt;/i&gt;, §11.12.2): baris nilai diganti saat impor ulang, berkas lama tetap ada (AB-PRK-24). NIM tanpa nama.&lt;br&gt;• &lt;b&gt;PengaturanPraktikum&lt;/b&gt; = variabel sistem satu rekaman (§8.2.2), dibaca oleh atribut turunan; tidak berasosiasi." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="700" y="920" width="560" height="150" as="geometry"/></mxCell><mxCell id="prk-cm3-n3" value="&lt;b&gt;Turunan dan invarian&lt;/b&gt;&lt;br&gt;• &lt;code&gt;/petugas_ditugaskan&lt;/code&gt; (Sesi) = personel pada BarisPenugasan dari Surat Tugas disahkan yang berlaku pada sesi.tanggal: asisten lewat sesi.kelas, laboran lewat sesi.ruang (SDM KF-SDM-10, 12).&lt;br&gt;• &lt;code&gt;/berasisten&lt;/code&gt; (Sesi) = ada asisten di /petugas_ditugaskan. Dosen dibaca dari Kelas.dosen.&lt;br&gt;• &lt;code&gt;/durasi_memenuhi&lt;/code&gt; = durasi jam_aktual ≥ ambang_durasi × durasi sesi.jam (AB-PRK-22).&lt;br&gt;• &lt;code&gt;/terlambat&lt;/code&gt; = waktu_kirim &amp;gt; sesi.tanggal + batas_hari_jurnal (AB-PRK-21).&lt;br&gt;• &lt;code&gt;/sesuai_penugasan&lt;/code&gt; = petugas ∈ sesi./petugas_ditugaskan (AB-PRK-20).&lt;br&gt;• Pengiriman hanya bila presensi dosen dan laboran (+ asisten bila berasisten), jumlah_hadir, versi modul, ≥ 1 log book (AB-PRK-19).&lt;br&gt;• &lt;code&gt;/ada_rubrik&lt;/code&gt; = /versi_berlaku MK kelas punya rubrik; &lt;code&gt;/berbukti&lt;/code&gt; = tautan_leads ∧ /ada_rubrik (AB-PRK-33).&lt;br&gt;• &lt;code&gt;/lengkap&lt;/code&gt; = P1–P4 dengan batas_lulus (AB-PRK-25). nim unik per penilaian." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1280" y="920" width="440" height="260" as="geometry"/></mxCell><mxCell id="prk-cm3-n4" value="Bahan kerja (tidak masuk proposal). Sumber: kamus DTO dan katalog operasi ssd-praktikum.md; AB-PRK-01–34 expanded-use-case-praktikum.md; kontrak-core.md (16 Nov 2026). Rincian: rancangan/conceptual-model-praktikum.md · Draf 16 Nov 2026 · Herrens" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="1150" width="1220" height="42" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="prk-cm4" name="CM TO-BE (4-4) - Survei Kepuasan Pengguna"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="1230" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="prk-cm4-title" value="CM-4 · Conceptual model: survei kepuasan pengguna (PKG-20)" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="4" width="1500" height="30" as="geometry"/></mxCell><mxCell id="prk-cm4-per" value="&lt;b&gt;Periode&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=27;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FAFAFA;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="220" height="50" as="geometry"/></mxCell><mxCell id="prk-cm4-per-a" value="&lt;i&gt;master Core&lt;/i&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="prk-cm4-per"><mxGeometry x="0" y="27" width="220" height="23" as="geometry"/></mxCell><mxCell id="prk-cm4-pts" value="&lt;b&gt;PenetapanSurvei&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=27;hori